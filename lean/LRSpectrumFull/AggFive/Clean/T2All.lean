/-
# L5S4.T2All : from the 26 per-node statements to `StreamHyp'.t2` over `R1d1` (stage S4R)

`T2Stmt n R2` is the `t2` clause of `StreamHyp'` for ONE depth-1 node.  `t2_of_d1` : if it holds for the node `nodeOfRaw (d1Data[i])`
of every stored depth-1 record `i`, it holds for every `n ∈ R1d1`; `T2Stmt.mono` lets each node use its own block
`{idx i | i < repPos.length}` inside the global block set.  The per-node statement is `T2D<k>.t2_block`
(`def`-unfolding gives `T2Stmt`), the global set is `TBlock.set` of the aggregation.

No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5S4.T2Link
import LRSpectrumFull.L5S4.CheckT1

namespace LRSpectrumFull
namespace L5S4

open Matrix Finset LRSpectrumFull.L5S3

/-- the `t2` clause of `StreamHyp'` for one depth-1 node -/
def T2Stmt (n : NodeW 1 4) (R2 : Set (NodeW 2 3)) : Prop :=
  ∀ y : V5, ChildPass n y → ∃ (y' : V5) (n2 : NodeW 2 3),
    (∀ i, dot (n.b i) y' = dot (n.b i) y) ∧ n2.rows = setRow n.rows 1 y' ∧
    ∃ rep ∈ R2, ∃ (g : SP) (U U' : ℕ → ℕ → ℤ), Chain2Rel g n2.rows rep.rows U U'

theorem T2Stmt.mono {n : NodeW 1 4} {R R' : Set (NodeW 2 3)} (h : T2Stmt n R) (hs : R ⊆ R') : T2Stmt n R' := by
  intro y hy
  obtain ⟨y', n2, h1, h2, rep, hrep, g, U, U', hch⟩ := h y hy
  exact ⟨y', n2, h1, h2, rep, hs hrep, g, U, U', hch⟩

/-- `t2` for every stored depth-1 node from `t2` for each of the 26 stored records. -/
theorem t2_of_d1 (R2 : Set (NodeW 2 3))
    (h : ∀ i, i < d1Data.length → ∀ hr : (d1Data.getD i badB.default_d1).ok,
      T2Stmt (nodeOfRaw (d1Data.getD i badB.default_d1) hr) R2) :
    ∀ n ∈ R1d1, T2Stmt n R2 := by
  rintro n ⟨r, hr, hok, rfl⟩
  obtain ⟨i, hi, hri⟩ := List.getElem_of_mem hr
  have e : d1Data.getD i badB.default_d1 = r := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]; simpa using hri
  subst e
  exact h i hi hok

theorem d1Data_length : d1Data.length = 26 := by decide +kernel


#print axioms T2Stmt.mono
#print axioms t2_of_d1
#print axioms d1Data_length

end L5S4

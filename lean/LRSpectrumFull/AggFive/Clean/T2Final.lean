theorem sub_of (node : ℕ → NodeW 2 3) (R2 : Set (NodeW 2 3)) (hmem : ∀ c, c < 1965 → node c ∈ R2) (f len : ℕ) (hle : f + len ≤ 1965) :
    {a | ∃ i, i < len ∧ a = node (f + i)} ⊆ R2 := by
  rintro a ⟨i, hi, rfl⟩
  exact hmem _ (by omega)

theorem t2_all (R2 : Set (NodeW 2 3)) (node : ℕ → NodeW 2 3) (hmem : ∀ c, c < 1965 → node c ∈ R2)

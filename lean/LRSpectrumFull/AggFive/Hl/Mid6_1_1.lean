/-
# AggFive.Hl.Mid6_1_1 : the lines clause carried by `Mid6_1_1.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.Mid6_1_1
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.AggFive.Hl.Leaf6_8
import LRSpectrumFull.AggFive.Hl.Leaf6_9
import LRSpectrumFull.AggFive.Hl.Leaf6_10

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace Mid6_1_1
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where
  k0 : Hl.Leaf6_8.HLines
  k1 : Hl.Leaf6_9.HLines
  k2 : Hl.Leaf6_10.HLines

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.Mid6_1_1.block :=
  (good_append (Hl.Leaf6_8.block_good HL.k0) (good_append (Hl.Leaf6_9.block_good HL.k1) (Hl.Leaf6_10.block_good HL.k2) _) _)

#print axioms block_good

end Mid6_1_1
end Hl
end AggFive
end LRSpectrumFull

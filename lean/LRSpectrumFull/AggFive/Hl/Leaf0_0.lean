/-
# AggFive.Hl.Leaf0_0 : the lines clause carried by `Leaf0_0.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.Leaf0_0
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.L5Reg.RegFin0
import LRSpectrumFull.L5Reg.RegFin23
import LRSpectrumFull.L5Reg.RegFin8

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace Leaf0_0
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.Leaf0_0.block :=
  (good_append (good_append (good_append (good_of_tab L5Reg.lines0) (good_of_tab L5Reg.lines1) _) (good_append (good_of_tab L5Reg.lines2) (good_of_tab L5Reg.lines3) _) _) (good_append (good_append (good_of_tab L5Reg.lines4) (good_of_tab L5Reg.lines5) _) (good_append (good_of_tab L5Reg.lines6) (good_of_tab L5Reg.lines7) _) _) _)

#print axioms block_good

end Leaf0_0
end Hl
end AggFive
end LRSpectrumFull

/-
# AggFive.Hl.D4 : the lines clause carried by `D4.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.D4
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.AggFive.Hl.Leaf4_0
import LRSpectrumFull.AggFive.Hl.Leaf4_1
import LRSpectrumFull.AggFive.Hl.Leaf4_2
import LRSpectrumFull.AggFive.Hl.Leaf4_3
import LRSpectrumFull.AggFive.Hl.Leaf4_4

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace D4
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where
  k0 : Hl.Leaf4_0.HLines
  k1 : Hl.Leaf4_1.HLines
  k2 : Hl.Leaf4_2.HLines
  k3 : Hl.Leaf4_3.HLines
  k4 : Hl.Leaf4_4.HLines

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.D4.block :=
  (good_append (good_append (Hl.Leaf4_0.block_good HL.k0) (Hl.Leaf4_1.block_good HL.k1) _) (good_append (Hl.Leaf4_2.block_good HL.k2) (good_append (Hl.Leaf4_3.block_good HL.k3) (Hl.Leaf4_4.block_good HL.k4) _) _) _)

#print axioms block_good

end D4
end Hl
end AggFive
end LRSpectrumFull

/-
# AggFive.Hl.D1 : the lines clause carried by `D1.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.D1
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.AggFive.Hl.Mid1_1_0
import LRSpectrumFull.AggFive.Hl.Mid1_1_1
import LRSpectrumFull.AggFive.Hl.Mid1_1_2

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace D1
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where
  k0 : Hl.Mid1_1_0.HLines
  k1 : Hl.Mid1_1_1.HLines
  k2 : Hl.Mid1_1_2.HLines

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.D1.block :=
  (good_append (Hl.Mid1_1_0.block_good HL.k0) (good_append (Hl.Mid1_1_1.block_good HL.k1) (Hl.Mid1_1_2.block_good HL.k2) _) _)

#print axioms block_good

end D1
end Hl
end AggFive
end LRSpectrumFull

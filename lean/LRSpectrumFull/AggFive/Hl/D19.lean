/-
# AggFive.Hl.D19 : the lines clause carried by `D19.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.D19
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.AggFive.Hl.Leaf19_0
import LRSpectrumFull.AggFive.Hl.Leaf19_1
import LRSpectrumFull.AggFive.Hl.Leaf19_2
import LRSpectrumFull.AggFive.Hl.Leaf19_3
import LRSpectrumFull.AggFive.Hl.Leaf19_4
import LRSpectrumFull.AggFive.Hl.Leaf19_5
import LRSpectrumFull.AggFive.Hl.Leaf19_6
import LRSpectrumFull.AggFive.Hl.Leaf19_7

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace D19
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where
  k0 : Hl.Leaf19_0.HLines
  k1 : Hl.Leaf19_1.HLines
  k2 : Hl.Leaf19_2.HLines
  k3 : Hl.Leaf19_3.HLines
  k4 : Hl.Leaf19_4.HLines
  k5 : Hl.Leaf19_5.HLines
  k6 : Hl.Leaf19_6.HLines
  k7 : Hl.Leaf19_7.HLines

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.D19.block :=
  (good_append (good_append (good_append (Hl.Leaf19_0.block_good HL.k0) (Hl.Leaf19_1.block_good HL.k1) _) (good_append (Hl.Leaf19_2.block_good HL.k2) (Hl.Leaf19_3.block_good HL.k3) _) _) (good_append (good_append (Hl.Leaf19_4.block_good HL.k4) (Hl.Leaf19_5.block_good HL.k5) _) (good_append (Hl.Leaf19_6.block_good HL.k6) (Hl.Leaf19_7.block_good HL.k7) _) _) _)

#print axioms block_good

end D19
end Hl
end AggFive
end LRSpectrumFull

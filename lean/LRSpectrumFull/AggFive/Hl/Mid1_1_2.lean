/-
# AggFive.Hl.Mid1_1_2 : the lines clause carried by `Mid1_1_2.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.Mid1_1_2
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.AggFive.Hl.Leaf1_16
import LRSpectrumFull.AggFive.Hl.Leaf1_17
import LRSpectrumFull.AggFive.Hl.Leaf1_18
import LRSpectrumFull.AggFive.Hl.Leaf1_19

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace Mid1_1_2
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where
  k0 : Hl.Leaf1_16.HLines
  k1 : Hl.Leaf1_17.HLines
  k2 : Hl.Leaf1_18.HLines
  k3 : Hl.Leaf1_19.HLines

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.Mid1_1_2.block :=
  (good_append (good_append (Hl.Leaf1_16.block_good HL.k0) (Hl.Leaf1_17.block_good HL.k1) _) (good_append (Hl.Leaf1_18.block_good HL.k2) (Hl.Leaf1_19.block_good HL.k3) _) _)

#print axioms block_good

end Mid1_1_2
end Hl
end AggFive
end LRSpectrumFull

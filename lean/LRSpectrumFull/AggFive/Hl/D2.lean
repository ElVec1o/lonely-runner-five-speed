/-
# AggFive.Hl.D2 : the lines clause carried by `D2.block` (generated by l5_hlines)

`HLines` lists the lines hypotheses that remain: one per hole representative (`h<c>`), one per built representative without a `L5Reg.lines<c>` theorem (`m<c>`), one per child (`k<i>`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.D2
import LRSpectrumFull.L5S5.AggLines
import LRSpectrumFull.AggFive.Hl.Leaf2_0
import LRSpectrumFull.AggFive.Hl.Leaf2_1
import LRSpectrumFull.AggFive.Hl.Leaf2_2
import LRSpectrumFull.AggFive.Hl.Leaf2_3

set_option maxRecDepth 100000
namespace LRSpectrumFull
namespace AggFive
namespace Hl
namespace D2
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5 LRSpectrumFull.L5Reg

structure HLines : Prop where
  k0 : Hl.Leaf2_0.HLines
  k1 : Hl.Leaf2_1.HLines
  k2 : Hl.Leaf2_2.HLines
  k3 : Hl.Leaf2_3.HLines

theorem block_good (HL : HLines) : Good T5Store.t5 AggFive.D2.block :=
  (good_append (good_append (Hl.Leaf2_0.block_good HL.k0) (Hl.Leaf2_1.block_good HL.k1) _) (good_append (Hl.Leaf2_2.block_good HL.k2) (Hl.Leaf2_3.block_good HL.k3) _) _)

#print axioms block_good

end D2
end Hl
end AggFive
end LRSpectrumFull

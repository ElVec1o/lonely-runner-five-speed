/-- the lines clause for every class of the concatenated local tables of the whole tree -/
theorem lines_all (H : AggFive.Top.Holes) (HL : HLines H) : ∀ cl ∈ AggFive.Top.topTab H, LinesCl T5Store.t5 cl := by
  intro cl hcl
  unfold AggFive.Top.topTab AggFive.Top.dB0 AggFive.Top.dB1 AggFive.Top.dB2 AggFive.Top.dB3 AggFive.Top.dB4 AggFive.Top.dB5 AggFive.Top.dB6 AggFive.Top.dB7 AggFive.Top.dB9 AggFive.Top.dB10 AggFive.Top.dB11 AggFive.Top.dB12 AggFive.Top.dB13 AggFive.Top.dB14 AggFive.Top.dB15 AggFive.Top.dB16 AggFive.Top.dB17 AggFive.Top.dB19 AggFive.Top.dB20 AggFive.Top.dB21 AggFive.Top.dB22 AggFive.Top.dB24 AggFive.Top.dB25 at hcl
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D25.block_good HL.d25) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D24.block_good HL.d24) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D22.block_good HL.d22) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D21.block_good HL.d21) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D20.block_good HL.d20) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D19.block_good HL.d19) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D17.block_good HL.d17) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D16.block_good HL.d16) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D15.block_good HL.d15) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D14.block_good HL.d14) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D13.block_good HL.d13) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D12.block_good HL.d12) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D11.block_good HL.d11) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D10.block_good HL.d10) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D9.block_good HL.d9) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D7.block_good HL.d7) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D6.block_good HL.d6) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D5.block_good HL.d5) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D4.block_good HL.d4) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D3.block_good HL.d3) cl h
  rcases List.mem_append.1 hcl with hcl | h

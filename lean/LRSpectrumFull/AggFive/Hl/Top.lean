  · exact (Hl.D2.block_good HL.d2) cl h
  rcases List.mem_append.1 hcl with hcl | h
  swap
  · exact (Hl.D1.block_good HL.d1) cl h
  exact (Hl.D0.block_good HL.d0) cl hcl

#print axioms lines_all


theorem pp0 (H : Holes) : (dB0 H).pos0 = 0 := rfl
theorem reg0 {H : Holes} {C : Certificate} (hC : LocRegistered C (topTab H)) : LocRegistered C (dB0 H).tab :=
  fun cl hcl => hC cl (by simp [topTab, hcl])
theorem look0 (H : Holes) (i : ℕ) (hi : i < 33) : topIdx H (0 + i) = (dB0 H).idx i := by
  unfold topIdx
  rw [if_pos (show 0 + i < 33 by omega)]
  all_goals (congr 1; omega)

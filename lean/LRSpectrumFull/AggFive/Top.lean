noncomputable def topIdx (H : Holes) (c : ℕ) : NodeW 2 3 := if c < 33 then (dB0 H).idx (c) else if c < 192 then (dB1 H).idx (c - 33) else if c < 219 then (dB2 H).idx (c - 192) else if c < 220 then (dB3 H).idx (c - 219) else if c < 259 then (dB4 H).idx (c - 220) else if c < 751 then (dB5 H).idx (c - 259) else if c < 833 then (dB6 H).idx (c - 751) else if c < 949 then (dB7 H).idx (c - 833) else if c < 1113 then (dB9 H).idx (c - 949) else if c < 1117 then (dB10 H).idx (c - 1113) else if c < 1119 then (dB11 H).idx (c - 1117) else if c < 1152 then (dB12 H).idx (c - 1119) else if c < 1409 then (dB13 H).idx (c - 1152) else if c < 1425 then (dB14 H).idx (c - 1409) else if c < 1514 then (dB15 H).idx (c - 1425) else if c < 1582 then (dB16 H).idx (c - 1514) else if c < 1672 then (dB17 H).idx (c - 1582) else if c < 1736 then (dB19 H).idx (c - 1672) else if c < 1780 then (dB20 H).idx (c - 1736) else if c < 1827 then (dB21 H).idx (c - 1780) else if c < 1961 then (dB22 H).idx (c - 1827) else if c < 1963 then (dB24 H).idx (c - 1961) else (dB25 H).idx (c - 1963)

noncomputable def R2 (H : Holes) : Set (NodeW 2 3) := {n | ∃ c, c < 1965 ∧ n = topIdx H c}


/-
# AggFive.Leaf0_4 : block of the representatives 32..32 of depth-1 node #0 (generated by l5_agg; 0 hole(s))

For every built representative: the row link `lk<c>` (kernel `decide`) and the single block from its `t3_nodeU_of`; every other one is a field of `Holes`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.AggFive.X0
import LRSpectrumFull.L5S4.GD3O32

set_option maxRecDepth 100000

namespace LRSpectrumFull
namespace AggFive
namespace Leaf0_4
open Matrix Finset LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lk32 : N32.nK.rows = X0.E 32 := by decide +kernel
noncomputable def r32 : X0.RB := RBlock.single 32 N32.nK N32.tabO (fun C h => N32.t3_nodeU_of C h) lk32
noncomputable def block : X0.RB := r32

#print axioms block

end Leaf0_4
end AggFive
end LRSpectrumFull

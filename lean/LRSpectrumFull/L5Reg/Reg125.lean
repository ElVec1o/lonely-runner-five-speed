/-
# L5Reg.Reg125 : the lines clause for every class of the local table of rep #125 (generated by l5reg)

Every local class `i < nT` of rep #125 (8 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O125T
import LRSpectrumFull.L5S4.LinRQSC114

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R125
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(114, LinRQSC114.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(114, 190, [2, 0, -1, 0, -3, 2, 1, -2, 1]), (114, 191, [1, 0, 0, 0, -1, -3, 0, -1, -2]), (114, 192, [2, 0, -1, 0, 1, 0, 1, 1, -1]), (114, 193, [2, 0, -1, 0, 3, -2, 1, 1, -1]), (114, 194, [2, 0, -1, 0, 3, -2, 1, 1, -1]), (114, 195, [2, 0, -1, 0, 3, -2, 1, 4, -3]), (114, 196, [2, 0, -1, 0, -1, 1, 1, 0, 0]), (114, 197, [2, 0, -1, 0, 3, -2, 1, 4, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N125.TT) N125.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N125.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #125. -/
theorem lines (t5 : List T5Rec) (h114 : ∀ p ∈ LinRQSC114.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N125.nT).map (t4At (LRSpectrumFull.L5S4.dg N125.TT) N125.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h114 p hp
)

#print axioms lines

end R125
end L5Reg
end LRSpectrumFull

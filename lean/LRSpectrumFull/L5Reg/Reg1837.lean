/-- the lines clause for every class of the local table of rep #1837. -/
theorem lines (t5 : List T5Rec) (h883 : ∀ p ∈ LinRQSC883.blobs, LinesCl t5 (t4OfRec p.1)) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1)) (h885 : ∀ p ∈ LinRQSC885.blobs, LinesCl t5 (t4OfRec p.1)) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1)) (h1047 : ∀ p ∈ LinRQSC1047.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1837.nT).map (t4At (LRSpectrumFull.L5S4.dg N1837.TT) N1837.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h883 p hp
  · exact h884 p hp
  · exact h885 p hp
  · exact h886 p hp
  · exact h1047 p hp
  · exact h1048 p hp
)

#print axioms lines


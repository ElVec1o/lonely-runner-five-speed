theorem lines (t5 : List T5Rec) (h748 : ∀ p ∈ LinRQSC748.blobs, LinesCl t5 (t4OfRec p.1)) (h749 : ∀ p ∈ LinRQSC749.blobs, LinesCl t5 (t4OfRec p.1))

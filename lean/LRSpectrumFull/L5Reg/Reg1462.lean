/-
# L5Reg.Reg1462 : the lines clause for every class of the local table of rep #1462 (generated by l5reg)

Every local class `i < nT` of rep #1462 (32 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1462T
import LRSpectrumFull.L5S4.LinRQSC199
import LRSpectrumFull.L5S4.LinRQSC1025

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1462
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs), (1025, LinRQSC1025.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1025, 302, [2, 0, -1, 0, 1, 0, -3, 0, 2]), (1025, 291, [1, 0, -1, -1, -1, 0, -1, 1, 1]), (1025, 303, [2, -1, 0, 0, 0, 1, 3, -1, 0]), (1025, 186, [1, 1, -1, 3, 0, -1, -1, 1, 0]), (1025, 205, [1, -2, 1, 2, 1, -1, 1, 0, 0]), (1025, 304, [1, 0, 0, 1, 1, -1, 2, -2, 1]), (1025, 305, [1, -2, 1, 3, 0, -2, -2, -1, 2]), (1025, 306, [2, -1, 0, 0, 0, 1, 1, -1, 1]), (1025, 307, [2, -1, -1, 0, -3, 2, 3, 1, -3]), (1025, 308, [1, 0, 0, 1, -1, 1, 3, 0, -1]), (1025, 197, [1, -1, 0, 3, -1, -1, -1, 2, -1]), (1025, 309, [1, 0, -1, 3, -1, -2, -2, 2, 1]), (1025, 310, [1, 0, -1, 3, -1, -1, 0, 1, -1]), (1025, 311, [1, 0, 0, 3, -2, 1, -2, 1, 0]), (1025, 312, [1, -1, -1, 3, -1, 0, -1, 0, -1]), (1025, 313, [1, 0, 0, 3, 1, -1, -2, 1, 0]), (1025, 314, [1, 0, 0, 0, 2, -1, -3, -1, 1]), (1025, 315, [1, 0, 0, 3, -2, 1, -2, 1, 0]), (1025, 168, [2, -2, 1, -3, -1, 2, -1, -2, 2]), (1025, 316, [0, 2, -1, 1, 0, 0, 2, 1, -1]), (1025, 317, [0, 1, -1, 1, 3, -3, 2, -2, 1]), (1025, 318, [1, -1, 0, 3, -2, 0, -2, 0, 1]), (1025, 319, [1, -1, 0, 3, -2, 0, -2, 0, 1]), (1025, 203, [1, 2, -1, 2, -1, -1, 0, 1, 0]), (1025, 320, [1, 0, 0, 0, 1, 0, -3, 1, -1]), (1025, 137, [2, -1, -1, 3, 1, -3, -1, 0, 1]), (1025, 321, [0, 1, 0, 1, 3, -1, 2, -2, -1]), (1025, 322, [0, 1, -1, 3, 0, -1, -1, -3, 3]), (1025, 323, [0, 2, -1, 1, 0, 0, 3, 1, -1]), (1025, 324, [1, -2, 1, 3, 0, -2, -2, -1, 2]), (199, 36, [0, 0, -1, 3, -2, -1, 1, -1, 0]), (1025, 325, [0, -2, 1, 1, 0, -1, 3, -1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1462.TT) N1462.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1462.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1462. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1025 : ∀ p ∈ LinRQSC1025.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1462.nT).map (t4At (LRSpectrumFull.L5S4.dg N1462.TT) N1462.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h199 p hp
  · exact h1025 p hp
)

#print axioms lines

end R1462
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h420 : ∀ p ∈ LinRQSC420.blobs, LinesCl t5 (t4OfRec p.1)) (h421 : ∀ p ∈ LinRQSC421.blobs, LinesCl t5 (t4OfRec p.1)) (h422 : ∀ p ∈ LinRQSC422.blobs, LinesCl t5 (t4OfRec p.1)) (h423 : ∀ p ∈ LinRQSC423.blobs, LinesCl t5 (t4OfRec p.1)) (h424 : ∀ p ∈ LinRQSC424.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N268.TT) N268.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h420 p hpe
    · exact h421 p hpe
    · exact h422 p hpe
    · exact h423 p hpe
    · exact h424 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


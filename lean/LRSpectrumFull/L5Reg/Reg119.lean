/-
# L5Reg.Reg119 : the lines clause for every class of the local table of rep #119 (generated by l5reg)

Every local class `i < nT` of rep #119 (29 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O119T
import LRSpectrumFull.L5S4.LinRQSC58
import LRSpectrumFull.L5S4.LinRQSC112
import LRSpectrumFull.L5S4.LinRQSC113

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R119
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(58, LinRQSC58.blobs), (112, LinRQSC112.blobs), (113, LinRQSC113.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(113, 67, [2, -1, 0, 0, -2, 1, -1, 2, -1]), (113, 68, [1, 0, 0, 0, 1, -1, -1, -2, 1]), (113, 69, [1, 0, 0, 0, -4, 1, 0, -3, 1]), (113, 70, [1, 0, 0, 0, -4, 3, -1, 3, -2]), (113, 71, [2, 0, -1, 0, -1, 0, 1, 3, -1]), (113, 72, [2, 0, -1, 0, 1, -1, -1, 4, -3]), (58, 88, [2, 0, -1, -1, 0, 0, 0, -1, 1]), (113, 73, [1, 0, 0, 0, -1, 0, 1, 2, -1]), (113, 74, [2, -1, 0, 0, -2, 1, 1, 0, 0]), (113, 75, [1, 0, 0, 0, 1, 0, 1, 0, -1]), (113, 76, [1, 0, 0, 0, 1, 0, -1, 2, -1]), (113, 30, [2, 0, -1, -1, -4, 4, 1, 3, -3]), (113, 77, [1, 0, 0, 0, -1, 1, 0, 1, 0]), (113, 78, [2, 0, -1, 0, 1, -1, -1, -2, 2]), (113, 79, [1, 0, 0, 0, 1, -1, 0, -2, 1]), (58, 65, [2, 0, -1, -1, 0, 0, 0, 1, 2]), (113, 80, [1, 1, -1, 0, 2, -1, 1, -4, 1]), (113, 81, [2, 0, -1, 0, -1, -1, 1, 0, -1]), (113, 82, [0, 1, -1, -1, 0, 0, 0, -1, 0]), (58, 90, [0, 0, -1, 0, -1, 1, 1, 0, 0]), (113, 83, [2, 0, -1, 0, -1, -1, 1, 0, 0]), (113, 84, [2, 0, -1, 0, 1, -1, 1, 2, -2]), (113, 85, [0, -2, 1, -1, 0, 1, 1, 1, -1]), (113, 86, [0, 2, -1, -1, 0, 0, 0, -1, 0]), (113, 87, [0, 0, 1, -1, 0, 0, 1, -1, 0]), (112, 216, [2, 0, -1, -1, -2, 0, 0, -1, 0]), (113, 88, [1, 0, 0, 0, 1, 0, 0, 2, 1]), (113, 89, [0, 0, 1, -1, 0, 0, 0, -1, 0]), (113, 90, [0, 0, 1, -1, 1, 0, 0, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N119.TT) N119.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N119.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #119. -/
theorem lines (t5 : List T5Rec) (h58 : ∀ p ∈ LinRQSC58.blobs, LinesCl t5 (t4OfRec p.1)) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1)) (h113 : ∀ p ∈ LinRQSC113.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N119.nT).map (t4At (LRSpectrumFull.L5S4.dg N119.TT) N119.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h58 p hp
  · exact h112 p hp
  · exact h113 p hp
)

#print axioms lines

end R119
end L5Reg
end LRSpectrumFull

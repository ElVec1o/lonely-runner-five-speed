theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N261.TT) N261.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N261.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #261. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h200 : ∀ p ∈ LinRQSC200.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N261.nT).map (t4At (LRSpectrumFull.L5S4.dg N261.TT) N261.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h199 p hp
  · exact h200 p hp
)

#print axioms lines


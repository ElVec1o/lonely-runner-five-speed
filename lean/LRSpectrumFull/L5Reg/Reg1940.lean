/-
# L5Reg.Reg1940 : the lines clause for every class of the local table of rep #1940 (generated by l5reg)

Every local class `i < nT` of rep #1940 (30 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1940T
import LRSpectrumFull.L5S4.LinRQSC884
import LRSpectrumFull.L5S4.LinRQSC888
import LRSpectrumFull.L5S4.LinRQSC1048
import LRSpectrumFull.L5S4.LinRQSC1049
import LRSpectrumFull.L5S4.LinRQSC1050
import LRSpectrumFull.L5S4.LinRQSC1051
import LRSpectrumFull.L5S4.LinRQSC1052

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1940
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(884, LinRQSC884.blobs), (888, LinRQSC888.blobs), (1048, LinRQSC1048.blobs), (1049, LinRQSC1049.blobs), (1050, LinRQSC1050.blobs), (1051, LinRQSC1051.blobs), (1052, LinRQSC1052.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1052, 47, [2, -1, 0, -2, 1, 1, -3, 1, 1]), (1052, 48, [2, -1, 0, -2, -1, 1, 3, 1, -1]), (1052, 49, [1, -1, 0, 0, -2, 1, 3, 2, -2]), (1052, 50, [2, -1, 1, -2, 1, 0, -3, 1, 0]), (1052, 51, [1, -1, 1, -1, 1, 0, -1, 0, 0]), (1052, 52, [2, -1, -1, -2, -1, 2, 3, 0, -2]), (1052, 53, [1, 2, -1, 2, -2, -1, 3, 1, -2]), (884, 136, [3, -1, -1, -1, 1, 0, 0, -1, 0]), (1048, 189, [1, 0, 1, 3, -1, 1, 2, -2, -1]), (1052, 54, [2, -1, 1, -2, 2, 1, -3, 2, 0]), (1049, 33, [2, -1, -1, -3, 1, 2, -2, -2, 3]), (1052, 55, [2, -1, 0, -2, 1, -1, -3, 2, -1]), (1052, 56, [1, 0, 1, -1, 0, 0, -1, 1, 1]), (1052, 57, [2, -1, 0, -2, 0, 1, 3, 1, -2]), (1052, 58, [1, -1, 0, 2, -1, -1, 3, -1, -1]), (888, 66, [3, 1, -3, -1, 2, 0, 0, 2, -1]), (1052, 59, [1, -1, 0, -1, -2, 1, -1, -1, 1]), (1052, 60, [1, 1, 0, -1, 0, 0, -1, 1, 1]), (1048, 117, [1, 1, -1, -1, -2, 1, -2, 2, 1]), (1052, 61, [1, 0, -1, 0, 1, -1, 3, -2, 0]), (1051, 167, [1, -1, 0, -1, 0, 0, 2, -1, -1]), (1050, 62, [1, 2, -2, 3, 1, -2, 2, -2, 1]), (884, 154, [3, 1, -1, -1, 2, -1, 0, -2, 1]), (1050, 222, [1, -1, 0, -2, -2, 3, 0, -1, 1]), (1050, 193, [2, 2, -3, -1, 1, 0, 0, 1, -1]), (1051, 143, [1, 1, -1, -1, 1, 0, -1, -2, 2]), (1052, 62, [1, -1, 0, -1, 0, 0, -1, -2, 1]), (1052, 63, [1, 0, -1, 2, -2, -1, 2, -1, -1]), (888, 128, [3, 1, -2, -1, 2, 0, 1, 2, -1]), (1050, 186, [2, 1, -1, -1, 1, 0, -1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1940.TT) N1940.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1940.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1940. -/
theorem lines (t5 : List T5Rec) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1)) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1)) (h1050 : ∀ p ∈ LinRQSC1050.blobs, LinesCl t5 (t4OfRec p.1)) (h1051 : ∀ p ∈ LinRQSC1051.blobs, LinesCl t5 (t4OfRec p.1)) (h1052 : ∀ p ∈ LinRQSC1052.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1940.nT).map (t4At (LRSpectrumFull.L5S4.dg N1940.TT) N1940.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h884 p hp
  · exact h888 p hp
  · exact h1048 p hp
  · exact h1049 p hp
  · exact h1050 p hp
  · exact h1051 p hp
  · exact h1052 p hp
)

#print axioms lines

end R1940
end L5Reg
end LRSpectrumFull

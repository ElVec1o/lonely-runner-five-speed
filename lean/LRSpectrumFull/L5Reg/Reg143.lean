/-- the lines clause for every class of the local table of rep #143. -/
theorem lines (t5 : List T5Rec) (h133 : ∀ p ∈ LinRQSC133.blobs, LinesCl t5 (t4OfRec p.1)) (h134 : ∀ p ∈ LinRQSC134.blobs, LinesCl t5 (t4OfRec p.1)) (h135 : ∀ p ∈ LinRQSC135.blobs, LinesCl t5 (t4OfRec p.1)) (h136 : ∀ p ∈ LinRQSC136.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N143.nT).map (t4At (LRSpectrumFull.L5S4.dg N143.TT) N143.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N143.nT := List.mem_range.1 hc
  have hn : N143.nT = 321 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 321) := by omega
  rcases hcase with h | h | h | h
  · exact P143_0.lines t5 h133 h134 c h.1 (by omega)
  · exact P143_1.lines t5 h134 h135 c h.1 (by omega)
  · exact P143_2.lines t5 h135 h136 c h.1 (by omega)
  · exact P143_3.lines t5 h136 c h.1 (by omega)

#print axioms lines

end R143

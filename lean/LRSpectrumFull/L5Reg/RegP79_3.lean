/-- the lines clause for local classes 300..398 of rep #79. -/
theorem lines (t5 : List T5Rec) (h75 : ∀ p ∈ LinRQSC75.blobs, LinesCl t5 (t4OfRec p.1)) (h76 : ∀ p ∈ LinRQSC76.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg318 : the lines clause for every class of the local table of rep #318 (generated by l5reg)

Every local class `i < nT` of rep #318 (35 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O318T
import LRSpectrumFull.L5S4.LinRQSC680
import LRSpectrumFull.L5S4.LinRQSC681

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R318
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(680, LinRQSC680.blobs), (681, LinRQSC681.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(680, 50, [0, 1, 0, 2, -3, -1, -3, -3, 2]), (680, 51, [0, 1, 0, 2, -3, -1, -5, 0, 3]), (680, 52, [0, 1, 0, 2, -3, -1, -5, -1, 3]), (680, 53, [0, 1, 0, 1, -3, 0, -2, -2, 1]), (680, 54, [0, 1, 0, 2, -3, -1, -3, -3, 2]), (680, 55, [1, 0, -1, -3, -1, 3, 0, 2, -1]), (680, 56, [0, 1, 0, 0, 3, -1, -1, 1, 0]), (680, 57, [0, 0, 1, 0, 1, 3, -1, 0, -2]), (680, 58, [1, 0, -1, -3, 2, 2, -3, -3, 4]), (680, 59, [1, 0, -1, -3, 1, 2, -1, -2, 2]), (680, 60, [1, -1, 0, -3, -3, 1, -2, 1, 0]), (680, 61, [1, -1, 0, -3, -3, 5, -1, 2, -1]), (680, 62, [1, 0, 0, 3, -2, 1, -3, 1, 0]), (681, 0, [1, -1, 0, -3, -3, 5, -2, 1, 1]), (681, 1, [1, -1, 0, -3, 1, 1, -3, 2, 1]), (681, 2, [1, -1, 0, -3, 0, 1, -1, -3, 1]), (681, 3, [1, 0, 0, -3, 2, -1, -3, 1, 0]), (681, 4, [1, 0, 0, -3, 2, -1, -3, 1, 0]), (681, 5, [1, 0, 0, 3, -2, 1, -3, 1, 0]), (681, 6, [1, -1, 0, -3, 0, 1, -4, -3, 2]), (681, 7, [1, -1, 0, -3, 0, 1, -4, -3, 2]), (681, 8, [1, -1, 0, -3, 2, 1, -2, 0, 1]), (681, 9, [1, -1, 0, -3, 0, 1, -3, -4, 2]), (681, 10, [1, -1, 0, -3, 0, 2, -1, -4, 3]), (681, 11, [1, -1, 0, -3, 2, 1, -2, 0, 1]), (681, 12, [1, -1, 0, 0, 3, -2, 4, 3, -5]), (681, 13, [1, -1, 0, 0, 3, -1, 4, 1, -2]), (681, 14, [1, 0, 0, 0, 2, -1, 4, -1, 0]), (681, 15, [1, -1, 0, -3, 0, 2, -4, -4, 5]), (681, 16, [1, -1, 0, -3, 0, 1, -3, -4, 2]), (681, 17, [1, -1, 0, -3, 0, 2, -1, -4, 3]), (681, 18, [1, -1, 0, 0, 3, -2, 4, 3, -5]), (681, 19, [1, -1, 0, 0, 3, -1, 4, 1, -2]), (681, 20, [1, 0, 0, 0, 1, 0, 4, 0, -1]), (681, 21, [1, -1, 0, 0, 3, -2, 4, 3, -5])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N318.TT) N318.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N318.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #318. -/
theorem lines (t5 : List T5Rec) (h680 : ∀ p ∈ LinRQSC680.blobs, LinesCl t5 (t4OfRec p.1)) (h681 : ∀ p ∈ LinRQSC681.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N318.nT).map (t4At (LRSpectrumFull.L5S4.dg N318.TT) N318.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h680 p hp
  · exact h681 p hp
)

#print axioms lines

end R318
end L5Reg
end LRSpectrumFull

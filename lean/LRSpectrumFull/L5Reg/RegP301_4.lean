theorem lines (t5 : List T5Rec) (h540 : ∀ p ∈ LinRQSC540.blobs, LinesCl t5 (t4OfRec p.1)) (h541 : ∀ p ∈ LinRQSC541.blobs, LinesCl t5 (t4OfRec p.1)) (h542 : ∀ p ∈ LinRQSC542.blobs, LinesCl t5 (t4OfRec p.1)) (h543 : ∀ p ∈ LinRQSC543.blobs, LinesCl t5 (t4OfRec p.1)) (h544 : ∀ p ∈ LinRQSC544.blobs, LinesCl t5 (t4OfRec p.1))

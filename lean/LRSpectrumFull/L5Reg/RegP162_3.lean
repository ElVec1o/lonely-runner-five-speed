theorem lines (t5 : List T5Rec) (h157 : ∀ p ∈ LinRQSC157.blobs, LinesCl t5 (t4OfRec p.1)) (h159 : ∀ p ∈ LinRQSC159.blobs, LinesCl t5 (t4OfRec p.1)) (h173 : ∀ p ∈ LinRQSC173.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg1620 : the lines clause for every class of the local table of rep #1620 (generated by l5reg)

Every local class `i < nT` of rep #1620 (33 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1620T
import LRSpectrumFull.L5S4.LinRQSC199
import LRSpectrumFull.L5S4.LinRQSC1026

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1620
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs), (1026, LinRQSC1026.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1026, 294, [2, -1, 0, 1, -1, 1, -2, 1, -1]), (1026, 295, [2, 2, -1, 1, -1, 0, -1, 2, 0]), (199, 209, [3, 0, -2, -1, -1, 2, 0, -1, 1]), (1026, 296, [2, -2, 1, 1, 3, -2, -2, -1, 1]), (1026, 297, [2, -2, 1, -3, 1, -1, -1, 0, 0]), (1026, 298, [1, 2, -1, 1, 1, -1, 2, -2, -1]), (1026, 299, [2, 2, -3, -3, 1, 1, 0, 1, -1]), (1026, 199, [2, -1, -1, 2, 2, -3, -1, -3, 3]), (1026, 300, [2, 2, -1, -1, -3, 1, -3, 2, 0]), (1026, 301, [2, -1, 0, 1, 0, -1, 0, 0, 1]), (199, 232, [3, 0, -1, 0, 1, 0, 1, -1, 0]), (1026, 302, [2, 1, -1, 1, 1, -1, -2, 2, -1]), (1026, 197, [2, -1, 0, -2, 2, -1, -3, -1, 2]), (1026, 303, [0, -1, 0, 1, 1, -1, 3, -1, -2]), (1026, 304, [2, 0, -1, -3, 2, 1, -1, 1, 0]), (1026, 305, [2, 2, -3, -3, -1, 3, 0, -3, 2]), (1026, 306, [2, -2, -1, -3, 1, 2, 2, 3, -2]), (199, 246, [3, 2, -2, 1, -3, 2, 2, -2, 1]), (1026, 307, [2, -2, 1, -1, -1, 1, -2, -1, 1]), (1026, 308, [2, 2, -3, -3, -1, 3, 1, -2, 1]), (1026, 309, [2, -1, 0, -3, 1, 0, 1, -2, 1]), (1026, 310, [2, -1, -1, -3, 1, 2, 3, -2, -2]), (1026, 311, [2, 0, -1, -3, -1, 2, 1, -2, 0]), (1026, 255, [2, -2, -1, 2, -1, -1, -3, 2, 1]), (1026, 312, [0, 2, -1, 1, -3, 1, 3, 0, -1]), (1026, 313, [2, 1, -1, -3, 1, 0, 0, 2, -1]), (1026, 314, [2, -1, 0, -3, 2, 0, 2, 0, -1]), (1026, 315, [2, 0, -1, -3, 1, 1, 1, 2, -2]), (1026, 316, [2, 1, -1, -3, 1, 1, 0, 1, 0]), (1026, 317, [2, -1, 0, -3, 2, 0, 0, 1, -1]), (1026, 318, [2, -2, -1, -3, -1, 1, 0, 1, 0]), (1026, 319, [2, -1, -1, -3, -1, 1, 0, -1, 0]), (1026, 267, [2, 0, -1, -3, -1, 2, 2, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1620.TT) N1620.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1620.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1620. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1620.nT).map (t4At (LRSpectrumFull.L5S4.dg N1620.TT) N1620.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h199 p hp
  · exact h1026 p hp
)

#print axioms lines

end R1620
end L5Reg
end LRSpectrumFull

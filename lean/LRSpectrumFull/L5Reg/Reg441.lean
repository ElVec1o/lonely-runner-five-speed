/-
# L5Reg.Reg441 : the lines clause for every class of the local table of rep #441 (generated by l5reg)

Every local class `i < nT` of rep #441 (19 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O441T
import LRSpectrumFull.L5S4.LinRQSC726

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R441
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(726, LinRQSC726.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(726, 23, [0, 1, 0, -1, 0, 0, 0, -4, 1]), (726, 24, [1, 0, 0, 0, 1, -5, -4, 0, -1]), (726, 25, [1, 0, 0, 0, -5, -1, -4, 1, 0]), (726, 26, [1, 0, -1, 0, -1, 0, -4, 0, 3]), (726, 27, [0, 1, 0, -1, 0, 0, 0, -4, 1]), (726, 28, [0, 1, 0, -1, 0, 0, 0, -4, 1]), (726, 29, [1, 0, -1, 0, 5, -2, -4, 2, 3]), (726, 30, [1, 0, -1, 0, 1, -1, -4, 0, 3]), (726, 31, [1, 0, 0, 0, 5, 1, -4, 1, 0]), (726, 32, [0, -1, 0, -5, 0, 3, 3, 3, -2]), (726, 33, [0, 1, -1, -1, 0, 0, 0, -3, 2]), (726, 34, [0, -1, 0, -5, 0, 4, 1, 4, -1]), (726, 35, [1, 0, 0, 0, 5, -2, -4, -3, 1]), (726, 36, [0, -1, 0, -5, 0, 1, -1, 4, 0]), (726, 37, [0, -1, 0, -5, -1, 4, -1, -4, 1]), (726, 38, [0, -1, 0, -1, -1, 1, 0, -3, 1]), (726, 39, [0, -1, 0, -5, -1, 1, 1, -4, 0]), (726, 40, [1, 0, -1, 1, 1, -1, 4, 0, -3]), (726, 41, [0, 1, 0, -1, 1, 0, 0, 4, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N441.TT) N441.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N441.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #441. -/
theorem lines (t5 : List T5Rec) (h726 : ∀ p ∈ LinRQSC726.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N441.nT).map (t4At (LRSpectrumFull.L5S4.dg N441.TT) N441.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h726 p hp
)

#print axioms lines

end R441
end L5Reg
end LRSpectrumFull

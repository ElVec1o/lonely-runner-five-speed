/-- the lines clause for every class of the local table of rep #169. -/
theorem lines (t5 : List T5Rec) (h118 : ∀ p ∈ LinRQSC118.blobs, LinesCl t5 (t4OfRec p.1)) (h119 : ∀ p ∈ LinRQSC119.blobs, LinesCl t5 (t4OfRec p.1)) (h163 : ∀ p ∈ LinRQSC163.blobs, LinesCl t5 (t4OfRec p.1)) (h185 : ∀ p ∈ LinRQSC185.blobs, LinesCl t5 (t4OfRec p.1)) (h186 : ∀ p ∈ LinRQSC186.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N169.nT).map (t4At (LRSpectrumFull.L5S4.dg N169.TT) N169.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h118 p hp
  · exact h119 p hp
  · exact h163 p hp
  · exact h185 p hp
  · exact h186 p hp
)


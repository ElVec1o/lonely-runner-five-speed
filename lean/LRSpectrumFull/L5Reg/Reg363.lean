/-
# L5Reg.Reg363 : the lines clause for every class of the local table of rep #363 (generated by l5reg)

Every local class `i < nT` of rep #363 (44 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O363T
import LRSpectrumFull.L5S4.LinRQSC430
import LRSpectrumFull.L5S4.LinRQSC679
import LRSpectrumFull.L5S4.LinRQSC680
import LRSpectrumFull.L5S4.LinRQSC720
import LRSpectrumFull.L5S4.LinRQSC721

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R363
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(430, LinRQSC430.blobs), (679, LinRQSC679.blobs), (680, LinRQSC680.blobs), (720, LinRQSC720.blobs), (721, LinRQSC721.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(720, 64, [1, -1, 0, -1, 2, -1, -4, -3, 6]), (720, 65, [1, -1, 0, -1, 2, -1, -4, -3, 6]), (720, 66, [1, -1, 0, -1, 2, -1, -4, -2, 5]), (720, 67, [1, -1, 0, -1, -2, 1, 4, 3, -2]), (721, 0, [1, -1, 0, -1, 0, 1, 4, -2, -1]), (721, 1, [1, -1, 0, -1, -2, 1, 4, 3, -2]), (721, 2, [1, -1, 0, -1, 2, -1, -4, -4, 7]), (721, 3, [1, -1, 0, -1, 2, -1, -4, -3, 6]), (430, 18, [1, -1, 0, -4, -3, 6, 1, -2, 1]), (680, 26, [1, -1, 0, 4, 2, -5, -1, 2, -1]), (430, 12, [1, -1, 0, -4, -3, 2, -1, -2, 1]), (721, 4, [1, -1, 0, -1, -2, 2, 3, 2, -3]), (721, 5, [1, -1, 0, -1, -2, 1, 4, 3, -2]), (721, 6, [1, -1, 0, -1, -2, 2, 4, 4, -5]), (721, 7, [1, -1, 0, -2, 1, 0, 4, 3, -1]), (721, 8, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (721, 9, [1, 0, -1, 2, 4, -3, -3, 3, 2]), (721, 10, [1, 0, -1, -2, -4, 5, 4, -1, -3]), (721, 11, [1, 0, -1, 2, 4, -5, -4, 1, 3]), (721, 12, [1, 0, -1, -2, 4, -1, 3, 3, -5]), (721, 13, [1, 0, -1, -2, 4, 1, 4, 1, -4]), (721, 14, [1, 0, -1, -2, 1, 1, 3, 1, -3]), (721, 15, [1, 0, -1, 2, -4, -1, -4, -1, 4]), (679, 52, [1, 0, -1, 4, -1, -3, 2, 2, -3]), (721, 16, [1, 0, -1, -2, 4, -1, 3, 3, -5]), (721, 17, [1, 0, -1, -2, 4, 1, 4, 1, -4]), (721, 18, [0, 1, 0, 4, 2, -1, 1, -4, 0]), (721, 19, [0, 1, 0, 1, -2, 0, 1, 3, -1]), (721, 20, [0, 1, 0, 4, -2, -1, 3, 3, -1]), (721, 21, [0, 1, 0, 4, 2, -1, 1, -4, 0]), (721, 22, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (721, 23, [0, -1, 0, 4, -2, -3, 5, 3, -4]), (721, 24, [1, 0, -1, 2, -1, -1, -3, -1, 3]), (721, 25, [0, 1, 0, 1, 2, -1, -1, 3, 0]), (721, 26, [0, 1, 0, 1, -2, 0, -1, -2, 1]), (721, 27, [1, 0, -1, -2, 1, 1, -2, -1, 2]), (721, 28, [1, 0, 0, -2, 2, -1, -4, 3, -1]), (721, 29, [1, 0, -1, 2, 1, -2, 2, -1, -1]), (721, 30, [1, -1, 0, -2, 1, 0, -4, -3, 1]), (721, 31, [1, 0, -1, 2, 0, -1, 4, 1, -2]), (721, 32, [1, -1, 0, -1, -2, 1, -4, -3, 2]), (721, 33, [1, -1, 0, -1, 2, -1, 4, 3, -6]), (721, 34, [1, 0, 0, -1, -1, 1, -4, 0, 1]), (679, 53, [1, 0, 0, 4, -2, 1, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N363.TT) N363.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N363.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #363. -/
theorem lines (t5 : List T5Rec) (h430 : ∀ p ∈ LinRQSC430.blobs, LinesCl t5 (t4OfRec p.1)) (h679 : ∀ p ∈ LinRQSC679.blobs, LinesCl t5 (t4OfRec p.1)) (h680 : ∀ p ∈ LinRQSC680.blobs, LinesCl t5 (t4OfRec p.1)) (h720 : ∀ p ∈ LinRQSC720.blobs, LinesCl t5 (t4OfRec p.1)) (h721 : ∀ p ∈ LinRQSC721.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N363.nT).map (t4At (LRSpectrumFull.L5S4.dg N363.TT) N363.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h430 p hp
  · exact h679 p hp
  · exact h680 p hp
  · exact h720 p hp
  · exact h721 p hp
)

#print axioms lines

end R363
end L5Reg
end LRSpectrumFull

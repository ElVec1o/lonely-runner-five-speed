/-- the lines clause for local classes 0..99 of rep #521. -/
theorem lines (t5 : List T5Rec) (h772 : ∀ p ∈ LinRQSC772.blobs, LinesCl t5 (t4OfRec p.1)) (h773 : ∀ p ∈ LinRQSC773.blobs, LinesCl t5 (t4OfRec p.1))

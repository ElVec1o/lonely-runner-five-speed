/-
# L5Reg.RegP494_3 : part 3 of the lines clause of rep #494: local classes 300..305 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O494T
import LRSpectrumFull.L5S4.LinRQSC755

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P494_3
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(755, LinRQSC755.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(755, 62, [0, 0, 1, -3, 1, 0, 1, 0, 0]), (755, 63, [0, 1, 0, -3, 1, 2, 1, 2, -1]), (755, 64, [0, 0, -1, -3, 2, -1, 2, -1, -2]), (755, 65, [0, -1, 0, -1, 0, 1, 1, 1, 0]), (755, 66, [0, 1, 0, -3, 0, 1, 1, -1, 0]), (755, 67, [0, 1, 0, -1, 0, 1, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N494.TT) N494.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 6 := by decide +kernel

/-- the lines clause for local classes 300..305 of rep #494. -/
theorem lines (t5 : List T5Rec) (h755 : ∀ p ∈ LinRQSC755.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 6 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N494.TT) N494.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h755 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P494_3
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h764 : ∀ p ∈ LinRQSC764.blobs, LinesCl t5 (t4OfRec p.1)) (h765 : ∀ p ∈ LinRQSC765.blobs, LinesCl t5 (t4OfRec p.1))

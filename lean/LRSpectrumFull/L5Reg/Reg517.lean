/-- the lines clause for every class of the local table of rep #517. -/
theorem lines (t5 : List T5Rec) (h450 : ∀ p ∈ LinRQSC450.blobs, LinesCl t5 (t4OfRec p.1)) (h452 : ∀ p ∈ LinRQSC452.blobs, LinesCl t5 (t4OfRec p.1)) (h729 : ∀ p ∈ LinRQSC729.blobs, LinesCl t5 (t4OfRec p.1)) (h730 : ∀ p ∈ LinRQSC730.blobs, LinesCl t5 (t4OfRec p.1)) (h758 : ∀ p ∈ LinRQSC758.blobs, LinesCl t5 (t4OfRec p.1)) (h759 : ∀ p ∈ LinRQSC759.blobs, LinesCl t5 (t4OfRec p.1)) (h760 : ∀ p ∈ LinRQSC760.blobs, LinesCl t5 (t4OfRec p.1)) (h761 : ∀ p ∈ LinRQSC761.blobs, LinesCl t5 (t4OfRec p.1)) (h762 : ∀ p ∈ LinRQSC762.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N517.nT).map (t4At (LRSpectrumFull.L5S4.dg N517.TT) N517.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N517.nT := List.mem_range.1 hc
  have hn : N517.nT = 333 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 333) := by omega
  rcases hcase with h | h | h | h
  · exact P517_0.lines t5 h730 h758 h759 c h.1 (by omega)
  · exact P517_1.lines t5 h450 h452 h729 h730 h759 h760 c h.1 (by omega)
  · exact P517_2.lines t5 h450 h452 h730 h760 h761 c h.1 (by omega)
  · exact P517_3.lines t5 h761 h762 c h.1 (by omega)

#print axioms lines


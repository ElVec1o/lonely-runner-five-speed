/-
# L5Reg.RegFin68 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg1699
import LRSpectrumFull.L5Reg.Reg66

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines1699 : ∀ cl ∈ (List.range N1699.nT).map (t4At (LRSpectrumFull.L5S4.dg N1699.TT) N1699.ST), LinesCl T5Store.t5 cl :=
  R1699.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem1030 p hp)) (fun p hp => FinalGlue.glines p (mem1031 p hp)) (fun p hp => FinalGlue.glines p (mem1032 p hp)) (fun p hp => FinalGlue.glines p (mem1033 p hp)) (fun p hp => FinalGlue.glines p (mem1034 p hp))

theorem lines66 : ∀ cl ∈ (List.range N66.nT).map (t4At (LRSpectrumFull.L5S4.dg N66.TT) N66.ST), LinesCl T5Store.t5 cl :=
  R66.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem42 p hp)) (fun p hp => FinalGlue.glines p (mem43 p hp))

#print axioms lines1699

end L5Reg
end LRSpectrumFull

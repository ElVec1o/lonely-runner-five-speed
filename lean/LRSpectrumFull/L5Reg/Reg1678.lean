/-
# L5Reg.Reg1678 : the lines clause for every class of the local table of rep #1678 (generated by l5reg)

Every local class `i < nT` of rep #1678 (19 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1678T
import LRSpectrumFull.L5S4.LinRQSC1028

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1678
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1028, LinRQSC1028.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1028, 84, [1, 1, -1, 4, 0, -1, -1, 4, -3]), (1028, 85, [1, 1, -1, 4, -1, -1, 1, -2, 1]), (1028, 86, [1, -1, 0, 4, 1, -4, -1, 0, 1]), (1028, 87, [1, 1, -1, 4, -1, -3, 1, -3, 0]), (1028, 88, [1, -1, 0, 4, 1, -4, -1, 2, -1]), (1028, 89, [1, -1, 0, 4, 1, -3, 1, 2, -2]), (1028, 90, [1, -1, 0, -1, -4, 1, 3, -2, 0]), (1028, 91, [1, 1, -1, 4, -1, -3, -2, -3, 2]), (1028, 92, [1, 0, -1, -1, 1, 0, -4, 1, 2]), (1028, 93, [1, 1, -1, -1, 4, -3, -3, -2, 2]), (1028, 94, [1, -1, -1, 4, -3, 1, 2, -2, -1]), (1028, 95, [1, 0, -1, 4, -1, 1, 2, 0, -1]), (1028, 96, [1, -1, 0, 4, 1, -2, 1, 1, -1]), (1028, 97, [1, 1, 0, 4, -1, -1, 2, 1, 0]), (1028, 98, [1, -1, 0, 4, 1, -2, -2, 0, 1]), (1028, 99, [1, 0, -1, 4, -1, -2, 1, -1, 0]), (1028, 100, [1, 1, -1, 4, -1, 0, -1, 3, -2]), (1028, 101, [1, -1, 1, 4, -3, 1, 1, -1, 2]), (1028, 102, [1, -1, 0, 4, 1, -2, -1, 3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1678.TT) N1678.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1678.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1678. -/
theorem lines (t5 : List T5Rec) (h1028 : ∀ p ∈ LinRQSC1028.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1678.nT).map (t4At (LRSpectrumFull.L5S4.dg N1678.TT) N1678.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1028 p hp
)

#print axioms lines

end R1678
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg364 : the lines clause for every class of the local table of rep #364 (generated by l5reg)

Every local class `i < nT` of rep #364 (44 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O364T
import LRSpectrumFull.L5S4.LinRQSC680
import LRSpectrumFull.L5S4.LinRQSC721
import LRSpectrumFull.L5S4.LinRQSC722

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R364
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(680, LinRQSC680.blobs), (721, LinRQSC721.blobs), (722, LinRQSC722.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(721, 35, [1, -1, 0, -1, 1, -1, 4, -3, 0]), (721, 36, [1, -1, 0, -1, 1, -1, 4, -3, -1]), (721, 37, [1, -1, 0, -1, 1, -1, 4, -3, 0]), (721, 38, [1, -1, 0, -1, 1, -1, 3, -2, -1]), (721, 39, [1, 0, -1, -1, -2, 2, 4, -1, -3]), (721, 40, [1, 0, -1, -1, -4, 4, 4, -1, -3]), (721, 41, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (721, 42, [1, 0, -1, -1, 4, -2, 3, 3, -5]), (721, 43, [1, 0, -1, -1, 4, -2, 4, 3, -6]), (721, 44, [1, 0, -1, -1, 4, -2, 3, 3, -5]), (721, 45, [1, 0, -1, -1, 4, 0, 4, 1, -4]), (721, 46, [0, 1, 0, 4, -1, -1, 3, 3, -1]), (721, 47, [1, 0, -1, -1, 1, 0, 4, 0, -3]), (721, 48, [0, 1, 0, 1, 2, -1, 0, -4, 1]), (721, 49, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (721, 50, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (721, 51, [0, 1, 0, 4, 2, -1, 1, -4, 0]), (721, 52, [0, 1, 0, 4, 2, -1, 1, -4, 0]), (721, 53, [0, 1, 0, 4, 2, -3, 3, -3, -2]), (721, 54, [0, 1, 0, 2, 2, -1, 1, -4, 0]), (722, 0, [0, 1, 0, 2, 2, -1, 1, -4, 0]), (722, 1, [0, 1, 0, 4, 2, -3, -3, 3, 2]), (722, 2, [0, 1, 0, 4, 2, -1, -1, 4, 0]), (722, 3, [0, 0, 1, 1, 0, -1, -1, -1, -3]), (722, 4, [0, 1, 0, 2, 2, -1, -1, 3, 0]), (722, 5, [0, 1, 0, 1, 2, -1, -1, 2, 0]), (722, 6, [0, -1, 1, 1, 1, -1, -1, 1, 0]), (722, 7, [0, 1, 0, 4, 2, -3, -3, 2, 2]), (722, 8, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (722, 9, [1, 0, -1, -1, 4, 0, -4, -1, 4]), (722, 10, [1, 0, 0, -1, -1, 1, -4, 0, 1]), (722, 11, [1, 0, 0, -1, 0, -1, -4, 1, 0]), (722, 12, [1, 0, -1, -1, 4, -2, -3, -3, 5]), (722, 13, [1, -1, 0, -1, 1, -1, -4, 3, 0]), (722, 14, [1, -1, 0, -1, 1, -1, -3, 2, 1]), (722, 15, [1, -1, 0, -1, 1, -1, -4, 3, 0]), (722, 16, [1, -1, 0, -1, 1, -1, 4, -3, 0]), (722, 17, [0, 1, 0, 4, -1, -3, -1, -3, 1]), (680, 56, [0, 1, 0, 0, 3, -1, -1, 1, 0]), (722, 18, [1, -1, 0, -1, 1, -1, -3, 2, 1]), (722, 19, [1, 0, 0, -1, 0, -1, 3, -1, 1]), (722, 20, [0, -1, 0, 4, 1, -3, -3, 2, 2]), (722, 21, [0, -1, 0, 0, 1, -1, 1, 1, -1]), (722, 22, [0, 0, -1, 0, -1, -2, 1, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N364.TT) N364.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N364.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #364. -/
theorem lines (t5 : List T5Rec) (h680 : ∀ p ∈ LinRQSC680.blobs, LinesCl t5 (t4OfRec p.1)) (h721 : ∀ p ∈ LinRQSC721.blobs, LinesCl t5 (t4OfRec p.1)) (h722 : ∀ p ∈ LinRQSC722.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N364.nT).map (t4At (LRSpectrumFull.L5S4.dg N364.TT) N364.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h680 p hp
  · exact h721 p hp
  · exact h722 p hp
)

#print axioms lines

end R364
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1244 : the lines clause for every class of the local table of rep #1244 (generated by l5reg)

Every local class `i < nT` of rep #1244 (39 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1244T
import LRSpectrumFull.L5S4.LinRQSC960
import LRSpectrumFull.L5S4.LinRQSC961

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1244
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(960, LinRQSC960.blobs), (961, LinRQSC961.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(960, 184, [2, 0, -1, -1, -1, 2, 3, 0, -2]), (960, 185, [1, 1, -1, 3, -1, -2, -2, -1, 2]), (960, 186, [1, 0, -1, 3, -1, -1, 2, 0, -1]), (960, 187, [2, -1, -1, -1, 1, 0, -3, -2, 4]), (960, 188, [2, -1, -1, -1, 1, -1, -1, 0, 1]), (960, 189, [1, 1, -1, 3, 0, -2, 0, 2, -1]), (960, 190, [2, -1, -1, -1, -3, 1, -3, -1, 2]), (960, 191, [2, 1, -1, -1, 3, -2, -1, 0, 0]), (960, 192, [2, 1, -2, -1, 3, -1, 3, 0, -2]), (960, 193, [1, 1, -1, 3, 0, -2, -1, -3, 2]), (960, 194, [2, -1, 0, -1, 0, 0, 2, 2, -1]), (960, 195, [1, -1, 0, 3, 0, -1, 0, 2, -1]), (960, 196, [2, 0, -1, -1, 1, 0, -2, -1, 1]), (960, 197, [1, 0, 0, 0, -1, 1, -3, 0, 1]), (960, 198, [1, 2, -1, 3, -1, -2, 1, 1, -1]), (960, 199, [2, 1, -1, -1, 3, 0, 3, -1, -1]), (960, 200, [1, -1, 0, 0, -3, 2, -3, 1, 1]), (960, 201, [1, -2, 0, 3, 1, -1, -2, -2, 1]), (960, 202, [1, -2, 1, 3, 1, -1, 0, 2, -1]), (960, 203, [1, -2, 1, -1, 1, 0, 3, 1, -3]), (960, 204, [1, -1, 0, -1, -3, 3, 3, 0, -2]), (960, 205, [1, -2, 1, -1, 1, 0, 2, 3, -4]), (960, 206, [1, 2, -1, 3, -1, 0, 0, -2, 1]), (960, 207, [1, 1, -1, 3, -1, -2, -1, 2, 0]), (960, 208, [1, -2, 1, 3, 1, -1, 2, 1, -1]), (960, 209, [1, 2, -2, 3, -1, -1, -2, -1, 2]), (960, 210, [1, -2, 0, -1, 1, 0, 3, 1, -1]), (961, 0, [1, 2, -1, 3, -1, -1, 1, -2, 0]), (961, 1, [1, -2, 0, -1, 1, 0, 3, 2, -1]), (961, 2, [1, 1, -1, 0, 3, -1, -3, 1, 2]), (961, 3, [1, 2, -1, 3, -1, -1, -1, 1, 0]), (961, 4, [1, 1, -1, 3, 0, -1, -1, -3, 2]), (961, 5, [1, -1, 0, 3, -2, 0, 0, 1, -1]), (961, 6, [1, -1, 0, 3, -2, -2, 2, -2, -1]), (961, 7, [1, 0, 0, 3, -1, -1, 0, 0, 1]), (961, 8, [1, 2, -1, 3, -1, -1, -2, 0, 1]), (961, 9, [1, -2, 1, 3, 1, -3, -1, 1, 0]), (961, 10, [1, -1, 0, -1, -1, 1, 3, -2, -1]), (961, 11, [1, -1, 0, -1, 0, 0, 3, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1244.TT) N1244.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1244.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1244. -/
theorem lines (t5 : List T5Rec) (h960 : ∀ p ∈ LinRQSC960.blobs, LinesCl t5 (t4OfRec p.1)) (h961 : ∀ p ∈ LinRQSC961.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1244.nT).map (t4At (LRSpectrumFull.L5S4.dg N1244.TT) N1244.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h960 p hp
  · exact h961 p hp
)

#print axioms lines

end R1244
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 200..299 of rep #523. -/
theorem lines (t5 : List T5Rec) (h492 : ∀ p ∈ LinRQSC492.blobs, LinesCl t5 (t4OfRec p.1)) (h493 : ∀ p ∈ LinRQSC493.blobs, LinesCl t5 (t4OfRec p.1)) (h719 : ∀ p ∈ LinRQSC719.blobs, LinesCl t5 (t4OfRec p.1)) (h782 : ∀ p ∈ LinRQSC782.blobs, LinesCl t5 (t4OfRec p.1)) (h783 : ∀ p ∈ LinRQSC783.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N523.TT) N523.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h492 p hpe
    · exact h493 p hpe
    · exact h719 p hpe
    · exact h782 p hpe
    · exact h783 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


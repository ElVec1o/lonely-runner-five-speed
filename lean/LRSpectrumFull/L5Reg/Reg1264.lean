theorem lines (t5 : List T5Rec) (h965 : ∀ p ∈ LinRQSC965.blobs, LinesCl t5 (t4OfRec p.1)) (h976 : ∀ p ∈ LinRQSC976.blobs, LinesCl t5 (t4OfRec p.1)) (h977 : ∀ p ∈ LinRQSC977.blobs, LinesCl t5 (t4OfRec p.1))

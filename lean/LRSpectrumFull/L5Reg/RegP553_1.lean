/-- the lines clause for local classes 100..199 of rep #553. -/
theorem lines (t5 : List T5Rec) (h752 : ∀ p ∈ LinRQSC752.blobs, LinesCl t5 (t4OfRec p.1)) (h753 : ∀ p ∈ LinRQSC753.blobs, LinesCl t5 (t4OfRec p.1)) (h818 : ∀ p ∈ LinRQSC818.blobs, LinesCl t5 (t4OfRec p.1)) (h819 : ∀ p ∈ LinRQSC819.blobs, LinesCl t5 (t4OfRec p.1)) (h820 : ∀ p ∈ LinRQSC820.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N553.TT) N553.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h752 p hpe
    · exact h753 p hpe
    · exact h818 p hpe
    · exact h819 p hpe
    · exact h820 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


/-
# L5Reg.Reg855 : the lines clause for every class of the local table of rep #855 (generated by l5reg)

Every local class `i < nT` of rep #855 (25 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O855T
import LRSpectrumFull.L5S4.LinRQSC879

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R855
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(879, LinRQSC879.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(879, 188, [3, -2, -1, -2, 0, 1, -1, -1, 1]), (879, 189, [3, -1, -1, -2, -2, 1, 0, -1, 0]), (879, 190, [3, 0, -2, -2, 0, 1, 1, -1, 0]), (879, 191, [3, 0, -2, -2, 0, 1, -1, -1, 1]), (879, 192, [3, -1, -1, -2, -2, 1, 0, -1, 0]), (879, 193, [3, -2, 0, -2, 0, 1, -1, -1, 1]), (879, 194, [3, 0, -2, -2, 0, 1, -1, -1, 1]), (879, 195, [3, 0, -2, -2, 0, 1, 0, -1, 0]), (879, 196, [3, -1, 0, -2, -2, 1, -1, 0, 0]), (879, 197, [3, -2, -2, -2, 2, 1, -1, 1, 1]), (879, 198, [3, -1, -1, -2, -2, 1, 0, -1, 0]), (879, 199, [3, -2, 0, -2, 0, 1, 1, -1, 0]), (879, 200, [3, -1, 0, -2, -2, 1, 0, -3, 1]), (879, 201, [3, -1, -2, -2, -2, 3, -1, -2, 2]), (879, 202, [3, -2, 1, -2, 1, 2, 0, 0, -1]), (879, 203, [3, -1, -2, -2, -2, 3, -1, -2, 2]), (879, 204, [3, 1, -1, -2, 2, -1, 1, 0, 0]), (879, 205, [3, 1, -1, -2, 2, -1, -1, 0, 0]), (879, 206, [3, -1, 0, -2, 1, 0, 0, 0, -1]), (879, 207, [3, 0, -1, -2, 0, 1, -1, -1, 1]), (879, 208, [3, 0, -1, -2, 0, 1, 0, -1, 1]), (879, 209, [3, -1, -1, -2, 2, 1, 0, 1, 0]), (879, 210, [3, 1, -2, -2, 2, 1, -2, 1, 1]), (879, 211, [3, -1, 0, -2, 2, -1, 0, 1, -1]), (879, 212, [3, 1, -2, -2, 2, 1, 0, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N855.TT) N855.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N855.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #855. -/
theorem lines (t5 : List T5Rec) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N855.nT).map (t4At (LRSpectrumFull.L5S4.dg N855.TT) N855.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h879 p hp
)

#print axioms lines

end R855
end L5Reg
end LRSpectrumFull

def bls : List (ℕ × List (ℕ × ℕ)) := [(790, LinRQSC790.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(790, 31, [1, -1, 0, -1, 1, -1, 2, -1, -1]), (790, 32, [1, 0, -1, -1, -1, 1, 3, 0, -2]), (790, 33, [1, 0, -1, -1, 1, 1, 3, 0, -2]), (790, 34, [1, -1, 0, -1, 1, 1, 3, -2, 1]), (790, 35, [1, -1, 0, -1, 1, 1, 3, -2, -2]), (790, 36, [1, 0, 0, -1, 0, 1, 3, -1, -1]), (790, 37, [1, 0, 0, -1, 0, 1, 3, -1, -2]), (790, 38, [1, -1, 0, -1, 0, 0, 4, -1, -1]), (790, 39, [1, 0, -1, -1, 1, 0, 4, 1, -4]), (790, 40, [1, -1, 1, -1, 1, 0, 4, -3, 1]), (790, 41, [1, -1, 0, -1, -1, 1, 4, 1, -3]), (790, 42, [1, 0, -1, -1, 2, 0, 3, 1, -3]), (790, 43, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (790, 44, [1, -1, 0, -1, 1, 1, 3, -2, 1]), (790, 45, [1, 0, -1, -1, -2, 2, 3, -1, -2]), (790, 46, [1, -1, 1, -1, 1, 0, 4, -3, 1]), (790, 47, [1, 0, -1, -1, 1, 1, -3, -1, 2]), (790, 48, [1, 0, -1, -1, -1, 1, -3, 1, 2]), (790, 49, [1, 0, -1, -1, -2, 2, 4, -1, -3]), (790, 50, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (790, 51, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (790, 52, [1, -1, 0, -1, 1, 1, 4, -3, 1]), (790, 53, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (790, 54, [1, 0, -1, -1, -1, 1, 4, 0, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N524.TT) N524.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 24 := by decide +kernel

/-- the lines clause for local classes 300..323 of rep #524. -/
theorem lines (t5 : List T5Rec) (h790 : ∀ p ∈ LinRQSC790.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 24 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N524.TT) N524.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h790 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P524_3

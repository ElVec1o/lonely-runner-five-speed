theorem lines (t5 : List T5Rec) (h933 : ∀ p ∈ LinRQSC933.blobs, LinesCl t5 (t4OfRec p.1)) (h948 : ∀ p ∈ LinRQSC948.blobs, LinesCl t5 (t4OfRec p.1)) (h1018 : ∀ p ∈ LinRQSC1018.blobs, LinesCl t5 (t4OfRec p.1)) (h1019 : ∀ p ∈ LinRQSC1019.blobs, LinesCl t5 (t4OfRec p.1)) (h1020 : ∀ p ∈ LinRQSC1020.blobs, LinesCl t5 (t4OfRec p.1)) (h1021 : ∀ p ∈ LinRQSC1021.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1350.nT).map (t4At (LRSpectrumFull.L5S4.dg N1350.TT) N1350.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h933 p hp
  · exact h948 p hp
  · exact h1018 p hp
  · exact h1019 p hp
  · exact h1020 p hp
  · exact h1021 p hp
)


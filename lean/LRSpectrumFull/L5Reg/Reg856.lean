/-
# L5Reg.Reg856 : the lines clause for every class of the local table of rep #856 (generated by l5reg)

Every local class `i < nT` of rep #856 (3 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O856T
import LRSpectrumFull.L5S4.LinRQSC876
import LRSpectrumFull.L5S4.LinRQSC879

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R856
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(876, LinRQSC876.blobs), (879, LinRQSC879.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(879, 213, [3, 1, -3, 0, -1, 1, 1, -3, 2]), (879, 214, [1, -3, 1, 3, 0, -1, -3, -2, 2]), (876, 259, [3, -1, -2, -1, -3, 3, 0, 3, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N856.TT) N856.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N856.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #856. -/
theorem lines (t5 : List T5Rec) (h876 : ∀ p ∈ LinRQSC876.blobs, LinesCl t5 (t4OfRec p.1)) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N856.nT).map (t4At (LRSpectrumFull.L5S4.dg N856.TT) N856.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h876 p hp
  · exact h879 p hp
)

#print axioms lines

end R856
end L5Reg
end LRSpectrumFull

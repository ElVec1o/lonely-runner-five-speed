/-- the lines clause for local classes 100..199 of rep #268. -/
theorem lines (t5 : List T5Rec) (h416 : ∀ p ∈ LinRQSC416.blobs, LinesCl t5 (t4OfRec p.1)) (h417 : ∀ p ∈ LinRQSC417.blobs, LinesCl t5 (t4OfRec p.1)) (h418 : ∀ p ∈ LinRQSC418.blobs, LinesCl t5 (t4OfRec p.1)) (h419 : ∀ p ∈ LinRQSC419.blobs, LinesCl t5 (t4OfRec p.1)) (h420 : ∀ p ∈ LinRQSC420.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N268.TT) N268.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h416 p hpe
    · exact h417 p hpe
    · exact h418 p hpe
    · exact h419 p hpe
    · exact h420 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


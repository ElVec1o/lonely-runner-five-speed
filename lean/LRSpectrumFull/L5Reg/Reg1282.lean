/-- the lines clause for every class of the local table of rep #1282. -/
theorem lines (t5 : List T5Rec) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1)) (h995 : ∀ p ∈ LinRQSC995.blobs, LinesCl t5 (t4OfRec p.1)) (h996 : ∀ p ∈ LinRQSC996.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1282.nT).map (t4At (LRSpectrumFull.L5S4.dg N1282.TT) N1282.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h935 p hp
  · exact h995 p hp
  · exact h996 p hp
)


theorem adv_len : adv.length = N13.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #13. -/
theorem lines (t5 : List T5Rec) (h0 : ∀ p ∈ LinRQSC0.blobs, LinesCl t5 (t4OfRec p.1)) (h1 : ∀ p ∈ LinRQSC1.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N13.nT).map (t4At (LRSpectrumFull.L5S4.dg N13.TT) N13.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h0 p hp
  · exact h1 p hp
)


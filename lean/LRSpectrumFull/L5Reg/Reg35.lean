theorem adv_len : adv.length = N35.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #35. -/
theorem lines (t5 : List T5Rec) (h2 : ∀ p ∈ LinRQSC2.blobs, LinesCl t5 (t4OfRec p.1)) (h3 : ∀ p ∈ LinRQSC3.blobs, LinesCl t5 (t4OfRec p.1)) (h4 : ∀ p ∈ LinRQSC4.blobs, LinesCl t5 (t4OfRec p.1)) (h5 : ∀ p ∈ LinRQSC5.blobs, LinesCl t5 (t4OfRec p.1)) (h6 : ∀ p ∈ LinRQSC6.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N35.nT).map (t4At (LRSpectrumFull.L5S4.dg N35.TT) N35.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h2 p hp
  · exact h3 p hp
  · exact h4 p hp
  · exact h5 p hp
  · exact h6 p hp
)


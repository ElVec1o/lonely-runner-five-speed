theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1032.TT) N1032.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1032.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1032. -/
theorem lines (t5 : List T5Rec) (h897 : ∀ p ∈ LinRQSC897.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1)) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1032.nT).map (t4At (LRSpectrumFull.L5S4.dg N1032.TT) N1032.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h897 p hp
  · exact h904 p hp
  · exact h907 p hp
)

#print axioms lines


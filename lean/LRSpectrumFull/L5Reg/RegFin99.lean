/-
# L5Reg.RegFin99 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg550
import LRSpectrumFull.L5Reg.Reg521

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines550 : ∀ cl ∈ (List.range N550.nT).map (t4At (LRSpectrumFull.L5S4.dg N550.TT) N550.ST), LinesCl T5Store.t5 cl :=
  R550.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem739 p hp)) (fun p hp => FinalGlue.glines p (mem740 p hp)) (fun p hp => FinalGlue.glines p (mem741 p hp)) (fun p hp => FinalGlue.glines p (mem805 p hp)) (fun p hp => FinalGlue.glines p (mem806 p hp)) (fun p hp => FinalGlue.glines p (mem807 p hp))

theorem lines521 : ∀ cl ∈ (List.range N521.nT).map (t4At (LRSpectrumFull.L5S4.dg N521.TT) N521.ST), LinesCl T5Store.t5 cl :=
  R521.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem772 p hp)) (fun p hp => FinalGlue.glines p (mem773 p hp)) (fun p hp => FinalGlue.glines p (mem774 p hp)) (fun p hp => FinalGlue.glines p (mem775 p hp)) (fun p hp => FinalGlue.glines p (mem776 p hp))

#print axioms lines550

end L5Reg
end LRSpectrumFull

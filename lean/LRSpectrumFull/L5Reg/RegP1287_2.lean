theorem lines (t5 : List T5Rec) (h927 : ∀ p ∈ LinRQSC927.blobs, LinesCl t5 (t4OfRec p.1)) (h980 : ∀ p ∈ LinRQSC980.blobs, LinesCl t5 (t4OfRec p.1)) (h981 : ∀ p ∈ LinRQSC981.blobs, LinesCl t5 (t4OfRec p.1)) (h982 : ∀ p ∈ LinRQSC982.blobs, LinesCl t5 (t4OfRec p.1)) (h986 : ∀ p ∈ LinRQSC986.blobs, LinesCl t5 (t4OfRec p.1))

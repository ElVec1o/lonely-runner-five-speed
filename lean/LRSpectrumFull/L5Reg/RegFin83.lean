/-
# L5Reg.RegFin83 : the lines clause for the local class tables of 4 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg290
import LRSpectrumFull.L5Reg.Reg628
import LRSpectrumFull.L5Reg.Reg40
import LRSpectrumFull.L5Reg.Reg45

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines290 : ∀ cl ∈ (List.range N290.nT).map (t4At (LRSpectrumFull.L5S4.dg N290.TT) N290.ST), LinesCl T5Store.t5 cl :=
  R290.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem439 p hp)) (fun p hp => FinalGlue.glines p (mem440 p hp))

theorem lines628 : ∀ cl ∈ (List.range N628.nT).map (t4At (LRSpectrumFull.L5S4.dg N628.TT) N628.ST), LinesCl T5Store.t5 cl :=
  R628.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem842 p hp)) (fun p hp => FinalGlue.glines p (mem843 p hp))

theorem lines40 : ∀ cl ∈ (List.range N40.nT).map (t4At (LRSpectrumFull.L5S4.dg N40.TT) N40.ST), LinesCl T5Store.t5 cl :=
  R40.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem28 p hp)) (fun p hp => FinalGlue.glines p (mem29 p hp))

theorem lines45 : ∀ cl ∈ (List.range N45.nT).map (t4At (LRSpectrumFull.L5S4.dg N45.TT) N45.ST), LinesCl T5Store.t5 cl :=
  R45.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem28 p hp)) (fun p hp => FinalGlue.glines p (mem29 p hp))

#print axioms lines290

end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #1194. -/
theorem lines (t5 : List T5Rec) (h940 : ∀ p ∈ LinRQSC940.blobs, LinesCl t5 (t4OfRec p.1)) (h943 : ∀ p ∈ LinRQSC943.blobs, LinesCl t5 (t4OfRec p.1))

/-- the lines clause for every class of the local table of rep #1387. -/
theorem lines (t5 : List T5Rec) (h977 : ∀ p ∈ LinRQSC977.blobs, LinesCl t5 (t4OfRec p.1)) (h1022 : ∀ p ∈ LinRQSC1022.blobs, LinesCl t5 (t4OfRec p.1)) (h1023 : ∀ p ∈ LinRQSC1023.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1387.nT).map (t4At (LRSpectrumFull.L5S4.dg N1387.TT) N1387.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h977 p hp
  · exact h1022 p hp
  · exact h1023 p hp
)


/-
# L5Reg.Reg1719 : the lines clause for every class of the local table of rep #1719 (generated by l5reg)

Every local class `i < nT` of rep #1719 (6 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1719T
import LRSpectrumFull.L5S4.LinRQSC1028
import LRSpectrumFull.L5S4.LinRQSC1034
import LRSpectrumFull.L5S4.LinRQSC1044

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1719
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1028, LinRQSC1028.blobs), (1034, LinRQSC1034.blobs), (1044, LinRQSC1044.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1028, 85, [1, 1, -1, 4, -1, -1, 1, -2, 1]), (1028, 101, [1, -1, 1, 4, -3, 1, 1, -1, 2]), (1028, 89, [1, -1, 0, 4, 1, -3, 1, 2, -2]), (1034, 33, [1, 1, -1, 3, 1, -2, -1, 2, 0]), (1044, 1, [1, 1, -1, 3, -2, 0, -3, -1, 2]), (1044, 7, [1, 0, -1, -2, 0, 1, -3, 1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1719.TT) N1719.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1719.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1719. -/
theorem lines (t5 : List T5Rec) (h1028 : ∀ p ∈ LinRQSC1028.blobs, LinesCl t5 (t4OfRec p.1)) (h1034 : ∀ p ∈ LinRQSC1034.blobs, LinesCl t5 (t4OfRec p.1)) (h1044 : ∀ p ∈ LinRQSC1044.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1719.nT).map (t4At (LRSpectrumFull.L5S4.dg N1719.TT) N1719.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h1028 p hp
  · exact h1034 p hp
  · exact h1044 p hp
)

#print axioms lines

end R1719
end L5Reg
end LRSpectrumFull

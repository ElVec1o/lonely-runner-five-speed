/-
# L5Reg.Reg836 : the lines clause for every class of the local table of rep #836 (generated by l5reg)

Every local class `i < nT` of rep #836 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O836T
import LRSpectrumFull.L5S4.LinRQSC876
import LRSpectrumFull.L5S4.LinRQSC877

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R836
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(876, LinRQSC876.blobs), (877, LinRQSC877.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(876, 269, [1, -3, 1, 3, 2, -3, 0, 2, -1]), (876, 270, [1, -3, 2, 3, 2, -3, -2, 0, 1]), (876, 271, [1, -1, 0, 3, -2, -1, 0, 0, 1]), (877, 0, [1, -3, 1, 3, 2, -1, 1, 0, 0]), (877, 1, [1, -3, 0, 3, 2, -2, -2, 1, 1]), (877, 2, [1, -3, 1, 3, 2, -4, 1, 0, -1]), (877, 3, [1, 0, -1, 3, 0, -2, -2, -1, 2]), (877, 4, [1, 0, -1, 3, 0, -2, 0, -1, 1]), (877, 5, [1, 0, -1, 3, 0, -2, -1, -1, 1]), (877, 6, [1, 0, -1, 3, 0, -2, -2, -1, 2]), (877, 7, [1, 0, -1, 3, 0, -2, 1, -1, 0]), (877, 8, [1, 0, -1, 3, 0, -2, -1, -1, 1]), (877, 9, [1, 0, -1, 3, 0, -2, -2, -1, 2]), (877, 10, [1, 0, -1, 3, 0, -2, -2, -1, 2]), (877, 11, [1, -3, 1, 3, 2, -4, 1, 0, -1]), (877, 12, [1, -3, 2, 3, 2, -3, -2, 1, 0]), (877, 13, [1, -3, 0, 3, 2, -2, -2, 0, 1]), (877, 14, [1, -3, 2, 3, 2, -3, -2, 0, 1]), (877, 15, [1, -3, 0, 3, 2, -3, 1, 1, -1]), (877, 16, [1, -3, 2, 3, 2, -2, 1, 1, -1]), (877, 17, [1, -3, 0, 3, 2, -3, -1, -1, 1]), (877, 18, [1, -3, 0, 3, 2, -2, -2, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N836.TT) N836.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N836.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #836. -/
theorem lines (t5 : List T5Rec) (h876 : ∀ p ∈ LinRQSC876.blobs, LinesCl t5 (t4OfRec p.1)) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N836.nT).map (t4At (LRSpectrumFull.L5S4.dg N836.TT) N836.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h876 p hp
  · exact h877 p hp
)

#print axioms lines

end R836
end L5Reg
end LRSpectrumFull

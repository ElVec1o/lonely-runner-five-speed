/-
# L5Reg.Reg139 : the lines clause for every class of the local table of rep #139 (generated by l5reg)

Every local class `i < nT` of rep #139 (38 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O139T
import LRSpectrumFull.L5S4.LinRQSC129
import LRSpectrumFull.L5S4.LinRQSC130

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R139
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(129, LinRQSC129.blobs), (130, LinRQSC130.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(129, 137, [2, 1, -1, -1, 3, -1, 2, -4, 1]), (129, 138, [2, 0, -1, -1, -3, 1, -1, 4, 0]), (129, 139, [2, 0, -1, -1, 1, 0, 2, 3, -2]), (129, 140, [2, -1, -1, -1, 1, 0, 0, 2, -1]), (129, 141, [2, 0, -1, -1, 1, 0, 1, 4, -2]), (129, 142, [2, 0, -1, -1, -1, 1, 1, 4, -3]), (129, 143, [2, 0, -1, -1, 1, 0, 0, 3, -1]), (129, 144, [2, -1, -1, -1, 1, 0, 1, 1, -1]), (129, 145, [2, -1, 0, -1, 1, -1, 2, 0, -1]), (129, 146, [2, 1, -1, -1, 3, 0, -1, 4, 0]), (129, 147, [2, 1, -1, -1, 3, 0, -1, 2, 0]), (129, 148, [2, 1, -1, -1, 3, -1, 0, 2, -1]), (129, 149, [2, 1, -1, -1, 3, 0, 1, -4, 0]), (129, 150, [2, -1, -1, -1, 1, -1, 0, -1, 2]), (129, 151, [2, 0, 1, -1, -1, 3, 2, 1, -3]), (129, 152, [2, 0, -1, -1, -1, 1, 0, 3, -2]), (130, 0, [2, 0, -1, -1, -1, 1, 1, 2, -2]), (130, 1, [2, -1, 0, -1, 0, 0, -1, 1, -1]), (130, 2, [2, 0, -1, -1, 3, 0, -1, -2, 1]), (130, 3, [2, -1, 0, -1, 0, 1, 2, -1, -1]), (130, 4, [2, -1, 0, -1, 1, 0, 1, 0, -1]), (130, 5, [2, 0, -1, -1, -1, -1, 0, 1, 2]), (130, 6, [2, -1, 0, -1, 0, -3, -1, 1, 4]), (130, 7, [2, -1, -1, -1, 0, 1, 1, -1, 1]), (130, 8, [2, 0, -1, -1, -1, 1, 0, -1, 0]), (130, 9, [0, -2, 1, -3, 1, 2, 2, 1, -2]), (130, 10, [0, 1, 0, -3, 1, 1, 2, -2, -1]), (130, 11, [2, -1, 0, -1, 1, 0, 2, 0, -1]), (130, 12, [2, 0, -1, -1, 1, 0, 0, 3, -2]), (130, 13, [2, 0, -1, -1, -1, 1, 2, -1, 0]), (130, 14, [2, -1, -1, -1, 0, 1, 0, -1, 2]), (130, 15, [2, 0, -1, -1, -1, 1, 1, -2, 1]), (130, 16, [2, 0, -1, -1, -1, 1, 0, -1, 0]), (130, 17, [2, 0, -1, -1, -3, 3, -1, 4, -3]), (130, 18, [2, -1, -1, -1, -1, 1, 0, 2, -1]), (130, 19, [2, -1, 0, -1, 0, 0, 1, -1, 1]), (130, 20, [2, 0, -1, -1, -1, 1, -1, -4, 3]), (130, 21, [2, 0, -1, -1, -1, 1, 0, -3, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N139.TT) N139.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N139.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #139. -/
theorem lines (t5 : List T5Rec) (h129 : ∀ p ∈ LinRQSC129.blobs, LinesCl t5 (t4OfRec p.1)) (h130 : ∀ p ∈ LinRQSC130.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N139.nT).map (t4At (LRSpectrumFull.L5S4.dg N139.TT) N139.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h129 p hp
  · exact h130 p hp
)

#print axioms lines

end R139
end L5Reg
end LRSpectrumFull

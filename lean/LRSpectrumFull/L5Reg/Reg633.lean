theorem lines (t5 : List T5Rec) (h487 : ∀ p ∈ LinRQSC487.blobs, LinesCl t5 (t4OfRec p.1)) (h713 : ∀ p ∈ LinRQSC713.blobs, LinesCl t5 (t4OfRec p.1)) (h767 : ∀ p ∈ LinRQSC767.blobs, LinesCl t5 (t4OfRec p.1)) (h768 : ∀ p ∈ LinRQSC768.blobs, LinesCl t5 (t4OfRec p.1)) (h769 : ∀ p ∈ LinRQSC769.blobs, LinesCl t5 (t4OfRec p.1)) (h850 : ∀ p ∈ LinRQSC850.blobs, LinesCl t5 (t4OfRec p.1)) (h851 : ∀ p ∈ LinRQSC851.blobs, LinesCl t5 (t4OfRec p.1)) (h852 : ∀ p ∈ LinRQSC852.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N633.nT).map (t4At (LRSpectrumFull.L5S4.dg N633.TT) N633.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h487 p hp
  · exact h713 p hp
  · exact h767 p hp
  · exact h768 p hp
  · exact h769 p hp
  · exact h850 p hp
  · exact h851 p hp
  · exact h852 p hp
)

#print axioms lines

end R633
end L5Reg
end LRSpectrumFull

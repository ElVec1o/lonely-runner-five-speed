/-
# L5Reg.Reg1123 : the lines clause for every class of the local table of rep #1123 (generated by l5reg)

Every local class `i < nT` of rep #1123 (41 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1123T
import LRSpectrumFull.L5S4.LinRQSC923

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1123
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(923, LinRQSC923.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(923, 39, [0, 1, 0, 0, -1, 1, -1, 0, 0]), (923, 40, [1, -1, 0, 2, 1, -1, -2, 0, 1]), (923, 41, [1, -1, 1, 2, -1, 1, -1, 1, 0]), (923, 42, [1, -1, 0, 2, 1, -1, -2, 0, 1]), (923, 43, [1, -1, 0, 2, 1, -2, -2, 1, 1]), (923, 44, [1, 1, -1, 2, 1, -2, 1, -3, 0]), (923, 45, [1, 1, -1, 2, 1, -2, 2, -2, -1]), (923, 46, [1, 1, -1, 2, -1, 0, 2, 0, -1]), (923, 47, [1, 1, -1, 2, 1, -2, 2, -2, -1]), (923, 48, [1, 0, 0, 2, -1, 0, 1, 0, -1]), (923, 49, [1, 1, -1, 2, -1, -1, 0, 1, 0]), (923, 50, [1, 0, -1, 2, -1, 1, 1, 0, 0]), (923, 51, [1, -1, 0, 2, 1, -1, 1, 0, 0]), (923, 52, [0, -1, 1, 0, -2, 1, -1, 0, 0]), (923, 53, [1, 1, -1, 2, -1, -1, 2, 1, -2]), (923, 54, [1, 1, -1, 2, -1, -1, 1, 2, -1]), (923, 55, [1, 0, -1, 2, -1, 0, 1, 0, 0]), (923, 56, [1, 0, 0, 2, -1, 0, 1, 0, 1]), (923, 57, [1, 1, -1, 2, 1, -2, 1, -2, 0]), (923, 58, [1, 1, -1, 2, -1, 0, 2, 1, -1]), (923, 59, [1, 1, -1, 2, -1, 0, 1, 0, 0]), (923, 60, [1, -1, 0, 2, -1, 0, 1, -1, 1]), (923, 61, [0, -1, -1, 0, -2, -1, -1, 0, 0]), (923, 62, [1, 0, 0, 2, 0, -1, 1, 1, 0]), (923, 63, [1, 1, -1, 2, -1, 0, 1, 2, -2]), (923, 64, [1, 0, 0, 2, 0, -1, 1, 1, 0]), (923, 65, [1, 1, -1, -1, 2, 0, 2, 0, -1]), (923, 66, [1, 1, -1, -1, 2, -1, 2, 0, -1]), (923, 67, [1, 1, -1, 2, -1, -1, 1, 2, -1]), (923, 68, [1, 1, -1, -1, 2, -1, 2, 1, -1]), (923, 69, [1, 0, -1, -1, 1, 0, 1, 0, 0]), (923, 70, [1, 0, -1, -1, 1, 0, 1, 0, 0]), (923, 71, [1, 1, -1, -1, 2, 0, 2, 0, -1]), (923, 72, [1, -1, 1, -1, 0, 1, 1, -1, 0]), (923, 73, [1, -1, 0, -1, -2, 1, 2, 0, -1]), (923, 74, [1, 1, -1, -1, 2, -1, 2, 1, -1]), (923, 75, [1, 0, -1, -1, 1, 0, 3, -1, -1]), (923, 76, [1, 0, 0, -1, 0, 1, 2, -1, 0]), (923, 77, [1, 0, -1, -1, 0, 0, 2, -1, -1]), (923, 78, [1, -1, -1, -1, 1, 0, 2, -1, -1]), (923, 79, [1, 0, -1, -1, 0, 0, -2, 1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1123.TT) N1123.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1123.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1123. -/
theorem lines (t5 : List T5Rec) (h923 : ∀ p ∈ LinRQSC923.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1123.nT).map (t4At (LRSpectrumFull.L5S4.dg N1123.TT) N1123.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h923 p hp
)

#print axioms lines


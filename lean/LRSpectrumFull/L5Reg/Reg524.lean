/-- the lines clause for every class of the local table of rep #524. -/
theorem lines (t5 : List T5Rec) (h787 : ∀ p ∈ LinRQSC787.blobs, LinesCl t5 (t4OfRec p.1)) (h788 : ∀ p ∈ LinRQSC788.blobs, LinesCl t5 (t4OfRec p.1)) (h789 : ∀ p ∈ LinRQSC789.blobs, LinesCl t5 (t4OfRec p.1)) (h790 : ∀ p ∈ LinRQSC790.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N524.nT).map (t4At (LRSpectrumFull.L5S4.dg N524.TT) N524.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N524.nT := List.mem_range.1 hc
  have hn : N524.nT = 324 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 324) := by omega
  rcases hcase with h | h | h | h
  · exact P524_0.lines t5 h787 h788 c h.1 (by omega)
  · exact P524_1.lines t5 h788 h789 c h.1 (by omega)
  · exact P524_2.lines t5 h789 h790 c h.1 (by omega)
  · exact P524_3.lines t5 h790 c h.1 (by omega)

#print axioms lines

end R524

/-- the lines clause for every class of the local table of rep #525. -/
theorem lines (t5 : List T5Rec) (h536 : ∀ p ∈ LinRQSC536.blobs, LinesCl t5 (t4OfRec p.1)) (h540 : ∀ p ∈ LinRQSC540.blobs, LinesCl t5 (t4OfRec p.1)) (h790 : ∀ p ∈ LinRQSC790.blobs, LinesCl t5 (t4OfRec p.1)) (h791 : ∀ p ∈ LinRQSC791.blobs, LinesCl t5 (t4OfRec p.1)) (h792 : ∀ p ∈ LinRQSC792.blobs, LinesCl t5 (t4OfRec p.1)) (h793 : ∀ p ∈ LinRQSC793.blobs, LinesCl t5 (t4OfRec p.1)) (h794 : ∀ p ∈ LinRQSC794.blobs, LinesCl t5 (t4OfRec p.1)) (h795 : ∀ p ∈ LinRQSC795.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N525.nT).map (t4At (LRSpectrumFull.L5S4.dg N525.TT) N525.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N525.nT := List.mem_range.1 hc
  have hn : N525.nT = 380 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 380) := by omega
  rcases hcase with h | h | h | h
  · exact P525_0.lines t5 h536 h790 h791 c h.1 (by omega)
  · exact P525_1.lines t5 h540 h791 h792 h793 c h.1 (by omega)
  · exact P525_2.lines t5 h536 h793 h794 c h.1 (by omega)
  · exact P525_3.lines t5 h794 h795 c h.1 (by omega)

#print axioms lines


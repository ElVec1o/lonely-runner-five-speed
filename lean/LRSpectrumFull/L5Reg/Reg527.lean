/-- the lines clause for every class of the local table of rep #527. -/
theorem lines (t5 : List T5Rec) (h798 : ∀ p ∈ LinRQSC798.blobs, LinesCl t5 (t4OfRec p.1)) (h799 : ∀ p ∈ LinRQSC799.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h51 : ∀ p ∈ LinRQSC51.blobs, LinesCl t5 (t4OfRec p.1)) (h52 : ∀ p ∈ LinRQSC52.blobs, LinesCl t5 (t4OfRec p.1)) (h150 : ∀ p ∈ LinRQSC150.blobs, LinesCl t5 (t4OfRec p.1)) (h151 : ∀ p ∈ LinRQSC151.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 0 ≤ c → c < 0 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N153.TT) N153.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h51 p hpe
    · exact h52 p hpe
    · exact h150 p hpe
    · exact h151 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 0 advOk c h1 ?_
  rw [adv_len]; exact h2


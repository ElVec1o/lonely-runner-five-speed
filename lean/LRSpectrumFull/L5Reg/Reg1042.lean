/-
# L5Reg.Reg1042 : the lines clause for every class of the local table of rep #1042 (generated by l5reg)

Every local class `i < nT` of rep #1042 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1042T
import LRSpectrumFull.L5S4.LinRQSC907
import LRSpectrumFull.L5S4.LinRQSC908
import LRSpectrumFull.L5S4.LinRQSC909

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1042
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(907, LinRQSC907.blobs), (908, LinRQSC908.blobs), (909, LinRQSC909.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(908, 226, [2, 0, -1, -3, 1, 1, 2, 1, -1]), (907, 35, [2, -2, 1, 0, -1, 1, -3, -2, 3]), (909, 0, [2, 0, -1, -3, -2, 3, 0, 3, -2]), (909, 1, [1, -1, 0, 0, 1, 0, -3, 1, 1]), (909, 2, [2, -1, -1, -3, 2, 2, 3, -1, -2]), (909, 3, [2, 0, -1, -3, 1, 1, 1, 2, -2]), (909, 4, [2, 0, -1, -3, 1, 1, 2, 1, -1]), (909, 5, [2, -1, 0, -3, 2, -2, 0, 1, -3]), (909, 6, [2, 0, -1, -3, -2, 3, 1, -3, 2]), (909, 7, [2, 1, -1, -3, 0, 2, -3, 1, 2]), (909, 8, [2, 0, -1, -3, -1, 2, 1, -2, 1]), (909, 9, [2, 0, -1, -3, 2, 1, 1, -1, 0]), (909, 10, [2, -1, -1, -3, 0, 2, 0, -2, 1]), (909, 11, [1, -2, 0, 0, 3, -1, -3, -2, 3]), (909, 12, [2, -1, -1, 1, -1, 0, -3, 1, 1]), (909, 13, [2, 1, -2, 1, 0, -1, 3, -2, -2]), (909, 14, [2, 1, -1, -3, 0, 2, 0, -1, 0]), (909, 15, [2, 2, -3, -3, 1, 1, 0, -1, 1]), (909, 16, [2, 0, 1, -3, 1, 0, -1, 0, 0]), (909, 17, [2, 2, -1, -3, 1, 1, -1, 2, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1042.TT) N1042.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1042.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1042. -/
theorem lines (t5 : List T5Rec) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1)) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1)) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1042.nT).map (t4At (LRSpectrumFull.L5S4.dg N1042.TT) N1042.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h907 p hp
  · exact h908 p hp
  · exact h909 p hp
)

#print axioms lines

end R1042
end L5Reg
end LRSpectrumFull

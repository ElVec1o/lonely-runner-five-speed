/-
# L5Reg.Reg91 : the lines clause for every class of the local table of rep #91 (generated by l5reg)

Every local class `i < nT` of rep #91 (18 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O91T
import LRSpectrumFull.L5S4.LinRQSC32
import LRSpectrumFull.L5S4.LinRQSC95

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R91
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(32, LinRQSC32.blobs), (95, LinRQSC95.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(95, 108, [0, -2, 1, 0, 1, 0, -1, 0, 0]), (95, 109, [0, -2, 1, 0, 1, 0, -1, -1, 0]), (95, 110, [0, 0, 1, -1, 0, 0, 0, 1, 0]), (95, 111, [0, 0, -1, 0, -1, 1, -1, 0, 0]), (95, 112, [0, 1, -1, -1, 0, 0, -1, 1, 0]), (95, 113, [2, -1, 0, -1, 1, 0, 1, 0, 1]), (95, 114, [0, -2, 1, -1, 1, 0, 0, -1, 0]), (95, 115, [2, 0, -1, -1, 1, 0, 1, 2, -1]), (95, 116, [0, -1, 1, -1, 1, 0, 0, -1, 0]), (32, 57, [0, -1, 1, 0, 1, 0, 1, -1, 0]), (95, 117, [2, 0, -1, -1, -4, 1, 2, 1, -1]), (95, 118, [2, -1, 0, -1, 1, -2, 1, 0, -1]), (95, 119, [2, 0, -1, -1, 2, 0, 2, 1, -1]), (95, 120, [2, 0, -1, -1, -4, 2, 1, -1, 0]), (95, 121, [2, 0, -1, -1, 0, 0, 2, 1, -1]), (95, 122, [2, 1, -2, -1, 1, 0, 2, -4, 1]), (95, 123, [2, 1, -2, -1, 1, 0, 1, -3, 1]), (95, 124, [2, 1, -2, -1, 1, 0, 2, -4, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N91.TT) N91.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N91.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #91. -/
theorem lines (t5 : List T5Rec) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1)) (h95 : ∀ p ∈ LinRQSC95.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N91.nT).map (t4At (LRSpectrumFull.L5S4.dg N91.TT) N91.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h32 p hp
  · exact h95 p hp
)

#print axioms lines

end R91
end L5Reg
end LRSpectrumFull

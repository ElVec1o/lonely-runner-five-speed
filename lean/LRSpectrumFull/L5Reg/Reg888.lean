/-
# L5Reg.Reg888 : the lines clause for every class of the local table of rep #888 (generated by l5reg)

Every local class `i < nT` of rep #888 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O888T
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R888
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 154, [3, -1, -2, -2, 1, 1, -1, 2, 0]), (881, 155, [3, 0, -1, -2, 1, 0, -2, -1, 1]), (881, 156, [3, 0, -1, -2, -1, 1, 2, -1, 0]), (881, 157, [1, 1, -1, 0, 1, -1, -3, 1, 0]), (881, 158, [3, 0, -2, -2, 1, 1, 0, 1, 0]), (881, 159, [3, -2, 1, -2, 1, 0, -2, 1, -1]), (881, 160, [3, 1, -2, -2, 0, 1, 1, -2, 1]), (881, 111, [3, 0, -1, 1, -3, 1, 0, 2, -1]), (881, 161, [3, 0, -1, -2, -1, 0, 1, 1, 0]), (881, 162, [3, 0, -2, -2, -1, 1, 0, 1, 0]), (881, 163, [0, -3, 2, -1, 2, -1, 1, 0, 0]), (881, 164, [0, -3, 1, -1, 2, 0, 0, 1, 0]), (881, 165, [3, -2, 1, -2, 1, 0, -1, 1, 0]), (881, 166, [1, 1, -1, 0, 1, -1, -3, 1, 0]), (881, 167, [3, -2, -1, -2, 1, 1, 2, 0, -1]), (881, 168, [0, 0, -1, -1, 0, 1, 1, -1, 0]), (881, 169, [3, 1, -2, -2, 1, 0, 2, 0, -1]), (881, 170, [0, 1, 0, -1, 0, 0, 1, 1, -1]), (881, 171, [3, -1, 0, -2, 1, 0, 1, 0, -1]), (881, 172, [0, 1, 0, -1, 0, 0, 0, 1, -1]), (881, 173, [3, 0, -1, -2, 1, 0, 1, 2, -2]), (881, 174, [3, 0, -1, -2, -1, 1, 1, -3, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N888.TT) N888.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N888.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #888. -/
theorem lines (t5 : List T5Rec) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N888.nT).map (t4At (LRSpectrumFull.L5S4.dg N888.TT) N888.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h881 p hp
)

#print axioms lines

end R888
end L5Reg
end LRSpectrumFull

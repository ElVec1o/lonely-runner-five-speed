/-
# L5Reg.Reg1003 : the lines clause for every class of the local table of rep #1003 (generated by l5reg)

Every local class `i < nT` of rep #1003 (3 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1003T
import LRSpectrumFull.L5S4.LinRQSC892
import LRSpectrumFull.L5S4.LinRQSC904

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1003
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs), (904, LinRQSC904.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(904, 63, [1, -2, 1, 1, -1, 0, 4, 0, -3]), (892, 30, [2, 0, -1, -3, 0, 2, -1, -1, 1]), (892, 17, [2, 0, -1, -3, -1, 2, 2, -3, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1003.TT) N1003.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1003.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1003. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1003.nT).map (t4At (LRSpectrumFull.L5S4.dg N1003.TT) N1003.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h892 p hp
  · exact h904 p hp
)

#print axioms lines

end R1003
end L5Reg
end LRSpectrumFull

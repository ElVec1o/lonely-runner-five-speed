/-
# L5Reg.Reg798 : the lines clause for every class of the local table of rep #798 (generated by l5reg)

Every local class `i < nT` of rep #798 (17 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O798T
import LRSpectrumFull.L5S4.LinRQSC872

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R798
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(872, LinRQSC872.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(872, 156, [2, 0, -1, -1, -1, 1, -1, 0, 1]), (872, 157, [2, 0, -1, -1, 2, 0, -2, -1, 1]), (872, 158, [2, 1, -2, -1, 1, 0, -1, 2, -1]), (872, 159, [0, -1, 0, 1, -1, -1, -3, 0, 2]), (872, 160, [0, 1, 0, -2, 1, 1, 1, 2, 0]), (872, 161, [0, -1, 0, -2, -1, 1, 1, -2, 0]), (872, 162, [0, -2, 1, -2, 1, 0, 3, 0, -1]), (872, 163, [2, 0, -1, -1, 2, -1, -2, -1, 2]), (872, 164, [1, 0, -1, 1, 1, -1, 1, -1, 0]), (872, 165, [0, -1, 1, 1, 2, -2, -2, 1, 0]), (872, 166, [0, -1, 1, 1, 2, -2, -3, 0, 1]), (872, 167, [0, 0, 1, -2, 1, 1, 3, -2, 1]), (872, 168, [0, 1, 0, -2, -2, 1, 3, 0, -2]), (872, 146, [0, 2, -1, 3, -1, 0, -1, 0, 0]), (872, 169, [1, 0, 0, 1, 1, -1, 1, -1, 0]), (872, 170, [1, 0, 0, 1, 1, -2, 1, -1, 3]), (872, 171, [0, -2, 1, -2, 1, 1, 3, 1, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N798.TT) N798.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N798.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #798. -/
theorem lines (t5 : List T5Rec) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N798.nT).map (t4At (LRSpectrumFull.L5S4.dg N798.TT) N798.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h872 p hp
)

#print axioms lines

end R798
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg484 : the lines clause for every class of the local table of rep #484 (generated by l5reg)

Every local class `i < nT` of rep #484 (10 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O484T
import LRSpectrumFull.L5S4.LinRQSC732
import LRSpectrumFull.L5S4.LinRQSC733

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R484
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(732, LinRQSC732.blobs), (733, LinRQSC733.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(732, 111, [1, -1, 0, -2, 2, 1, 4, -3, -1]), (732, 112, [1, 0, -1, -2, -3, 4, 4, -1, -3]), (733, 0, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (733, 1, [1, 0, -1, -2, -1, 2, 4, 0, -3]), (733, 2, [1, 0, -1, -2, 1, 1, -4, 0, 3]), (733, 3, [1, 0, -1, -2, -1, 2, 4, 0, -3]), (733, 4, [1, -1, 0, -2, 2, 1, -4, 3, 1]), (733, 5, [1, 0, 0, 3, -1, 3, 4, 1, -2]), (733, 6, [1, 0, -1, 3, 1, -3, 3, -1, -2]), (733, 7, [1, 1, -1, 3, -2, -2, 3, -1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N484.TT) N484.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N484.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #484. -/
theorem lines (t5 : List T5Rec) (h732 : ∀ p ∈ LinRQSC732.blobs, LinesCl t5 (t4OfRec p.1)) (h733 : ∀ p ∈ LinRQSC733.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N484.nT).map (t4At (LRSpectrumFull.L5S4.dg N484.TT) N484.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h732 p hp
  · exact h733 p hp
)

#print axioms lines

end R484
end L5Reg
end LRSpectrumFull

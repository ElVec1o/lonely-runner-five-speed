theorem lines (t5 : List T5Rec) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h885 : ∀ p ∈ LinRQSC885.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N918.nT).map (t4At (LRSpectrumFull.L5S4.dg N918.TT) N918.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h878 p hp
  · exact h880 p hp
  · exact h881 p hp
  · exact h882 p hp
  · exact h885 p hp
)


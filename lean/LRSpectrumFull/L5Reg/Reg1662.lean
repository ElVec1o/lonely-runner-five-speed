/-
# L5Reg.Reg1662 : the lines clause for every class of the local table of rep #1662 (generated by l5reg)

Every local class `i < nT` of rep #1662 (10 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1662T
import LRSpectrumFull.L5S4.LinRQSC199
import LRSpectrumFull.L5S4.LinRQSC1027

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1662
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs), (1027, LinRQSC1027.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(199, 208, [0, 3, -1, -3, -1, 2, 2, 0, -1]), (199, 185, [3, 0, -2, 2, 2, -3, -1, 3, -2]), (199, 186, [0, 0, 1, 1, 0, 0, 1, -1, 0]), (199, 229, [3, 0, -1, 0, 1, -1, 2, 0, -1]), (199, 228, [1, 0, 0, 0, 1, -1, 0, -1, 0]), (199, 227, [3, 0, -1, 0, -2, 1, 2, 1, -1]), (1027, 16, [0, -2, 1, 1, 2, -1, 0, -3, 1]), (199, 230, [1, 0, 0, 0, 1, -1, 0, -1, 0]), (199, 224, [3, 0, -1, 0, -1, 0, -2, -1, 1]), (199, 225, [1, 2, -2, 0, -2, 1, 0, -3, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1662.TT) N1662.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1662.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1662. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1027 : ∀ p ∈ LinRQSC1027.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1662.nT).map (t4At (LRSpectrumFull.L5S4.dg N1662.TT) N1662.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h199 p hp
  · exact h1027 p hp
)

#print axioms lines

end R1662
end L5Reg
end LRSpectrumFull

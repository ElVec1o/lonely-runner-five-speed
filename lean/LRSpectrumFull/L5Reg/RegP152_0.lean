theorem lines (t5 : List T5Rec) (h63 : ∀ p ∈ LinRQSC63.blobs, LinesCl t5 (t4OfRec p.1)) (h64 : ∀ p ∈ LinRQSC64.blobs, LinesCl t5 (t4OfRec p.1)) (h147 : ∀ p ∈ LinRQSC147.blobs, LinesCl t5 (t4OfRec p.1)) (h148 : ∀ p ∈ LinRQSC148.blobs, LinesCl t5 (t4OfRec p.1))

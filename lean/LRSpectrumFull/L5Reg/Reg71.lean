/-- the lines clause for every class of the local table of rep #71. -/
theorem lines (t5 : List T5Rec) (h56 : ∀ p ∈ LinRQSC56.blobs, LinesCl t5 (t4OfRec p.1)) (h57 : ∀ p ∈ LinRQSC57.blobs, LinesCl t5 (t4OfRec p.1)) (h58 : ∀ p ∈ LinRQSC58.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N71.nT).map (t4At (LRSpectrumFull.L5S4.dg N71.TT) N71.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h56 p hp
  · exact h57 p hp
  · exact h58 p hp
)


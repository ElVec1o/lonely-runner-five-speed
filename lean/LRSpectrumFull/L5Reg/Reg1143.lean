/-
# L5Reg.Reg1143 : the lines clause for every class of the local table of rep #1143 (generated by l5reg)

Every local class `i < nT` of rep #1143 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1143T
import LRSpectrumFull.L5S4.LinRQSC923
import LRSpectrumFull.L5S4.LinRQSC925

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1143
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(923, LinRQSC923.blobs), (925, LinRQSC925.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(925, 3, [1, -1, 0, 2, -1, 0, 2, -1, -1]), (925, 4, [1, -1, 0, 2, 1, -2, 1, 0, -1]), (925, 5, [1, 0, 0, 0, -2, 1, -2, -1, 1]), (923, 105, [1, -1, -1, -2, 1, 0, 0, 0, 1]), (925, 6, [1, -1, -1, 2, -1, -1, 0, 0, -1]), (925, 7, [1, 1, -1, 2, -1, 0, 2, 0, -1]), (925, 8, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (925, 9, [1, 0, -1, 2, -2, -1, -1, -3, 2]), (925, 10, [1, 1, 0, 0, -1, 0, -3, 0, 1]), (925, 11, [1, 0, -1, 2, -1, 0, -1, 1, 0]), (923, 106, [1, 1, -1, -2, 1, 0, -2, 0, 1]), (925, 12, [0, -1, 1, 2, -2, 1, 3, 1, -2]), (925, 13, [1, 0, 0, 0, 1, -1, -3, 2, -1]), (925, 14, [0, 1, 0, 2, -1, -1, 3, 0, -2]), (923, 102, [1, 0, -1, -2, 1, -2, 0, 0, 1]), (925, 15, [1, 0, -1, 0, 0, 1, -2, 1, -2]), (925, 16, [1, 0, -1, 0, -2, 1, -2, 1, 1]), (925, 17, [0, 1, -1, 2, 2, -3, 1, -2, 1]), (923, 110, [1, -1, 0, -2, -1, 2, 0, -2, 1]), (923, 111, [1, -1, 0, -2, 1, 0, -1, 0, -1]), (925, 18, [1, -1, 1, -1, 0, 0, 2, 2, -1]), (925, 19, [0, -1, 1, 2, 0, -1, 1, 0, 0]), (925, 20, [1, -1, 0, -1, -2, 1, 2, 0, -1]), (923, 103, [1, 1, -1, -2, 1, 1, -1, 0, 1]), (925, 21, [1, 0, 0, -1, 1, -1, 2, -1, 0]), (925, 22, [1, 0, -1, -1, 1, 0, 1, 1, -1]), (925, 23, [1, -1, 0, -1, 0, 1, 1, 2, -2]), (925, 24, [1, 0, 0, -1, 2, -1, 2, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1143.TT) N1143.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1143.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1143. -/
theorem lines (t5 : List T5Rec) (h923 : ∀ p ∈ LinRQSC923.blobs, LinesCl t5 (t4OfRec p.1)) (h925 : ∀ p ∈ LinRQSC925.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1143.nT).map (t4At (LRSpectrumFull.L5S4.dg N1143.TT) N1143.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h923 p hp
  · exact h925 p hp
)

#print axioms lines

end R1143
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg861 : the lines clause for every class of the local table of rep #861 (generated by l5reg)

Every local class `i < nT` of rep #861 (15 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O861T
import LRSpectrumFull.L5S4.LinRQSC877
import LRSpectrumFull.L5S4.LinRQSC880

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R861
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(877, LinRQSC877.blobs), (880, LinRQSC880.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(880, 97, [1, 3, -1, 3, 0, -2, 1, 2, -1]), (880, 98, [1, 0, 0, 0, -1, 1, 0, 0, 1]), (880, 99, [0, 0, -1, 1, -1, 0, 0, -1, 0]), (880, 100, [1, 0, 0, 3, -2, -1, 3, -1, -1]), (880, 101, [3, -1, 1, 0, 0, 1, 1, 0, 1]), (880, 102, [3, 1, -2, 0, 3, -2, 1, 1, -1]), (880, 103, [3, -1, 0, 0, -3, 1, 1, 0, 0]), (877, 31, [3, 1, -2, 1, 3, -1, 2, -3, -1]), (880, 104, [1, 1, -1, 0, 1, 0, 0, -3, 1]), (880, 105, [3, 1, -2, 0, 1, 0, -1, -3, 1]), (880, 106, [1, 1, -1, 1, 0, -1, -3, 0, 2]), (880, 107, [3, -1, -1, 0, -1, 1, -1, 3, -2]), (880, 108, [3, 0, -1, 0, 2, -1, -1, 3, -1]), (880, 109, [3, 0, -1, 0, 2, -1, 2, 3, -2]), (880, 110, [1, 0, -1, 0, 2, -1, 0, 3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N861.TT) N861.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N861.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #861. -/
theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N861.nT).map (t4At (LRSpectrumFull.L5S4.dg N861.TT) N861.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h877 p hp
  · exact h880 p hp
)

#print axioms lines

end R861
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1275 : the lines clause for every class of the local table of rep #1275 (generated by l5reg)

Every local class `i < nT` of rep #1275 (23 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1275T
import LRSpectrumFull.L5S4.LinRQSC958
import LRSpectrumFull.L5S4.LinRQSC991

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1275
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(958, LinRQSC958.blobs), (991, LinRQSC991.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(991, 145, [2, 1, -1, 1, -3, 1, -3, 0, 1]), (991, 146, [1, 1, -1, 0, -3, 2, -3, -1, 2]), (991, 147, [2, -1, 0, 1, 3, -3, -1, -2, 2]), (991, 148, [2, -1, -1, 1, 3, -3, -2, -2, 3]), (991, 149, [2, 0, -1, 1, -1, 0, 2, 1, -2]), (991, 150, [2, 1, -1, 1, 0, 0, 3, -2, 1]), (991, 151, [2, -1, 0, 1, 3, -2, 0, -2, 1]), (991, 152, [1, 1, -1, -2, -3, 2, -3, 1, 2]), (991, 153, [1, 0, 0, -2, -1, 0, -3, 0, 1]), (958, 154, [1, 0, 0, 3, -1, 0, 2, -1, 1]), (991, 154, [1, 1, -1, -2, -3, 3, -2, 3, -2]), (991, 155, [1, 1, -1, -2, -3, 3, -3, 2, -1]), (991, 156, [2, 0, -1, 1, 1, -1, 0, 1, -1]), (991, 157, [2, 0, -1, 1, 1, 0, 0, 1, 0]), (991, 158, [1, 1, -1, -3, -2, 3, 3, -2, -2]), (991, 159, [1, 1, -1, -2, -3, 3, -3, 2, -1]), (991, 160, [1, 1, -1, -3, -2, 2, 3, -2, 1]), (991, 161, [1, -1, 0, -3, 2, 1, 1, 3, -3]), (991, 162, [1, 1, -1, -3, -2, 3, 3, -2, -2]), (991, 163, [1, 0, 0, -3, 1, 0, 3, 1, -1]), (991, 164, [1, 0, 0, -3, 1, 0, 3, 1, -1]), (991, 165, [1, -2, 1, -3, -1, 2, 2, -1, 0]), (991, 166, [1, 0, 0, -3, 1, 0, 3, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1275.TT) N1275.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1275.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1275. -/
theorem lines (t5 : List T5Rec) (h958 : ∀ p ∈ LinRQSC958.blobs, LinesCl t5 (t4OfRec p.1)) (h991 : ∀ p ∈ LinRQSC991.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1275.nT).map (t4At (LRSpectrumFull.L5S4.dg N1275.TT) N1275.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h958 p hp
  · exact h991 p hp
)

#print axioms lines

end R1275
end L5Reg
end LRSpectrumFull

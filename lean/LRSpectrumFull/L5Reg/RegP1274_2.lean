theorem lines (t5 : List T5Rec) (h949 : ∀ p ∈ LinRQSC949.blobs, LinesCl t5 (t4OfRec p.1)) (h961 : ∀ p ∈ LinRQSC961.blobs, LinesCl t5 (t4OfRec p.1)) (h990 : ∀ p ∈ LinRQSC990.blobs, LinesCl t5 (t4OfRec p.1)) (h991 : ∀ p ∈ LinRQSC991.blobs, LinesCl t5 (t4OfRec p.1))

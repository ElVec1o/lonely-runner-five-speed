/-- the lines clause for local classes 200..299 of rep #302. -/
theorem lines (t5 : List T5Rec) (h551 : ∀ p ∈ LinRQSC551.blobs, LinesCl t5 (t4OfRec p.1)) (h552 : ∀ p ∈ LinRQSC552.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N302.TT) N302.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl
    · exact h551 p hpe
    · exact h552 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


/-- the lines clause for local classes 100..199 of rep #162. -/
theorem lines (t5 : List T5Rec) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1)) (h89 : ∀ p ∈ LinRQSC89.blobs, LinesCl t5 (t4OfRec p.1)) (h159 : ∀ p ∈ LinRQSC159.blobs, LinesCl t5 (t4OfRec p.1)) (h171 : ∀ p ∈ LinRQSC171.blobs, LinesCl t5 (t4OfRec p.1)) (h172 : ∀ p ∈ LinRQSC172.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N162.TT) N162.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h36 p hpe
    · exact h89 p hpe
    · exact h159 p hpe
    · exact h171 p hpe
    · exact h172 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


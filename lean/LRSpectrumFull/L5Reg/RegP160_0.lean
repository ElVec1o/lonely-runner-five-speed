theorem lines (t5 : List T5Rec) (h44 : ∀ p ∈ LinRQSC44.blobs, LinesCl t5 (t4OfRec p.1)) (h103 : ∀ p ∈ LinRQSC103.blobs, LinesCl t5 (t4OfRec p.1)) (h104 : ∀ p ∈ LinRQSC104.blobs, LinesCl t5 (t4OfRec p.1)) (h164 : ∀ p ∈ LinRQSC164.blobs, LinesCl t5 (t4OfRec p.1)) (h165 : ∀ p ∈ LinRQSC165.blobs, LinesCl t5 (t4OfRec p.1))

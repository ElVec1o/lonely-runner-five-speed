theorem lines (t5 : List T5Rec) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1)) (h89 : ∀ p ∈ LinRQSC89.blobs, LinesCl t5 (t4OfRec p.1)) (h157 : ∀ p ∈ LinRQSC157.blobs, LinesCl t5 (t4OfRec p.1)) (h158 : ∀ p ∈ LinRQSC158.blobs, LinesCl t5 (t4OfRec p.1)) (h159 : ∀ p ∈ LinRQSC159.blobs, LinesCl t5 (t4OfRec p.1)) (h170 : ∀ p ∈ LinRQSC170.blobs, LinesCl t5 (t4OfRec p.1)) (h171 : ∀ p ∈ LinRQSC171.blobs, LinesCl t5 (t4OfRec p.1)) (h172 : ∀ p ∈ LinRQSC172.blobs, LinesCl t5 (t4OfRec p.1)) (h173 : ∀ p ∈ LinRQSC173.blobs, LinesCl t5 (t4OfRec p.1))

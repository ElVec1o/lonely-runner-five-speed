/-
# L5Reg.Reg1205 : the lines clause for every class of the local table of rep #1205 (generated by l5reg)

Every local class `i < nT` of rep #1205 (21 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1205T
import LRSpectrumFull.L5S4.LinRQSC955

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1205
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(955, LinRQSC955.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(955, 42, [2, -1, 0, -1, -1, 1, 2, 1, -1]), (955, 43, [2, -1, 0, -1, -1, 1, -2, -1, 1]), (955, 44, [2, -1, -1, -1, -1, 1, 2, 3, -2]), (955, 45, [2, 1, -1, -1, 3, -2, -2, 2, -1]), (955, 46, [1, 2, -2, 3, -1, -1, 2, 0, -1]), (955, 47, [2, -1, 0, -1, -3, 3, -2, 0, 1]), (955, 48, [2, 0, -1, -1, 0, 0, 2, 1, 0]), (955, 49, [1, 2, -1, 3, -1, -2, -1, -1, 1]), (955, 50, [2, 0, -1, -1, 0, 0, 3, 1, 0]), (955, 51, [1, 1, -1, 1, 3, -2, -3, 2, 0]), (955, 52, [1, 0, -1, -2, 1, 1, 4, -3, -2]), (955, 53, [1, -1, 0, -2, 1, 0, 4, -1, -1]), (955, 54, [1, 1, -1, 1, 3, -2, -3, 2, 0]), (955, 55, [1, 1, -1, -2, 3, -2, 2, 3, -3]), (955, 56, [1, -1, 0, 3, -2, 0, 0, 2, 1]), (955, 57, [1, 1, -1, 3, -2, -1, 0, 3, -1]), (955, 58, [1, -1, 0, 1, -2, 0, -4, 2, 1]), (955, 59, [1, 2, -2, 3, -1, -1, 1, -1, 0]), (955, 60, [1, -1, 0, 3, -1, -1, 2, 3, -2]), (955, 61, [1, 1, -1, 3, -2, -1, 3, 1, -2]), (955, 62, [1, 1, -1, 3, -2, -2, 2, 3, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1205.TT) N1205.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1205.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1205. -/
theorem lines (t5 : List T5Rec) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1205.nT).map (t4At (LRSpectrumFull.L5S4.dg N1205.TT) N1205.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h955 p hp
)

#print axioms lines

end R1205
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1018 : the lines clause for every class of the local table of rep #1018 (generated by l5reg)

Every local class `i < nT` of rep #1018 (40 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1018T
import LRSpectrumFull.L5S4.LinRQSC888
import LRSpectrumFull.L5S4.LinRQSC901
import LRSpectrumFull.L5S4.LinRQSC906

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1018
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(888, LinRQSC888.blobs), (901, LinRQSC901.blobs), (906, LinRQSC906.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(906, 59, [0, 1, 0, 3, 1, -1, -1, 3, 0]), (906, 60, [0, 1, 0, 3, 1, -2, -2, 2, 1]), (888, 211, [0, 1, 0, 0, 3, -1, 1, 1, -1]), (906, 61, [0, 1, 0, 1, 1, -1, 0, 3, -1]), (906, 62, [0, 1, 0, 3, 0, -1, -2, -1, 1]), (906, 63, [0, 2, -1, 3, 0, -2, -2, -1, 2]), (901, 171, [0, -1, 1, 2, 1, -2, 1, -1, 0]), (906, 64, [2, 0, -1, 0, 3, -2, -3, -2, 3]), (906, 65, [2, 0, -1, 0, 1, 0, -3, 0, 2]), (906, 66, [2, 0, -1, 0, 3, -2, -3, 1, 1]), (906, 67, [2, 0, -1, 0, 3, -1, -3, -1, 2]), (906, 68, [1, 0, 0, 0, 3, -1, -1, -2, 1]), (906, 69, [2, 0, -1, 0, -3, 2, -3, -1, 2]), (906, 70, [2, -1, 0, 0, 0, -1, -3, 1, 0]), (906, 71, [2, -1, -1, 0, 0, -1, -3, 1, 2]), (906, 72, [0, 2, -1, 3, 0, -2, -1, -3, 2]), (906, 73, [1, 0, -1, 0, 3, -1, -1, -1, 1]), (906, 74, [2, 0, -1, 0, 3, -1, -3, 1, 1]), (906, 75, [1, 0, 0, 0, 0, -1, -1, 1, -1]), (906, 76, [0, 0, -1, 3, -2, 1, 1, -1, 2]), (906, 77, [0, 1, 0, 3, 0, -1, -1, -1, 0]), (906, 78, [0, 2, -1, 3, 0, -1, -2, -1, 1]), (906, 79, [0, 1, 0, 3, 0, -2, -2, -1, 1]), (906, 80, [0, 1, 0, 3, 0, -1, -2, -1, 1]), (906, 81, [0, 2, -1, 3, 0, -1, -2, -1, 1]), (906, 82, [0, 2, -1, 1, 0, 0, 0, -1, 1]), (906, 83, [0, 2, -1, 3, 0, -2, -2, -1, 2]), (906, 84, [0, -2, 1, 3, 0, -2, -2, 1, 1]), (906, 85, [0, 1, 0, 3, 0, -1, -1, -1, 0]), (906, 86, [0, -1, 0, 3, 0, -2, 1, 1, -1]), (906, 87, [0, 0, -1, 3, -2, 1, 1, -1, 1]), (906, 88, [0, 2, -1, 3, 0, -1, -2, -1, 1]), (906, 89, [0, -2, 1, 3, 0, -1, -2, 1, 0]), (906, 90, [0, -2, 1, 3, 0, -1, -1, 1, 0]), (906, 91, [0, -2, 1, 3, 0, -2, -2, 1, 1]), (906, 92, [0, 0, -1, 1, 0, 0, 0, 1, 0]), (906, 93, [0, -2, -1, 1, 0, 0, 0, 1, 0]), (906, 94, [0, 0, 1, 0, -1, 0, 1, 0, 0]), (906, 95, [0, 0, 1, 0, -1, 1, 1, 0, 0]), (906, 96, [0, -1, 0, 0, 0, -1, 1, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1018.TT) N1018.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1018.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1018. -/
theorem lines (t5 : List T5Rec) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1018.nT).map (t4At (LRSpectrumFull.L5S4.dg N1018.TT) N1018.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h888 p hp
  · exact h901 p hp
  · exact h906 p hp
)

#print axioms lines

end R1018
end L5Reg
end LRSpectrumFull

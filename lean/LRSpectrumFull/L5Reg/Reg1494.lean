/-
# L5Reg.Reg1494 : the lines clause for every class of the local table of rep #1494 (generated by l5reg)

Every local class `i < nT` of rep #1494 (15 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1494T
import LRSpectrumFull.L5S4.LinRQSC1025
import LRSpectrumFull.L5S4.LinRQSC1026

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1494
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1025, LinRQSC1025.blobs), (1026, LinRQSC1026.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1026, 100, [1, 2, -2, 2, -1, -1, -2, -2, 3]), (1025, 297, [1, -2, 0, -1, -2, 1, 2, -1, -1]), (1026, 101, [1, 0, 0, 2, -1, -1, 1, -1, 0]), (1026, 102, [1, 1, -1, 2, 1, -2, -3, 0, 2]), (1025, 328, [0, 2, -1, 1, -2, 0, 3, 1, -3]), (1025, 331, [0, 1, 0, 1, 2, -1, 3, 1, -2]), (1026, 103, [0, 1, -1, 2, 1, -2, 3, 0, -1]), (1026, 104, [2, -1, -1, -1, -1, 1, 2, 1, -2]), (1026, 105, [0, 2, -1, 2, 1, -2, 3, 0, -2]), (1026, 106, [2, 0, -1, -1, 1, -1, 3, -2, 1]), (1026, 107, [2, 0, -1, -1, 2, 0, 2, 1, -1]), (1026, 108, [0, 2, -1, 2, -1, -1, 1, 3, -2]), (1026, 109, [0, -2, 1, 2, 1, -2, 3, 0, -2]), (1026, 110, [2, -1, 0, -1, -1, 1, 2, 1, -1]), (1026, 111, [2, 0, -1, -1, 2, 0, 0, 3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1494.TT) N1494.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1494.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1494. -/
theorem lines (t5 : List T5Rec) (h1025 : ∀ p ∈ LinRQSC1025.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1494.nT).map (t4At (LRSpectrumFull.L5S4.dg N1494.TT) N1494.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1025 p hp
  · exact h1026 p hp
)

#print axioms lines

end R1494
end L5Reg
end LRSpectrumFull

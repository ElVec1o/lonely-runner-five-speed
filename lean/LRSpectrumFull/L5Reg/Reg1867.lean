/-
# L5Reg.Reg1867 : the lines clause for every class of the local table of rep #1867 (generated by l5reg)

Every local class `i < nT` of rep #1867 (12 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1867T
import LRSpectrumFull.L5S4.LinRQSC1048
import LRSpectrumFull.L5S4.LinRQSC1049

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1867
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1048, LinRQSC1048.blobs), (1049, LinRQSC1049.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1049, 152, [1, -2, 1, 3, 2, -2, -2, 1, 0]), (1049, 153, [1, -1, 0, 3, 0, -2, 0, -1, 1]), (1049, 154, [2, 1, -2, 0, 3, -1, 3, -2, -2]), (1048, 110, [1, -1, 0, 1, 0, -1, 0, 0, 1]), (1049, 155, [1, 1, -1, 3, 0, -1, 1, 2, -2]), (1049, 156, [1, -1, 0, 3, 0, -2, 0, -1, 1]), (1049, 157, [1, 2, -2, 3, 0, -1, 1, 3, -3]), (1049, 158, [1, 1, -1, 3, 0, -1, -2, -1, 1]), (1048, 149, [1, 1, -1, 3, 1, -2, 0, -3, 2]), (1049, 159, [1, 1, -1, 3, 0, -2, 0, 1, 0]), (1049, 160, [1, -1, 0, 3, 0, -2, -2, -3, 3]), (1049, 161, [1, 1, -1, 0, 3, -2, 3, -2, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1867.TT) N1867.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1867.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1867. -/
theorem lines (t5 : List T5Rec) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1)) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1867.nT).map (t4At (LRSpectrumFull.L5S4.dg N1867.TT) N1867.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1048 p hp
  · exact h1049 p hp
)

#print axioms lines

end R1867
end L5Reg
end LRSpectrumFull

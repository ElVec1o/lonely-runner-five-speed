theorem lines (t5 : List T5Rec) (h486 : ∀ p ∈ LinRQSC486.blobs, LinesCl t5 (t4OfRec p.1)) (h487 : ∀ p ∈ LinRQSC487.blobs, LinesCl t5 (t4OfRec p.1)) (h712 : ∀ p ∈ LinRQSC712.blobs, LinesCl t5 (t4OfRec p.1)) (h713 : ∀ p ∈ LinRQSC713.blobs, LinesCl t5 (t4OfRec p.1)) (h767 : ∀ p ∈ LinRQSC767.blobs, LinesCl t5 (t4OfRec p.1)) (h768 : ∀ p ∈ LinRQSC768.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N520.TT) N520.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl
    · exact h486 p hpe
    · exact h487 p hpe
    · exact h712 p hpe
    · exact h713 p hpe
    · exact h767 p hpe
    · exact h768 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


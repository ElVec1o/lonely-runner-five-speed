/-
# L5Reg.Reg41 : the lines clause for every class of the local table of rep #41 (generated by l5reg)

Every local class `i < nT` of rep #41 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O41T
import LRSpectrumFull.L5S4.LinRQSC29

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R41
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(29, LinRQSC29.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(29, 42, [0, -2, 1, 0, 1, 0, -1, 0, 1]), (29, 43, [2, -1, -1, -1, 2, 0, 2, -2, -1]), (29, 44, [2, 1, -1, -1, 4, -3, 2, -3, 2]), (29, 45, [2, 1, -2, -1, 4, -3, -1, 3, -2]), (29, 46, [2, -1, 0, -1, 1, 0, 0, 0, -1]), (29, 47, [2, 1, -2, -1, 4, 0, 1, 0, -1]), (29, 48, [2, 0, -1, -1, 0, 1, 1, -1, 0]), (29, 49, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (29, 50, [2, 0, -1, -1, 0, 1, 0, -1, 1]), (29, 51, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (29, 52, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (29, 53, [2, 0, -1, -1, 0, 1, -2, -1, 2]), (29, 54, [2, 0, -1, -1, 0, 1, 0, -1, 1]), (29, 55, [2, 0, -1, -1, 0, 1, 0, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N41.TT) N41.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N41.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #41. -/
theorem lines (t5 : List T5Rec) (h29 : ∀ p ∈ LinRQSC29.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N41.nT).map (t4At (LRSpectrumFull.L5S4.dg N41.TT) N41.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h29 p hp
)

#print axioms lines

end R41
end L5Reg
end LRSpectrumFull

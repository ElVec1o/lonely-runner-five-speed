/-
# L5Reg.Reg1156 : the lines clause for every class of the local table of rep #1156 (generated by l5reg)

Every local class `i < nT` of rep #1156 (37 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1156T
import LRSpectrumFull.L5S4.LinRQSC930
import LRSpectrumFull.L5S4.LinRQSC931

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1156
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(930, LinRQSC930.blobs), (931, LinRQSC931.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(930, 81, [2, -1, 0, 2, 2, -1, -1, 1, 0]), (930, 82, [1, -1, 0, 1, 2, -1, 0, 2, -1]), (930, 83, [1, 1, -1, 1, -1, 0, 0, 3, -2]), (930, 84, [1, 0, 0, 1, -1, 0, -1, 0, 1]), (930, 85, [2, 1, -2, 2, -1, -1, -1, 3, -1]), (930, 86, [2, 1, -1, 2, -1, 0, 1, 3, -2]), (930, 87, [1, 0, 0, 1, -1, 0, -1, 2, -1]), (930, 88, [2, -1, -1, 2, 2, -3, -1, 1, 0]), (930, 89, [2, -1, -1, 2, -2, -1, -1, 0, 1]), (930, 90, [2, 1, -2, 2, -2, -1, 1, -2, 0]), (930, 91, [1, 0, 0, 1, -1, 0, 0, -1, 1]), (930, 92, [2, 1, -1, 2, -2, 1, -1, -1, 1]), (930, 93, [1, 1, -1, 1, -2, 0, -1, -2, 1]), (930, 94, [1, 1, -1, 1, -2, 1, 0, -2, 1]), (930, 95, [2, -1, -1, 2, 2, -3, -1, 1, 0]), (930, 96, [2, 1, -2, 2, -2, -1, 1, -3, 0]), (930, 97, [2, 1, -1, 2, -2, 1, 1, -3, 2]), (930, 98, [1, 1, -1, 1, -2, 0, 0, -2, 1]), (930, 99, [2, 1, -1, 2, -2, 1, 1, -3, 2]), (930, 100, [1, 0, 0, 1, -1, 0, 0, -1, -1]), (930, 101, [1, 1, -1, 1, -2, 0, -1, -2, 1]), (930, 102, [2, 1, -2, 2, -2, -1, 1, -3, 0]), (930, 103, [2, -1, -1, 2, -2, -1, -1, 0, 1]), (930, 104, [2, 1, -2, 2, -2, -1, -1, -3, 2]), (930, 105, [2, 1, -2, 2, -2, -1, 1, -3, 0]), (930, 106, [2, -1, 0, 2, -2, 1, -1, 0, 0]), (930, 107, [1, -1, 0, 1, 2, -1, 0, 2, -1]), (930, 108, [1, -1, 0, 1, 0, 0, 0, 1, -1]), (930, 109, [1, 0, -1, 1, 0, 0, 0, -1, 2]), (930, 110, [2, -1, 0, 2, -1, 1, -1, 0, 1]), (930, 111, [2, -1, -1, 2, -1, 0, 1, -1, 1]), (930, 112, [1, 0, 0, -2, 2, -1, -2, 1, 0]), (930, 113, [1, -2, 1, -2, -2, 3, -3, 1, 1]), (930, 114, [1, -2, 0, -2, -2, 1, -3, -1, 1]), (930, 115, [1, -1, 0, -2, -1, 1, -4, 0, 1]), (930, 116, [1, -1, 0, 1, 2, -1, 0, 2, -1]), (931, 0, [1, -1, 0, 1, 0, 0, 0, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1156.TT) N1156.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1156.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1156. -/
theorem lines (t5 : List T5Rec) (h930 : ∀ p ∈ LinRQSC930.blobs, LinesCl t5 (t4OfRec p.1)) (h931 : ∀ p ∈ LinRQSC931.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1156.nT).map (t4At (LRSpectrumFull.L5S4.dg N1156.TT) N1156.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h930 p hp
  · exact h931 p hp
)

#print axioms lines

end R1156
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg385 : the lines clause for every class of the local table of rep #385 (generated by l5reg)

Every local class `i < nT` of rep #385 (8 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O385T
import LRSpectrumFull.L5S4.LinRQSC725

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R385
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(725, LinRQSC725.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(725, 108, [1, 0, -1, -1, -5, 3, 4, -2, -3]), (725, 109, [1, 0, -1, -1, -5, 4, 4, 2, -5]), (725, 110, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (725, 111, [1, 0, -1, -1, 5, -1, 4, 3, -5]), (725, 112, [1, 0, -1, -1, 1, 0, 4, 0, -3]), (725, 113, [0, 1, 0, 5, -1, -3, 3, 4, -2]), (725, 114, [0, 1, 0, 5, 1, -4, -1, -4, 1]), (725, 115, [0, 1, 0, 1, 1, -1, 0, -4, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N385.TT) N385.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N385.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #385. -/
theorem lines (t5 : List T5Rec) (h725 : ∀ p ∈ LinRQSC725.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N385.nT).map (t4At (LRSpectrumFull.L5S4.dg N385.TT) N385.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h725 p hp
)

#print axioms lines

end R385
end L5Reg
end LRSpectrumFull

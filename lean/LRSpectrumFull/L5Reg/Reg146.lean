theorem lines (t5 : List T5Rec) (h142 : ∀ p ∈ LinRQSC142.blobs, LinesCl t5 (t4OfRec p.1)) (h143 : ∀ p ∈ LinRQSC143.blobs, LinesCl t5 (t4OfRec p.1)) (h144 : ∀ p ∈ LinRQSC144.blobs, LinesCl t5 (t4OfRec p.1))

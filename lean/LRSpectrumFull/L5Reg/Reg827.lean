/-
# L5Reg.Reg827 : the lines clause for every class of the local table of rep #827 (generated by l5reg)

Every local class `i < nT` of rep #827 (5 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O827T
import LRSpectrumFull.L5S4.LinRQSC872
import LRSpectrumFull.L5S4.LinRQSC874
import LRSpectrumFull.L5S4.LinRQSC875
import LRSpectrumFull.L5S4.LinRQSC876

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R827
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(872, LinRQSC872.blobs), (874, LinRQSC874.blobs), (875, LinRQSC875.blobs), (876, LinRQSC876.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(874, 154, [2, 0, -1, -2, 1, 0, 1, 2, -2]), (872, 154, [0, -1, 0, -3, 0, 1, 2, -1, -1]), (876, 201, [0, -2, 1, -2, 1, 1, 3, 0, -2]), (876, 202, [0, 2, -1, -2, -1, 1, 1, 0, 0]), (875, 117, [0, -2, 1, -1, 1, 0, 2, 1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N827.TT) N827.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N827.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #827. -/
theorem lines (t5 : List T5Rec) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1)) (h874 : ∀ p ∈ LinRQSC874.blobs, LinesCl t5 (t4OfRec p.1)) (h875 : ∀ p ∈ LinRQSC875.blobs, LinesCl t5 (t4OfRec p.1)) (h876 : ∀ p ∈ LinRQSC876.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N827.nT).map (t4At (LRSpectrumFull.L5S4.dg N827.TT) N827.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h872 p hp
  · exact h874 p hp
  · exact h875 p hp
  · exact h876 p hp
)

#print axioms lines

end R827
end L5Reg
end LRSpectrumFull

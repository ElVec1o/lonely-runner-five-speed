/-- the lines clause for every class of the local table of rep #62. -/
theorem lines (t5 : List T5Rec) (h40 : ∀ p ∈ LinRQSC40.blobs, LinesCl t5 (t4OfRec p.1)) (h41 : ∀ p ∈ LinRQSC41.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N62.nT).map (t4At (LRSpectrumFull.L5S4.dg N62.TT) N62.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h40 p hp
  · exact h41 p hp
)


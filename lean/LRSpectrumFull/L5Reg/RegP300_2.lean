/-- the lines clause for local classes 200..299 of rep #300. -/
theorem lines (t5 : List T5Rec) (h503 : ∀ p ∈ LinRQSC503.blobs, LinesCl t5 (t4OfRec p.1)) (h504 : ∀ p ∈ LinRQSC504.blobs, LinesCl t5 (t4OfRec p.1)) (h505 : ∀ p ∈ LinRQSC505.blobs, LinesCl t5 (t4OfRec p.1)) (h506 : ∀ p ∈ LinRQSC506.blobs, LinesCl t5 (t4OfRec p.1)) (h507 : ∀ p ∈ LinRQSC507.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N300.TT) N300.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h503 p hpe
    · exact h504 p hpe
    · exact h505 p hpe
    · exact h506 p hpe
    · exact h507 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


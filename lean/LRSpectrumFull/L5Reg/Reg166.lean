theorem lines (t5 : List T5Rec) (h28 : ∀ p ∈ LinRQSC28.blobs, LinesCl t5 (t4OfRec p.1)) (h183 : ∀ p ∈ LinRQSC183.blobs, LinesCl t5 (t4OfRec p.1)) (h184 : ∀ p ∈ LinRQSC184.blobs, LinesCl t5 (t4OfRec p.1)) (h185 : ∀ p ∈ LinRQSC185.blobs, LinesCl t5 (t4OfRec p.1))

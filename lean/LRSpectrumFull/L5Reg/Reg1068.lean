/-- the lines clause for every class of the local table of rep #1068. -/
theorem lines (t5 : List T5Rec) (h915 : ∀ p ∈ LinRQSC915.blobs, LinesCl t5 (t4OfRec p.1)) (h916 : ∀ p ∈ LinRQSC916.blobs, LinesCl t5 (t4OfRec p.1))

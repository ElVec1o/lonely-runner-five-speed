/-
# L5Reg.RegFin82 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg516
import LRSpectrumFull.L5Reg.Reg555
import LRSpectrumFull.L5Reg.Reg524

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines516 : ∀ cl ∈ (List.range N516.nT).map (t4At (LRSpectrumFull.L5S4.dg N516.TT) N516.ST), LinesCl T5Store.t5 cl :=
  R516.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem444 p hp)) (fun p hp => FinalGlue.glines p (mem705 p hp)) (fun p hp => FinalGlue.glines p (mem727 p hp)) (fun p hp => FinalGlue.glines p (mem728 p hp)) (fun p hp => FinalGlue.glines p (mem758 p hp))

theorem lines555 : ∀ cl ∈ (List.range N555.nT).map (t4At (LRSpectrumFull.L5S4.dg N555.TT) N555.ST), LinesCl T5Store.t5 cl :=

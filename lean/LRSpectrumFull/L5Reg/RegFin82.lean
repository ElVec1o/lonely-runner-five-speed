theorem lines524 : ∀ cl ∈ (List.range N524.nT).map (t4At (LRSpectrumFull.L5S4.dg N524.TT) N524.ST), LinesCl T5Store.t5 cl :=
  R524.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem787 p hp)) (fun p hp => FinalGlue.glines p (mem788 p hp)) (fun p hp => FinalGlue.glines p (mem789 p hp)) (fun p hp => FinalGlue.glines p (mem790 p hp))

#print axioms lines516


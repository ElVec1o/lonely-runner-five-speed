/-
# L5Reg.Reg1138 : the lines clause for every class of the local table of rep #1138 (generated by l5reg)

Every local class `i < nT` of rep #1138 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1138T
import LRSpectrumFull.L5S4.LinRQSC924

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1138
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(924, LinRQSC924.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(924, 132, [1, 0, -1, 1, -1, 0, 0, 0, 1]), (924, 133, [1, 1, -1, 0, -1, 0, -2, 0, 1]), (924, 134, [1, -1, 0, 0, 1, 0, -2, 0, 1]), (924, 135, [1, 0, 1, 1, -1, -1, -1, 0, 0]), (924, 136, [0, -1, 1, 1, 0, 0, -2, 0, 1]), (924, 137, [0, 1, -1, 1, 1, -1, -2, -1, 2]), (924, 138, [1, 0, 0, 1, -1, 0, 1, 2, -1]), (924, 139, [1, 0, 0, 1, -1, 0, 1, 1, -1]), (924, 140, [1, -1, 0, -1, 0, 0, -1, -1, 1]), (924, 141, [1, 1, -1, -1, 0, 0, -2, 0, 1]), (924, 142, [1, 0, 0, 1, 1, -1, 0, -2, 1]), (924, 143, [1, 0, 0, 1, 1, -1, 1, -1, 0]), (924, 144, [1, 0, 0, -1, 0, 1, -2, 1, -1]), (924, 145, [1, -1, -1, -1, 0, 1, -2, 1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1138.TT) N1138.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1138.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1138. -/
theorem lines (t5 : List T5Rec) (h924 : ∀ p ∈ LinRQSC924.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1138.nT).map (t4At (LRSpectrumFull.L5S4.dg N1138.TT) N1138.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h924 p hp
)

#print axioms lines

end R1138
end L5Reg
end LRSpectrumFull

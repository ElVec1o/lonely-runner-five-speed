/-- the lines clause for local classes 100..199 of rep #135. -/
theorem lines (t5 : List T5Rec) (h85 : ∀ p ∈ LinRQSC85.blobs, LinesCl t5 (t4OfRec p.1)) (h86 : ∀ p ∈ LinRQSC86.blobs, LinesCl t5 (t4OfRec p.1)) (h99 : ∀ p ∈ LinRQSC99.blobs, LinesCl t5 (t4OfRec p.1)) (h121 : ∀ p ∈ LinRQSC121.blobs, LinesCl t5 (t4OfRec p.1)) (h122 : ∀ p ∈ LinRQSC122.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N135.TT) N135.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h85 p hpe
    · exact h86 p hpe
    · exact h99 p hpe
    · exact h121 p hpe
    · exact h122 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


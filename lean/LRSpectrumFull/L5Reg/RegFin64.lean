/-
# L5Reg.RegFin64 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg951
import LRSpectrumFull.L5Reg.Reg558

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines951 : ∀ cl ∈ (List.range N951.nT).map (t4At (LRSpectrumFull.L5S4.dg N951.TT) N951.ST), LinesCl T5Store.t5 cl :=
  R951.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem888 p hp)) (fun p hp => FinalGlue.glines p (mem889 p hp))

theorem lines558 : ∀ cl ∈ (List.range N558.nT).map (t4At (LRSpectrumFull.L5S4.dg N558.TT) N558.ST), LinesCl T5Store.t5 cl :=
  R558.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem836 p hp)) (fun p hp => FinalGlue.glines p (mem837 p hp))

#print axioms lines951

end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg646 : the lines clause for every class of the local table of rep #646 (generated by l5reg)

Every local class `i < nT` of rep #646 (17 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O646T
import LRSpectrumFull.L5S4.LinRQSC853

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R646
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(853, LinRQSC853.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(853, 44, [1, -1, 0, 0, 3, -2, -4, -3, 5]), (853, 45, [1, -1, 0, -3, 0, 2, 1, 4, -3]), (853, 46, [1, -1, 0, -3, 0, 2, 3, 4, -5]), (853, 47, [1, -1, 0, -3, 0, 2, 4, 3, -5]), (853, 48, [1, 0, -1, -3, -2, 4, 2, -3, 0]), (853, 49, [1, 0, -1, -3, 2, 2, 1, 3, -2]), (853, 50, [1, 0, -1, -3, 2, 2, 2, 3, -3]), (853, 51, [1, 0, -1, -3, 1, 2, 4, 1, -4]), (853, 52, [1, 0, 0, 3, -1, 2, 1, 2, -3]), (853, 53, [1, 0, 0, 3, 2, -1, 1, -3, 2]), (853, 54, [1, 0, -1, 3, 2, -4, 4, -1, -3]), (853, 55, [1, -1, 0, 3, 0, -2, 2, 3, -3]), (853, 56, [1, 0, -1, 3, -2, -2, 1, 3, -2]), (853, 57, [1, -1, 0, 3, -2, 0, 2, 0, -1]), (853, 58, [1, 0, -1, 0, 1, -1, -4, 0, 3]), (853, 59, [1, 0, -1, 0, 2, -1, -4, -1, 4]), (853, 60, [1, -1, 0, 0, -3, 2, -4, -3, 5])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N646.TT) N646.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N646.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #646. -/
theorem lines (t5 : List T5Rec) (h853 : ∀ p ∈ LinRQSC853.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N646.nT).map (t4At (LRSpectrumFull.L5S4.dg N646.TT) N646.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h853 p hp
)

#print axioms lines

end R646
end L5Reg
end LRSpectrumFull

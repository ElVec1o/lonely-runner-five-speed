/-
# L5Reg.Reg1293 : the lines clause for every class of the local table of rep #1293 (generated by l5reg)

Every local class `i < nT` of rep #1293 (23 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1293T
import LRSpectrumFull.L5S4.LinRQSC1003

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1293
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1003, LinRQSC1003.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1003, 30, [2, -1, 0, 2, 2, -1, -1, 0, 0]), (1003, 31, [2, 1, -1, 2, -2, 1, 1, 0, 0]), (1003, 32, [2, -1, 0, 2, 0, -1, -1, 0, 0]), (1003, 33, [2, -1, 0, 2, -2, 1, -1, 1, 0]), (1003, 34, [2, 0, -1, 2, -1, 0, 1, -4, 3]), (1003, 35, [1, -2, 1, -1, -2, 2, -4, -1, 3]), (1003, 36, [2, -1, 0, 2, 2, -1, -1, -2, 1]), (1003, 37, [2, -1, -1, 2, 2, -3, -1, -2, 2]), (1003, 38, [1, -1, -1, 1, 2, 0, 1, 1, 0]), (1003, 39, [2, -1, -1, 2, -2, -1, 1, -1, 0]), (1003, 40, [1, -1, 0, 1, 2, -1, -1, 0, 0]), (1003, 41, [1, 1, -1, 1, -2, 0, 0, -1, 0]), (1003, 42, [2, -1, 0, 2, -2, 1, 1, -1, 0]), (1003, 43, [2, 0, -1, 2, 1, -1, 1, -3, 0]), (1003, 44, [1, -1, 0, 1, 2, -1, -1, 0, 0]), (1003, 45, [1, -1, 0, 1, 2, -1, 1, 0, 0]), (1003, 46, [1, 0, 0, 1, -1, 0, 0, 3, -1]), (1003, 47, [2, -1, -1, 2, 1, -2, 1, -3, 1]), (1003, 48, [2, 1, -1, 2, -1, 0, -1, 3, -1]), (1003, 49, [2, 1, -1, 2, -2, 1, 1, 0, 0]), (1003, 50, [1, 1, -1, 1, -2, 1, 0, 2, -1]), (1003, 51, [2, 1, -1, 2, -1, 0, -1, 3, -1]), (1003, 52, [2, 0, -1, 2, 1, -2, -1, -3, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1293.TT) N1293.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1293.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1293. -/
theorem lines (t5 : List T5Rec) (h1003 : ∀ p ∈ LinRQSC1003.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1293.nT).map (t4At (LRSpectrumFull.L5S4.dg N1293.TT) N1293.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1003 p hp
)

#print axioms lines

end R1293
end L5Reg
end LRSpectrumFull

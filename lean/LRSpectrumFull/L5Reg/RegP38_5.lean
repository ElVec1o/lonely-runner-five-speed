/-
# L5Reg.RegP38_5 : part 5 of the lines clause of rep #38: local classes 500..503 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O38T
import LRSpectrumFull.L5S4.LinRQSC27

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P38_5
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(27, LinRQSC27.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(27, 24, [2, -1, 1, -2, 1, 0, -1, 0, 0]), (27, 25, [2, -1, 0, -2, 1, 1, 1, -1, 0]), (27, 26, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (27, 27, [2, -1, 1, -2, 1, 0, -1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N38.TT) N38.ST (assoc bls) 500 adv = true := by decide +kernel

theorem adv_len : adv.length = 4 := by decide +kernel

/-- the lines clause for local classes 500..503 of rep #38. -/
theorem lines (t5 : List T5Rec) (h27 : ∀ p ∈ LinRQSC27.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 500 ≤ c → c < 500 + 4 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N38.TT) N38.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h27 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 500 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P38_5
end L5Reg
end LRSpectrumFull

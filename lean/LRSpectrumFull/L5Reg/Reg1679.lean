/-- the lines clause for every class of the local table of rep #1679. -/
theorem lines (t5 : List T5Rec) (h1028 : ∀ p ∈ LinRQSC1028.blobs, LinesCl t5 (t4OfRec p.1)) (h1029 : ∀ p ∈ LinRQSC1029.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1679.nT).map (t4At (LRSpectrumFull.L5S4.dg N1679.TT) N1679.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1028 p hp
  · exact h1029 p hp
)


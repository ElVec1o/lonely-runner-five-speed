theorem lines (t5 : List T5Rec) (h940 : ∀ p ∈ LinRQSC940.blobs, LinesCl t5 (t4OfRec p.1)) (h943 : ∀ p ∈ LinRQSC943.blobs, LinesCl t5 (t4OfRec p.1)) (h967 : ∀ p ∈ LinRQSC967.blobs, LinesCl t5 (t4OfRec p.1)) (h968 : ∀ p ∈ LinRQSC968.blobs, LinesCl t5 (t4OfRec p.1)) (h995 : ∀ p ∈ LinRQSC995.blobs, LinesCl t5 (t4OfRec p.1)) (h1012 : ∀ p ∈ LinRQSC1012.blobs, LinesCl t5 (t4OfRec p.1)) (h1021 : ∀ p ∈ LinRQSC1021.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1352.nT).map (t4At (LRSpectrumFull.L5S4.dg N1352.TT) N1352.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h940 p hp
  · exact h943 p hp
  · exact h967 p hp
  · exact h968 p hp
  · exact h995 p hp
  · exact h1012 p hp
  · exact h1021 p hp
)


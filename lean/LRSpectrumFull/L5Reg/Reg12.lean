/-
# L5Reg.Reg12 : the lines clause for every class of the local table of rep #12 (generated by l5reg)

Every local class `i < nT` of rep #12 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O12T
import LRSpectrumFull.L5S4.LinRQSC0

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R12
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(0, LinRQSC0.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(0, 184, [1, 1, -1, 0, -1, 1, 1, -1, 0]), (0, 185, [1, 1, -1, 0, -1, 1, 1, -2, 1]), (0, 186, [0, 1, -1, -2, 0, 1, 1, 1, -1]), (0, 187, [0, 1, -1, -1, 0, 1, 1, 1, -1]), (0, 188, [0, 0, -1, -2, 1, 0, -1, 1, 1]), (0, 189, [0, -1, 1, -1, 0, 0, 0, 1, 0]), (0, 190, [0, 1, -1, -1, 0, 1, 0, -2, 1]), (0, 191, [1, 0, 0, 0, -2, 1, -2, -1, 1]), (0, 192, [0, -1, 1, 1, 0, -1, -2, 0, 1]), (0, 193, [1, 1, -1, 0, -1, 1, -2, 1, 0]), (0, 194, [0, -1, 1, -2, 0, 1, -1, 1, 0]), (0, 195, [0, -1, 1, -1, 0, 0, 0, 1, 0]), (0, 196, [0, 0, -1, -2, 1, 0, -1, 0, 0]), (0, 197, [0, 0, -1, 0, 1, 0, 1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N12.TT) N12.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N12.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #12. -/
theorem lines (t5 : List T5Rec) (h0 : ∀ p ∈ LinRQSC0.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N12.nT).map (t4At (LRSpectrumFull.L5S4.dg N12.TT) N12.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h0 p hp
)

#print axioms lines

end R12
end L5Reg
end LRSpectrumFull

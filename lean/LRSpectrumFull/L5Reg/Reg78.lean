/-- the lines clause for every class of the local table of rep #78. -/
theorem lines (t5 : List T5Rec) (h9 : ∀ p ∈ LinRQSC9.blobs, LinesCl t5 (t4OfRec p.1)) (h68 : ∀ p ∈ LinRQSC68.blobs, LinesCl t5 (t4OfRec p.1)) (h69 : ∀ p ∈ LinRQSC69.blobs, LinesCl t5 (t4OfRec p.1)) (h70 : ∀ p ∈ LinRQSC70.blobs, LinesCl t5 (t4OfRec p.1)) (h71 : ∀ p ∈ LinRQSC71.blobs, LinesCl t5 (t4OfRec p.1)) (h72 : ∀ p ∈ LinRQSC72.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N78.nT).map (t4At (LRSpectrumFull.L5S4.dg N78.TT) N78.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N78.nT := List.mem_range.1 hc
  have hn : N78.nT = 382 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 382) := by omega
  rcases hcase with h | h | h | h
  · exact P78_0.lines t5 h9 h68 h69 c h.1 (by omega)
  · exact P78_1.lines t5 h69 h70 c h.1 (by omega)
  · exact P78_2.lines t5 h70 h71 c h.1 (by omega)
  · exact P78_3.lines t5 h71 h72 c h.1 (by omega)

#print axioms lines


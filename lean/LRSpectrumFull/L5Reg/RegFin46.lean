/-
# L5Reg.RegFin46 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg745
import LRSpectrumFull.L5Reg.Reg1164

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines745 : ∀ cl ∈ (List.range N745.nT).map (t4At (LRSpectrumFull.L5S4.dg N745.TT) N745.ST), LinesCl T5Store.t5 cl :=
  R745.lines T5Store.t5 

theorem lines1164 : ∀ cl ∈ (List.range N1164.nT).map (t4At (LRSpectrumFull.L5S4.dg N1164.TT) N1164.ST), LinesCl T5Store.t5 cl :=
  R1164.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem933 p hp)) (fun p hp => FinalGlue.glines p (mem934 p hp))

#print axioms lines745

end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h883 : ∀ p ∈ LinRQSC883.blobs, LinesCl t5 (t4OfRec p.1)) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1)) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1))

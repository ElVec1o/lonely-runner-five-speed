/-- the lines clause for local classes 500..599 of rep #296. -/
theorem lines (t5 : List T5Rec) (h475 : ∀ p ∈ LinRQSC475.blobs, LinesCl t5 (t4OfRec p.1)) (h476 : ∀ p ∈ LinRQSC476.blobs, LinesCl t5 (t4OfRec p.1)) (h477 : ∀ p ∈ LinRQSC477.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 500 ≤ c → c < 500 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N296.TT) N296.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h475 p hpe
    · exact h476 p hpe
    · exact h477 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 500 advOk c h1 ?_
  rw [adv_len]; exact h2


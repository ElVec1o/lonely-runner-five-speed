theorem lines (t5 : List T5Rec) (h717 : ∀ p ∈ LinRQSC717.blobs, LinesCl t5 (t4OfRec p.1)) (h776 : ∀ p ∈ LinRQSC776.blobs, LinesCl t5 (t4OfRec p.1)) (h777 : ∀ p ∈ LinRQSC777.blobs, LinesCl t5 (t4OfRec p.1)) (h778 : ∀ p ∈ LinRQSC778.blobs, LinesCl t5 (t4OfRec p.1)) (h779 : ∀ p ∈ LinRQSC779.blobs, LinesCl t5 (t4OfRec p.1)) (h780 : ∀ p ∈ LinRQSC780.blobs, LinesCl t5 (t4OfRec p.1))

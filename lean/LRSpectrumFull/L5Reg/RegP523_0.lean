theorem lines (t5 : List T5Rec) (h492 : ∀ p ∈ LinRQSC492.blobs, LinesCl t5 (t4OfRec p.1)) (h719 : ∀ p ∈ LinRQSC719.blobs, LinesCl t5 (t4OfRec p.1)) (h780 : ∀ p ∈ LinRQSC780.blobs, LinesCl t5 (t4OfRec p.1)) (h781 : ∀ p ∈ LinRQSC781.blobs, LinesCl t5 (t4OfRec p.1))

/-- the lines clause for every class of the local table of rep #1236. -/
theorem lines (t5 : List T5Rec) (h930 : ∀ p ∈ LinRQSC930.blobs, LinesCl t5 (t4OfRec p.1)) (h933 : ∀ p ∈ LinRQSC933.blobs, LinesCl t5 (t4OfRec p.1)) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1236.nT).map (t4At (LRSpectrumFull.L5S4.dg N1236.TT) N1236.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h930 p hp
  · exact h933 p hp
  · exact h955 p hp
  · exact h959 p hp
)


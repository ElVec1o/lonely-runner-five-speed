theorem lines (t5 : List T5Rec) (h492 : ∀ p ∈ LinRQSC492.blobs, LinesCl t5 (t4OfRec p.1)) (h493 : ∀ p ∈ LinRQSC493.blobs, LinesCl t5 (t4OfRec p.1)) (h718 : ∀ p ∈ LinRQSC718.blobs, LinesCl t5 (t4OfRec p.1)) (h783 : ∀ p ∈ LinRQSC783.blobs, LinesCl t5 (t4OfRec p.1)) (h784 : ∀ p ∈ LinRQSC784.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N523.TT) N523.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h492 p hpe
    · exact h493 p hpe
    · exact h718 p hpe
    · exact h783 p hpe
    · exact h784 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


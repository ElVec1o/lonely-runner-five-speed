/-- the lines clause for local classes 300..399 of rep #300. -/
theorem lines (t5 : List T5Rec) (h507 : ∀ p ∈ LinRQSC507.blobs, LinesCl t5 (t4OfRec p.1)) (h508 : ∀ p ∈ LinRQSC508.blobs, LinesCl t5 (t4OfRec p.1)) (h509 : ∀ p ∈ LinRQSC509.blobs, LinesCl t5 (t4OfRec p.1)) (h510 : ∀ p ∈ LinRQSC510.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N300.TT) N300.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h507 p hpe
    · exact h508 p hpe
    · exact h509 p hpe
    · exact h510 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


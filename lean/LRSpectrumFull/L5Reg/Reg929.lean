/-
# L5Reg.Reg929 : the lines clause for every class of the local table of rep #929 (generated by l5reg)

Every local class `i < nT` of rep #929 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O929T
import LRSpectrumFull.L5S4.LinRQSC881
import LRSpectrumFull.L5S4.LinRQSC886
import LRSpectrumFull.L5S4.LinRQSC888

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R929
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(881, LinRQSC881.blobs), (886, LinRQSC886.blobs), (888, LinRQSC888.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(888, 56, [3, 0, -2, -1, -1, 1, 0, 2, -1]), (888, 57, [3, -1, 0, -1, -2, 2, -1, -3, 3]), (888, 58, [1, 3, -3, 2, -1, -1, 3, -2, -1]), (888, 59, [3, 1, -2, -1, 2, 0, 0, 3, -1]), (888, 60, [3, 1, -2, -1, 2, -1, 1, 2, -2]), (888, 61, [3, -1, -2, -1, -2, 1, -2, -3, 2]), (888, 62, [3, 0, -1, -1, -1, 1, -2, 2, -1]), (888, 63, [3, 0, -1, -1, -1, 1, -2, 2, -1]), (888, 64, [3, -2, -1, -1, 1, 0, -1, 0, 0]), (888, 65, [3, 1, -1, -1, 2, -1, -1, 0, 0]), (888, 66, [3, 1, -3, -1, 2, 0, 0, 2, -1]), (888, 67, [3, 1, -2, -1, 2, -1, 1, 2, -2]), (888, 68, [3, 1, -3, -1, 2, -1, -1, 3, -2]), (888, 69, [3, 0, -1, -1, -1, 1, -1, 3, -2]), (888, 70, [3, -1, -1, -1, -2, 1, 0, -3, 1]), (888, 71, [3, 0, -2, -1, -1, 1, 1, 3, -2]), (881, 214, [3, -1, -2, 0, -1, 0, 1, 2, -1]), (888, 72, [3, 1, -1, -1, 2, 0, -1, 1, 0]), (888, 73, [3, 1, -3, -1, 2, 0, 0, 2, -1]), (888, 74, [3, 1, -2, -1, 2, -1, 0, 3, -2]), (886, 49, [0, -1, 1, -1, -2, 2, 3, -1, 0]), (888, 75, [3, 1, -3, -1, 2, 0, -2, 2, 1]), (888, 76, [3, 1, -2, -1, 2, -1, -2, 1, 0]), (888, 77, [3, 1, -2, -1, 2, 0, 1, 1, -1]), (888, 78, [3, -2, 0, -1, 1, 1, -1, 1, 0]), (881, 233, [3, 1, -1, 0, 1, 0, -1, 2, 0]), (881, 234, [3, -2, 1, 0, 0, 1, 1, -1, -2]), (888, 79, [3, 1, -3, -1, 2, 0, 1, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N929.TT) N929.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N929.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #929. -/
theorem lines (t5 : List T5Rec) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N929.nT).map (t4At (LRSpectrumFull.L5S4.dg N929.TT) N929.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h881 p hp
  · exact h886 p hp
  · exact h888 p hp
)

#print axioms lines

end R929
end L5Reg
end LRSpectrumFull

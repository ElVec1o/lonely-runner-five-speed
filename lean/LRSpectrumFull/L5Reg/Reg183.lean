/-
# L5Reg.Reg183 : the lines clause for every class of the local table of rep #183 (generated by l5reg)

Every local class `i < nT` of rep #183 (39 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O183T
import LRSpectrumFull.L5S4.LinRQSC37
import LRSpectrumFull.L5S4.LinRQSC95
import LRSpectrumFull.L5S4.LinRQSC96
import LRSpectrumFull.L5S4.LinRQSC194

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R183
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(37, LinRQSC37.blobs), (95, LinRQSC95.blobs), (96, LinRQSC96.blobs), (194, LinRQSC194.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(194, 40, [2, 0, -1, 0, -1, 1, -1, 0, 0]), (96, 18, [1, 0, 0, -1, -1, 0, 0, 1, -1]), (96, 39, [1, 0, 0, -1, 2, -1, 0, -3, 2]), (194, 41, [1, 1, -1, 0, 2, -1, -1, 4, -2]), (194, 42, [1, 1, -1, 0, 2, -1, 1, -2, 0]), (194, 43, [1, 0, 0, 0, -1, 2, -1, 0, -1]), (194, 44, [2, 0, -1, 0, -1, 0, 1, 2, -1]), (194, 45, [2, 0, -1, 0, -1, 0, 1, -1, 0]), (194, 46, [2, 0, -1, 0, 1, -1, -1, -2, 2]), (194, 47, [1, 0, 0, 0, 1, -1, 0, -2, 1]), (194, 48, [2, 1, -2, 0, 2, -1, 1, -3, 1]), (194, 49, [1, 0, 0, 0, 2, -1, -1, -1, 0]), (194, 50, [2, -1, 0, 0, -1, -1, -1, 1, 0]), (37, 184, [1, 0, 0, 0, 1, 0, 0, 2, 1]), (194, 51, [1, 0, 0, 0, 1, 0, 1, 0, -1]), (194, 52, [2, 0, -1, 0, 3, 1, -1, -1, 0]), (194, 53, [0, 1, -1, 2, 0, -1, 3, 0, -1]), (194, 54, [2, 0, -1, 0, -1, 2, -1, 0, 0]), (194, 55, [1, 0, 0, 0, -2, 1, 0, -1, 1]), (194, 56, [1, 0, 0, 0, 1, 0, 1, 1, -1]), (194, 57, [1, 0, 0, 0, -1, 3, -1, 0, -1]), (194, 58, [2, -1, 0, 0, -1, 1, -1, 1, -1]), (194, 59, [2, 0, -1, 0, -3, 1, -1, 1, 0]), (194, 60, [2, -1, -1, 0, 1, 0, 1, 0, -1]), (194, 61, [1, 0, 0, 0, 3, -1, 0, -4, 1]), (194, 62, [0, -1, 1, 2, -1, 0, 3, -2, 0]), (194, 63, [2, 0, -1, 0, 3, -2, -1, -4, 3]), (194, 64, [2, 0, -1, 0, -1, 1, 1, -1, 1]), (194, 65, [1, 0, 0, 0, -3, 2, 0, 4, -3]), (194, 66, [0, 2, -1, -3, 0, 1, 4, -1, -1]), (194, 67, [1, 0, 0, 0, -3, 2, 0, 4, -3]), (194, 68, [1, 0, 0, 0, 2, -1, 0, 3, -2]), (37, 165, [0, 0, 1, -4, 3, 0, -3, 2, 0]), (194, 69, [1, 0, 0, 0, 2, 1, 1, 1, 1]), (95, 134, [0, -2, 1, -4, 1, 1, -3, 0, 1]), (95, 142, [0, 2, -1, -4, -1, 2, 3, 0, -1]), (194, 70, [2, 0, -1, 0, -1, 0, -1, -2, 1]), (194, 71, [2, 0, -1, 0, 1, -1, 1, 2, -2]), (194, 72, [2, -1, 0, 0, 1, -1, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N183.TT) N183.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N183.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #183. -/
theorem lines (t5 : List T5Rec) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1)) (h95 : ∀ p ∈ LinRQSC95.blobs, LinesCl t5 (t4OfRec p.1)) (h96 : ∀ p ∈ LinRQSC96.blobs, LinesCl t5 (t4OfRec p.1)) (h194 : ∀ p ∈ LinRQSC194.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N183.nT).map (t4At (LRSpectrumFull.L5S4.dg N183.TT) N183.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h37 p hp
  · exact h95 p hp
  · exact h96 p hp
  · exact h194 p hp
)

#print axioms lines

end R183
end L5Reg
end LRSpectrumFull

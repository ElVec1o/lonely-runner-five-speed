/-- the lines clause for every class of the local table of rep #298. -/
theorem lines (t5 : List T5Rec) (h488 : ∀ p ∈ LinRQSC488.blobs, LinesCl t5 (t4OfRec p.1)) (h489 : ∀ p ∈ LinRQSC489.blobs, LinesCl t5 (t4OfRec p.1)) (h490 : ∀ p ∈ LinRQSC490.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N298.nT).map (t4At (LRSpectrumFull.L5S4.dg N298.TT) N298.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h488 p hp
  · exact h489 p hp
  · exact h490 p hp
)


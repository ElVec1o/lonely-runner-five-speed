/-
# L5Reg.Reg1008 : the lines clause for every class of the local table of rep #1008 (generated by l5reg)

Every local class `i < nT` of rep #1008 (30 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1008T
import LRSpectrumFull.L5S4.LinRQSC889
import LRSpectrumFull.L5S4.LinRQSC901
import LRSpectrumFull.L5S4.LinRQSC902
import LRSpectrumFull.L5S4.LinRQSC904

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1008
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(889, LinRQSC889.blobs), (901, LinRQSC901.blobs), (902, LinRQSC902.blobs), (904, LinRQSC904.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(889, 118, [2, 0, -1, -3, 0, 1, 0, -1, 0]), (904, 113, [2, 0, -1, 0, 3, -2, -3, -1, 2]), (904, 114, [1, 0, 0, 0, 3, -2, -1, 2, -1]), (901, 164, [2, 0, -1, -1, 2, 0, 0, 3, -1]), (904, 115, [1, 0, -1, 0, -3, 2, -3, -2, 4]), (904, 116, [1, 0, -1, 0, -1, 1, -1, 0, 0]), (902, 204, [0, 1, 0, 2, 2, -1, 3, 0, -1]), (904, 117, [1, 0, -1, 0, -3, 1, -1, -1, 1]), (904, 118, [0, -2, 1, 3, 0, -2, 2, 3, -3]), (904, 119, [0, -2, 1, 1, 2, -2, 0, -3, 2]), (889, 117, [0, 2, -1, 0, -3, 2, -1, -2, 2]), (904, 120, [0, -1, 0, 1, 1, -1, 1, -1, 0]), (904, 121, [0, -2, 1, 3, 2, -3, 2, -3, 0]), (904, 122, [0, -2, 1, 1, 2, -1, 0, -3, 1]), (904, 123, [0, -2, 1, 3, 2, -2, 1, -3, 1]), (904, 124, [0, -2, 1, 1, 2, -2, 0, 3, -2]), (904, 125, [0, -2, 1, 3, 2, -2, -2, 1, 0]), (904, 126, [0, -2, 1, 3, 2, -3, -1, 3, -1]), (904, 127, [0, 1, -1, 1, 0, 0, 0, 1, 0]), (904, 128, [0, -2, 1, 3, 0, -2, -2, -1, 2]), (904, 129, [0, -1, 0, 3, 0, -2, -1, -1, 1]), (904, 130, [0, -1, 0, 1, 1, -1, -1, 1, 0]), (904, 131, [1, 0, -1, 0, -3, 2, 3, 2, -4]), (904, 132, [2, 0, -1, 0, 1, 0, 3, 0, -2]), (904, 133, [1, -1, 0, 0, 0, 1, 3, -2, 0]), (904, 134, [1, 0, -1, 0, 3, -1, 1, -2, 0]), (904, 135, [0, 0, 1, 3, -2, 0, -1, 1, 2]), (904, 136, [0, 0, 1, 3, -2, 1, -2, 1, 0]), (904, 137, [0, 1, 0, 0, 0, -1, 1, -1, 0]), (904, 138, [0, 1, 0, 3, 0, -2, 1, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1008.TT) N1008.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1008.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1008. -/
theorem lines (t5 : List T5Rec) (h889 : ∀ p ∈ LinRQSC889.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1008.nT).map (t4At (LRSpectrumFull.L5S4.dg N1008.TT) N1008.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h889 p hp
  · exact h901 p hp
  · exact h902 p hp
  · exact h904 p hp
)

#print axioms lines

end R1008
end L5Reg
end LRSpectrumFull

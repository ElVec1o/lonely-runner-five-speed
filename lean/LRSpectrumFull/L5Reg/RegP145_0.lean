theorem lines (t5 : List T5Rec) (h139 : ∀ p ∈ LinRQSC139.blobs, LinesCl t5 (t4OfRec p.1)) (h140 : ∀ p ∈ LinRQSC140.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg1856 : the lines clause for every class of the local table of rep #1856 (generated by l5reg)

Every local class `i < nT` of rep #1856 (32 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1856T
import LRSpectrumFull.L5S4.LinRQSC884
import LRSpectrumFull.L5S4.LinRQSC888
import LRSpectrumFull.L5S4.LinRQSC1048

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1856
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(884, LinRQSC884.blobs), (888, LinRQSC888.blobs), (1048, LinRQSC1048.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1048, 166, [2, -1, -1, -1, 0, 0, 1, -1, 0]), (1048, 167, [2, -1, 0, -1, -1, 1, 1, 2, -2]), (1048, 168, [2, -1, 0, -1, -3, 2, 0, 2, -1]), (1048, 169, [2, 2, -1, -1, 1, 0, -1, 2, 0]), (1048, 170, [1, 0, -1, 3, -1, -2, 2, -1, 0]), (1048, 171, [1, -2, 1, 1, -1, 0, -2, -1, 2]), (1048, 172, [1, 2, -1, 3, 1, -1, 0, -2, 1]), (1048, 173, [1, -2, 1, 3, -1, 0, 3, 2, -2]), (1048, 174, [2, 2, -3, -1, 1, 0, 0, 3, -2]), (1048, 175, [2, -1, 0, -1, -1, 1, 0, -1, 1]), (884, 132, [3, 0, -1, -1, -1, 1, -1, -3, 2]), (1048, 176, [2, -2, -1, -1, -1, 1, 0, -3, 1]), (1048, 177, [2, -1, 2, -1, 0, 1, -1, 0, 2]), (1048, 178, [1, 2, -1, 3, 1, -2, 2, -2, -1]), (1048, 179, [2, -2, 1, 1, 1, -1, 3, 2, -2]), (1048, 180, [1, -1, 1, -1, 1, 0, 3, -2, 1]), (1048, 181, [1, 0, -1, 1, 0, -2, -3, 1, 0]), (1048, 182, [1, -2, 0, 3, 1, -1, 1, -1, 0]), (1048, 183, [1, -2, 0, 3, 1, -2, 2, -1, -1]), (884, 186, [3, -1, -1, -1, 0, 1, 1, 0, -2]), (1048, 184, [1, 0, 0, 3, -1, -1, -2, 1, 2]), (1048, 185, [1, 0, -1, 3, -1, -2, 3, -2, -2]), (888, 71, [3, 0, -2, -1, -1, 1, 1, 3, -2]), (1048, 186, [1, 1, -1, 3, 1, -2, 2, -1, -1]), (1048, 187, [2, 1, -1, 1, 1, 0, 2, 0, -1]), (1048, 188, [1, 0, 0, 3, -1, 0, -2, 2, -1]), (1048, 189, [1, 0, 1, 3, -1, 1, 2, -2, -1]), (1048, 190, [1, 2, -2, 1, 1, -1, -3, 0, 1]), (1048, 191, [2, -1, -1, 1, -1, -1, 2, 1, 2]), (1048, 124, [1, 2, -2, -1, 1, 0, 3, -1, -1]), (1048, 192, [1, -1, 0, 3, -2, 0, 2, 0, -1]), (1048, 193, [1, 0, -1, 3, -1, -2, 2, -2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1856.TT) N1856.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1856.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1856. -/
theorem lines (t5 : List T5Rec) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1856.nT).map (t4At (LRSpectrumFull.L5S4.dg N1856.TT) N1856.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h884 p hp
  · exact h888 p hp
  · exact h1048 p hp
)

#print axioms lines

end R1856
end L5Reg
end LRSpectrumFull

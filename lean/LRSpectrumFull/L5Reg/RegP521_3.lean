theorem lines (t5 : List T5Rec) (h775 : ∀ p ∈ LinRQSC775.blobs, LinesCl t5 (t4OfRec p.1)) (h776 : ∀ p ∈ LinRQSC776.blobs, LinesCl t5 (t4OfRec p.1))

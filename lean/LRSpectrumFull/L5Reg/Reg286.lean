/-
# L5Reg.Reg286 : the lines clause for every class of the local table of rep #286 (generated by l5reg)

Every local class `i < nT` of rep #286 (40 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O286T
import LRSpectrumFull.L5S4.LinRQSC434

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R286
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(434, LinRQSC434.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(434, 18, [0, -1, 0, 1, -4, 0, -5, -3, 1]), (434, 19, [1, -1, 0, 4, 4, -5, 3, 0, -2]), (434, 20, [1, -1, 0, 4, 4, -3, 0, -3, 1]), (434, 21, [1, -1, 0, 4, -2, -1, 4, -3, -1]), (434, 22, [1, -1, 0, 4, 4, -3, 0, -3, 1]), (434, 23, [1, -1, 0, 4, 4, -1, 2, -3, 0]), (434, 24, [1, -1, 0, 4, 4, -3, 1, -4, 1]), (434, 25, [1, -1, 0, 4, 4, -5, 4, -1, -2]), (434, 26, [1, -1, 0, 4, -3, -1, 4, -2, -1]), (434, 27, [1, -1, 0, 4, 0, -1, 1, 4, -1]), (434, 28, [1, -1, 0, 4, -3, -1, 2, -2, -1]), (434, 29, [1, -1, 0, 4, 0, -1, 4, 5, -2]), (434, 30, [1, -1, 0, 4, 0, -3, 2, 5, -5]), (434, 31, [1, -1, 0, 4, 0, -1, 4, 5, -2]), (434, 32, [1, -1, 0, 0, -4, 3, -5, -4, 7]), (434, 33, [1, 0, 0, 0, 1, 0, 5, 0, -1]), (434, 34, [1, -1, 0, -4, -4, 7, -2, 3, -1]), (434, 35, [1, 0, -1, -4, -1, 4, -1, 2, 0]), (434, 36, [1, -1, 0, -4, -4, 5, -4, 1, 2]), (434, 37, [1, 0, -1, -4, -1, 4, -4, 1, 3]), (434, 38, [1, 0, 0, -4, 2, -1, -4, 1, 0]), (434, 39, [1, -1, 0, -4, -4, 3, 0, 3, -1]), (434, 40, [1, 0, -1, -4, 0, 3, 0, -1, 1]), (434, 41, [1, 0, -1, -4, 0, 3, -4, -1, 4]), (434, 42, [1, 0, 0, -4, 0, 1, -3, -1, -4]), (434, 43, [0, 1, 0, 1, 0, 0, -6, 0, 1]), (434, 44, [1, 0, 0, -4, 1, 0, 0, -5, -1]), (434, 45, [1, 0, 0, -4, 1, 0, -3, -4, -1]), (434, 46, [1, 0, -1, -4, -1, 4, -4, 1, 3]), (434, 47, [1, -1, 0, -4, 2, -1, -4, 3, 0]), (434, 48, [1, 0, -1, -4, 1, 3, 1, -4, 2]), (434, 49, [1, 0, -1, -4, -1, 4, -3, 2, 2]), (434, 50, [1, 0, -1, -4, -1, 4, 1, 3, -2]), (434, 51, [1, 0, 0, -4, -1, 0, -2, 3, -1]), (434, 52, [0, 0, -1, 0, -1, -4, 1, 0, -1]), (434, 53, [0, -1, 0, 0, -4, 1, 1, -2, 0]), (434, 54, [0, -1, 0, 0, -4, 1, 1, -2, 0]), (434, 55, [0, 1, 0, 0, 4, -1, 1, -2, 0]), (434, 56, [0, 1, 0, 0, 0, 1, 1, 0, 0]), (434, 57, [0, 1, 0, 0, 0, 1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N286.TT) N286.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N286.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #286. -/
theorem lines (t5 : List T5Rec) (h434 : ∀ p ∈ LinRQSC434.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N286.nT).map (t4At (LRSpectrumFull.L5S4.dg N286.TT) N286.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h434 p hp
)

#print axioms lines

end R286
end L5Reg
end LRSpectrumFull

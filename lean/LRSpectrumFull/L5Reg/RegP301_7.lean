/-
# L5Reg.RegP301_7 : part 7 of the lines clause of rep #301: local classes 700..701 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O301T
import LRSpectrumFull.L5S4.LinRQSC548

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P301_7
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(548, LinRQSC548.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(548, 41, [0, -1, 1, 0, 1, 0, 1, 1, -1]), (548, 42, [0, -1, 1, 0, 1, 0, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N301.TT) N301.ST (assoc bls) 700 adv = true := by decide +kernel

theorem adv_len : adv.length = 2 := by decide +kernel

/-- the lines clause for local classes 700..701 of rep #301. -/
theorem lines (t5 : List T5Rec) (h548 : ∀ p ∈ LinRQSC548.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 700 ≤ c → c < 700 + 2 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N301.TT) N301.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h548 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 700 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P301_7
end L5Reg
end LRSpectrumFull

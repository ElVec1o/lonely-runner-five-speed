/-- the lines clause for local classes 600..699 of rep #300. -/
theorem lines (t5 : List T5Rec) (h517 : ∀ p ∈ LinRQSC517.blobs, LinesCl t5 (t4OfRec p.1)) (h518 : ∀ p ∈ LinRQSC518.blobs, LinesCl t5 (t4OfRec p.1)) (h519 : ∀ p ∈ LinRQSC519.blobs, LinesCl t5 (t4OfRec p.1)) (h520 : ∀ p ∈ LinRQSC520.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 600 ≤ c → c < 600 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N300.TT) N300.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h517 p hpe
    · exact h518 p hpe
    · exact h519 p hpe
    · exact h520 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 600 advOk c h1 ?_
  rw [adv_len]; exact h2


theorem lines (t5 : List T5Rec) (h105 : ∀ p ∈ LinRQSC105.blobs, LinesCl t5 (t4OfRec p.1)) (h106 : ∀ p ∈ LinRQSC106.blobs, LinesCl t5 (t4OfRec p.1)) (h107 : ∀ p ∈ LinRQSC107.blobs, LinesCl t5 (t4OfRec p.1)) (h108 : ∀ p ∈ LinRQSC108.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N103.nT).map (t4At (LRSpectrumFull.L5S4.dg N103.TT) N103.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h105 p hp
  · exact h106 p hp
  · exact h107 p hp
  · exact h108 p hp
)


/-
# L5Reg.Reg1038 : the lines clause for every class of the local table of rep #1038 (generated by l5reg)

Every local class `i < nT` of rep #1038 (44 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1038T
import LRSpectrumFull.L5S4.LinRQSC908

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1038
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(908, LinRQSC908.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(908, 147, [0, -2, 1, -1, 1, 0, 0, 3, -2]), (908, 148, [2, 0, -1, -1, -1, 1, -3, 0, 1]), (908, 149, [2, 0, -1, -1, 0, 0, -3, 1, -1]), (908, 150, [2, 0, -1, -1, 3, 0, -2, -1, 1]), (908, 151, [2, -2, 1, -1, 1, -1, 3, -2, 1]), (908, 152, [2, 0, -1, -1, 3, 0, -2, -1, 1]), (908, 153, [2, 0, -1, -1, -3, 1, 3, -2, -1]), (908, 154, [2, -1, 0, -1, 2, 1, 3, -2, 0]), (908, 155, [0, -1, 1, -3, 2, 0, -2, 0, 1]), (908, 156, [1, 0, 0, 0, -3, 1, 3, 1, 0]), (908, 157, [1, 0, 0, 0, 3, -1, -2, 2, -1]), (908, 158, [1, 0, 0, 0, 3, -1, -3, -1, 0]), (908, 159, [2, -1, -1, -1, 2, 0, -3, 2, 1]), (908, 160, [2, -2, -1, -1, 1, 0, 3, -2, -2]), (908, 161, [2, 0, -1, -1, 0, 1, -3, 1, 1]), (908, 162, [2, -1, 0, -1, 0, 0, 2, 1, -1]), (908, 163, [0, -1, 0, -3, 0, 2, 2, -2, -1]), (908, 164, [0, -1, 0, -3, 0, 2, -1, -2, 1]), (908, 165, [0, 2, -1, -3, -1, 1, -1, 2, -1]), (908, 166, [0, 1, 0, -3, 0, 1, 2, 3, -1]), (908, 167, [0, 2, -1, -3, -1, 3, 2, -1, -1]), (908, 168, [0, 1, -2, -1, 0, 1, 1, -1, 2]), (908, 169, [1, 0, -1, 0, 1, 0, -3, 0, 2]), (908, 170, [2, 1, 0, -1, 0, 0, -2, 1, 1]), (908, 171, [2, 1, 0, -1, 0, 0, 2, -1, -1]), (908, 172, [0, 1, 0, -3, 0, 2, 1, 2, -1]), (908, 173, [0, 1, 0, -3, 1, 1, 1, -1, 0]), (908, 174, [0, -1, 0, -3, 2, 1, 2, 0, -1]), (908, 175, [0, -2, 1, -3, 1, 2, -1, 2, 0]), (908, 176, [0, -1, 0, -3, 0, 2, 2, -1, -1]), (908, 177, [0, -1, 1, -3, 2, 0, -1, 1, 0]), (908, 178, [0, 1, 0, -3, 0, 1, 2, 2, -1]), (908, 179, [0, 1, 0, -3, 1, 2, -1, 0, 1]), (908, 180, [0, -2, 1, -3, 1, 2, 2, 1, -2]), (908, 181, [0, 1, -1, -3, 1, 1, -1, 1, 0]), (908, 182, [0, -1, 0, -3, 0, 1, 1, -1, 0]), (908, 183, [0, -1, 1, -3, 2, -1, 1, 0, 0]), (908, 184, [0, -2, 1, -3, 1, 0, 2, 1, -1]), (908, 185, [0, -1, 0, -3, 0, 1, 2, -1, -1]), (908, 186, [0, -2, 1, -1, 1, 0, 0, 1, -1]), (908, 187, [0, 0, -1, -1, 0, 0, 0, -1, -1]), (908, 188, [0, 1, 2, -1, 0, -1, 0, 0, 1]), (908, 189, [0, -2, 1, -3, 1, 2, 1, 0, -1]), (908, 190, [0, 2, -1, -3, -1, 1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1038.TT) N1038.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1038.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1038. -/
theorem lines (t5 : List T5Rec) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1038.nT).map (t4At (LRSpectrumFull.L5S4.dg N1038.TT) N1038.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h908 p hp
)

#print axioms lines

end R1038

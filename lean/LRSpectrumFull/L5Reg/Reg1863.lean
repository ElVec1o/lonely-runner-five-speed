/-
# L5Reg.Reg1863 : the lines clause for every class of the local table of rep #1863 (generated by l5reg)

Every local class `i < nT` of rep #1863 (21 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1863T
import LRSpectrumFull.L5S4.LinRQSC1049

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1863
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1049, LinRQSC1049.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1049, 115, [2, 2, -3, -1, 2, -1, 2, -3, 1]), (1049, 116, [1, 0, 1, -2, 1, 0, -3, 1, 0]), (1049, 117, [1, 0, 0, -2, 2, -1, 2, -1, 0]), (1049, 118, [2, -1, -1, -1, 0, 1, -2, 2, 1]), (1049, 119, [1, 0, 0, -2, 1, 1, -2, 1, 0]), (1049, 120, [2, -1, 0, 2, 2, -1, -1, -3, 1]), (1049, 121, [1, -1, 1, -2, 2, -1, 3, -2, 0]), (1049, 122, [1, -2, 1, -2, -2, 3, -3, -1, 3]), (1049, 123, [2, -1, -1, -1, 2, 0, -3, -2, 3]), (1049, 124, [1, -1, 1, -2, 1, 0, -3, 1, 0]), (1049, 125, [1, -1, 0, -2, 1, 1, -2, 0, 1]), (1049, 126, [2, -1, 0, 2, 2, -1, -3, 1, 0]), (1049, 127, [2, -1, 0, 2, 2, -1, 1, 3, -1]), (1049, 128, [1, 1, -1, 1, -2, 1, 0, -2, 1]), (1049, 129, [2, -1, 0, 2, 2, -1, -1, -2, 1]), (1049, 130, [2, -2, 1, 2, 1, -1, -3, -2, 2]), (1049, 131, [2, 1, -1, 2, 0, -1, -3, 1, 1]), (1049, 132, [1, -1, 1, 1, 0, 0, -1, 1, 0]), (1049, 133, [2, -1, -1, 2, 2, -3, 1, 2, -2]), (1049, 134, [2, 1, -1, 2, -2, 1, 1, -2, 1]), (1049, 135, [2, 1, -1, 2, -2, 1, -3, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1863.TT) N1863.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1863.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1863. -/
theorem lines (t5 : List T5Rec) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1863.nT).map (t4At (LRSpectrumFull.L5S4.dg N1863.TT) N1863.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1049 p hp
)

#print axioms lines

end R1863
end L5Reg
end LRSpectrumFull

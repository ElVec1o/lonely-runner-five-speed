/-
# L5Reg.Reg1135 : the lines clause for every class of the local table of rep #1135 (generated by l5reg)

Every local class `i < nT` of rep #1135 (16 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1135T
import LRSpectrumFull.L5S4.LinRQSC923

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1135
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(923, LinRQSC923.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(923, 216, [1, 1, -1, 2, -1, -1, 1, 0, -1]), (923, 217, [1, 0, -1, 2, -1, -1, -1, -2, 2]), (923, 218, [1, -1, 0, 2, 0, -1, -2, -1, 2]), (923, 219, [1, 1, -1, 0, -1, 0, -2, 1, 1]), (923, 220, [1, 0, -1, 2, -1, 0, -1, 1, 0]), (923, 221, [1, 1, -1, 2, 0, -1, -1, -2, 1]), (923, 222, [1, -1, -1, 0, -1, 0, 2, -1, -1]), (923, 223, [1, 1, -1, 2, -1, 0, 0, 1, -1]), (923, 224, [1, -1, 0, 2, 0, -1, 0, 1, 0]), (923, 225, [1, -1, 0, 2, 0, -1, 1, 2, -1]), (923, 226, [0, 1, -1, 1, 2, -2, 2, -1, 0]), (923, 227, [1, -1, 0, -1, 0, -1, 1, -1, -1]), (923, 228, [1, -1, 1, 2, 1, 0, -1, -1, 0]), (923, 229, [1, 0, -1, -1, 1, 0, 1, 1, -1]), (923, 230, [1, 1, -1, -1, 0, 0, 2, -1, 0]), (923, 231, [1, 1, -1, -1, 0, 0, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1135.TT) N1135.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1135.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1135. -/
theorem lines (t5 : List T5Rec) (h923 : ∀ p ∈ LinRQSC923.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1135.nT).map (t4At (LRSpectrumFull.L5S4.dg N1135.TT) N1135.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h923 p hp
)

#print axioms lines

end R1135
end L5Reg
end LRSpectrumFull

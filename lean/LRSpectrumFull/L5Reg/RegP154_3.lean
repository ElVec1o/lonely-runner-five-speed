theorem lines (t5 : List T5Rec) (h108 : ∀ p ∈ LinRQSC108.blobs, LinesCl t5 (t4OfRec p.1)) (h156 : ∀ p ∈ LinRQSC156.blobs, LinesCl t5 (t4OfRec p.1)) (h157 : ∀ p ∈ LinRQSC157.blobs, LinesCl t5 (t4OfRec p.1))

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1353.TT) N1353.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1353.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1353. -/
theorem lines (t5 : List T5Rec) (h966 : ∀ p ∈ LinRQSC966.blobs, LinesCl t5 (t4OfRec p.1)) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1)) (h1021 : ∀ p ∈ LinRQSC1021.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1353.nT).map (t4At (LRSpectrumFull.L5S4.dg N1353.TT) N1353.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h966 p hp
  · exact h1004 p hp
  · exact h1021 p hp
)

#print axioms lines


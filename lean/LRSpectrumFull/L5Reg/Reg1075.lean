/-- the lines clause for every class of the local table of rep #1075. -/
theorem lines (t5 : List T5Rec) (h893 : ∀ p ∈ LinRQSC893.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1)) (h918 : ∀ p ∈ LinRQSC918.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1075.nT).map (t4At (LRSpectrumFull.L5S4.dg N1075.TT) N1075.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h893 p hp
  · exact h906 p hp
  · exact h918 p hp
)


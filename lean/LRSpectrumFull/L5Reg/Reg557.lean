theorem lines (t5 : List T5Rec) (h312 : ∀ p ∈ LinRQSC312.blobs, LinesCl t5 (t4OfRec p.1)) (h702 : ∀ p ∈ LinRQSC702.blobs, LinesCl t5 (t4OfRec p.1)) (h833 : ∀ p ∈ LinRQSC833.blobs, LinesCl t5 (t4OfRec p.1)) (h834 : ∀ p ∈ LinRQSC834.blobs, LinesCl t5 (t4OfRec p.1)) (h835 : ∀ p ∈ LinRQSC835.blobs, LinesCl t5 (t4OfRec p.1)) (h836 : ∀ p ∈ LinRQSC836.blobs, LinesCl t5 (t4OfRec p.1))

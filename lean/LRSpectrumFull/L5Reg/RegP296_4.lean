/-- the lines clause for local classes 400..499 of rep #296. -/
theorem lines (t5 : List T5Rec) (h473 : ∀ p ∈ LinRQSC473.blobs, LinesCl t5 (t4OfRec p.1)) (h474 : ∀ p ∈ LinRQSC474.blobs, LinesCl t5 (t4OfRec p.1)) (h475 : ∀ p ∈ LinRQSC475.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N296.TT) N296.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h473 p hpe
    · exact h474 p hpe
    · exact h475 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2


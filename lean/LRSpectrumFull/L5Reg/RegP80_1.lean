/-- the lines clause for local classes 100..199 of rep #80. -/
theorem lines (t5 : List T5Rec) (h77 : ∀ p ∈ LinRQSC77.blobs, LinesCl t5 (t4OfRec p.1)) (h78 : ∀ p ∈ LinRQSC78.blobs, LinesCl t5 (t4OfRec p.1))

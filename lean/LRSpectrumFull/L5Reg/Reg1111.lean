theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1111.TT) N1111.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1111.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1111. -/
theorem lines (t5 : List T5Rec) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1)) (h913 : ∀ p ∈ LinRQSC913.blobs, LinesCl t5 (t4OfRec p.1)) (h917 : ∀ p ∈ LinRQSC917.blobs, LinesCl t5 (t4OfRec p.1)) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1)) (h921 : ∀ p ∈ LinRQSC921.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1111.nT).map (t4At (LRSpectrumFull.L5S4.dg N1111.TT) N1111.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h896 p hp
  · exact h905 p hp
  · exact h908 p hp
  · exact h913 p hp
  · exact h917 p hp
  · exact h920 p hp
  · exact h921 p hp
)

#print axioms lines


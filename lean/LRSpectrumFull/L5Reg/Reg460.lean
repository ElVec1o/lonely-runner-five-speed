/-
# L5Reg.Reg460 : the lines clause for every class of the local table of rep #460 (generated by l5reg)

Every local class `i < nT` of rep #460 (37 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O460T
import LRSpectrumFull.L5S4.LinRQSC726
import LRSpectrumFull.L5S4.LinRQSC727

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R460
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(726, LinRQSC726.blobs), (727, LinRQSC727.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(726, 72, [1, 0, -1, -1, -2, 2, 4, -1, -3]), (726, 73, [1, 0, -1, -1, -4, 4, 4, -1, -3]), (726, 74, [1, 0, -1, -1, -1, 2, 4, 0, -3]), (726, 75, [1, 0, 0, -1, 4, 1, -4, 1, 0]), (726, 76, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (726, 77, [1, -1, 0, -1, 2, 0, 4, 3, -1]), (726, 78, [1, 0, -1, -1, 4, -2, -3, -3, 5]), (726, 79, [1, -1, 0, -2, 1, 1, -2, -4, 5]), (726, 80, [1, 0, -1, -1, -1, 2, 4, 0, -3]), (726, 81, [1, 0, -1, -1, 1, 0, -3, -1, 3]), (726, 82, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (726, 83, [1, 0, -1, -1, -1, 1, -4, 0, 3]), (726, 84, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (726, 85, [1, 0, -1, 2, -1, -1, 4, 1, -4]), (726, 86, [1, 0, -1, -1, -1, 1, -3, 0, 2]), (726, 87, [1, -1, 0, -2, 1, 1, -4, -3, 6]), (726, 88, [1, 0, -1, -2, -4, 3, -3, 3, 2]), (726, 89, [1, -1, 0, -2, 1, 0, -4, -3, 1]), (726, 90, [1, -1, 0, 2, 1, -1, 4, 3, -2]), (726, 91, [1, 0, -1, 2, 1, -2, 2, -1, -1]), (726, 92, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (726, 93, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (726, 94, [1, 0, 0, -2, -1, -4, -4, 0, 1]), (726, 95, [1, 0, 0, 2, 4, 1, 4, -1, 0]), (726, 96, [1, 0, -1, -2, 4, -1, -3, -3, 5]), (726, 97, [1, 0, -1, -2, 1, 1, -4, 0, 3]), (726, 98, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (726, 99, [1, 0, 0, -2, 1, 4, -3, -1, -3]), (726, 100, [0, -1, 0, -1, 2, 0, 1, 2, -1]), (726, 101, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (727, 0, [1, 0, 0, -2, -1, 4, -4, 0, -1]), (727, 1, [0, 1, 0, -4, 2, 3, 1, 4, -1]), (727, 2, [0, -1, 0, -4, -2, 1, 1, -4, 0]), (727, 3, [0, -1, 0, -1, 2, 0, 1, 3, -1]), (727, 4, [0, -1, 0, -1, -2, 1, 1, -2, 0]), (727, 5, [0, -1, 0, -4, -2, 1, 1, -4, 0]), (727, 6, [1, 0, -1, 2, -1, -1, 3, 1, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N460.TT) N460.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N460.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #460. -/
theorem lines (t5 : List T5Rec) (h726 : ∀ p ∈ LinRQSC726.blobs, LinesCl t5 (t4OfRec p.1)) (h727 : ∀ p ∈ LinRQSC727.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N460.nT).map (t4At (LRSpectrumFull.L5S4.dg N460.TT) N460.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h726 p hp
  · exact h727 p hp
)

#print axioms lines

end R460
end L5Reg
end LRSpectrumFull

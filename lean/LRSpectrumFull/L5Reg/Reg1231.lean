/-
# L5Reg.Reg1231 : the lines clause for every class of the local table of rep #1231 (generated by l5reg)

Every local class `i < nT` of rep #1231 (41 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1231T
import LRSpectrumFull.L5S4.LinRQSC926
import LRSpectrumFull.L5S4.LinRQSC935
import LRSpectrumFull.L5S4.LinRQSC959

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1231
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(926, LinRQSC926.blobs), (935, LinRQSC935.blobs), (959, LinRQSC959.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(959, 31, [1, -1, 0, -3, 0, 2, -3, -1, 3]), (959, 32, [1, 1, -1, 0, -1, 0, 0, 2, -1]), (959, 33, [1, -1, 0, -3, -2, 3, -3, 0, 2]), (959, 34, [1, -1, 0, -3, -2, 2, -3, 1, 1]), (959, 35, [1, 1, -1, -1, -3, 2, -3, 0, 2]), (959, 36, [1, -1, 0, -3, -2, 1, 1, -2, 0]), (959, 37, [2, 1, -2, 0, -3, 1, 1, 0, -1]), (959, 38, [1, 1, -1, -3, -1, 2, -1, 2, 0]), (959, 39, [1, 1, -1, -3, 2, 2, -2, -3, 2]), (959, 40, [1, -1, 0, -3, -2, 2, 3, 0, -1]), (935, 141, [1, 0, -1, -3, 0, 2, 1, -1, -1]), (959, 41, [1, 0, -1, -3, -1, 3, 3, -1, -2]), (959, 42, [1, 0, -1, -3, 1, 2, 3, 1, -3]), (959, 43, [1, 2, -1, -3, 0, 2, 3, -1, -2]), (959, 44, [1, -1, 0, -3, -2, 2, -1, 3, -1]), (959, 45, [1, 1, -1, -3, 2, 1, -3, -1, 2]), (935, 168, [1, -2, 0, 3, 1, -1, 3, 0, -1]), (959, 46, [1, 0, 0, -3, 2, -1, -1, 1, 0]), (959, 47, [1, 1, -1, -3, -1, 2, -1, 2, 0]), (959, 48, [1, 1, -1, -3, -1, 2, -3, 2, 0]), (935, 134, [1, 0, -1, -3, 0, 2, -1, -1, 2]), (959, 49, [1, 0, -1, -3, -1, 3, 2, -1, -1]), (959, 50, [1, 1, -1, -1, 2, -1, -3, 1, 0]), (959, 51, [1, 0, -1, -3, 1, 2, 1, 2, -2]), (935, 160, [1, -2, 1, 2, 1, -2, -3, 0, 2]), (959, 52, [1, 0, 0, 0, 1, -1, 1, -2, 1]), (959, 53, [1, 1, -1, 2, -3, 0, -1, -3, 2]), (959, 54, [1, 0, -1, -1, 1, 1, -3, 1, 2]), (959, 55, [1, 1, -1, -1, -3, 2, -3, 2, 0]), (959, 56, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (959, 57, [1, 1, -1, -1, -3, 2, -3, 0, 1]), (959, 58, [1, 0, -1, 0, -1, 1, 1, 1, -1]), (959, 59, [1, 0, 0, -3, 1, 0, 0, -1, 1]), (959, 60, [1, 0, -1, 0, 1, 0, 1, -2, 0]), (926, 42, [2, -1, -1, -3, -1, 3, 0, -2, 1]), (935, 169, [1, 0, -1, 3, 0, -2, 1, 1, -1]), (959, 61, [1, 0, 0, 0, -1, -1, 1, 0, -1]), (926, 58, [2, 0, -1, -3, 0, 2, 0, -1, 1]), (926, 34, [2, -1, -1, -3, -1, 3, 0, -3, 2]), (959, 62, [1, 0, 0, 2, -1, -1, -3, 1, 2]), (959, 63, [2, -1, -1, 0, 1, 0, 1, 3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1231.TT) N1231.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1231.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1231. -/
theorem lines (t5 : List T5Rec) (h926 : ∀ p ∈ LinRQSC926.blobs, LinesCl t5 (t4OfRec p.1)) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1231.nT).map (t4At (LRSpectrumFull.L5S4.dg N1231.TT) N1231.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h926 p hp
  · exact h935 p hp
  · exact h959 p hp
)

#print axioms lines

end R1231
end L5Reg
end LRSpectrumFull

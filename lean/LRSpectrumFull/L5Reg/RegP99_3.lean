theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N99.TT) N99.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 21 := by decide +kernel

/-- the lines clause for local classes 300..320 of rep #99. -/
theorem lines (t5 : List T5Rec) (h104 : ∀ p ∈ LinRQSC104.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 21 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N99.TT) N99.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h104 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines


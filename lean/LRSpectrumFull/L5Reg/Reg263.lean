theorem adv_len : adv.length = N263.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #263. -/
theorem lines (t5 : List T5Rec) (h220 : ∀ p ∈ LinRQSC220.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N263.nT).map (t4At (LRSpectrumFull.L5S4.dg N263.TT) N263.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h220 p hp
)


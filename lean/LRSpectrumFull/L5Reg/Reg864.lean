/-
# L5Reg.Reg864 : the lines clause for every class of the local table of rep #864 (generated by l5reg)

Every local class `i < nT` of rep #864 (7 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O864T
import LRSpectrumFull.L5S4.LinRQSC880

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R864
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(880, LinRQSC880.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(880, 178, [3, 1, -1, -1, 2, 0, 2, -3, 0]), (880, 179, [3, 1, -2, -1, 2, -1, 2, -1, 0]), (880, 180, [3, -1, -2, -1, -2, 1, 1, 3, -1]), (880, 181, [1, -3, 0, 2, 1, -2, -3, -2, 3]), (880, 182, [3, -1, 0, -1, -2, 2, 2, 3, -3]), (880, 183, [3, -1, -1, -1, -2, 2, -1, 2, -1]), (880, 184, [3, 1, -2, -1, 2, 0, -1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N864.TT) N864.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N864.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #864. -/
theorem lines (t5 : List T5Rec) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N864.nT).map (t4At (LRSpectrumFull.L5S4.dg N864.TT) N864.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h880 p hp
)

#print axioms lines

end R864
end L5Reg
end LRSpectrumFull

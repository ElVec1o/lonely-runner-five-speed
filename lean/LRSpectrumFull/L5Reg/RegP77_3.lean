theorem lines (t5 : List T5Rec) (h57 : ∀ p ∈ LinRQSC57.blobs, LinesCl t5 (t4OfRec p.1)) (h67 : ∀ p ∈ LinRQSC67.blobs, LinesCl t5 (t4OfRec p.1)) (h68 : ∀ p ∈ LinRQSC68.blobs, LinesCl t5 (t4OfRec p.1))

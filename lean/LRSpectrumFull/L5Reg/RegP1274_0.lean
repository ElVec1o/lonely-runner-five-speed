theorem lines (t5 : List T5Rec) (h948 : ∀ p ∈ LinRQSC948.blobs, LinesCl t5 (t4OfRec p.1)) (h989 : ∀ p ∈ LinRQSC989.blobs, LinesCl t5 (t4OfRec p.1))

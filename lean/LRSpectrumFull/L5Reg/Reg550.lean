theorem lines (t5 : List T5Rec) (h739 : ∀ p ∈ LinRQSC739.blobs, LinesCl t5 (t4OfRec p.1)) (h740 : ∀ p ∈ LinRQSC740.blobs, LinesCl t5 (t4OfRec p.1)) (h741 : ∀ p ∈ LinRQSC741.blobs, LinesCl t5 (t4OfRec p.1)) (h805 : ∀ p ∈ LinRQSC805.blobs, LinesCl t5 (t4OfRec p.1)) (h806 : ∀ p ∈ LinRQSC806.blobs, LinesCl t5 (t4OfRec p.1)) (h807 : ∀ p ∈ LinRQSC807.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N550.nT).map (t4At (LRSpectrumFull.L5S4.dg N550.TT) N550.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h739 p hp
  · exact h740 p hp
  · exact h741 p hp
  · exact h805 p hp
  · exact h806 p hp
  · exact h807 p hp
)


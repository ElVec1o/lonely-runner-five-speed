/-
# L5Reg.Reg1310 : the lines clause for every class of the local table of rep #1310 (generated by l5reg)

Every local class `i < nT` of rep #1310 (30 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1310T
import LRSpectrumFull.L5S4.LinRQSC1004

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1310
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1004, LinRQSC1004.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1004, 83, [2, -1, 0, 0, 1, -1, -3, 1, 0]), (1004, 84, [1, 0, -1, 3, -2, -2, 0, -1, 0]), (1004, 85, [2, 0, -1, 0, -1, 1, -3, 0, 2]), (1004, 86, [1, -1, 0, 0, 0, -1, -3, 2, 0]), (1004, 87, [2, -1, -1, 0, 1, 0, 3, -2, -1]), (1004, 88, [1, 0, -1, 0, -2, 1, -3, 1, 2]), (1004, 89, [1, -1, 0, 0, 0, -1, 1, 0, 0]), (1004, 90, [2, 1, -1, 0, -1, 0, 3, -1, -1]), (1004, 91, [2, -1, 0, 0, 1, -1, 3, 2, -3]), (1004, 92, [1, -1, 0, -1, 0, 1, 3, 1, -3]), (1004, 93, [2, 1, -1, 0, 3, -2, -3, 1, 0]), (1004, 94, [1, 1, -1, 3, -1, -2, -2, -1, 2]), (1004, 95, [1, 1, -1, 0, -1, 1, -1, 2, -1]), (1004, 96, [2, -1, 1, 0, -1, 2, -3, 1, 0]), (1004, 97, [1, 0, 0, 0, 2, -1, 3, 1, -1]), (1004, 98, [2, 1, -1, 0, 3, -2, 3, -2, 1]), (1004, 99, [2, 1, -1, 0, -1, 0, 1, -3, 0]), (1004, 100, [1, 1, -1, 0, 3, -2, -3, -1, 2]), (1004, 101, [1, 1, -1, 0, -1, 0, -3, 1, 2]), (1004, 102, [2, 1, -2, 0, 3, -1, 3, -1, -2]), (1004, 103, [1, 1, -1, -1, 3, -2, 3, 2, -2]), (1004, 104, [2, 1, -2, 0, 3, -1, -3, 1, 2]), (1004, 105, [1, -1, 0, 0, 0, -1, 3, -2, 0]), (1004, 106, [1, 1, -1, 3, 0, -2, -1, -2, 1]), (1004, 107, [2, -1, -1, 0, 0, -1, 3, -2, 0]), (1004, 108, [1, 0, -1, -1, -1, 0, 3, 0, -2]), (1004, 109, [2, -1, -1, 0, 1, 0, -3, -2, 2]), (1004, 110, [1, 1, -1, 3, -1, 0, 0, -1, 1]), (1004, 111, [1, -1, 0, -1, 0, 1, 3, 1, -3]), (1004, 112, [1, 2, 1, -1, 0, 0, 3, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1310.TT) N1310.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1310.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1310. -/
theorem lines (t5 : List T5Rec) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1310.nT).map (t4At (LRSpectrumFull.L5S4.dg N1310.TT) N1310.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1004 p hp
)

#print axioms lines

end R1310
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1100 : the lines clause for every class of the local table of rep #1100 (generated by l5reg)

Every local class `i < nT` of rep #1100 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1100T
import LRSpectrumFull.L5S4.LinRQSC892
import LRSpectrumFull.L5S4.LinRQSC911
import LRSpectrumFull.L5S4.LinRQSC920

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1100
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs), (911, LinRQSC911.blobs), (920, LinRQSC920.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(920, 109, [2, 0, -1, 1, -1, 0, 2, 1, -1]), (920, 110, [2, -1, -1, -2, 0, 1, -3, 2, 1]), (920, 111, [2, 0, -1, -2, 1, 0, -1, -1, 1]), (920, 112, [2, 0, -1, -2, -1, 2, -1, 1, 0]), (920, 113, [1, 0, -1, 0, 2, -1, 3, -1, -2]), (920, 114, [1, 0, -1, 0, -2, 1, 3, 1, -3]), (920, 115, [1, 0, -1, 0, -2, 1, -3, -1, 3]), (920, 116, [2, -1, -1, -2, 2, 1, 3, -1, -2]), (920, 117, [1, 2, -1, -1, 1, 0, 1, 0, 0]), (920, 118, [2, 2, -1, -2, 1, 0, 3, -2, 0]), (892, 92, [2, 0, -1, -2, -1, 2, -1, 2, -1]), (920, 119, [2, -2, -1, 1, 2, -1, -2, -3, 2]), (920, 120, [2, -1, 0, 1, 1, -1, -3, -1, 2]), (920, 121, [2, -1, -1, -2, 0, 1, 3, -2, -1]), (920, 122, [2, 1, -1, -2, 0, 1, 3, -1, -1]), (920, 123, [2, 2, -3, 1, -2, 1, -1, 1, 0]), (911, 163, [1, 0, -1, -1, -1, 1, -1, 1, 0]), (911, 122, [1, 1, -1, -1, 2, -1, -1, 0, 0]), (911, 123, [2, 1, -1, -2, 2, -1, -1, 0, 0]), (920, 124, [0, 1, 1, -1, 0, 1, -1, 0, 0]), (920, 125, [0, -1, 0, -1, 0, 1, -1, 0, 0]), (920, 126, [0, -2, 1, -1, 2, 0, -1, -1, 1]), (920, 127, [0, 0, 1, -1, 0, -1, -1, 1, 0]), (920, 128, [0, 0, 1, 2, -1, 1, -1, 0, 1]), (920, 129, [0, 0, 1, -1, 0, -1, -1, 1, 0]), (920, 130, [0, -1, 0, 2, 0, -1, -3, 2, 2]), (920, 131, [0, 1, 0, -2, 0, 1, -3, 0, 1]), (920, 132, [0, -1, 0, -2, 0, 1, -3, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1100.TT) N1100.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1100.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1100. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h911 : ∀ p ∈ LinRQSC911.blobs, LinesCl t5 (t4OfRec p.1)) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1100.nT).map (t4At (LRSpectrumFull.L5S4.dg N1100.TT) N1100.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h892 p hp
  · exact h911 p hp
  · exact h920 p hp
)

#print axioms lines

end R1100
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1859 : the lines clause for every class of the local table of rep #1859 (generated by l5reg)

Every local class `i < nT` of rep #1859 (39 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1859T
import LRSpectrumFull.L5S4.LinRQSC882
import LRSpectrumFull.L5S4.LinRQSC884
import LRSpectrumFull.L5S4.LinRQSC888
import LRSpectrumFull.L5S4.LinRQSC1048
import LRSpectrumFull.L5S4.LinRQSC1049

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1859
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(882, LinRQSC882.blobs), (884, LinRQSC884.blobs), (888, LinRQSC888.blobs), (1048, LinRQSC1048.blobs), (1049, LinRQSC1049.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1049, 5, [2, 1, -2, -3, 1, 1, 2, 2, -3]), (1049, 6, [1, -2, 0, -1, -1, 1, 3, 1, -2]), (1049, 7, [2, 1, -2, -3, -1, 3, -1, 2, 0]), (1049, 8, [2, 1, -2, -3, 1, 1, -1, -2, 2]), (1049, 9, [2, -2, -1, -3, 1, 2, -1, 0, 1]), (1049, 10, [2, -2, -1, -3, -1, 2, -1, -2, 1]), (1048, 189, [1, 0, 1, 3, -1, 1, 2, -2, -1]), (1049, 11, [1, -1, 0, -1, 0, 0, -3, 1, 1]), (1049, 12, [2, -2, -1, -3, 1, 1, 2, -1, -1]), (1049, 13, [1, 2, -1, -1, -3, 1, 3, -2, -2]), (884, 159, [3, 0, -2, -1, 1, 0, -1, -1, 1]), (884, 220, [3, 1, -2, -1, 2, -1, 1, 1, -1]), (1049, 14, [1, -2, 0, -1, -1, 1, 2, 1, -2]), (1049, 15, [2, -1, -1, -3, 1, 2, 0, -3, 2]), (1049, 16, [2, -2, -1, 1, 3, -2, -2, -1, 2]), (1049, 17, [2, -1, -1, 1, 1, -1, -2, -1, 2]), (1049, 18, [2, 1, -2, -3, 1, 1, -1, -2, 2]), (882, 115, [3, 0, -1, 1, -2, 0, 1, -3, 0]), (1049, 19, [2, -1, 0, -3, 1, 0, 0, -3, 1]), (1049, 20, [1, -2, 0, 1, 3, -2, 3, 1, -3]), (1049, 21, [2, -1, 0, -2, -2, 1, 3, -1, 0]), (1049, 22, [2, 1, -1, -3, -1, 1, -1, 2, -1]), (1049, 23, [1, 0, -1, -1, 1, -1, 3, -2, 0]), (1049, 24, [1, 0, -1, -1, 1, -1, 3, -2, 2]), (888, 68, [3, 1, -3, -1, 2, -1, -1, 3, -2]), (1049, 25, [1, 2, 0, -1, -3, 0, 3, 0, -1]), (1049, 26, [2, 1, -2, -3, 1, 2, -1, -1, 1]), (1049, 27, [2, 2, -3, -3, 1, 1, 0, -1, 1]), (1049, 28, [2, -2, 1, -3, -1, 2, -3, 0, 1]), (1049, 29, [2, -1, 1, -3, 1, 1, 0, 0, -1]), (1048, 144, [1, 2, -2, -2, 1, 1, -3, 1, 2]), (1049, 30, [2, 2, -3, 1, -3, 2, -3, 0, 2]), (1049, 31, [2, -1, -1, -3, 1, 2, -3, -2, 4]), (1049, 32, [2, -1, -1, -3, 1, 2, 0, -3, 2]), (1049, 33, [2, -1, -1, -3, 1, 2, -2, -2, 3]), (1049, 34, [2, 1, -2, -3, -1, 3, -1, 2, 0]), (1049, 35, [2, 1, -2, -3, -1, 3, -1, 2, 0]), (1049, 36, [2, 1, -2, -3, -1, 3, -2, 2, 1]), (1049, 37, [2, 1, -2, -3, -1, 3, -1, 2, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1859.TT) N1859.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1859.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1859. -/
theorem lines (t5 : List T5Rec) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1)) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1859.nT).map (t4At (LRSpectrumFull.L5S4.dg N1859.TT) N1859.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h882 p hp
  · exact h884 p hp
  · exact h888 p hp
  · exact h1048 p hp
  · exact h1049 p hp
)

#print axioms lines

end R1859
end L5Reg
end LRSpectrumFull

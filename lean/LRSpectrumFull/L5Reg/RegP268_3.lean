/-- the lines clause for local classes 300..399 of rep #268. -/
theorem lines (t5 : List T5Rec) (h424 : ∀ p ∈ LinRQSC424.blobs, LinesCl t5 (t4OfRec p.1)) (h425 : ∀ p ∈ LinRQSC425.blobs, LinesCl t5 (t4OfRec p.1)) (h426 : ∀ p ∈ LinRQSC426.blobs, LinesCl t5 (t4OfRec p.1)) (h427 : ∀ p ∈ LinRQSC427.blobs, LinesCl t5 (t4OfRec p.1)) (h428 : ∀ p ∈ LinRQSC428.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N268.TT) N268.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h424 p hpe
    · exact h425 p hpe
    · exact h426 p hpe
    · exact h427 p hpe
    · exact h428 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


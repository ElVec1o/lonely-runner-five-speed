/-
# L5Reg.Reg52 : the lines clause for every class of the local table of rep #52 (generated by l5reg)

Every local class `i < nT` of rep #52 (13 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O52T
import LRSpectrumFull.L5S4.LinRQSC2
import LRSpectrumFull.L5S4.LinRQSC36

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R52
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(2, LinRQSC2.blobs), (36, LinRQSC36.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(36, 96, [0, -2, 1, 0, 1, -1, -1, -1, 1]), (36, 97, [2, 0, -1, -1, -4, 2, 0, -3, 1]), (2, 196, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (36, 98, [2, 0, -1, -1, -4, 1, 2, -1, -1]), (36, 99, [2, -1, -1, -1, 0, 1, -2, 1, 2]), (36, 100, [2, 0, -1, -1, -1, 1, -1, 0, 0]), (36, 101, [0, 2, -1, 0, -1, 1, -1, 0, 1]), (36, 102, [0, 2, -1, 0, -1, 1, -1, 0, 0]), (36, 103, [0, 2, -1, 0, -1, 1, -1, 1, 0]), (36, 104, [0, 2, -1, 0, -1, 1, -1, 0, 0]), (36, 105, [2, 0, -1, -1, 0, 0, 0, -1, 1]), (36, 106, [2, 0, -1, -1, 0, 0, -2, -1, 1]), (36, 107, [2, 0, -1, -1, 0, 0, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N52.TT) N52.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N52.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #52. -/
theorem lines (t5 : List T5Rec) (h2 : ∀ p ∈ LinRQSC2.blobs, LinesCl t5 (t4OfRec p.1)) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N52.nT).map (t4At (LRSpectrumFull.L5S4.dg N52.TT) N52.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h2 p hp
  · exact h36 p hp
)

#print axioms lines

end R52
end L5Reg
end LRSpectrumFull

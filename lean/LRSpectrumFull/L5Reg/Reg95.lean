theorem adv_len : adv.length = N95.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #95. -/
theorem lines (t5 : List T5Rec) (h96 : ∀ p ∈ LinRQSC96.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N95.nT).map (t4At (LRSpectrumFull.L5S4.dg N95.TT) N95.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h96 p hp
)


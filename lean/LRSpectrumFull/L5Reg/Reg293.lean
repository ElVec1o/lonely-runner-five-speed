/-- the lines clause for every class of the local table of rep #293. -/
theorem lines (t5 : List T5Rec) (h444 : ∀ p ∈ LinRQSC444.blobs, LinesCl t5 (t4OfRec p.1)) (h445 : ∀ p ∈ LinRQSC445.blobs, LinesCl t5 (t4OfRec p.1)) (h446 : ∀ p ∈ LinRQSC446.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N293.nT).map (t4At (LRSpectrumFull.L5S4.dg N293.TT) N293.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h444 p hp
  · exact h445 p hp
  · exact h446 p hp
)


theorem lines (t5 : List T5Rec) (h200 : ∀ p ∈ LinRQSC200.blobs, LinesCl t5 (t4OfRec p.1)) (h201 : ∀ p ∈ LinRQSC201.blobs, LinesCl t5 (t4OfRec p.1)) (h202 : ∀ p ∈ LinRQSC202.blobs, LinesCl t5 (t4OfRec p.1)) (h203 : ∀ p ∈ LinRQSC203.blobs, LinesCl t5 (t4OfRec p.1)) (h204 : ∀ p ∈ LinRQSC204.blobs, LinesCl t5 (t4OfRec p.1)) (h205 : ∀ p ∈ LinRQSC205.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 0 ≤ c → c < 0 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N262.TT) N262.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl
    · exact h200 p hpe
    · exact h201 p hpe
    · exact h202 p hpe
    · exact h203 p hpe
    · exact h204 p hpe
    · exact h205 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 0 advOk c h1 ?_
  rw [adv_len]; exact h2


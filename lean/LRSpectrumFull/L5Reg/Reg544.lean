/-
# L5Reg.Reg544 : the lines clause for every class of the local table of rep #544 (generated by l5reg)

Every local class `i < nT` of rep #544 (38 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O544T
import LRSpectrumFull.L5S4.LinRQSC799
import LRSpectrumFull.L5S4.LinRQSC800

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R544
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(799, LinRQSC799.blobs), (800, LinRQSC800.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(799, 69, [1, -1, 0, 4, 0, -1, 1, 4, -1]), (799, 70, [1, -1, 0, 4, -3, -1, 0, 1, 0]), (799, 71, [1, -1, 0, 4, 0, -3, 3, 4, -5]), (799, 72, [1, -1, 0, 4, 0, -3, 3, 4, -5]), (799, 73, [1, -1, 0, 4, 0, -1, 1, 4, -1]), (799, 74, [1, 0, -1, 4, -1, -3, 0, -3, 2]), (799, 75, [1, -1, 0, 0, -1, 0, -4, 2, 1]), (799, 76, [1, 0, -1, 4, -1, -3, -1, -3, 3]), (799, 77, [1, -1, 0, 0, -4, 1, -4, -3, 2]), (799, 78, [1, -1, 0, 0, 3, -2, -4, -3, 5]), (799, 79, [1, -1, 0, -3, 0, 2, 1, 4, -3]), (799, 80, [1, -1, 0, -3, -4, 4, 1, -3, 1]), (799, 81, [1, 0, 0, 4, 1, 1, -1, -4, -3]), (799, 82, [1, 0, -1, -3, 1, 2, -4, -1, 4]), (799, 83, [1, 0, 0, 4, -1, -1, 0, 3, 4]), (799, 84, [1, 0, 0, 4, -1, -1, 3, 2, 3]), (799, 85, [1, -1, 0, -3, 0, 2, -3, -4, 5]), (799, 86, [1, 1, -1, 0, -3, 2, 4, -1, -1]), (799, 87, [1, 1, -1, 0, -3, 2, 4, -4, 1]), (799, 88, [1, -1, 0, 0, -4, 3, 4, 1, -4]), (800, 0, [1, -1, 0, 4, 0, -3, -3, -4, 5]), (800, 1, [1, -1, 0, 4, -3, 0, 0, -1, 1]), (800, 2, [1, 0, -1, 4, 1, -4, 1, -2, 0]), (800, 3, [1, 0, -1, 4, 1, -4, 4, -1, -3]), (800, 4, [1, -1, 0, 4, 3, -2, 3, 0, -1]), (800, 5, [1, 1, -1, -3, 4, 1, -4, 0, 3]), (800, 6, [1, -1, 0, 4, 0, -3, -3, -4, 5]), (800, 7, [1, 0, 0, 4, -1, 0, -4, 2, -1]), (800, 8, [1, -1, 0, 4, 3, -5, 0, -3, 2]), (800, 9, [1, -1, 0, -3, -4, 4, -4, -1, 3]), (800, 10, [1, -1, 0, -3, -4, 4, -1, 3, -1]), (800, 11, [1, 1, -1, 4, -3, -2, 0, -3, 1]), (800, 12, [1, -1, 0, 4, 3, -5, 3, 1, -3]), (800, 13, [1, 1, -1, 4, -3, -2, 0, -3, 1]), (800, 14, [0, 1, 0, -1, -3, 1, 5, 1, -4]), (800, 15, [0, -1, 0, -1, 3, 1, 5, -1, -4]), (800, 16, [1, -1, 0, 4, 3, -2, 1, 3, -1]), (800, 17, [1, 0, -1, 4, 1, -4, -2, 2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N544.TT) N544.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N544.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #544. -/
theorem lines (t5 : List T5Rec) (h799 : ∀ p ∈ LinRQSC799.blobs, LinesCl t5 (t4OfRec p.1)) (h800 : ∀ p ∈ LinRQSC800.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N544.nT).map (t4At (LRSpectrumFull.L5S4.dg N544.TT) N544.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h799 p hp
  · exact h800 p hp
)

#print axioms lines

end R544
end L5Reg
end LRSpectrumFull

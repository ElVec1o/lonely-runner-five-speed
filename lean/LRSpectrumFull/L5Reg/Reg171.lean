theorem lines (t5 : List T5Rec) (h54 : ∀ p ∈ LinRQSC54.blobs, LinesCl t5 (t4OfRec p.1)) (h187 : ∀ p ∈ LinRQSC187.blobs, LinesCl t5 (t4OfRec p.1)) (h188 : ∀ p ∈ LinRQSC188.blobs, LinesCl t5 (t4OfRec p.1)) (h189 : ∀ p ∈ LinRQSC189.blobs, LinesCl t5 (t4OfRec p.1))

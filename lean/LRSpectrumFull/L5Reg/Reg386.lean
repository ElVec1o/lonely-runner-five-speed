/-
# L5Reg.Reg386 : the lines clause for every class of the local table of rep #386 (generated by l5reg)

Every local class `i < nT` of rep #386 (8 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O386T
import LRSpectrumFull.L5S4.LinRQSC436
import LRSpectrumFull.L5S4.LinRQSC439
import LRSpectrumFull.L5S4.LinRQSC725

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R386
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(436, LinRQSC436.blobs), (439, LinRQSC439.blobs), (725, LinRQSC725.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(439, 76, [0, 0, -1, 0, -1, -4, 1, 0, 0]), (725, 116, [0, -1, 0, 5, 0, -3, 3, 3, -2]), (725, 117, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (436, 17, [0, 1, 0, 1, 4, -1, 5, 1, -4]), (439, 85, [0, 0, -1, 0, 1, -4, 1, 0, 1]), (725, 118, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (439, 84, [0, -1, 0, 0, -4, 1, 1, -1, 0]), (436, 18, [0, 1, 0, 1, 4, -1, 5, -1, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N386.TT) N386.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N386.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #386. -/
theorem lines (t5 : List T5Rec) (h436 : ∀ p ∈ LinRQSC436.blobs, LinesCl t5 (t4OfRec p.1)) (h439 : ∀ p ∈ LinRQSC439.blobs, LinesCl t5 (t4OfRec p.1)) (h725 : ∀ p ∈ LinRQSC725.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N386.nT).map (t4At (LRSpectrumFull.L5S4.dg N386.TT) N386.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h436 p hp
  · exact h439 p hp
  · exact h725 p hp
)

#print axioms lines

end R386
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h262 : ∀ p ∈ LinRQSC262.blobs, LinesCl t5 (t4OfRec p.1)) (h263 : ∀ p ∈ LinRQSC263.blobs, LinesCl t5 (t4OfRec p.1)) (h264 : ∀ p ∈ LinRQSC264.blobs, LinesCl t5 (t4OfRec p.1)) (h265 : ∀ p ∈ LinRQSC265.blobs, LinesCl t5 (t4OfRec p.1)) (h266 : ∀ p ∈ LinRQSC266.blobs, LinesCl t5 (t4OfRec p.1)) (h267 : ∀ p ∈ LinRQSC267.blobs, LinesCl t5 (t4OfRec p.1)) (h268 : ∀ p ∈ LinRQSC268.blobs, LinesCl t5 (t4OfRec p.1)) (h269 : ∀ p ∈ LinRQSC269.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N265.TT) N265.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact h262 p hpe
    · exact h263 p hpe
    · exact h264 p hpe
    · exact h265 p hpe
    · exact h266 p hpe
    · exact h267 p hpe
    · exact h268 p hpe
    · exact h269 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


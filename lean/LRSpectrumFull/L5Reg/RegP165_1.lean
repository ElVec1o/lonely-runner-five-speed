/-- the lines clause for local classes 100..199 of rep #165. -/
theorem lines (t5 : List T5Rec) (h181 : ∀ p ∈ LinRQSC181.blobs, LinesCl t5 (t4OfRec p.1)) (h182 : ∀ p ∈ LinRQSC182.blobs, LinesCl t5 (t4OfRec p.1))

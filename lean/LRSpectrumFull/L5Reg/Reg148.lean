/-
# L5Reg.Reg148 : the lines clause for every class of the local table of rep #148 (generated by l5reg)

Every local class `i < nT` of rep #148 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O148T
import LRSpectrumFull.L5S4.LinRQSC95
import LRSpectrumFull.L5S4.LinRQSC144

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R148
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(95, LinRQSC95.blobs), (144, LinRQSC144.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(144, 11, [1, 1, -1, -1, 3, 0, 1, -4, 0]), (144, 12, [2, 1, -2, -2, 3, -1, 1, -1, 0]), (144, 13, [1, 0, 0, -1, -2, 1, 0, 3, -1]), (144, 14, [2, -1, -1, -2, 0, 1, 1, -1, 0]), (144, 15, [1, 0, 0, -1, -2, -1, 0, -3, -1]), (144, 16, [1, 0, 0, -1, -1, -2, 1, -1, -1]), (144, 17, [1, 0, 0, -1, -2, 1, 0, 3, -1]), (144, 18, [2, 0, -1, -2, 1, 1, 1, 1, -1]), (144, 19, [2, 0, -1, -2, -1, 1, 1, -1, 0]), (144, 20, [2, 0, -1, -2, -1, 1, 1, 4, -1]), (95, 119, [2, 0, -1, -1, 2, 0, 2, 1, -1]), (144, 21, [2, 0, -1, -2, 1, 0, -1, -2, 2]), (144, 22, [2, 0, -1, -2, -1, 1, 1, 1, 0]), (95, 121, [2, 0, -1, -1, 0, 0, 2, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N148.TT) N148.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N148.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #148. -/
theorem lines (t5 : List T5Rec) (h95 : ∀ p ∈ LinRQSC95.blobs, LinesCl t5 (t4OfRec p.1)) (h144 : ∀ p ∈ LinRQSC144.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N148.nT).map (t4At (LRSpectrumFull.L5S4.dg N148.TT) N148.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h95 p hp
  · exact h144 p hp
)

#print axioms lines

end R148
end L5Reg
end LRSpectrumFull

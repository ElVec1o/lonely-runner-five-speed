/-- the lines clause for local classes 100..199 of rep #160. -/
theorem lines (t5 : List T5Rec) (h44 : ∀ p ∈ LinRQSC44.blobs, LinesCl t5 (t4OfRec p.1)) (h165 : ∀ p ∈ LinRQSC165.blobs, LinesCl t5 (t4OfRec p.1)) (h166 : ∀ p ∈ LinRQSC166.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N160.TT) N160.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h44 p hpe
    · exact h165 p hpe
    · exact h166 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


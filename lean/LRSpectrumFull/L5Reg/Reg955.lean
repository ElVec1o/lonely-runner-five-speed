/-
# L5Reg.Reg955 : the lines clause for every class of the local table of rep #955 (generated by l5reg)

Every local class `i < nT` of rep #955 (33 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O955T
import LRSpectrumFull.L5S4.LinRQSC889

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R955
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(889, LinRQSC889.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(889, 116, [0, 2, -1, 0, -3, 2, -1, 0, 0]), (889, 117, [0, 2, -1, 0, -3, 2, -1, -2, 2]), (889, 118, [2, 0, -1, -3, 0, 1, 0, -1, 0]), (889, 119, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (889, 120, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (889, 121, [2, -1, 0, -3, -2, 3, -2, 0, 1]), (889, 122, [2, -1, -1, -3, -2, 4, 0, 3, -2]), (889, 123, [2, -1, -1, -3, -2, 2, -2, 2, 1]), (889, 124, [2, -1, 0, -3, -2, 3, -1, 3, -2]), (889, 125, [2, -1, -1, -3, -2, 4, 0, 3, -2]), (889, 126, [2, -1, 0, -3, -2, 2, 0, 2, -1]), (889, 127, [2, -1, -1, -3, -2, 2, -2, 2, 1]), (889, 128, [2, -1, 0, -3, 1, 1, -1, 1, 0]), (889, 129, [2, -1, 0, -3, -2, 3, -1, 3, -2]), (889, 130, [2, -1, -1, -3, -2, 4, 0, -3, 2]), (889, 131, [2, -1, 0, -3, -2, 1, 1, -1, 0]), (889, 132, [2, -1, 0, -3, -2, 3, 1, -3, 2]), (889, 133, [2, 0, -1, -3, 0, 1, 2, 1, -2]), (889, 134, [2, 0, -1, -3, 0, 1, 0, 1, -1]), (889, 135, [2, 0, -1, -3, 0, 1, 0, 1, -1]), (889, 136, [2, 0, -1, -3, 0, 1, 2, 1, -1]), (889, 137, [2, 0, -1, -3, 0, 1, 2, 1, -1]), (889, 138, [2, 0, -1, -3, 0, 1, 0, 1, 0]), (889, 139, [2, 0, -1, -3, 0, 1, 0, 1, -1]), (889, 140, [2, 0, -1, -3, 0, 1, 0, 1, -1]), (889, 141, [2, 0, -1, -1, -1, 1, -3, 0, 1]), (889, 142, [2, 0, -1, -3, 0, 1, -1, 1, 0]), (889, 143, [2, 0, -1, -3, 0, 1, 2, 1, -1]), (889, 144, [0, -2, 1, 0, 3, -2, -1, 0, 0]), (889, 145, [0, -2, 1, 0, 3, -2, -1, 1, 0]), (889, 146, [2, 0, -1, -3, 0, 1, 2, 1, -1]), (889, 147, [2, 0, -1, -3, 0, 1, 0, 1, -1]), (889, 148, [2, 0, -1, -3, 0, 1, 2, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N955.TT) N955.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N955.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #955. -/
theorem lines (t5 : List T5Rec) (h889 : ∀ p ∈ LinRQSC889.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N955.nT).map (t4At (LRSpectrumFull.L5S4.dg N955.TT) N955.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h889 p hp
)

#print axioms lines

end R955
end L5Reg
end LRSpectrumFull

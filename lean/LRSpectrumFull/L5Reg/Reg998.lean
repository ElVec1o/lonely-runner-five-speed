theorem lines (t5 : List T5Rec) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1)) (h894 : ∀ p ∈ LinRQSC894.blobs, LinesCl t5 (t4OfRec p.1)) (h895 : ∀ p ∈ LinRQSC895.blobs, LinesCl t5 (t4OfRec p.1)) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h897 : ∀ p ∈ LinRQSC897.blobs, LinesCl t5 (t4OfRec p.1)) (h900 : ∀ p ∈ LinRQSC900.blobs, LinesCl t5 (t4OfRec p.1)) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1)) (h903 : ∀ p ∈ LinRQSC903.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N998.nT).map (t4At (LRSpectrumFull.L5S4.dg N998.TT) N998.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h891 p hp
  · exact h894 p hp
  · exact h895 p hp
  · exact h896 p hp
  · exact h897 p hp
  · exact h900 p hp
  · exact h902 p hp
  · exact h903 p hp
)


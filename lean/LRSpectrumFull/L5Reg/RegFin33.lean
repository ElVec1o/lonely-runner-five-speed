/-
# L5Reg.RegFin33 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg273
import LRSpectrumFull.L5Reg.Reg17
import LRSpectrumFull.L5Reg.Reg972

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines273 : ∀ cl ∈ (List.range N273.nT).map (t4At (LRSpectrumFull.L5S4.dg N273.TT) N273.ST), LinesCl T5Store.t5 cl :=
  R273.lines T5Store.t5 

theorem lines17 : ∀ cl ∈ (List.range N17.nT).map (t4At (LRSpectrumFull.L5S4.dg N17.TT) N17.ST), LinesCl T5Store.t5 cl :=
  R17.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem1 p hp)) (fun p hp => FinalGlue.glines p (mem2 p hp))

theorem lines972 : ∀ cl ∈ (List.range N972.nT).map (t4At (LRSpectrumFull.L5S4.dg N972.TT) N972.ST), LinesCl T5Store.t5 cl :=
  R972.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem894 p hp)) (fun p hp => FinalGlue.glines p (mem895 p hp)) (fun p hp => FinalGlue.glines p (mem896 p hp))

#print axioms lines273

end L5Reg
end LRSpectrumFull

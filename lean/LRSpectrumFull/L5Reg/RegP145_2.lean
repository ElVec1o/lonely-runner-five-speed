/-- the lines clause for local classes 200..299 of rep #145. -/
theorem lines (t5 : List T5Rec) (h141 : ∀ p ∈ LinRQSC141.blobs, LinesCl t5 (t4OfRec p.1)) (h142 : ∀ p ∈ LinRQSC142.blobs, LinesCl t5 (t4OfRec p.1))

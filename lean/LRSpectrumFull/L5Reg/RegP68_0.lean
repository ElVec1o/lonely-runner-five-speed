theorem lines (t5 : List T5Rec) (h46 : ∀ p ∈ LinRQSC46.blobs, LinesCl t5 (t4OfRec p.1)) (h47 : ∀ p ∈ LinRQSC47.blobs, LinesCl t5 (t4OfRec p.1))

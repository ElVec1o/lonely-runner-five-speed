/-- the lines clause for local classes 300..349 of rep #161. -/
theorem lines (t5 : List T5Rec) (h169 : ∀ p ∈ LinRQSC169.blobs, LinesCl t5 (t4OfRec p.1)) (h170 : ∀ p ∈ LinRQSC170.blobs, LinesCl t5 (t4OfRec p.1))

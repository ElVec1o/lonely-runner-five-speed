/-
# L5Reg.Reg1055 : the lines clause for every class of the local table of rep #1055 (generated by l5reg)

Every local class `i < nT` of rep #1055 (5 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1055T
import LRSpectrumFull.L5S4.LinRQSC896
import LRSpectrumFull.L5S4.LinRQSC904
import LRSpectrumFull.L5S4.LinRQSC913

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1055
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(896, LinRQSC896.blobs), (904, LinRQSC904.blobs), (913, LinRQSC913.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(913, 119, [1, 0, -1, 3, -1, -2, 2, 2, -3]), (896, 13, [1, -1, 0, 3, 1, -3, 3, 0, -2]), (913, 120, [1, 0, -1, 3, -1, -2, -3, -1, 3]), (904, 29, [1, 0, -1, 3, 1, -3, -3, 1, 2]), (913, 121, [1, 0, 0, 3, -1, 0, 3, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1055.TT) N1055.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1055.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1055. -/
theorem lines (t5 : List T5Rec) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1)) (h913 : ∀ p ∈ LinRQSC913.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1055.nT).map (t4At (LRSpectrumFull.L5S4.dg N1055.TT) N1055.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h896 p hp
  · exact h904 p hp
  · exact h913 p hp
)

#print axioms lines

end R1055
end L5Reg
end LRSpectrumFull

/-
# L5Reg.RegP264_4 : part 4 of the lines clause of rep #264: local classes 400..404 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O264T
import LRSpectrumFull.L5S4.LinRQSC234

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P264_4
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(234, LinRQSC234.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(234, 0, [1, 0, -1, -2, 0, 1, -1, -1, 1]), (234, 1, [1, 0, -1, -2, 0, 1, 0, -1, 1]), (234, 2, [1, 0, -1, -2, 0, 1, -1, -1, 1]), (234, 3, [1, 0, -1, -2, 0, 1, 0, -1, 1]), (234, 4, [1, 0, -1, -2, 0, 1, -1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N264.TT) N264.ST (assoc bls) 400 adv = true := by decide +kernel

theorem adv_len : adv.length = 5 := by decide +kernel

/-- the lines clause for local classes 400..404 of rep #264. -/
theorem lines (t5 : List T5Rec) (h234 : ∀ p ∈ LinRQSC234.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 5 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N264.TT) N264.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h234 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P264_4
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg46 : the lines clause for every class of the local table of rep #46 (generated by l5reg)

Every local class `i < nT` of rep #46 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O46T
import LRSpectrumFull.L5S4.LinRQSC32

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R46
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(32, LinRQSC32.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(32, 56, [1, 0, 0, -1, 1, -1, -1, 1, 0]), (32, 57, [0, -1, 1, 0, 1, 0, 1, -1, 0]), (32, 58, [1, 0, 0, -1, 0, 1, 0, -1, 0]), (32, 59, [2, -1, 0, -2, 1, 1, 1, -1, 0]), (32, 60, [1, 1, -1, -1, 3, -2, 0, 1, -1]), (32, 61, [1, 0, 0, -1, 0, 1, 0, -1, 0]), (32, 62, [2, -1, 0, -2, 1, 1, 1, -1, 0]), (32, 63, [2, -1, 0, -2, 1, 1, 1, -1, 0]), (32, 64, [1, 0, 0, -1, 0, 1, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N46.TT) N46.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N46.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #46. -/
theorem lines (t5 : List T5Rec) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N46.nT).map (t4At (LRSpectrumFull.L5S4.dg N46.TT) N46.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h32 p hp
)

#print axioms lines

end R46
end L5Reg
end LRSpectrumFull

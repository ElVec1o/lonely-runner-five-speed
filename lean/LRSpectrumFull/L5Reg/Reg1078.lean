/-- the lines clause for every class of the local table of rep #1078. -/
theorem lines (t5 : List T5Rec) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1)) (h911 : ∀ p ∈ LinRQSC911.blobs, LinesCl t5 (t4OfRec p.1)) (h919 : ∀ p ∈ LinRQSC919.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1078.nT).map (t4At (LRSpectrumFull.L5S4.dg N1078.TT) N1078.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h902 p hp
  · exact h904 p hp
  · exact h905 p hp
  · exact h906 p hp
  · exact h911 p hp
  · exact h919 p hp
)

#print axioms lines


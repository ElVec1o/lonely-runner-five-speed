theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N64.TT) N64.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N64.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #64. -/
theorem lines (t5 : List T5Rec) (h41 : ∀ p ∈ LinRQSC41.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N64.nT).map (t4At (LRSpectrumFull.L5S4.dg N64.TT) N64.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h41 p hp
)

#print axioms lines


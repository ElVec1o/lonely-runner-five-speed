/-
# L5Reg.Reg462 : the lines clause for every class of the local table of rep #462 (generated by l5reg)

Every local class `i < nT` of rep #462 (30 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O462T
import LRSpectrumFull.L5S4.LinRQSC727

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R462
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(727, LinRQSC727.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(727, 27, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (727, 28, [1, 0, 0, -1, -4, -1, 4, -1, 0]), (727, 29, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (727, 30, [1, 0, -1, -1, 1, 1, 4, 0, -3]), (727, 31, [1, -1, 0, -1, 0, 0, 4, -2, -1]), (727, 32, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (727, 33, [1, 0, 0, -1, 4, 1, -3, -3, -1]), (727, 34, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (727, 35, [1, 0, 0, -1, -1, 4, -4, 0, -1]), (727, 36, [1, 0, 0, -1, 0, 1, -4, 1, 2]), (727, 37, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (727, 38, [1, 0, -1, -1, 1, 1, 4, 0, -3]), (727, 39, [1, -1, 0, -1, 1, 1, 4, -3, 1]), (727, 40, [1, 0, -1, -1, 1, 1, -3, -1, 2]), (727, 41, [1, 0, 0, 2, -1, 1, 4, 1, 0]), (727, 42, [1, 0, 0, -1, 1, 4, -3, -1, -3]), (727, 43, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (727, 44, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (727, 45, [1, 0, 0, -1, -1, 4, -4, 0, -1]), (727, 46, [1, -1, 0, -1, -2, 1, -4, -3, 2]), (727, 47, [1, 0, 0, 2, -1, 2, 3, 1, -1]), (727, 48, [1, 0, -1, 2, 1, -2, 4, 0, -3]), (727, 49, [1, 0, 0, 2, -1, 1, 4, -2, 1]), (727, 50, [1, 0, 0, 2, -1, 4, 3, 1, -3]), (727, 51, [1, 0, -1, 2, 1, -2, 2, -1, -1]), (727, 52, [0, -1, 0, -1, -2, 1, 1, -2, 0]), (727, 53, [1, 0, 0, 2, 4, -1, 3, -3, 1]), (727, 54, [1, 0, -1, 2, 1, -2, 2, -1, -1]), (727, 55, [1, 0, 0, 2, 4, 1, 4, -1, 0]), (727, 56, [1, 0, 0, 2, -1, 0, 4, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N462.TT) N462.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N462.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #462. -/
theorem lines (t5 : List T5Rec) (h727 : ∀ p ∈ LinRQSC727.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N462.nT).map (t4At (LRSpectrumFull.L5S4.dg N462.TT) N462.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h727 p hp
)

#print axioms lines

end R462
end L5Reg
end LRSpectrumFull

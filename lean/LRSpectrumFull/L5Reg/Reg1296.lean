/-- the lines clause for every class of the local table of rep #1296. -/
theorem lines (t5 : List T5Rec) (h936 : ∀ p ∈ LinRQSC936.blobs, LinesCl t5 (t4OfRec p.1)) (h1003 : ∀ p ∈ LinRQSC1003.blobs, LinesCl t5 (t4OfRec p.1)) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1296.nT).map (t4At (LRSpectrumFull.L5S4.dg N1296.TT) N1296.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h936 p hp
  · exact h1003 p hp
  · exact h1004 p hp
)


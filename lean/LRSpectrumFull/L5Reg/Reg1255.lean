theorem lines (t5 : List T5Rec) (h968 : ∀ p ∈ LinRQSC968.blobs, LinesCl t5 (t4OfRec p.1)) (h969 : ∀ p ∈ LinRQSC969.blobs, LinesCl t5 (t4OfRec p.1)) (h970 : ∀ p ∈ LinRQSC970.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1255.nT).map (t4At (LRSpectrumFull.L5S4.dg N1255.TT) N1255.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h968 p hp
  · exact h969 p hp

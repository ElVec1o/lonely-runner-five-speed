/-
# L5Reg.Reg1390 : the lines clause for every class of the local table of rep #1390 (generated by l5reg)

Every local class `i < nT` of rep #1390 (31 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1390T
import LRSpectrumFull.L5S4.LinRQSC943
import LRSpectrumFull.L5S4.LinRQSC1004
import LRSpectrumFull.L5S4.LinRQSC1021
import LRSpectrumFull.L5S4.LinRQSC1023

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1390
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(943, LinRQSC943.blobs), (1004, LinRQSC1004.blobs), (1021, LinRQSC1021.blobs), (1023, LinRQSC1023.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1023, 124, [1, -1, -1, 1, 0, 0, -3, -1, -2]), (1023, 125, [1, 2, -1, 0, -2, 1, -3, 1, 0]), (1023, 126, [1, 1, -1, 0, -1, 1, -3, 1, 0]), (1004, 165, [1, 0, 0, 2, 2, -1, -3, 1, 0]), (1023, 127, [1, 0, 1, 0, 0, -1, -3, 1, 0]), (1023, 128, [1, 1, -1, 1, 0, -1, -3, 0, 2]), (1023, 129, [0, -1, 0, 1, 0, 0, 0, 2, -1]), (1023, 130, [0, -1, 0, 3, 0, -1, 2, 2, -1]), (1023, 131, [1, -1, -1, 0, 0, -1, 3, -2, 1]), (1023, 132, [2, -1, 0, -2, 0, 1, 1, 3, -3]), (1023, 133, [0, 1, 0, 3, 0, -1, 2, -1, -1]), (1023, 134, [1, -1, 0, 0, 1, -1, -3, -1, 3]), (1023, 135, [0, -1, 0, 3, 0, -2, 1, 3, -1]), (1023, 136, [2, 1, -2, -2, 0, 1, 1, -2, 1]), (1004, 166, [1, 0, 0, 2, -2, 1, -1, -3, 2]), (943, 60, [2, 1, -2, -1, 2, -2, 2, 0, -1]), (1023, 137, [0, 1, 0, 3, 0, -2, 1, -1, -1]), (943, 59, [0, -1, 1, 0, -3, 2, 1, -1, 0]), (1023, 138, [1, -1, 0, -1, 0, 0, 1, 1, -1]), (1023, 139, [1, 0, -1, -1, -1, 1, 1, -1, 0]), (1023, 140, [2, 0, -1, -2, -1, 2, 3, 0, -2]), (1023, 141, [1, 0, 0, -1, -3, 2, 1, -2, 1]), (1023, 142, [2, 1, -2, -2, 0, 1, 3, -1, -1]), (1023, 143, [0, -1, 1, 3, 1, -3, 1, -1, 0]), (1023, 144, [0, -2, 1, 1, 2, -1, 1, -1, 0]), (1023, 145, [1, 0, -1, -1, -3, 2, 1, -2, 0]), (1023, 146, [2, -1, -1, -2, -1, 2, 3, 1, -3]), (1021, 119, [2, 0, -1, 1, -2, 1, -2, -3, 3]), (1023, 147, [0, -1, 0, 1, -1, 0, 1, 2, -1]), (1023, 148, [0, -1, 1, 3, 1, -2, 2, -1, 0]), (1023, 149, [0, -2, 1, 3, 2, -2, 1, -3, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1390.TT) N1390.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1390.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1390. -/
theorem lines (t5 : List T5Rec) (h943 : ∀ p ∈ LinRQSC943.blobs, LinesCl t5 (t4OfRec p.1)) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1)) (h1021 : ∀ p ∈ LinRQSC1021.blobs, LinesCl t5 (t4OfRec p.1)) (h1023 : ∀ p ∈ LinRQSC1023.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1390.nT).map (t4At (LRSpectrumFull.L5S4.dg N1390.TT) N1390.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h943 p hp
  · exact h1004 p hp
  · exact h1021 p hp
  · exact h1023 p hp
)

#print axioms lines

end R1390
end L5Reg
end LRSpectrumFull

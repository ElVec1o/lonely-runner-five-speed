open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

/-- the lines clause for every class of the local table of rep #145. -/
theorem lines (t5 : List T5Rec) (h139 : ∀ p ∈ LinRQSC139.blobs, LinesCl t5 (t4OfRec p.1)) (h140 : ∀ p ∈ LinRQSC140.blobs, LinesCl t5 (t4OfRec p.1)) (h141 : ∀ p ∈ LinRQSC141.blobs, LinesCl t5 (t4OfRec p.1)) (h142 : ∀ p ∈ LinRQSC142.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N145.nT).map (t4At (LRSpectrumFull.L5S4.dg N145.TT) N145.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N145.nT := List.mem_range.1 hc
  have hn : N145.nT = 327 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 327) := by omega
  rcases hcase with h | h | h | h
  · exact P145_0.lines t5 h139 h140 c h.1 (by omega)
  · exact P145_1.lines t5 h140 h141 c h.1 (by omega)
  · exact P145_2.lines t5 h141 h142 c h.1 (by omega)
  · exact P145_3.lines t5 h142 c h.1 (by omega)

#print axioms lines

end R145
end L5Reg
end LRSpectrumFull

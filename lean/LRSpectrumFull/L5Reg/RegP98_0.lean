theorem lines (t5 : List T5Rec) (h6 : ∀ p ∈ LinRQSC6.blobs, LinesCl t5 (t4OfRec p.1)) (h29 : ∀ p ∈ LinRQSC29.blobs, LinesCl t5 (t4OfRec p.1)) (h30 : ∀ p ∈ LinRQSC30.blobs, LinesCl t5 (t4OfRec p.1)) (h99 : ∀ p ∈ LinRQSC99.blobs, LinesCl t5 (t4OfRec p.1)) (h100 : ∀ p ∈ LinRQSC100.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg885 : the lines clause for every class of the local table of rep #885 (generated by l5reg)

Every local class `i < nT` of rep #885 (25 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O885T
import LRSpectrumFull.L5S4.LinRQSC877
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC880
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R885
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(877, LinRQSC877.blobs), (879, LinRQSC879.blobs), (880, LinRQSC880.blobs), (881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 121, [3, 0, -2, -1, 3, 0, -1, -2, 1]), (881, 122, [3, -2, 0, -1, 1, 0, 2, 0, -1]), (880, 119, [3, 1, -3, -2, 1, 1, -1, 1, 0]), (881, 123, [3, -1, -2, -1, 0, 1, -2, 2, 1]), (880, 141, [3, 0, -1, -2, 0, 1, -1, 1, 0]), (881, 124, [3, 0, -1, -1, 1, 0, 1, -2, 0]), (881, 125, [1, -3, 1, -1, 1, 0, -3, 0, 1]), (877, 8, [1, 0, -1, 3, 0, -2, -1, -1, 1]), (877, 5, [1, 0, -1, 3, 0, -2, -1, -1, 1]), (880, 155, [3, -1, -1, -2, 0, 1, 1, 0, 0]), (881, 126, [3, 0, -2, -1, -3, 2, 2, -1, -1]), (881, 127, [1, 0, -1, 1, -3, 1, 3, 2, -4]), (881, 128, [0, 1, -1, -1, 0, 0, 0, 0, -1]), (881, 129, [0, 1, -1, -1, 0, 1, 0, 0, 1]), (880, 22, [1, 3, -2, 3, 0, -1, -1, -1, 1]), (881, 130, [0, 1, -1, -1, 1, 0, 1, 2, -2]), (881, 131, [3, 1, -2, -1, -1, 1, 0, -3, 1]), (880, 14, [0, 1, 0, 0, 3, -1, -1, -1, 1]), (881, 132, [3, 0, -1, -1, -3, 2, 0, 2, -1]), (881, 133, [0, -1, 0, -1, 1, 1, 0, 0, 1]), (879, 219, [0, 1, 0, 2, 2, -1, 3, -1, -1]), (881, 134, [0, -1, 1, -1, -1, 1, 1, -1, 0]), (881, 135, [0, 0, 1, -1, 0, 0, 0, -1, 0]), (881, 136, [0, 0, -1, -3, 1, 1, 2, -1, 2]), (881, 137, [0, 1, 0, -1, -1, 1, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N885.TT) N885.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N885.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #885. -/
theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N885.nT).map (t4At (LRSpectrumFull.L5S4.dg N885.TT) N885.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h877 p hp
  · exact h879 p hp
  · exact h880 p hp
  · exact h881 p hp
)

#print axioms lines

end R885
end L5Reg
end LRSpectrumFull

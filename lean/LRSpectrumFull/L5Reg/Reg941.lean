/-
# L5Reg.Reg941 : the lines clause for every class of the local table of rep #941 (generated by l5reg)

Every local class `i < nT` of rep #941 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O941T
import LRSpectrumFull.L5S4.LinRQSC882
import LRSpectrumFull.L5S4.LinRQSC885
import LRSpectrumFull.L5S4.LinRQSC886
import LRSpectrumFull.L5S4.LinRQSC888

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R941
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(882, LinRQSC882.blobs), (885, LinRQSC885.blobs), (886, LinRQSC886.blobs), (888, LinRQSC888.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(888, 91, [3, -1, -1, 0, 1, -1, -2, -2, 3]), (888, 92, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (885, 110, [1, 0, 0, 3, 1, -1, -2, 2, -1]), (888, 93, [3, 0, -2, 0, 2, -1, -1, -1, 1]), (888, 94, [1, 3, -3, 2, 0, -1, 3, -2, 0]), (888, 95, [1, 3, -2, -1, 0, 1, -2, 2, 1]), (888, 96, [3, -1, 0, 0, -2, 1, -2, -1, 1]), (888, 97, [1, 0, 0, 0, -2, 1, 0, 1, 0]), (885, 123, [3, 0, -1, -1, 1, 0, 0, 2, -1]), (888, 98, [3, 1, -1, 0, 2, -1, -2, 3, -1]), (886, 175, [3, -1, -1, -1, 2, -1, 0, 1, -1]), (888, 99, [0, 0, 1, -1, 0, 0, 1, -1, 0]), (888, 100, [0, 0, 1, -1, 1, 2, 1, 0, 2]), (882, 77, [3, 0, -2, -1, -1, 1, 0, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N941.TT) N941.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N941.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #941. -/
theorem lines (t5 : List T5Rec) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h885 : ∀ p ∈ LinRQSC885.blobs, LinesCl t5 (t4OfRec p.1)) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N941.nT).map (t4At (LRSpectrumFull.L5S4.dg N941.TT) N941.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h882 p hp
  · exact h885 p hp
  · exact h886 p hp
  · exact h888 p hp
)

#print axioms lines

end R941
end L5Reg
end LRSpectrumFull

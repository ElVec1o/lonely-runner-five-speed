/-
# L5Reg.RegFin123 : the lines clause for the local class tables of 1 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg145

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines145 : ∀ cl ∈ (List.range N145.nT).map (t4At (LRSpectrumFull.L5S4.dg N145.TT) N145.ST), LinesCl T5Store.t5 cl :=
  R145.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem139 p hp)) (fun p hp => FinalGlue.glines p (mem140 p hp)) (fun p hp => FinalGlue.glines p (mem141 p hp)) (fun p hp => FinalGlue.glines p (mem142 p hp))

#print axioms lines145

end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1056 : the lines clause for every class of the local table of rep #1056 (generated by l5reg)

Every local class `i < nT` of rep #1056 (32 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1056T
import LRSpectrumFull.L5S4.LinRQSC901
import LRSpectrumFull.L5S4.LinRQSC906
import LRSpectrumFull.L5S4.LinRQSC909
import LRSpectrumFull.L5S4.LinRQSC913

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1056
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(901, LinRQSC901.blobs), (906, LinRQSC906.blobs), (909, LinRQSC909.blobs), (913, LinRQSC913.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(913, 122, [1, 0, -1, 2, -2, -1, 1, 3, -2]), (913, 123, [1, 0, -1, 3, -1, -2, 2, 2, -3]), (909, 63, [2, -1, 0, -1, -2, 1, 1, -1, 0]), (913, 124, [2, 1, -2, -1, 2, 0, 2, -2, -1]), (913, 125, [2, 1, -1, -1, 2, 0, 2, 0, -1]), (913, 126, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (913, 127, [1, -1, 1, 2, 0, -1, 2, -1, 0]), (913, 128, [1, 2, -2, 2, -1, 0, 2, -2, 1]), (901, 95, [2, 0, -1, -3, 0, 1, 1, 1, 0]), (913, 129, [1, 0, -1, -1, -2, 2, -1, 1, 0]), (913, 130, [2, 0, -1, -2, 1, 0, -1, -1, 1]), (913, 131, [1, 0, -1, -1, 1, 0, -1, -1, 1]), (913, 132, [2, -1, 0, -1, -2, 2, 3, 2, -3]), (913, 133, [2, -1, 0, -2, -2, 1, -3, -1, 1]), (913, 134, [2, -1, -1, -1, 1, 0, 2, 1, -2]), (906, 186, [0, 1, 0, -3, 0, 1, 2, 2, -1]), (913, 135, [1, 0, 0, -1, 1, 0, -1, -1, 1]), (913, 136, [2, 0, -1, -2, 1, 1, -1, -1, 1]), (913, 137, [1, -2, 0, -1, 1, 0, -1, -2, 1]), (913, 138, [2, -2, -1, -2, 1, 1, -3, -2, 2]), (913, 139, [2, -1, -1, -1, 1, 0, 3, 1, -3]), (913, 140, [2, 0, -1, -2, -1, 2, -1, 1, -1]), (913, 141, [1, 0, -1, -1, -1, 0, -1, 1, 1]), (913, 142, [2, 1, -1, -1, -1, 1, 3, -1, 0]), (913, 143, [2, -1, 0, -1, -2, 2, 3, 2, -3]), (913, 144, [2, 0, -1, -1, 2, 0, 3, 1, -2]), (913, 145, [0, -1, 0, -1, -2, 1, 1, -2, 0]), (913, 146, [2, 0, -1, -1, -2, 2, 2, -1, 0]), (913, 147, [0, 0, -1, -1, 0, -2, 1, -1, -2]), (913, 148, [1, 2, -2, 2, -2, 1, 2, -1, 0]), (913, 149, [2, 0, -1, -2, -1, 2, -3, 0, 2]), (913, 150, [2, 2, -1, -2, -1, 1, -1, 3, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1056.TT) N1056.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1056.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1056. -/
theorem lines (t5 : List T5Rec) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1)) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1)) (h913 : ∀ p ∈ LinRQSC913.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1056.nT).map (t4At (LRSpectrumFull.L5S4.dg N1056.TT) N1056.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h901 p hp
  · exact h906 p hp
  · exact h909 p hp
  · exact h913 p hp
)

#print axioms lines

end R1056
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1592 : the lines clause for every class of the local table of rep #1592 (generated by l5reg)

Every local class `i < nT` of rep #1592 (11 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1592T
import LRSpectrumFull.L5S4.LinRQSC199
import LRSpectrumFull.L5S4.LinRQSC1026

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1592
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs), (1026, LinRQSC1026.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1026, 183, [2, -2, 1, -1, -3, 3, 0, -1, 1]), (1026, 184, [2, 1, -1, -1, 0, 0, -2, 1, 0]), (1026, 185, [2, 2, -1, -1, 0, 0, -1, 3, -1]), (199, 145, [3, 1, -3, 2, -1, -1, -1, 0, 1]), (1026, 186, [2, 2, -1, 0, -1, 0, 3, -1, -1]), (1026, 187, [2, -1, -1, 0, -1, 0, 3, 0, -2]), (1026, 188, [2, 0, -1, -1, 0, 1, -1, 1, -2]), (1026, 189, [2, 1, -1, -1, 2, 0, 3, 0, -1]), (1026, 190, [2, -1, 1, -1, 0, 1, 0, 0, 1]), (1026, 191, [2, -1, -1, -2, 0, 1, -1, -2, 1]), (1026, 192, [0, -1, 2, -1, -1, 1, 0, -2, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1592.TT) N1592.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1592.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1592. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1592.nT).map (t4At (LRSpectrumFull.L5S4.dg N1592.TT) N1592.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h199 p hp
  · exact h1026 p hp
)

#print axioms lines

end R1592
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h933 : ∀ p ∈ LinRQSC933.blobs, LinesCl t5 (t4OfRec p.1)) (h934 : ∀ p ∈ LinRQSC934.blobs, LinesCl t5 (t4OfRec p.1)) (h963 : ∀ p ∈ LinRQSC963.blobs, LinesCl t5 (t4OfRec p.1)) (h964 : ∀ p ∈ LinRQSC964.blobs, LinesCl t5 (t4OfRec p.1))

/-- the lines clause for local classes 0..99 of rep #322. -/
theorem lines (t5 : List T5Rec) (h687 : ∀ p ∈ LinRQSC687.blobs, LinesCl t5 (t4OfRec p.1)) (h688 : ∀ p ∈ LinRQSC688.blobs, LinesCl t5 (t4OfRec p.1))

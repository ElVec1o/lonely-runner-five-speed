/-- the lines clause for every class of the local table of rep #634. -/
theorem lines (t5 : List T5Rec) (h774 : ∀ p ∈ LinRQSC774.blobs, LinesCl t5 (t4OfRec p.1)) (h852 : ∀ p ∈ LinRQSC852.blobs, LinesCl t5 (t4OfRec p.1)) (h853 : ∀ p ∈ LinRQSC853.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N634.nT).map (t4At (LRSpectrumFull.L5S4.dg N634.TT) N634.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h774 p hp
  · exact h852 p hp
  · exact h853 p hp
)

#print axioms lines


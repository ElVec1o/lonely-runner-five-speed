theorem lines (t5 : List T5Rec) (h39 : ∀ p ∈ LinRQSC39.blobs, LinesCl t5 (t4OfRec p.1)) (h40 : ∀ p ∈ LinRQSC40.blobs, LinesCl t5 (t4OfRec p.1)) (h42 : ∀ p ∈ LinRQSC42.blobs, LinesCl t5 (t4OfRec p.1)) (h117 : ∀ p ∈ LinRQSC117.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg342 : the lines clause for every class of the local table of rep #342 (generated by l5reg)

Every local class `i < nT` of rep #342 (39 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O342T
import LRSpectrumFull.L5S4.LinRQSC703
import LRSpectrumFull.L5S4.LinRQSC704

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R342
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(703, LinRQSC703.blobs), (704, LinRQSC704.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(703, 79, [1, -1, 0, 3, -2, 0, 1, 0, 1]), (703, 80, [1, -1, 0, 3, 1, -3, -2, -3, 4]), (703, 81, [1, -1, 0, -1, -3, 1, -4, -3, 2]), (703, 82, [1, -1, 0, -1, -3, 3, -4, -1, 4]), (703, 83, [1, -1, 0, 3, -2, 0, -1, 0, 1]), (703, 84, [1, -1, 0, -1, 0, 0, -3, 2, 1]), (703, 85, [1, -1, 0, 3, 1, -1, -2, -3, 1]), (703, 86, [1, -1, 0, -1, -3, 3, -4, -3, 5]), (703, 87, [1, -1, 0, 3, -1, -1, -3, 0, 2]), (703, 88, [1, -1, 0, 3, -1, -1, -3, 0, 1]), (703, 89, [1, -1, 0, -1, -1, 1, -4, 1, 2]), (703, 90, [1, -1, 0, -1, -3, 1, -4, -3, 2]), (703, 91, [1, 0, 0, -1, -1, 1, -4, 0, 1]), (703, 92, [1, 0, -1, 3, 3, -4, -4, 2, 3]), (704, 0, [1, -1, 0, -1, 2, 0, -4, -3, 1]), (704, 1, [1, -1, 0, 3, -2, 0, -3, 2, 1]), (704, 2, [1, -1, 0, -1, 2, 0, -4, -2, 1]), (704, 3, [1, -1, 0, -1, 2, 0, -4, -3, 1]), (704, 4, [1, 1, -1, 3, -2, 1, -3, 1, 0]), (704, 5, [1, -1, 0, -1, 2, 0, -4, -3, 1]), (704, 6, [1, -1, 0, -1, 2, 0, -4, -3, 1]), (704, 7, [1, 0, -1, 3, -3, -2, -3, -4, 4]), (704, 8, [1, 0, -1, 3, -1, -2, -3, -1, 3]), (704, 9, [1, -1, 0, -2, 1, 1, 4, 3, -6]), (704, 10, [0, -1, 0, 1, 1, 0, 1, -1, -1]), (704, 11, [1, 0, -1, -2, 3, 1, 3, 1, -3]), (704, 12, [1, 1, -1, -2, 3, 1, 2, 1, -2]), (704, 13, [1, -1, 0, -2, 1, 1, 4, 3, -6]), (704, 14, [0, -1, 0, 1, -3, 0, 1, 4, -1]), (704, 15, [0, 1, 0, 3, 3, -2, 5, -1, -3]), (704, 16, [1, -1, 0, -2, 1, 1, 4, 3, -6]), (704, 17, [1, -1, 0, -2, 1, 1, 3, 4, -6]), (704, 18, [1, -1, 0, -2, -3, 4, 4, 2, -5]), (704, 19, [1, 0, -1, 3, 0, -2, -2, -1, 1]), (704, 20, [1, -1, 0, -2, -3, 4, 3, 1, -3]), (704, 21, [1, -1, 0, -2, -3, 3, 4, 3, -4]), (704, 22, [0, 1, 0, 3, 3, -1, 4, -2, -1]), (704, 23, [1, -1, 0, -2, -3, 4, 3, 1, -3]), (704, 24, [1, -1, 0, -2, -3, 2, 3, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N342.TT) N342.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N342.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #342. -/
theorem lines (t5 : List T5Rec) (h703 : ∀ p ∈ LinRQSC703.blobs, LinesCl t5 (t4OfRec p.1)) (h704 : ∀ p ∈ LinRQSC704.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N342.nT).map (t4At (LRSpectrumFull.L5S4.dg N342.TT) N342.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h703 p hp
  · exact h704 p hp
)

#print axioms lines

end R342
end L5Reg
end LRSpectrumFull

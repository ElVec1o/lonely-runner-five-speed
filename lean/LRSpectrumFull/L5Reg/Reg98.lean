/-- the lines clause for every class of the local table of rep #98. -/
theorem lines (t5 : List T5Rec) (h6 : ∀ p ∈ LinRQSC6.blobs, LinesCl t5 (t4OfRec p.1)) (h29 : ∀ p ∈ LinRQSC29.blobs, LinesCl t5 (t4OfRec p.1)) (h30 : ∀ p ∈ LinRQSC30.blobs, LinesCl t5 (t4OfRec p.1)) (h99 : ∀ p ∈ LinRQSC99.blobs, LinesCl t5 (t4OfRec p.1)) (h100 : ∀ p ∈ LinRQSC100.blobs, LinesCl t5 (t4OfRec p.1)) (h101 : ∀ p ∈ LinRQSC101.blobs, LinesCl t5 (t4OfRec p.1)) (h102 : ∀ p ∈ LinRQSC102.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N98.nT).map (t4At (LRSpectrumFull.L5S4.dg N98.TT) N98.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N98.nT := List.mem_range.1 hc
  have hn : N98.nT = 306 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 306) := by omega
  rcases hcase with h | h | h | h
  · exact P98_0.lines t5 h6 h29 h30 h99 h100 c h.1 (by omega)
  · exact P98_1.lines t5 h29 h100 h101 c h.1 (by omega)
  · exact P98_2.lines t5 h101 h102 c h.1 (by omega)
  · exact P98_3.lines t5 h102 c h.1 (by omega)

#print axioms lines

end R98

/-- the lines clause for local classes 300..399 of rep #262. -/
theorem lines (t5 : List T5Rec) (h213 : ∀ p ∈ LinRQSC213.blobs, LinesCl t5 (t4OfRec p.1)) (h214 : ∀ p ∈ LinRQSC214.blobs, LinesCl t5 (t4OfRec p.1)) (h215 : ∀ p ∈ LinRQSC215.blobs, LinesCl t5 (t4OfRec p.1)) (h216 : ∀ p ∈ LinRQSC216.blobs, LinesCl t5 (t4OfRec p.1)) (h217 : ∀ p ∈ LinRQSC217.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N262.TT) N262.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h213 p hpe
    · exact h214 p hpe
    · exact h215 p hpe
    · exact h216 p hpe
    · exact h217 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


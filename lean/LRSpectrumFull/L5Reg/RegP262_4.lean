theorem lines (t5 : List T5Rec) (h217 : ∀ p ∈ LinRQSC217.blobs, LinesCl t5 (t4OfRec p.1)) (h218 : ∀ p ∈ LinRQSC218.blobs, LinesCl t5 (t4OfRec p.1)) (h219 : ∀ p ∈ LinRQSC219.blobs, LinesCl t5 (t4OfRec p.1)) (h220 : ∀ p ∈ LinRQSC220.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg1372 : the lines clause for every class of the local table of rep #1372 (generated by l5reg)

Every local class `i < nT` of rep #1372 (35 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1372T
import LRSpectrumFull.L5S4.LinRQSC996
import LRSpectrumFull.L5S4.LinRQSC997
import LRSpectrumFull.L5S4.LinRQSC1021
import LRSpectrumFull.L5S4.LinRQSC1022

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1372
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(996, LinRQSC996.blobs), (997, LinRQSC997.blobs), (1021, LinRQSC1021.blobs), (1022, LinRQSC1022.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(997, 29, [2, -1, 0, -3, 1, 0, -1, -1, 1]), (1021, 231, [2, 0, -1, 1, -3, 0, -3, -2, 2]), (1021, 232, [2, 0, -1, 1, -3, 2, -2, -1, 2]), (996, 85, [2, -1, -1, -3, 1, 2, 1, -2, 0]), (1021, 233, [2, 0, -1, 1, -3, 2, -2, 1, 0]), (996, 132, [2, -1, -1, -3, -1, 3, 1, 0, -1]), (1021, 234, [2, 1, -2, 1, -1, 0, 2, -1, -1]), (1022, 0, [2, 0, -1, 1, -3, 0, -2, 1, 1]), (1022, 1, [2, -1, 0, 1, 0, -1, -2, 2, -1]), (1022, 2, [2, 1, -1, 1, 2, -1, -3, 1, 1]), (996, 108, [2, 1, -2, -3, 1, 2, 2, -1, -1]), (1022, 3, [1, 2, -1, 0, 1, 0, 3, -1, -2]), (1022, 4, [2, 0, -1, 1, 3, -1, 2, 1, -1]), (997, 63, [2, 1, -2, -3, 1, 1, -1, -2, 2]), (1022, 5, [1, -1, 0, -1, 0, 0, 2, 1, -1]), (1022, 6, [2, -1, 0, 1, -1, 0, 3, -2, 1]), (996, 118, [2, -1, -1, -3, 1, 2, 1, -2, 0]), (1022, 7, [2, 1, -1, 1, -1, 0, -2, 1, 0]), (1022, 8, [2, 0, -1, 1, -3, 2, -1, -2, 2]), (1022, 9, [2, -1, 0, 1, 0, 0, 2, 2, -1]), (997, 9, [2, 1, -2, -3, 1, 2, -1, 0, 1]), (997, 43, [2, 1, -1, -3, 1, 0, 1, 0, 0]), (1022, 10, [1, 1, -1, 2, 0, -1, -3, 0, 1]), (1022, 11, [0, -1, 1, 1, 1, 0, 0, -3, 2]), (1022, 12, [1, 0, -1, 2, 1, -2, -3, 0, 2]), (1022, 13, [0, -2, 1, 1, 0, -1, 0, 1, -1]), (1022, 14, [0, -1, 1, 1, 1, -1, 0, -3, 2]), (1022, 15, [0, 1, -1, 1, 2, -2, 0, -3, 2]), (1022, 16, [1, -1, 0, -1, 0, 1, 2, 1, -2]), (1022, 17, [1, 1, -1, -1, 0, 1, 4, 0, -3]), (1022, 18, [1, 0, 0, 2, -1, 0, -3, 0, 1]), (1022, 19, [1, 0, -1, 2, 3, -3, -3, 2, 2]), (1022, 20, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (1022, 21, [0, -1, 0, 1, -2, 0, 1, 2, -1]), (1022, 22, [0, 2, -1, 3, 1, -1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1372.TT) N1372.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1372.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1372. -/
theorem lines (t5 : List T5Rec) (h996 : ∀ p ∈ LinRQSC996.blobs, LinesCl t5 (t4OfRec p.1)) (h997 : ∀ p ∈ LinRQSC997.blobs, LinesCl t5 (t4OfRec p.1)) (h1021 : ∀ p ∈ LinRQSC1021.blobs, LinesCl t5 (t4OfRec p.1)) (h1022 : ∀ p ∈ LinRQSC1022.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1372.nT).map (t4At (LRSpectrumFull.L5S4.dg N1372.TT) N1372.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h996 p hp
  · exact h997 p hp
  · exact h1021 p hp
  · exact h1022 p hp
)

#print axioms lines

end R1372
end L5Reg
end LRSpectrumFull

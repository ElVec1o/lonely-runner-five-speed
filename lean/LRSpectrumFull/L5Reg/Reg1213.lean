/-
# L5Reg.Reg1213 : the lines clause for every class of the local table of rep #1213 (generated by l5reg)

Every local class `i < nT` of rep #1213 (34 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1213T
import LRSpectrumFull.L5S4.LinRQSC956

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1213
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(956, LinRQSC956.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(956, 56, [0, -2, -1, 0, 1, 1, -1, -1, -1]), (956, 57, [1, 0, -1, 3, -2, 0, -3, 1, 1]), (956, 58, [1, -1, 0, 3, -1, -1, 2, 3, -2]), (956, 59, [1, 1, -1, 3, 1, -2, -2, 3, 0]), (956, 60, [1, 1, -1, 3, 1, -2, 0, 3, -1]), (956, 61, [1, -1, 0, 1, -3, 1, -3, -2, 3]), (956, 62, [1, 1, -1, 3, 1, -2, 0, -3, 2]), (956, 63, [1, -2, 0, 3, 1, -2, -1, -1, 1]), (956, 64, [1, 1, -1, 3, -1, 0, -2, -1, 1]), (956, 65, [1, 1, -1, 1, 3, -2, -3, 2, 0]), (956, 66, [1, 1, -1, 3, 1, -2, 0, -3, 2]), (956, 67, [1, 1, -1, 3, 1, -2, 2, -3, 1]), (956, 68, [2, -1, -1, -1, -3, 1, 1, 2, -1]), (956, 69, [2, -1, 0, -1, 0, 1, 2, 0, -1]), (956, 70, [1, 0, -1, -1, 1, 0, -2, 0, 1]), (956, 71, [2, -1, -1, -1, -3, 2, 2, 1, -2]), (956, 72, [2, 1, -1, -1, 3, -1, 1, -1, 0]), (956, 73, [1, 2, -1, -1, -1, 1, -3, 1, 2]), (956, 74, [2, 1, -2, -1, -1, 1, 1, -3, 0]), (956, 75, [2, -1, 0, -1, -3, 3, 2, 0, -1]), (956, 76, [2, 1, -2, -1, 3, -1, 3, 0, -2]), (956, 77, [2, 1, -1, -1, 3, -2, 1, 0, 0]), (956, 78, [1, 1, -1, -1, 3, -2, -3, 0, 1]), (956, 79, [2, 1, -2, -1, -1, 1, 3, -2, -2]), (956, 80, [2, 1, -2, -1, 3, -1, 2, -1, -1]), (956, 81, [2, 1, -2, -1, 3, -2, 2, 0, -1]), (956, 82, [1, 2, -1, -1, -1, 1, -3, 2, 2]), (956, 83, [1, -1, 0, -1, -1, 1, -3, 2, 1]), (956, 84, [1, -2, 0, -1, 1, 0, -3, -2, 1]), (956, 85, [2, 1, -2, -1, -1, 1, 2, -3, -1]), (956, 86, [2, -1, -1, -1, 1, 0, 3, 2, -4]), (956, 87, [2, -1, 0, -1, -3, 2, 3, 0, -1]), (956, 88, [2, 1, -2, -1, 3, 0, 1, 0, -1]), (956, 89, [2, -1, -1, -1, 1, 0, 1, 4, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1213.TT) N1213.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1213.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1213. -/
theorem lines (t5 : List T5Rec) (h956 : ∀ p ∈ LinRQSC956.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1213.nT).map (t4At (LRSpectrumFull.L5S4.dg N1213.TT) N1213.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h956 p hp
)

#print axioms lines

end R1213
end L5Reg
end LRSpectrumFull

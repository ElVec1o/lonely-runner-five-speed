/-
# L5Reg.Reg1106 : the lines clause for every class of the local table of rep #1106 (generated by l5reg)

Every local class `i < nT` of rep #1106 (26 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1106T
import LRSpectrumFull.L5S4.LinRQSC920
import LRSpectrumFull.L5S4.LinRQSC921

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1106
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(920, LinRQSC920.blobs), (921, LinRQSC921.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(920, 232, [1, 0, -1, 2, -1, -1, -2, -1, 2]), (920, 233, [1, 0, -1, 2, 2, -3, 3, -1, -2]), (920, 234, [1, 0, -1, 2, 2, -3, -3, 1, 2]), (920, 235, [2, 0, -1, 1, 2, -1, -3, -1, 2]), (920, 236, [2, -2, -1, 1, 0, -1, -3, -1, 3]), (920, 237, [2, -2, -1, 0, -1, 0, 3, 2, -2]), (920, 238, [2, 0, -1, 0, 1, 0, 3, 0, -2]), (920, 239, [1, -2, 0, 0, -1, 0, 1, 3, -1]), (920, 240, [2, -1, -1, 0, -1, 0, 3, -2, -1]), (920, 241, [2, 2, -3, 0, 1, -1, -3, 2, 0]), (921, 0, [1, -1, 0, 0, -2, 1, -1, 0, 1]), (921, 1, [2, -2, 1, 0, -1, 1, -1, -3, 3]), (921, 2, [2, -1, 0, 1, -2, 1, 3, 1, -2]), (921, 3, [1, 0, 0, 0, -1, 2, -1, 0, -1]), (921, 4, [1, -1, 1, 2, -1, 0, -2, 0, 1]), (921, 5, [2, 2, -1, 1, 0, 0, 3, -1, 0]), (921, 6, [2, -1, -1, 0, -2, 1, -1, 0, 1]), (921, 7, [2, -1, 0, 1, -2, 1, 3, 1, -2]), (921, 8, [2, -1, 0, 1, -1, 0, 2, 0, -1]), (921, 9, [2, -1, -1, 0, -1, 0, -1, 1, 0]), (921, 10, [0, 2, -1, -2, 1, 0, 3, 1, -1]), (921, 11, [0, 2, -1, -2, 1, 1, 3, 0, -2]), (921, 12, [1, 2, -2, 2, 0, -1, 3, -1, -1]), (921, 13, [2, 1, -1, 1, 2, -1, 2, 0, -1]), (921, 14, [0, 0, -1, -2, 1, 0, 3, -2, 0]), (921, 15, [0, 1, 0, 2, 2, -1, 1, -2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1106.TT) N1106.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1106.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1106. -/
theorem lines (t5 : List T5Rec) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1)) (h921 : ∀ p ∈ LinRQSC921.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1106.nT).map (t4At (LRSpectrumFull.L5S4.dg N1106.TT) N1106.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h920 p hp
  · exact h921 p hp
)

#print axioms lines

end R1106
end L5Reg
end LRSpectrumFull

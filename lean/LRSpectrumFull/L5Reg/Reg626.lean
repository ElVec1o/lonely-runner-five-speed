/-
# L5Reg.Reg626 : the lines clause for every class of the local table of rep #626 (generated by l5reg)

Every local class `i < nT` of rep #626 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O626T
import LRSpectrumFull.L5S4.LinRQSC756
import LRSpectrumFull.L5S4.LinRQSC757
import LRSpectrumFull.L5S4.LinRQSC841

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R626
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(756, LinRQSC756.blobs), (757, LinRQSC757.blobs), (841, LinRQSC841.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(841, 53, [1, 0, -1, -1, -3, 3, -4, 1, 3]), (841, 54, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (841, 55, [1, 0, -1, -1, -3, 2, 3, -2, -2]), (841, 56, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (841, 57, [1, -1, 0, -1, -1, 1, 4, -1, -2]), (841, 58, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (841, 59, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (756, 91, [1, -1, 0, 3, -2, -1, -1, 0, 0]), (841, 60, [1, -1, 0, -1, 1, 1, -4, 3, 2]), (841, 61, [1, 0, -1, -1, -1, 1, -4, 0, 3]), (841, 62, [1, -1, 0, -1, 1, -1, 4, -3, 0]), (841, 63, [1, 0, -1, -1, -2, 2, 3, -1, -2]), (841, 64, [1, -1, 0, -1, 1, 1, 4, -3, 0]), (841, 65, [1, 0, -1, 3, 2, -4, 1, -3, 1]), (841, 66, [1, 0, -1, -1, 1, 0, -3, -1, 3]), (841, 67, [1, 0, -1, -1, 1, 0, -3, -1, 3]), (841, 68, [1, 0, -1, -1, -1, 1, -4, 0, 3]), (841, 69, [1, 0, 0, 3, 2, 3, 4, -1, -1]), (841, 70, [1, 0, -1, 3, 1, -3, 2, -1, -1]), (757, 22, [1, 0, 0, -3, 2, 1, -3, -3, -2]), (841, 71, [1, -1, 1, 3, -2, -1, 2, -1, -1]), (841, 72, [1, -1, 0, -1, -3, 1, -2, -1, 1]), (841, 73, [1, 1, -1, 3, -1, -2, 3, -2, -2]), (841, 74, [1, 0, -1, 3, 1, -3, 3, -1, -2]), (841, 75, [1, 0, 0, 3, 3, 1, 1, -4, -1]), (841, 76, [1, 1, -1, 3, -1, 0, 2, -1, 0]), (841, 77, [1, 0, -1, 3, 1, -3, 3, -1, -2]), (841, 78, [1, 0, -1, 3, -3, -2, 2, 4, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N626.TT) N626.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N626.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #626. -/
theorem lines (t5 : List T5Rec) (h756 : ∀ p ∈ LinRQSC756.blobs, LinesCl t5 (t4OfRec p.1)) (h757 : ∀ p ∈ LinRQSC757.blobs, LinesCl t5 (t4OfRec p.1)) (h841 : ∀ p ∈ LinRQSC841.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N626.nT).map (t4At (LRSpectrumFull.L5S4.dg N626.TT) N626.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h756 p hp
  · exact h757 p hp
  · exact h841 p hp
)

#print axioms lines

end R626
end L5Reg
end LRSpectrumFull

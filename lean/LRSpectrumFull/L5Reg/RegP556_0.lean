theorem lines (t5 : List T5Rec) (h826 : ∀ p ∈ LinRQSC826.blobs, LinesCl t5 (t4OfRec p.1)) (h827 : ∀ p ∈ LinRQSC827.blobs, LinesCl t5 (t4OfRec p.1)) (h828 : ∀ p ∈ LinRQSC828.blobs, LinesCl t5 (t4OfRec p.1))

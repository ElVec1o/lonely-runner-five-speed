/-
# L5Reg.Reg1223 : the lines clause for every class of the local table of rep #1223 (generated by l5reg)

Every local class `i < nT` of rep #1223 (24 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1223T
import LRSpectrumFull.L5S4.LinRQSC958

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1223
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(958, LinRQSC958.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(958, 72, [2, -1, 0, 0, 1, -1, -3, 2, 0]), (958, 73, [1, -1, 0, 0, 1, 0, 1, 3, -1]), (958, 74, [1, 0, -1, 3, 1, -3, 2, -2, -1]), (958, 75, [1, 0, 0, 3, -1, 0, 3, 1, -1]), (958, 76, [1, 0, -1, 3, -1, -1, 1, 0, 0]), (958, 77, [1, 1, -1, 0, 3, -2, -1, 3, -2]), (958, 78, [2, -1, 0, 0, 1, -1, -3, -1, 2]), (958, 79, [2, 0, -1, 0, 1, 0, 3, 0, -2]), (958, 80, [1, 1, -1, 0, 3, -2, 1, -3, 2]), (958, 81, [1, -1, 0, 3, 2, -2, 0, -3, 1]), (958, 82, [1, 1, -1, 3, 0, -2, 1, -1, 0]), (958, 83, [1, 1, -1, 3, 0, -2, 3, -1, -2]), (958, 84, [1, 1, -1, -1, -2, 2, -4, 0, 1]), (958, 85, [1, 0, -1, 3, 1, -3, 2, -1, -1]), (958, 86, [1, -1, 0, 3, 2, -4, 2, -1, -1]), (958, 87, [1, 1, -1, 0, 3, -2, 1, 0, 0]), (958, 88, [1, -1, 0, 0, 1, 0, -1, -1, 1]), (958, 89, [1, -1, 0, -2, -3, 1, 2, -3, 0]), (958, 90, [1, 0, 0, -2, -1, 2, 2, -1, 1]), (958, 91, [1, 1, -1, -2, 3, 0, 3, 1, -2]), (958, 92, [1, -1, 0, -2, 1, 0, 2, -2, 1]), (958, 93, [1, -1, 0, -1, -3, 3, -3, 2, 1]), (958, 94, [1, 0, -1, -2, -1, 1, 4, 0, -3]), (958, 95, [1, 2, -2, -2, 0, 1, 3, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1223.TT) N1223.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1223.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1223. -/
theorem lines (t5 : List T5Rec) (h958 : ∀ p ∈ LinRQSC958.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1223.nT).map (t4At (LRSpectrumFull.L5S4.dg N1223.TT) N1223.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h958 p hp
)

#print axioms lines

end R1223
end L5Reg
end LRSpectrumFull

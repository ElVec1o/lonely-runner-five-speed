/-
# L5Reg.RegP520_5 : part 5 of the lines clause of rep #520: local classes 500..525 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O520T
import LRSpectrumFull.L5S4.LinRQSC771
import LRSpectrumFull.L5S4.LinRQSC772

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P520_5
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(771, LinRQSC771.blobs), (772, LinRQSC772.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(771, 76, [1, 1, -1, -2, -1, 2, -2, 3, 1]), (771, 77, [1, -1, 0, -2, 1, 1, -3, -3, 5]), (771, 78, [1, 1, -1, -2, 2, -1, -2, 1, 0]), (771, 79, [1, 0, 0, -2, 2, -1, -2, 1, 0]), (771, 80, [1, 1, -1, -2, 2, 1, -2, -1, 2]), (771, 81, [1, 0, 0, -2, 1, 0, -3, 1, 1]), (771, 82, [1, -1, 0, -2, -2, 1, -3, 0, 1]), (771, 83, [1, -1, 0, -2, 0, 1, -2, 1, 1]), (771, 84, [1, 0, -1, -2, 2, 1, -4, -1, 4]), (771, 85, [1, 0, 0, -2, 1, 0, -3, 1, 1]), (771, 86, [1, -1, 0, -2, -2, 1, -2, -1, 1]), (771, 87, [1, -1, 0, -2, 0, 1, -2, 1, 1]), (771, 88, [1, -1, 0, -2, -2, 3, -2, 1, 1]), (772, 0, [1, -1, 0, -2, 1, 0, -3, 2, 1]), (772, 1, [1, 0, -1, -2, 1, 1, -4, -1, 4]), (772, 2, [1, 0, -1, -2, -1, 2, -3, 1, 2]), (772, 3, [1, -1, 0, -2, 1, -1, -3, 2, 0]), (772, 4, [1, -1, 0, -2, -2, 1, -2, -1, 1]), (772, 5, [1, 0, -1, -2, 2, 1, -3, -3, 4]), (772, 6, [1, 0, -1, -2, 1, 1, -4, -1, 4]), (772, 7, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (772, 8, [1, -1, 0, -1, 2, 0, 4, 4, -1]), (772, 9, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (772, 10, [1, -1, 0, -2, 1, 1, -4, -3, 6]), (772, 11, [1, 1, -1, -2, -1, 2, -3, 3, 2]), (772, 12, [1, 0, -1, -2, 1, 1, -4, -1, 4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N520.TT) N520.ST (assoc bls) 500 adv = true := by decide +kernel

theorem adv_len : adv.length = 26 := by decide +kernel

/-- the lines clause for local classes 500..525 of rep #520. -/
theorem lines (t5 : List T5Rec) (h771 : ∀ p ∈ LinRQSC771.blobs, LinesCl t5 (t4OfRec p.1)) (h772 : ∀ p ∈ LinRQSC772.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 500 ≤ c → c < 500 + 26 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N520.TT) N520.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl
    · exact h771 p hpe
    · exact h772 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 500 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P520_5
end L5Reg
end LRSpectrumFull

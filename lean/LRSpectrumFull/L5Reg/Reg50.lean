theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N50.TT) N50.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N50.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #50. -/
theorem lines (t5 : List T5Rec) (h34 : ∀ p ∈ LinRQSC34.blobs, LinesCl t5 (t4OfRec p.1)) (h35 : ∀ p ∈ LinRQSC35.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N50.nT).map (t4At (LRSpectrumFull.L5S4.dg N50.TT) N50.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h34 p hp
  · exact h35 p hp
)


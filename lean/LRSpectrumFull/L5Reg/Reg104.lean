/-- the lines clause for every class of the local table of rep #104. -/
theorem lines (t5 : List T5Rec) (h34 : ∀ p ∈ LinRQSC34.blobs, LinesCl t5 (t4OfRec p.1)) (h35 : ∀ p ∈ LinRQSC35.blobs, LinesCl t5 (t4OfRec p.1)) (h108 : ∀ p ∈ LinRQSC108.blobs, LinesCl t5 (t4OfRec p.1)) (h109 : ∀ p ∈ LinRQSC109.blobs, LinesCl t5 (t4OfRec p.1)) (h110 : ∀ p ∈ LinRQSC110.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N104.nT).map (t4At (LRSpectrumFull.L5S4.dg N104.TT) N104.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h34 p hp
  · exact h35 p hp
  · exact h108 p hp
  · exact h109 p hp
  · exact h110 p hp
)


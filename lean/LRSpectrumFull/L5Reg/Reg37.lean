theorem adv_len : adv.length = N37.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #37. -/
theorem lines (t5 : List T5Rec) (h6 : ∀ p ∈ LinRQSC6.blobs, LinesCl t5 (t4OfRec p.1)) (h7 : ∀ p ∈ LinRQSC7.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N37.nT).map (t4At (LRSpectrumFull.L5S4.dg N37.TT) N37.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h6 p hp
  · exact h7 p hp
)


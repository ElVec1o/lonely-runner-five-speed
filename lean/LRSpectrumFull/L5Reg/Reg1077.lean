/-
# L5Reg.Reg1077 : the lines clause for every class of the local table of rep #1077 (generated by l5reg)

Every local class `i < nT` of rep #1077 (26 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1077T
import LRSpectrumFull.L5S4.LinRQSC918
import LRSpectrumFull.L5S4.LinRQSC919

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1077
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(918, LinRQSC918.blobs), (919, LinRQSC919.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(918, 182, [1, 0, -1, 3, -1, -2, -1, -2, 2]), (918, 183, [2, -1, -1, 1, -3, 0, -2, -3, 2]), (918, 184, [2, -2, 1, 1, 1, -1, -2, -3, 3]), (918, 185, [2, -2, -1, 1, 1, -1, -3, -2, 3]), (918, 186, [2, -2, 1, -1, -1, 1, 3, 2, -2]), (918, 187, [2, -1, -1, -1, 0, 1, 2, 0, -1]), (918, 188, [2, 0, -1, -1, -1, 1, -2, 1, 1]), (918, 189, [2, 2, -1, -1, 1, 0, -1, 2, 0]), (918, 190, [1, 0, 0, 3, -1, 1, 2, 2, -1]), (918, 191, [2, 0, -1, 1, -1, 0, 3, -2, -1]), (918, 192, [1, 0, 0, 3, 1, -1, 0, -2, 3]), (918, 193, [1, 0, 0, 3, 1, -1, 2, -1, 2]), (918, 194, [2, -1, 0, 1, -3, 1, 2, 1, -1]), (918, 195, [1, -2, 0, 3, -1, -1, -2, -2, 1]), (918, 196, [1, 0, -1, 3, 1, -3, 3, -1, -2]), (918, 197, [1, 0, -1, 3, 1, -3, 2, -1, -1]), (918, 198, [1, 0, -1, 3, 1, -3, -3, 1, 2]), (918, 199, [2, 0, -1, -1, -1, 0, -3, 0, 1]), (918, 200, [2, 1, -1, -1, 3, -1, 0, -2, 1]), (918, 201, [1, 2, -1, 3, 1, -1, -2, 3, -1]), (918, 202, [1, -1, 0, 3, -2, 1, 0, 0, -1]), (919, 0, [1, 0, 0, 3, -1, 0, 0, -2, 1]), (919, 1, [1, 2, -2, 3, -1, -1, -2, -1, 2]), (919, 2, [2, -1, -1, -1, -3, 2, 0, 2, -1]), (919, 3, [1, -2, 0, 3, 1, -2, -2, 0, 1]), (919, 4, [2, -1, -1, -1, 1, 0, -2, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1077.TT) N1077.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1077.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1077. -/
theorem lines (t5 : List T5Rec) (h918 : ∀ p ∈ LinRQSC918.blobs, LinesCl t5 (t4OfRec p.1)) (h919 : ∀ p ∈ LinRQSC919.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1077.nT).map (t4At (LRSpectrumFull.L5S4.dg N1077.TT) N1077.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h918 p hp
  · exact h919 p hp
)

#print axioms lines

end R1077
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #1202. -/
theorem lines (t5 : List T5Rec) (h937 : ∀ p ∈ LinRQSC937.blobs, LinesCl t5 (t4OfRec p.1)) (h949 : ∀ p ∈ LinRQSC949.blobs, LinesCl t5 (t4OfRec p.1)) (h950 : ∀ p ∈ LinRQSC950.blobs, LinesCl t5 (t4OfRec p.1)) (h951 : ∀ p ∈ LinRQSC951.blobs, LinesCl t5 (t4OfRec p.1)) (h952 : ∀ p ∈ LinRQSC952.blobs, LinesCl t5 (t4OfRec p.1)) (h953 : ∀ p ∈ LinRQSC953.blobs, LinesCl t5 (t4OfRec p.1)) (h954 : ∀ p ∈ LinRQSC954.blobs, LinesCl t5 (t4OfRec p.1)) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1202.nT).map (t4At (LRSpectrumFull.L5S4.dg N1202.TT) N1202.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N1202.nT := List.mem_range.1 hc
  have hn : N1202.nT = 472 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 400) ∨ (400 ≤ c ∧ c < 472) := by omega
  rcases hcase with h | h | h | h | h
  · exact P1202_0.lines t5 h937 h949 h950 h951 c h.1 (by omega)
  · exact P1202_1.lines t5 h951 h952 c h.1 (by omega)
  · exact P1202_2.lines t5 h952 h953 c h.1 (by omega)
  · exact P1202_3.lines t5 h953 h954 c h.1 (by omega)
  · exact P1202_4.lines t5 h954 h955 c h.1 (by omega)


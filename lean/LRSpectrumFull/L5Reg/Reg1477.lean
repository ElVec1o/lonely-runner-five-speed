/-
# L5Reg.Reg1477 : the lines clause for every class of the local table of rep #1477 (generated by l5reg)

Every local class `i < nT` of rep #1477 (26 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1477T
import LRSpectrumFull.L5S4.LinRQSC199
import LRSpectrumFull.L5S4.LinRQSC1025
import LRSpectrumFull.L5S4.LinRQSC1026

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1477
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs), (1025, LinRQSC1025.blobs), (1026, LinRQSC1026.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1026, 43, [2, -1, 0, -1, -2, 2, -1, -1, 1]), (199, 52, [3, 0, -1, 1, -2, 0, 2, 1, -1]), (1026, 44, [2, -1, 0, -1, 0, 1, -2, 1, 1]), (1026, 45, [2, -1, -1, -1, -2, 1, 1, 1, -1]), (1026, 46, [2, -2, 1, -1, -1, 1, -3, -2, 2]), (1026, 47, [2, -1, 0, -1, 0, 1, -2, 1, 1]), (1025, 138, [2, -1, 0, 3, 1, -2, -1, 2, -1]), (1026, 48, [0, 1, -1, 1, 2, -2, -2, 1, 0]), (1026, 49, [0, 1, -1, 1, 2, -2, -2, 1, 0]), (1026, 50, [2, 1, -2, -1, 2, -1, 2, 0, -1]), (1025, 339, [2, -1, -1, -3, 0, 2, 0, -2, 1]), (199, 80, [3, 0, -1, -2, -1, 1, 0, -2, 1]), (1026, 51, [2, -1, 0, -1, -2, 2, 0, -1, 1]), (1026, 52, [2, -1, -1, -1, 1, 1, 2, -2, -1]), (1026, 53, [1, 2, -2, 2, -1, 0, 1, 1, -1]), (1026, 54, [2, 0, -1, 1, 2, -2, 1, -1, 0]), (1026, 55, [1, 0, 0, 2, 1, -1, 3, 0, -1]), (199, 105, [3, 0, -1, -2, -1, 1, 1, 0, 0]), (1026, 56, [1, 2, -1, 2, 1, -1, 3, -1, -1]), (1026, 57, [2, 0, -1, -1, -1, 1, 2, -1, -1]), (1026, 58, [2, -1, 0, 0, -1, 1, 1, 0, -1]), (1025, 188, [1, 0, 0, 3, -1, -2, -2, 1, 1]), (1026, 59, [1, 0, -1, 2, -1, -2, 2, 1, -1]), (1026, 60, [1, -2, 0, 2, 1, -1, 3, 0, -1]), (1026, 61, [1, 0, -1, 2, 1, -2, 3, 0, -2]), (1025, 196, [1, 0, -1, 3, 0, -2, -2, -1, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1477.TT) N1477.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1477.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1477. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1025 : ∀ p ∈ LinRQSC1025.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1477.nT).map (t4At (LRSpectrumFull.L5S4.dg N1477.TT) N1477.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h199 p hp
  · exact h1025 p hp
  · exact h1026 p hp
)

#print axioms lines

end R1477
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 100..199 of rep #154. -/
theorem lines (t5 : List T5Rec) (h108 : ∀ p ∈ LinRQSC108.blobs, LinesCl t5 (t4OfRec p.1)) (h109 : ∀ p ∈ LinRQSC109.blobs, LinesCl t5 (t4OfRec p.1)) (h155 : ∀ p ∈ LinRQSC155.blobs, LinesCl t5 (t4OfRec p.1)) (h156 : ∀ p ∈ LinRQSC156.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N154.TT) N154.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h108 p hpe
    · exact h109 p hpe
    · exact h155 p hpe
    · exact h156 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


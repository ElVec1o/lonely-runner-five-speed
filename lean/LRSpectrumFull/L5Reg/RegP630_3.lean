/-- the lines clause for local classes 300..324 of rep #630. -/
theorem lines (t5 : List T5Rec) (h706 : ∀ p ∈ LinRQSC706.blobs, LinesCl t5 (t4OfRec p.1)) (h707 : ∀ p ∈ LinRQSC707.blobs, LinesCl t5 (t4OfRec p.1)) (h731 : ∀ p ∈ LinRQSC731.blobs, LinesCl t5 (t4OfRec p.1)) (h763 : ∀ p ∈ LinRQSC763.blobs, LinesCl t5 (t4OfRec p.1)) (h846 : ∀ p ∈ LinRQSC846.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 25 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N630.TT) N630.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h706 p hpe
    · exact h707 p hpe
    · exact h731 p hpe
    · exact h763 p hpe
    · exact h846 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines


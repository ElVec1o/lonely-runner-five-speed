/-- the lines clause for local classes 100..199 of rep #493. -/
theorem lines (t5 : List T5Rec) (h749 : ∀ p ∈ LinRQSC749.blobs, LinesCl t5 (t4OfRec p.1)) (h750 : ∀ p ∈ LinRQSC750.blobs, LinesCl t5 (t4OfRec p.1)) (h751 : ∀ p ∈ LinRQSC751.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N493.TT) N493.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h749 p hpe
    · exact h750 p hpe
    · exact h751 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


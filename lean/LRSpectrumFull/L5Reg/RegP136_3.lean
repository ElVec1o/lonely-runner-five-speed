/-- the lines clause for local classes 300..399 of rep #136. -/
theorem lines (t5 : List T5Rec) (h126 : ∀ p ∈ LinRQSC126.blobs, LinesCl t5 (t4OfRec p.1)) (h127 : ∀ p ∈ LinRQSC127.blobs, LinesCl t5 (t4OfRec p.1))

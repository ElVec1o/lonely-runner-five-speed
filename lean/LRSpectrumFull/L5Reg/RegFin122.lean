/-
# L5Reg.RegFin122 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg50
import LRSpectrumFull.L5Reg.Reg146
import LRSpectrumFull.L5Reg.Reg104

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines50 : ∀ cl ∈ (List.range N50.nT).map (t4At (LRSpectrumFull.L5S4.dg N50.TT) N50.ST), LinesCl T5Store.t5 cl :=
  R50.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem34 p hp)) (fun p hp => FinalGlue.glines p (mem35 p hp))

theorem lines146 : ∀ cl ∈ (List.range N146.nT).map (t4At (LRSpectrumFull.L5S4.dg N146.TT) N146.ST), LinesCl T5Store.t5 cl :=
  R146.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem142 p hp)) (fun p hp => FinalGlue.glines p (mem143 p hp)) (fun p hp => FinalGlue.glines p (mem144 p hp))

theorem lines104 : ∀ cl ∈ (List.range N104.nT).map (t4At (LRSpectrumFull.L5S4.dg N104.TT) N104.ST), LinesCl T5Store.t5 cl :=
  R104.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem34 p hp)) (fun p hp => FinalGlue.glines p (mem35 p hp)) (fun p hp => FinalGlue.glines p (mem108 p hp)) (fun p hp => FinalGlue.glines p (mem109 p hp)) (fun p hp => FinalGlue.glines p (mem110 p hp))

#print axioms lines50

end L5Reg
end LRSpectrumFull

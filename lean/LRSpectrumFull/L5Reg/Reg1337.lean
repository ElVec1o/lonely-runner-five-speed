/-
# L5Reg.Reg1337 : the lines clause for every class of the local table of rep #1337 (generated by l5reg)

Every local class `i < nT` of rep #1337 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1337T
import LRSpectrumFull.L5S4.LinRQSC1014

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1337
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1014, LinRQSC1014.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1014, 48, [2, -1, 0, -1, 1, 0, 0, 1, -1]), (1014, 49, [1, -1, 0, 3, -1, -1, -1, -2, 1]), (1014, 50, [2, 0, -1, -1, 2, 0, -1, -3, 1]), (1014, 51, [1, -1, 0, 3, -2, 0, 1, -1, -1]), (1014, 52, [2, 1, -2, -1, 3, -1, 0, 2, -1]), (1014, 53, [2, -1, -1, -1, -3, 2, -2, -1, 2]), (1014, 54, [1, 0, -1, 1, -2, 0, -3, -1, 3]), (1014, 55, [2, -1, 0, -1, -1, 1, -1, -2, 2]), (1014, 56, [2, -1, 0, -2, -1, 1, 1, 3, -2]), (1014, 57, [2, -1, 0, -1, -3, 1, 1, 0, 0]), (1014, 58, [2, -1, -1, -1, -3, 3, 1, 0, -1]), (1014, 59, [2, 1, -2, -1, 1, 0, -1, 3, -1]), (1014, 60, [1, -1, 0, 1, -3, 1, -3, -2, 3]), (1014, 61, [2, -1, 0, -1, -1, 1, 1, 3, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1337.TT) N1337.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1337.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1337. -/
theorem lines (t5 : List T5Rec) (h1014 : ∀ p ∈ LinRQSC1014.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1337.nT).map (t4At (LRSpectrumFull.L5S4.dg N1337.TT) N1337.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1014 p hp
)

#print axioms lines

end R1337
end L5Reg
end LRSpectrumFull

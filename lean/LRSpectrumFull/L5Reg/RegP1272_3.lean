/-- the lines clause for local classes 300..399 of rep #1272. -/
theorem lines (t5 : List T5Rec) (h981 : ∀ p ∈ LinRQSC981.blobs, LinesCl t5 (t4OfRec p.1)) (h987 : ∀ p ∈ LinRQSC987.blobs, LinesCl t5 (t4OfRec p.1))

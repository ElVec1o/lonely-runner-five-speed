theorem adv_len : adv.length = N1051.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1051. -/
theorem lines (t5 : List T5Rec) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1)) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h911 : ∀ p ∈ LinRQSC911.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1051.nT).map (t4At (LRSpectrumFull.L5S4.dg N1051.TT) N1051.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h891 p hp
  · exact h892 p hp
  · exact h911 p hp
)

#print axioms lines


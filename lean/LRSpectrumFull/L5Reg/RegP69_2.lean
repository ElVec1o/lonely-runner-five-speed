/-- the lines clause for local classes 200..299 of rep #69. -/
theorem lines (t5 : List T5Rec) (h51 : ∀ p ∈ LinRQSC51.blobs, LinesCl t5 (t4OfRec p.1)) (h52 : ∀ p ∈ LinRQSC52.blobs, LinesCl t5 (t4OfRec p.1))

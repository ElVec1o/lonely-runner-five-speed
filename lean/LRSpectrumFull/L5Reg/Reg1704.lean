/-- the lines clause for every class of the local table of rep #1704. -/
theorem lines (t5 : List T5Rec) (h1034 : ∀ p ∈ LinRQSC1034.blobs, LinesCl t5 (t4OfRec p.1)) (h1035 : ∀ p ∈ LinRQSC1035.blobs, LinesCl t5 (t4OfRec p.1)) (h1036 : ∀ p ∈ LinRQSC1036.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1704.nT).map (t4At (LRSpectrumFull.L5S4.dg N1704.TT) N1704.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h1034 p hp
  · exact h1035 p hp
  · exact h1036 p hp
)


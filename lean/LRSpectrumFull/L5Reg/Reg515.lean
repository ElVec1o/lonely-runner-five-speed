theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N515.TT) N515.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N515.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #515. -/
theorem lines (t5 : List T5Rec) (h727 : ∀ p ∈ LinRQSC727.blobs, LinesCl t5 (t4OfRec p.1)) (h757 : ∀ p ∈ LinRQSC757.blobs, LinesCl t5 (t4OfRec p.1)) (h758 : ∀ p ∈ LinRQSC758.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N515.nT).map (t4At (LRSpectrumFull.L5S4.dg N515.TT) N515.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h727 p hp
  · exact h757 p hp
  · exact h758 p hp
)

#print axioms lines


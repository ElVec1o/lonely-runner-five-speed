/-
# L5Reg.Reg944 : the lines clause for every class of the local table of rep #944 (generated by l5reg)

Every local class `i < nT` of rep #944 (38 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O944T
import LRSpectrumFull.L5S4.LinRQSC878
import LRSpectrumFull.L5S4.LinRQSC880
import LRSpectrumFull.L5S4.LinRQSC881
import LRSpectrumFull.L5S4.LinRQSC885
import LRSpectrumFull.L5S4.LinRQSC888

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R944
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(878, LinRQSC878.blobs), (880, LinRQSC880.blobs), (881, LinRQSC881.blobs), (885, LinRQSC885.blobs), (888, LinRQSC888.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(888, 114, [3, -1, 0, 1, 0, 0, 0, -3, 1]), (888, 115, [3, -1, 0, 1, 0, 0, 0, -3, 1]), (888, 116, [3, -1, 0, 1, -2, 1, 1, 1, -1]), (888, 117, [3, -1, -1, 1, -2, 1, 2, 2, -3]), (881, 253, [3, -1, -1, 0, 0, -1, 2, -1, -1]), (881, 212, [3, -2, -2, 0, 0, -1, 2, -1, -1]), (888, 118, [3, 1, -2, 1, 2, -2, -2, 2, -1]), (888, 119, [3, -1, -1, 1, -2, 1, -2, -2, 3]), (888, 120, [3, 1, -1, 1, 0, 0, 0, -3, 2]), (888, 121, [3, -2, 1, 1, -1, 0, 0, 0, -1]), (888, 122, [3, 0, -2, 1, -2, 1, 0, 1, -1]), (888, 123, [3, -1, 0, 1, 0, 0, 0, 0, 1]), (888, 124, [3, 0, -1, 1, 1, -1, -1, 0, 0]), (888, 125, [3, 0, -1, -1, -1, 1, -1, -2, 2]), (888, 126, [3, 0, -1, 1, -2, 0, 1, -1, 0]), (888, 127, [3, -1, 1, 1, 0, 0, -2, 1, 0]), (888, 128, [3, 1, -2, -1, 2, 0, 1, 2, -1]), (888, 129, [0, 0, 1, 1, 0, 2, 1, -1, -1]), (881, 28, [3, -1, -1, 0, 1, 0, -2, 1, 1]), (888, 130, [0, 1, -1, 2, 2, -3, -1, 2, -1]), (888, 131, [3, 1, -3, 1, 2, -2, 0, 2, -1]), (888, 132, [3, 0, -1, 1, -2, 0, -1, 1, 0]), (878, 115, [1, -1, 0, 3, 0, -1, -1, 2, 0]), (888, 133, [3, -1, -2, 1, 0, -1, 2, 3, -4]), (881, 217, [3, -2, -1, 0, -1, 0, -2, 1, 1]), (888, 134, [3, 0, -1, 1, 2, -2, 1, -3, 2]), (885, 178, [3, -1, -2, 1, 0, -1, 0, -1, 0]), (885, 179, [3, -1, -2, 1, 0, -1, -1, 1, 1]), (880, 75, [3, 0, -1, -2, 0, 1, 1, -1, 0]), (878, 121, [3, -1, 0, -1, 1, -1, 2, -1, 0]), (878, 119, [3, 0, -2, -1, 1, 0, 0, -2, 1]), (888, 135, [3, 0, -1, 1, 2, -2, -1, -1, 1]), (888, 136, [1, 0, -1, 2, 1, -2, 2, -1, -1]), (888, 137, [1, -3, 0, 0, -1, 0, -3, -2, 1]), (888, 138, [1, 3, -1, 0, 1, 0, -4, 0, 3]), (885, 148, [1, 0, 0, 3, -1, 0, -2, -2, 1]), (888, 139, [3, -2, 1, 1, -1, 1, 0, 0, 1]), (888, 140, [3, -2, 0, 1, -1, 0, 0, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N944.TT) N944.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N944.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #944. -/
theorem lines (t5 : List T5Rec) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h885 : ∀ p ∈ LinRQSC885.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N944.nT).map (t4At (LRSpectrumFull.L5S4.dg N944.TT) N944.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h878 p hp
  · exact h880 p hp
  · exact h881 p hp
  · exact h885 p hp
  · exact h888 p hp
)

#print axioms lines

end R944
end L5Reg
end LRSpectrumFull

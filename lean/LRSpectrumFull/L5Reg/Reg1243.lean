/-- the lines clause for every class of the local table of rep #1243. -/
theorem lines (t5 : List T5Rec) (h926 : ∀ p ∈ LinRQSC926.blobs, LinesCl t5 (t4OfRec p.1)) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1)) (h960 : ∀ p ∈ LinRQSC960.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1243.nT).map (t4At (LRSpectrumFull.L5S4.dg N1243.TT) N1243.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h926 p hp
  · exact h935 p hp
  · exact h959 p hp
  · exact h960 p hp
)


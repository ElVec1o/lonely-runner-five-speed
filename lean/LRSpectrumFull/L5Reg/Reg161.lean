/-- the lines clause for every class of the local table of rep #161. -/
theorem lines (t5 : List T5Rec) (h142 : ∀ p ∈ LinRQSC142.blobs, LinesCl t5 (t4OfRec p.1)) (h143 : ∀ p ∈ LinRQSC143.blobs, LinesCl t5 (t4OfRec p.1)) (h167 : ∀ p ∈ LinRQSC167.blobs, LinesCl t5 (t4OfRec p.1)) (h168 : ∀ p ∈ LinRQSC168.blobs, LinesCl t5 (t4OfRec p.1)) (h169 : ∀ p ∈ LinRQSC169.blobs, LinesCl t5 (t4OfRec p.1)) (h170 : ∀ p ∈ LinRQSC170.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N161.nT).map (t4At (LRSpectrumFull.L5S4.dg N161.TT) N161.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N161.nT := List.mem_range.1 hc
  have hn : N161.nT = 350 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 350) := by omega
  rcases hcase with h | h | h | h
  · exact P161_0.lines t5 h142 h167 h168 c h.1 (by omega)
  · exact P161_1.lines t5 h143 h168 h169 c h.1 (by omega)
  · exact P161_2.lines t5 h142 h169 c h.1 (by omega)
  · exact P161_3.lines t5 h169 h170 c h.1 (by omega)

#print axioms lines


theorem lines (t5 : List T5Rec) (h948 : ∀ p ∈ LinRQSC948.blobs, LinesCl t5 (t4OfRec p.1)) (h949 : ∀ p ∈ LinRQSC949.blobs, LinesCl t5 (t4OfRec p.1)) (h961 : ∀ p ∈ LinRQSC961.blobs, LinesCl t5 (t4OfRec p.1)) (h962 : ∀ p ∈ LinRQSC962.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1245.nT).map (t4At (LRSpectrumFull.L5S4.dg N1245.TT) N1245.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h948 p hp
  · exact h949 p hp
  · exact h961 p hp
  · exact h962 p hp
)

#print axioms lines

end R1245
end L5Reg
end LRSpectrumFull

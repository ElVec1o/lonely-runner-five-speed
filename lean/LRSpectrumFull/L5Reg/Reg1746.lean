/-
# L5Reg.Reg1746 : the lines clause for every class of the local table of rep #1746 (generated by l5reg)

Every local class `i < nT` of rep #1746 (31 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1746T
import LRSpectrumFull.L5S4.LinRQSC1046

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1746
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1046, LinRQSC1046.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1046, 41, [1, 0, 0, -3, 1, 1, -1, 0, 1]), (1046, 42, [2, 1, -1, -1, -3, 2, -2, 2, -1]), (1046, 43, [2, -1, 0, -1, 3, -2, -3, -2, 3]), (1046, 44, [1, -1, -1, -3, 2, 2, -1, 1, 0]), (1046, 45, [1, 1, -1, -3, 1, 2, 0, 3, -1]), (1046, 46, [1, -1, 0, 1, 0, 0, 2, -2, 1]), (1046, 47, [1, -2, 1, 1, 1, -1, -3, -1, 2]), (1046, 48, [1, -1, 0, 1, 3, -1, -3, 0, 1]), (1046, 49, [1, -1, 0, -3, -1, 3, -2, 1, 1]), (1046, 50, [1, -1, 0, -3, 2, -1, 0, 0, 1]), (1046, 51, [1, 1, -1, -3, 0, 2, -2, 0, 1]), (1046, 52, [1, -1, -1, -3, 2, 0, 1, -1, -2]), (1046, 53, [1, -1, -1, -3, 2, 0, 1, -1, -2]), (1046, 54, [2, -1, -1, -1, 0, 1, 1, -1, -1]), (1046, 55, [2, 1, -1, -1, -3, 1, 2, 0, -1]), (1046, 56, [1, 1, 0, -3, 0, 1, -1, 1, 1]), (1046, 57, [1, 1, -1, -3, 0, 1, -2, 0, 1]), (1046, 58, [1, 2, -2, -3, -1, 3, 0, 2, -1]), (1046, 59, [1, 2, -2, 0, -1, 1, 2, -1, 0]), (1046, 60, [1, 1, -1, -3, 0, 1, 1, 0, 0]), (1046, 61, [1, 1, -1, -3, 0, 1, 0, -1, 1]), (1046, 62, [1, 1, -1, -3, 0, -1, -2, -1, 1]), (1046, 63, [1, 1, -1, -3, 0, -1, -2, -1, 1]), (1046, 64, [1, 2, -2, -3, -1, 2, -2, 2, -1]), (1046, 65, [1, -1, 2, -3, 0, -1, 0, -1, 2]), (1046, 66, [1, 2, -2, 0, -1, 1, 3, 0, -1]), (1046, 67, [1, -1, 0, 0, 0, 1, 3, -2, 1]), (1046, 68, [1, -1, 0, -3, 2, 1, -2, 1, 0]), (1046, 69, [1, 0, 0, 0, 0, -1, -2, 1, 0]), (1046, 70, [1, 0, -1, -3, 1, 2, 1, -1, -1]), (1046, 71, [1, -1, 0, -3, 0, 1, 0, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1746.TT) N1746.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1746.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1746. -/
theorem lines (t5 : List T5Rec) (h1046 : ∀ p ∈ LinRQSC1046.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1746.nT).map (t4At (LRSpectrumFull.L5S4.dg N1746.TT) N1746.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1046 p hp
)

#print axioms lines

end R1746
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h682 : ∀ p ∈ LinRQSC682.blobs, LinesCl t5 (t4OfRec p.1)) (h723 : ∀ p ∈ LinRQSC723.blobs, LinesCl t5 (t4OfRec p.1)) (h724 : ∀ p ∈ LinRQSC724.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N366.nT).map (t4At (LRSpectrumFull.L5S4.dg N366.TT) N366.ST), LinesCl t5 cl :=

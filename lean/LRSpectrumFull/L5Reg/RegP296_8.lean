theorem lines (t5 : List T5Rec) (h482 : ∀ p ∈ LinRQSC482.blobs, LinesCl t5 (t4OfRec p.1)) (h483 : ∀ p ∈ LinRQSC483.blobs, LinesCl t5 (t4OfRec p.1)) (h484 : ∀ p ∈ LinRQSC484.blobs, LinesCl t5 (t4OfRec p.1))

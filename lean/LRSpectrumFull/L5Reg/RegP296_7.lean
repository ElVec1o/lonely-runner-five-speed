theorem lines (t5 : List T5Rec) (h480 : ∀ p ∈ LinRQSC480.blobs, LinesCl t5 (t4OfRec p.1)) (h481 : ∀ p ∈ LinRQSC481.blobs, LinesCl t5 (t4OfRec p.1)) (h482 : ∀ p ∈ LinRQSC482.blobs, LinesCl t5 (t4OfRec p.1))

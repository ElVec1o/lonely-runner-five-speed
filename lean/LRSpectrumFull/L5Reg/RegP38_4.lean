/-- the lines clause for local classes 400..499 of rep #38. -/
theorem lines (t5 : List T5Rec) (h24 : ∀ p ∈ LinRQSC24.blobs, LinesCl t5 (t4OfRec p.1)) (h25 : ∀ p ∈ LinRQSC25.blobs, LinesCl t5 (t4OfRec p.1)) (h26 : ∀ p ∈ LinRQSC26.blobs, LinesCl t5 (t4OfRec p.1)) (h27 : ∀ p ∈ LinRQSC27.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N38.TT) N38.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h24 p hpe
    · exact h25 p hpe
    · exact h26 p hpe
    · exact h27 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2


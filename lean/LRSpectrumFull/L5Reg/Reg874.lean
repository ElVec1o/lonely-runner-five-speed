/-
# L5Reg.Reg874 : the lines clause for every class of the local table of rep #874 (generated by l5reg)

Every local class `i < nT` of rep #874 (23 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O874T
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R874
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(879, LinRQSC879.blobs), (881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 42, [3, 0, -2, -2, -3, 2, 1, 2, -1]), (881, 43, [3, -2, 1, -2, 1, 0, 0, 0, 1]), (881, 44, [0, 1, -2, 0, 0, 1, -1, 0, 0]), (881, 45, [1, 0, -1, 1, -3, 1, -3, -2, 4]), (881, 46, [0, -1, 0, 1, 2, -1, 0, 3, -1]), (881, 47, [3, 1, -2, -2, 1, 1, 2, -2, -1]), (881, 48, [0, 1, -1, 1, 0, 0, 1, 0, -1]), (881, 49, [1, 3, -2, 0, -2, 1, -3, 2, 1]), (881, 50, [3, -1, -2, -2, 1, 1, 2, -2, -1]), (881, 51, [3, 1, -2, -2, 0, 1, 1, -2, 0]), (881, 52, [0, -3, 1, 1, 2, -1, 0, -2, 1]), (879, 179, [3, -2, 1, 0, 0, -1, -2, 1, -1]), (881, 53, [3, -2, 0, -2, 1, 0, 2, 0, -1]), (881, 54, [1, 0, 0, 0, -3, 1, -3, -2, 1]), (881, 55, [3, 0, -1, -2, -1, 1, 2, 0, -1]), (879, 180, [3, -1, -1, 0, -3, 2, 2, 0, -1]), (881, 56, [0, 3, -2, 3, -2, -1, 2, 2, -3]), (881, 57, [3, 0, -1, -2, 1, 0, 2, 1, -1]), (881, 58, [3, -1, -1, -2, 0, 1, 0, 3, -2]), (881, 59, [1, -3, 1, 0, 2, -1, -3, -2, 2]), (881, 60, [3, 0, -2, -2, 3, -1, 2, 1, -2]), (881, 61, [3, 0, -1, -2, -3, 3, 2, -2, 1]), (879, 81, [3, 0, -2, 0, 1, -1, 2, 3, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N874.TT) N874.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N874.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #874. -/
theorem lines (t5 : List T5Rec) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N874.nT).map (t4At (LRSpectrumFull.L5S4.dg N874.TT) N874.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h879 p hp
  · exact h881 p hp
)

#print axioms lines

end R874
end L5Reg
end LRSpectrumFull

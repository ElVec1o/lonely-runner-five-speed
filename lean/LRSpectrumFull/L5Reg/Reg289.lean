/-- the lines clause for every class of the local table of rep #289. -/
theorem lines (t5 : List T5Rec) (h434 : ∀ p ∈ LinRQSC434.blobs, LinesCl t5 (t4OfRec p.1)) (h435 : ∀ p ∈ LinRQSC435.blobs, LinesCl t5 (t4OfRec p.1)) (h436 : ∀ p ∈ LinRQSC436.blobs, LinesCl t5 (t4OfRec p.1)) (h437 : ∀ p ∈ LinRQSC437.blobs, LinesCl t5 (t4OfRec p.1)) (h438 : ∀ p ∈ LinRQSC438.blobs, LinesCl t5 (t4OfRec p.1)) (h439 : ∀ p ∈ LinRQSC439.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N289.nT).map (t4At (LRSpectrumFull.L5S4.dg N289.TT) N289.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N289.nT := List.mem_range.1 hc
  have hn : N289.nT = 361 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 361) := by omega
  rcases hcase with h | h | h | h
  · exact P289_0.lines t5 h434 h435 h436 h437 c h.1 (by omega)
  · exact P289_1.lines t5 h437 h438 c h.1 (by omega)
  · exact P289_2.lines t5 h438 h439 c h.1 (by omega)
  · exact P289_3.lines t5 h439 c h.1 (by omega)

#print axioms lines


/-
# L5Reg.Reg1025 : the lines clause for every class of the local table of rep #1025 (generated by l5reg)

Every local class `i < nT` of rep #1025 (10 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1025T
import LRSpectrumFull.L5S4.LinRQSC892
import LRSpectrumFull.L5S4.LinRQSC899
import LRSpectrumFull.L5S4.LinRQSC906

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1025
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs), (899, LinRQSC899.blobs), (906, LinRQSC906.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(899, 109, [1, 0, -1, 2, 1, -2, -1, 1, 0]), (899, 115, [1, -1, 0, 3, -1, -1, -2, 1, 0]), (906, 144, [2, 1, -2, 0, -1, 1, 1, -1, 0]), (906, 145, [2, 0, -1, -2, -1, 2, -3, 0, 1]), (906, 146, [0, 1, 0, -1, 1, 0, 1, 2, -1]), (906, 147, [2, -1, -1, -2, -1, 2, -3, -1, 3]), (892, 35, [1, 2, -2, -1, 3, -1, -1, 1, 0]), (906, 148, [2, 0, -1, 0, -1, 0, 3, 0, -2]), (906, 149, [2, 0, -1, -2, 1, 1, -1, -1, 1]), (906, 150, [0, 0, -1, -1, 0, 1, 1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1025.TT) N1025.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1025.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1025. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h899 : ∀ p ∈ LinRQSC899.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1025.nT).map (t4At (LRSpectrumFull.L5S4.dg N1025.TT) N1025.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h892 p hp
  · exact h899 p hp
  · exact h906 p hp
)

#print axioms lines

end R1025
end L5Reg
end LRSpectrumFull

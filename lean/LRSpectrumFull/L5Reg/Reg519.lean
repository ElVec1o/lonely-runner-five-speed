theorem lines (t5 : List T5Rec) (h765 : ∀ p ∈ LinRQSC765.blobs, LinesCl t5 (t4OfRec p.1)) (h766 : ∀ p ∈ LinRQSC766.blobs, LinesCl t5 (t4OfRec p.1)) (h767 : ∀ p ∈ LinRQSC767.blobs, LinesCl t5 (t4OfRec p.1))

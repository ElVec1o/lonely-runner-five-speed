theorem adv_len : adv.length = N1207.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1207. -/
theorem lines (t5 : List T5Rec) (h942 : ∀ p ∈ LinRQSC942.blobs, LinesCl t5 (t4OfRec p.1)) (h949 : ∀ p ∈ LinRQSC949.blobs, LinesCl t5 (t4OfRec p.1)) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1207.nT).map (t4At (LRSpectrumFull.L5S4.dg N1207.TT) N1207.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h942 p hp
  · exact h949 p hp
  · exact h955 p hp
)

#print axioms lines


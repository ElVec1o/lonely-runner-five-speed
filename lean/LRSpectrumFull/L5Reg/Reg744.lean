/-
# L5Reg.Reg744 : the lines clause for every class of the local table of rep #744 (generated by l5reg)

Every local class `i < nT` of rep #744 (0 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O744T

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R744
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := []
def adv : List (ℕ × ℕ × List ℤ) := []

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N744.TT) N744.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N744.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #744. -/
theorem lines (t5 : List T5Rec) 
    : ∀ cl ∈ (List.range N744.nT).map (t4At (LRSpectrumFull.L5S4.dg N744.TT) N744.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he; simp [bls] at he
)

#print axioms lines

end R744
end L5Reg
end LRSpectrumFull

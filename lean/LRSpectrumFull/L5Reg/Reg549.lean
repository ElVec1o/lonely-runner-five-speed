/-- the lines clause for every class of the local table of rep #549. -/
theorem lines (t5 : List T5Rec) (h735 : ∀ p ∈ LinRQSC735.blobs, LinesCl t5 (t4OfRec p.1)) (h736 : ∀ p ∈ LinRQSC736.blobs, LinesCl t5 (t4OfRec p.1)) (h737 : ∀ p ∈ LinRQSC737.blobs, LinesCl t5 (t4OfRec p.1)) (h804 : ∀ p ∈ LinRQSC804.blobs, LinesCl t5 (t4OfRec p.1)) (h805 : ∀ p ∈ LinRQSC805.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N549.nT).map (t4At (LRSpectrumFull.L5S4.dg N549.TT) N549.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h735 p hp
  · exact h736 p hp
  · exact h737 p hp
  · exact h804 p hp
  · exact h805 p hp
)


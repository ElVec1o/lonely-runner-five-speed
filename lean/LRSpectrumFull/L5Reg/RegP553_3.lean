theorem lines (t5 : List T5Rec) (h752 : ∀ p ∈ LinRQSC752.blobs, LinesCl t5 (t4OfRec p.1)) (h754 : ∀ p ∈ LinRQSC754.blobs, LinesCl t5 (t4OfRec p.1)) (h821 : ∀ p ∈ LinRQSC821.blobs, LinesCl t5 (t4OfRec p.1)) (h822 : ∀ p ∈ LinRQSC822.blobs, LinesCl t5 (t4OfRec p.1))

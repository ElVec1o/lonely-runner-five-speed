/-
# L5Reg.Reg1851 : the lines clause for every class of the local table of rep #1851 (generated by l5reg)

Every local class `i < nT` of rep #1851 (36 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1851T
import LRSpectrumFull.L5S4.LinRQSC882
import LRSpectrumFull.L5S4.LinRQSC886
import LRSpectrumFull.L5S4.LinRQSC1048

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1851
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(882, LinRQSC882.blobs), (886, LinRQSC886.blobs), (1048, LinRQSC1048.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1048, 114, [2, 1, -1, 1, -2, 1, 1, 1, -1]), (1048, 115, [2, 1, -2, 1, -2, 1, 3, 0, -2]), (1048, 116, [1, 1, -1, -1, -2, 1, -3, 0, 2]), (1048, 117, [1, 1, -1, -1, -2, 1, -2, 2, 1]), (1048, 118, [1, 1, -1, -1, -2, 1, -3, 1, 2]), (1048, 119, [1, -1, 0, -1, 2, -1, 3, 2, -4]), (1048, 120, [1, -1, 0, -1, 2, -1, 3, 1, -3]), (1048, 121, [1, 2, -2, -1, 1, 0, 3, -1, -1]), (882, 221, [3, 1, -3, -1, 2, -1, 1, -1, 0]), (1048, 122, [1, -1, 1, -1, 2, -2, 2, 2, -1]), (1048, 123, [2, 0, -1, 1, 0, 0, -3, 1, 0]), (1048, 124, [1, 2, -2, -1, 1, 0, 3, -1, -1]), (1048, 125, [1, -2, 0, -1, -1, 1, 3, 1, -2]), (1048, 126, [2, -1, 0, 1, 2, -1, -1, 0, 0]), (1048, 127, [2, -1, -1, 1, 0, 0, -3, 1, 0]), (1048, 128, [2, -1, -1, 1, 2, -2, -2, -1, 2]), (1048, 129, [2, -1, 0, 1, 1, -1, -3, -1, 2]), (1048, 130, [1, 0, -1, -2, 1, 1, -3, 1, 1]), (1048, 131, [1, 2, -2, -2, 1, 0, -3, 0, 1]), (1048, 132, [1, -1, 0, -2, 1, 0, -1, -3, 1]), (1048, 133, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1048, 134, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1048, 135, [1, -1, 0, -2, 1, 0, -3, -1, 1]), (1048, 136, [1, 1, 0, -2, -1, 0, -1, 2, 1]), (1048, 137, [2, -1, -1, 1, 1, 0, -2, 0, 1]), (1048, 138, [2, -1, -1, 1, 1, 2, -2, -1, -2]), (1048, 139, [1, -2, 0, -2, -1, 2, -2, 1, 1]), (1048, 140, [1, 2, -1, -2, 1, 0, -2, -1, 1]), (1048, 141, [1, -2, 1, -2, -1, 2, -2, 0, 1]), (1048, 142, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1048, 143, [1, -1, 0, -2, 1, 0, -3, -1, 1]), (1048, 144, [1, 2, -2, -2, 1, 1, -3, 1, 2]), (1048, 145, [1, 1, 0, -2, -1, 0, -2, 1, 1]), (886, 152, [3, -2, 1, -2, 2, -1, -1, 1, -1]), (1048, 146, [1, 0, 0, -2, 0, 1, -2, 1, 0]), (1048, 147, [1, -2, 0, -2, -1, 1, -3, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1851.TT) N1851.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1851.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1851. -/
theorem lines (t5 : List T5Rec) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1851.nT).map (t4At (LRSpectrumFull.L5S4.dg N1851.TT) N1851.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h882 p hp
  · exact h886 p hp
  · exact h1048 p hp
)

#print axioms lines

end R1851
end L5Reg
end LRSpectrumFull

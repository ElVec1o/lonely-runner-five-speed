theorem lines (t5 : List T5Rec) (h552 : ∀ p ∈ LinRQSC552.blobs, LinesCl t5 (t4OfRec p.1)) (h553 : ∀ p ∈ LinRQSC553.blobs, LinesCl t5 (t4OfRec p.1))

/-- the lines clause for every class of the local table of rep #494. -/
theorem lines (t5 : List T5Rec) (h752 : ∀ p ∈ LinRQSC752.blobs, LinesCl t5 (t4OfRec p.1)) (h753 : ∀ p ∈ LinRQSC753.blobs, LinesCl t5 (t4OfRec p.1)) (h754 : ∀ p ∈ LinRQSC754.blobs, LinesCl t5 (t4OfRec p.1)) (h755 : ∀ p ∈ LinRQSC755.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N494.nT).map (t4At (LRSpectrumFull.L5S4.dg N494.TT) N494.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N494.nT := List.mem_range.1 hc
  have hn : N494.nT = 306 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 306) := by omega
  rcases hcase with h | h | h | h
  · exact P494_0.lines t5 h752 h753 c h.1 (by omega)
  · exact P494_1.lines t5 h753 h754 c h.1 (by omega)
  · exact P494_2.lines t5 h754 h755 c h.1 (by omega)
  · exact P494_3.lines t5 h755 c h.1 (by omega)

#print axioms lines


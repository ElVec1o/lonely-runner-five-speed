theorem lines (t5 : List T5Rec) (h59 : ∀ p ∈ LinRQSC59.blobs, LinesCl t5 (t4OfRec p.1)) (h60 : ∀ p ∈ LinRQSC60.blobs, LinesCl t5 (t4OfRec p.1)) (h61 : ∀ p ∈ LinRQSC61.blobs, LinesCl t5 (t4OfRec p.1)) (h84 : ∀ p ∈ LinRQSC84.blobs, LinesCl t5 (t4OfRec p.1)) (h85 : ∀ p ∈ LinRQSC85.blobs, LinesCl t5 (t4OfRec p.1)) (h86 : ∀ p ∈ LinRQSC86.blobs, LinesCl t5 (t4OfRec p.1)) (h98 : ∀ p ∈ LinRQSC98.blobs, LinesCl t5 (t4OfRec p.1)) (h99 : ∀ p ∈ LinRQSC99.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N97.nT).map (t4At (LRSpectrumFull.L5S4.dg N97.TT) N97.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h59 p hp
  · exact h60 p hp
  · exact h61 p hp
  · exact h84 p hp
  · exact h85 p hp
  · exact h86 p hp
  · exact h98 p hp
  · exact h99 p hp
)

#print axioms lines

end R97
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg625 : the lines clause for every class of the local table of rep #625 (generated by l5reg)

Every local class `i < nT` of rep #625 (34 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O625T
import LRSpectrumFull.L5S4.LinRQSC756
import LRSpectrumFull.L5S4.LinRQSC841

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R625
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(756, LinRQSC756.blobs), (841, LinRQSC841.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(841, 21, [1, 0, 0, 3, 1, -2, 2, -1, 3]), (841, 22, [1, 0, -1, 3, -1, -2, 3, 1, -3]), (841, 23, [1, 0, -1, 3, 1, -3, -3, 1, 2]), (841, 24, [1, 0, -1, 3, 1, -3, -2, 1, 1]), (841, 25, [1, 0, -1, 0, -2, 1, 4, -1, -3]), (841, 26, [1, -1, 0, 0, -3, 2, 4, 3, -5]), (841, 27, [1, 0, -1, 0, 1, -1, 4, 0, -3]), (841, 28, [1, 0, 0, 3, -2, 3, 1, 3, -4]), (841, 29, [1, 0, -1, 3, -1, -2, 3, 1, -3]), (841, 30, [1, 0, -1, 3, 1, -3, -2, 1, 1]), (841, 31, [1, 0, -1, 3, 2, -4, -4, 1, 3]), (841, 32, [1, 0, 0, 3, 1, -3, 2, -1, 4]), (841, 33, [1, 0, -1, 3, -2, -2, -4, -1, 4]), (841, 34, [1, 0, -1, -2, 2, 1, -4, -1, 4]), (841, 35, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (841, 36, [1, 0, -1, 0, 3, -1, 4, 1, -4]), (841, 37, [1, 0, 0, 3, 1, -3, 2, -1, 4]), (841, 38, [1, 0, -1, 3, 1, -3, -2, 1, 1]), (841, 39, [1, -1, 0, 0, 1, -1, 4, 0, -3]), (841, 40, [1, 0, -1, 0, 1, -1, 4, 0, -3]), (841, 41, [1, 0, -1, 0, 3, -2, 4, 2, -5]), (841, 42, [1, 0, -1, -2, -1, 2, -2, 1, 1]), (841, 43, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (756, 65, [1, 0, -1, 4, 1, -4, -3, 1, 2]), (841, 44, [1, 0, -1, 0, -3, 1, 4, 1, -4]), (841, 45, [1, 0, -1, 0, 1, -1, 4, 0, -3]), (841, 46, [1, 0, -1, 3, -2, -2, -4, -1, 4]), (841, 47, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (841, 48, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (756, 69, [1, -1, 0, -2, -1, 1, -2, 1, 0]), (841, 49, [1, 0, -1, -2, -3, 4, -4, 1, 3]), (841, 50, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (841, 51, [1, 0, -1, -2, -1, 2, -2, 1, 1]), (841, 52, [1, -1, 0, 0, 2, -1, 4, 3, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N625.TT) N625.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N625.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #625. -/
theorem lines (t5 : List T5Rec) (h756 : ∀ p ∈ LinRQSC756.blobs, LinesCl t5 (t4OfRec p.1)) (h841 : ∀ p ∈ LinRQSC841.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N625.nT).map (t4At (LRSpectrumFull.L5S4.dg N625.TT) N625.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h756 p hp
  · exact h841 p hp
)

#print axioms lines

end R625
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h33 : ∀ p ∈ LinRQSC33.blobs, LinesCl t5 (t4OfRec p.1)) (h128 : ∀ p ∈ LinRQSC128.blobs, LinesCl t5 (t4OfRec p.1)) (h129 : ∀ p ∈ LinRQSC129.blobs, LinesCl t5 (t4OfRec p.1)) (h145 : ∀ p ∈ LinRQSC145.blobs, LinesCl t5 (t4OfRec p.1)) (h146 : ∀ p ∈ LinRQSC146.blobs, LinesCl t5 (t4OfRec p.1)) (h147 : ∀ p ∈ LinRQSC147.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h961 : ∀ p ∈ LinRQSC961.blobs, LinesCl t5 (t4OfRec p.1)) (h962 : ∀ p ∈ LinRQSC962.blobs, LinesCl t5 (t4OfRec p.1)) (h991 : ∀ p ∈ LinRQSC991.blobs, LinesCl t5 (t4OfRec p.1))

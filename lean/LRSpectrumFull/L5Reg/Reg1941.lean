theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1941.TT) N1941.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1941.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1941. -/
theorem lines (t5 : List T5Rec) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1)) (h1050 : ∀ p ∈ LinRQSC1050.blobs, LinesCl t5 (t4OfRec p.1)) (h1052 : ∀ p ∈ LinRQSC1052.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1941.nT).map (t4At (LRSpectrumFull.L5S4.dg N1941.TT) N1941.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h1049 p hp
  · exact h1050 p hp
  · exact h1052 p hp
)

#print axioms lines

end R1941
end L5Reg
end LRSpectrumFull

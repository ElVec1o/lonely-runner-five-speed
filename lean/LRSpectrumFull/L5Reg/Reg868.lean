/-
# L5Reg.Reg868 : the lines clause for every class of the local table of rep #868 (generated by l5reg)

Every local class `i < nT` of rep #868 (15 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O868T
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC880

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R868
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(879, LinRQSC879.blobs), (880, LinRQSC880.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(880, 189, [1, 0, 0, 0, 0, 1, 3, -1, 1]), (880, 190, [3, 0, -1, 0, 1, -1, 1, 0, 0]), (880, 191, [0, 1, -1, 1, 2, -2, 0, -3, 2]), (880, 192, [3, 0, -2, 0, 1, -1, 2, 0, -1]), (880, 193, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (880, 194, [0, 1, 0, 1, 0, 0, -1, 0, 1]), (880, 195, [0, -1, 1, 3, -2, 0, -1, 1, 0]), (880, 196, [3, 0, -2, 0, 1, -1, -2, 0, 1]), (880, 197, [0, -3, 1, 1, 0, 0, 0, 2, -1]), (880, 198, [0, -3, 2, 1, 0, 0, 0, 1, -1]), (879, 208, [3, 0, -1, -2, 0, 1, 0, -1, 1]), (880, 199, [1, 0, 0, 0, 0, -1, 0, 1, 0]), (880, 200, [3, -2, -2, 0, 0, -1, -1, 1, 1]), (880, 201, [3, -1, -2, 0, -1, 0, -1, 1, 1]), (880, 202, [0, -1, 0, 0, 0, -1, 1, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N868.TT) N868.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N868.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #868. -/
theorem lines (t5 : List T5Rec) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N868.nT).map (t4At (LRSpectrumFull.L5S4.dg N868.TT) N868.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h879 p hp
  · exact h880 p hp
)

#print axioms lines

end R868
end L5Reg
end LRSpectrumFull

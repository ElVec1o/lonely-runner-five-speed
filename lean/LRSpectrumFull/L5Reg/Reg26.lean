theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N26.TT) N26.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N26.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #26. -/
theorem lines (t5 : List T5Rec) (h1 : ∀ p ∈ LinRQSC1.blobs, LinesCl t5 (t4OfRec p.1)) (h2 : ∀ p ∈ LinRQSC2.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N26.nT).map (t4At (LRSpectrumFull.L5S4.dg N26.TT) N26.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1 p hp
  · exact h2 p hp
)

#print axioms lines


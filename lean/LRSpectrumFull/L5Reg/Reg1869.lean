namespace LRSpectrumFull
namespace L5Reg
namespace R1869
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(877, LinRQSC877.blobs), (878, LinRQSC878.blobs), (880, LinRQSC880.blobs), (881, LinRQSC881.blobs), (882, LinRQSC882.blobs), (883, LinRQSC883.blobs), (885, LinRQSC885.blobs), (888, LinRQSC888.blobs), (1049, LinRQSC1049.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(888, 73, [3, 1, -3, -1, 2, 0, 0, 2, -1]), (888, 176, [3, 1, -2, -2, 1, 0, -2, 0, 1]), (883, 115, [3, 1, -2, 1, 2, -2, -1, 2, -1]), (888, 60, [3, 1, -2, -1, 2, -1, 1, 2, -2]), (888, 59, [3, 1, -2, -1, 2, 0, 0, 3, -1]), (888, 58, [1, 3, -3, 2, -1, -1, 3, -2, -1]), (885, 170, [3, 1, -1, 1, 3, -2, -1, 2, -1]), (888, 77, [3, 1, -2, -1, 2, 0, 1, 1, -1]), (888, 67, [3, 1, -2, -1, 2, -1, 1, 2, -2]), (878, 30, [3, 1, -1, 1, 3, -2, -1, 2, -1]), (882, 47, [3, 1, -1, 1, 0, 0, 1, -2, 1]), (888, 74, [3, 1, -2, -1, 2, -1, 0, 3, -2]), (881, 233, [3, 1, -1, 0, 1, 0, -1, 2, 0]), (888, 61, [3, -1, -2, -1, -2, 1, -2, -3, 2]), (885, 142, [1, -3, 0, 3, -1, -1, -2, -1, 1]), (880, 46, [3, -1, -2, -2, -2, 3, 1, 2, -2]), (888, 70, [3, -1, -1, -1, -2, 1, 0, -3, 1]), (888, 57, [3, -1, 0, -1, -2, 2, -1, -3, 3]), (877, 119, [1, -1, 0, 3, 1, -1, 1, -2, 0]), (888, 69, [3, 0, -1, -1, -1, 1, -1, 3, -2]), (1049, 163, [1, 0, 0, 3, -1, -1, 1, -1, 0]), (888, 62, [3, 0, -1, -1, -1, 1, -2, 2, -1]), (888, 76, [3, 1, -2, -1, 2, -1, -2, 1, 0]), (888, 63, [3, 0, -1, -1, -1, 1, -2, 2, -1]), (882, 116, [3, 1, -2, 1, 1, -1, -1, 2, 0]), (888, 125, [3, 0, -1, -1, -1, 1, -1, -2, 2]), (888, 72, [3, 1, -1, -1, 2, 0, -1, 1, 0]), (888, 65, [3, 1, -1, -1, 2, -1, -1, 0, 0]), (888, 56, [3, 0, -2, -1, -1, 1, 0, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1869.TT) N1869.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1869.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1869. -/
theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h883 : ∀ p ∈ LinRQSC883.blobs, LinesCl t5 (t4OfRec p.1)) (h885 : ∀ p ∈ LinRQSC885.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1)) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1869.nT).map (t4At (LRSpectrumFull.L5S4.dg N1869.TT) N1869.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h877 p hp
  · exact h878 p hp
  · exact h880 p hp
  · exact h881 p hp
  · exact h882 p hp
  · exact h883 p hp
  · exact h885 p hp
  · exact h888 p hp
  · exact h1049 p hp
)

#print axioms lines


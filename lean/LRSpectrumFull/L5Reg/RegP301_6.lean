/-- the lines clause for local classes 600..699 of rep #301. -/
theorem lines (t5 : List T5Rec) (h546 : ∀ p ∈ LinRQSC546.blobs, LinesCl t5 (t4OfRec p.1)) (h547 : ∀ p ∈ LinRQSC547.blobs, LinesCl t5 (t4OfRec p.1)) (h548 : ∀ p ∈ LinRQSC548.blobs, LinesCl t5 (t4OfRec p.1))

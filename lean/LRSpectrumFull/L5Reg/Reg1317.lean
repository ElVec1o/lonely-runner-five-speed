/-- the lines clause for every class of the local table of rep #1317. -/
theorem lines (t5 : List T5Rec) (h960 : ∀ p ∈ LinRQSC960.blobs, LinesCl t5 (t4OfRec p.1)) (h1005 : ∀ p ∈ LinRQSC1005.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1317.nT).map (t4At (LRSpectrumFull.L5S4.dg N1317.TT) N1317.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h960 p hp
  · exact h1005 p hp
)


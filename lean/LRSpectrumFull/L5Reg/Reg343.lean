theorem adv_len : adv.length = N343.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #343. -/
theorem lines (t5 : List T5Rec) (h444 : ∀ p ∈ LinRQSC444.blobs, LinesCl t5 (t4OfRec p.1)) (h704 : ∀ p ∈ LinRQSC704.blobs, LinesCl t5 (t4OfRec p.1)) (h705 : ∀ p ∈ LinRQSC705.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N343.nT).map (t4At (LRSpectrumFull.L5S4.dg N343.TT) N343.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h444 p hp
  · exact h704 p hp
  · exact h705 p hp
)


/-
# L5Reg.Reg1680 : the lines clause for every class of the local table of rep #1680 (generated by l5reg)

Every local class `i < nT` of rep #1680 (42 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1680T
import LRSpectrumFull.L5S4.LinRQSC1029

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1680
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1029, LinRQSC1029.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1029, 67, [1, -1, -1, -1, 1, 0, 3, -2, -2]), (1029, 68, [1, 0, 0, -1, 0, 1, -2, 1, 0]), (1029, 69, [1, 0, 0, -1, 0, 1, -2, 1, 0]), (1029, 70, [1, 0, 0, -1, 0, 1, -2, 1, 0]), (1029, 71, [1, 0, -1, -1, 0, 0, 2, -1, 0]), (1029, 72, [1, 0, -1, -1, 0, 0, 2, -1, -1]), (1029, 73, [1, -1, 0, 2, 1, -2, -1, -1, 1]), (1029, 74, [1, 1, -1, 2, -1, -1, 0, -1, 0]), (1029, 75, [1, 1, -1, 2, -1, 0, -2, -1, 1]), (1029, 76, [1, -1, 1, 2, -1, 1, -2, 1, 0]), (1029, 77, [1, 1, -1, 2, 1, -1, -2, 2, -1]), (1029, 78, [1, 1, -1, 2, 1, -1, -2, 2, -1]), (1029, 79, [1, 1, -1, 2, 1, -2, -2, 2, 1]), (1029, 80, [1, 1, -1, 2, 1, -1, -1, 3, -2]), (1029, 81, [1, 1, -1, 2, 1, -2, -2, 2, 1]), (1029, 82, [1, 1, -1, 2, -1, -1, -2, -1, 2]), (1029, 83, [1, -1, 1, 2, -1, 1, 1, -1, 0]), (1029, 84, [1, 1, -1, 2, -1, -1, 2, 0, -1]), (1029, 85, [1, 0, 1, 2, -1, -1, 1, 0, 2]), (1029, 86, [1, -1, 1, 2, -1, 1, 1, -1, 0]), (1029, 87, [1, -1, 0, 2, 1, -1, 2, 0, -1]), (1029, 88, [1, 1, 0, 2, -1, -1, 1, 0, 0]), (1029, 89, [1, 1, -1, 2, -1, -1, 0, 1, 0]), (1029, 90, [1, 1, -1, 2, -1, -1, 0, 1, 0]), (1029, 91, [1, -1, -1, -1, 1, 0, -2, 1, 1]), (1029, 92, [1, -1, 0, 2, 1, -2, 2, 0, -1]), (1029, 93, [1, -1, 0, -1, 1, -1, -3, 2, -1]), (1029, 94, [1, -1, 1, 2, -1, 0, 0, 0, 1]), (1029, 95, [1, -1, -1, -1, 1, 0, -2, 1, 1]), (1029, 96, [1, -1, 1, -1, 1, 0, 2, -1, 1]), (1029, 97, [1, -1, 0, -1, -2, 1, -2, 1, 0]), (1029, 98, [1, -1, 0, -1, 1, 1, 3, -2, -1]), (1029, 99, [1, -1, 0, -1, -2, 1, -2, 0, 1]), (1029, 100, [1, 1, -1, -1, 2, 0, 2, 0, -1]), (1029, 101, [1, -1, 1, -1, 0, 1, -3, 2, 0]), (1029, 102, [1, 1, -1, -1, 2, 0, 3, 1, -2]), (1029, 103, [1, -1, 0, 2, 1, -2, 2, 0, -1]), (1029, 104, [1, -1, 0, -1, 1, -1, -2, 1, 0]), (1029, 105, [1, 1, -1, -1, 2, 0, 2, 0, -1]), (1029, 106, [1, -1, 1, -1, 0, 1, 2, -1, -1]), (1029, 107, [1, -1, 1, -1, 0, 1, -3, 2, 0]), (1029, 108, [1, -1, 0, -1, -2, 2, -2, 1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1680.TT) N1680.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1680.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1680. -/
theorem lines (t5 : List T5Rec) (h1029 : ∀ p ∈ LinRQSC1029.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1680.nT).map (t4At (LRSpectrumFull.L5S4.dg N1680.TT) N1680.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1029 p hp
)

#print axioms lines

end R1680
end L5Reg
end LRSpectrumFull

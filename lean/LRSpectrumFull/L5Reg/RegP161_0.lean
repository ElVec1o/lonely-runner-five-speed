/-- the lines clause for local classes 0..99 of rep #161. -/
theorem lines (t5 : List T5Rec) (h142 : ∀ p ∈ LinRQSC142.blobs, LinesCl t5 (t4OfRec p.1)) (h167 : ∀ p ∈ LinRQSC167.blobs, LinesCl t5 (t4OfRec p.1)) (h168 : ∀ p ∈ LinRQSC168.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 0 ≤ c → c < 0 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N161.TT) N161.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h142 p hpe
    · exact h167 p hpe
    · exact h168 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 0 advOk c h1 ?_
  rw [adv_len]; exact h2


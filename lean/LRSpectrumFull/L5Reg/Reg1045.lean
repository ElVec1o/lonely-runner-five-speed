/-
# L5Reg.Reg1045 : the lines clause for every class of the local table of rep #1045 (generated by l5reg)

Every local class `i < nT` of rep #1045 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1045T
import LRSpectrumFull.L5S4.LinRQSC892
import LRSpectrumFull.L5S4.LinRQSC899
import LRSpectrumFull.L5S4.LinRQSC901
import LRSpectrumFull.L5S4.LinRQSC909

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1045
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs), (899, LinRQSC899.blobs), (901, LinRQSC901.blobs), (909, LinRQSC909.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(899, 113, [1, -2, 0, 3, 2, -3, -2, 1, 1]), (899, 109, [1, 0, -1, 2, 1, -2, -1, 1, 0]), (909, 57, [1, 0, 0, 2, -2, -1, 1, 3, 2]), (909, 58, [2, 0, -1, 1, -1, 0, 2, 1, -2]), (892, 40, [2, 1, -2, -2, 1, 1, 1, 2, -2]), (909, 59, [2, -1, 0, -2, 0, 1, -1, 2, -1]), (901, 75, [2, -1, 0, -3, -1, 1, 2, 2, -1]), (892, 35, [1, 2, -2, -1, 3, -1, -1, 1, 0]), (909, 60, [2, 2, -3, -2, 1, 1, -3, 2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1045.TT) N1045.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1045.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1045. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h899 : ∀ p ∈ LinRQSC899.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1045.nT).map (t4At (LRSpectrumFull.L5S4.dg N1045.TT) N1045.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h892 p hp
  · exact h899 p hp
  · exact h901 p hp
  · exact h909 p hp
)

#print axioms lines

end R1045
end L5Reg
end LRSpectrumFull

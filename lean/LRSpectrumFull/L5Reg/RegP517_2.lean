/-- the lines clause for local classes 200..299 of rep #517. -/
theorem lines (t5 : List T5Rec) (h450 : ∀ p ∈ LinRQSC450.blobs, LinesCl t5 (t4OfRec p.1)) (h452 : ∀ p ∈ LinRQSC452.blobs, LinesCl t5 (t4OfRec p.1)) (h730 : ∀ p ∈ LinRQSC730.blobs, LinesCl t5 (t4OfRec p.1)) (h760 : ∀ p ∈ LinRQSC760.blobs, LinesCl t5 (t4OfRec p.1)) (h761 : ∀ p ∈ LinRQSC761.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N517.TT) N517.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h450 p hpe
    · exact h452 p hpe
    · exact h730 p hpe
    · exact h760 p hpe
    · exact h761 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


/-
# L5Reg.Reg894 : the lines clause for every class of the local table of rep #894 (generated by l5reg)

Every local class `i < nT` of rep #894 (17 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O894T
import LRSpectrumFull.L5S4.LinRQSC882

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R894
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(882, LinRQSC882.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(882, 87, [1, 0, 0, 1, 3, -2, 2, -2, 1]), (882, 88, [3, 0, -1, 0, 1, -1, -1, -3, 3]), (882, 89, [1, 0, 0, 0, -1, 0, 0, -2, 1]), (882, 90, [1, 3, -2, 1, 0, -1, 3, -2, -2]), (882, 91, [1, 3, -3, 1, 0, -1, 3, -1, -2]), (882, 92, [1, 0, -1, 1, -1, 0, 3, 0, -2]), (882, 93, [3, -1, -2, 0, -1, 0, -1, -2, 1]), (882, 94, [0, 3, -2, -1, 0, 0, 1, 1, -1]), (882, 95, [0, 3, -2, -1, 0, 0, 0, -2, 1]), (882, 96, [1, 0, -1, 0, -3, 1, 0, 2, -1]), (882, 97, [1, -1, 0, 0, -1, 0, 0, -3, 1]), (882, 98, [1, 0, -1, 0, 1, -1, 0, -1, 0]), (882, 99, [3, 0, -1, 0, -1, 0, -1, 0, 0]), (882, 100, [1, 0, 0, 0, 3, -1, 0, -1, 0]), (882, 101, [3, -1, -1, 0, 1, -1, -2, 0, 1]), (882, 102, [3, 1, -2, 0, 1, -1, -2, 2, -1]), (882, 103, [3, 1, -2, 0, 1, 0, -2, 2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N894.TT) N894.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N894.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #894. -/
theorem lines (t5 : List T5Rec) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N894.nT).map (t4At (LRSpectrumFull.L5S4.dg N894.TT) N894.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h882 p hp
)

#print axioms lines

end R894
end L5Reg
end LRSpectrumFull

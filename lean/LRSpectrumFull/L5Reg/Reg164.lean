theorem lines (t5 : List T5Rec) (h74 : ∀ p ∈ LinRQSC74.blobs, LinesCl t5 (t4OfRec p.1)) (h75 : ∀ p ∈ LinRQSC75.blobs, LinesCl t5 (t4OfRec p.1)) (h177 : ∀ p ∈ LinRQSC177.blobs, LinesCl t5 (t4OfRec p.1)) (h178 : ∀ p ∈ LinRQSC178.blobs, LinesCl t5 (t4OfRec p.1)) (h179 : ∀ p ∈ LinRQSC179.blobs, LinesCl t5 (t4OfRec p.1)) (h180 : ∀ p ∈ LinRQSC180.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N164.nT).map (t4At (LRSpectrumFull.L5S4.dg N164.TT) N164.ST), LinesCl t5 cl := by

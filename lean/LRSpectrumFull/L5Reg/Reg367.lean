theorem lines (t5 : List T5Rec) (h684 : ∀ p ∈ LinRQSC684.blobs, LinesCl t5 (t4OfRec p.1)) (h685 : ∀ p ∈ LinRQSC685.blobs, LinesCl t5 (t4OfRec p.1)) (h724 : ∀ p ∈ LinRQSC724.blobs, LinesCl t5 (t4OfRec p.1)) (h725 : ∀ p ∈ LinRQSC725.blobs, LinesCl t5 (t4OfRec p.1))

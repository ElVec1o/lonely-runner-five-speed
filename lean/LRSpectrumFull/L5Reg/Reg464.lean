theorem adv_len : adv.length = N464.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #464. -/
theorem lines (t5 : List T5Rec) (h445 : ∀ p ∈ LinRQSC445.blobs, LinesCl t5 (t4OfRec p.1)) (h706 : ∀ p ∈ LinRQSC706.blobs, LinesCl t5 (t4OfRec p.1)) (h728 : ∀ p ∈ LinRQSC728.blobs, LinesCl t5 (t4OfRec p.1)) (h729 : ∀ p ∈ LinRQSC729.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N464.nT).map (t4At (LRSpectrumFull.L5S4.dg N464.TT) N464.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h445 p hp
  · exact h706 p hp
  · exact h728 p hp
  · exact h729 p hp
)


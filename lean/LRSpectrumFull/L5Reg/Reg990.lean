/-
# L5Reg.Reg990 : the lines clause for every class of the local table of rep #990 (generated by l5reg)

Every local class `i < nT` of rep #990 (34 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O990T
import LRSpectrumFull.L5S4.LinRQSC889
import LRSpectrumFull.L5S4.LinRQSC901

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R990
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(889, LinRQSC889.blobs), (901, LinRQSC901.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(901, 135, [1, -2, 0, 2, 1, -2, 3, 1, -3]), (901, 136, [1, 2, -2, 2, 2, -3, 3, -1, -2]), (901, 137, [1, -2, 0, 2, 1, -2, -3, -1, 3]), (901, 138, [1, -1, 0, 2, -1, -1, 3, 1, -3]), (901, 139, [1, -1, 1, 2, -1, 1, -3, 2, -1]), (901, 140, [0, 0, -1, 0, -1, 1, -1, 0, 1]), (901, 141, [1, 0, -1, 2, -2, -1, -3, -1, 3]), (901, 142, [1, -2, 0, 2, -2, -1, 2, 3, -3]), (901, 143, [2, -1, -1, 2, -2, -1, -1, -3, 1]), (901, 144, [1, -2, 0, 2, -2, -1, 2, 3, -3]), (901, 145, [1, -1, 0, 1, -2, 0, -1, -3, 1]), (901, 146, [1, -2, 0, 2, 1, -2, -2, 1, 1]), (889, 123, [2, -1, -1, -3, -2, 2, -2, 2, 1]), (901, 147, [2, 0, -1, -1, 0, 0, -1, 1, 0]), (901, 148, [2, 0, -1, -1, 0, 0, 0, 1, -1]), (901, 149, [2, 0, -1, -1, 0, 0, -1, 1, 0]), (901, 150, [2, -1, -1, 2, -2, -1, -3, -2, 2]), (901, 151, [0, -2, 1, 1, 1, -1, 1, -2, 1]), (901, 152, [2, -1, -1, 2, -2, -1, -3, -2, 2]), (901, 153, [0, -2, 1, 2, 1, -2, 3, 0, -2]), (901, 154, [2, 0, -1, 2, 1, -2, -3, 0, 2]), (901, 155, [1, 2, -1, 1, -1, 0, -1, 0, 0]), (901, 156, [2, 2, -1, 2, -1, 0, -3, 1, 0]), (901, 157, [2, -2, -1, -1, 0, 1, 2, -1, -1]), (901, 158, [2, -2, -1, 2, -1, -1, -3, 2, 2]), (901, 159, [0, -2, 1, 1, 1, -1, 1, -2, 0]), (901, 160, [2, -2, 1, -1, -2, 2, 2, 3, -3]), (901, 161, [2, 0, -1, -1, -2, 2, 2, -3, 1]), (901, 162, [2, -2, -1, 2, 1, -2, -3, -2, 3]), (901, 163, [2, -1, 0, -1, -1, 1, 0, 1, -1]), (901, 164, [2, 0, -1, -1, 2, 0, 0, 3, -1]), (901, 165, [2, -2, 1, -1, -2, 2, 1, 3, -3]), (901, 166, [2, -1, 0, -1, 1, 0, 3, -1, -1]), (901, 167, [0, 1, -1, 1, -1, 0, 2, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N990.TT) N990.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N990.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #990. -/
theorem lines (t5 : List T5Rec) (h889 : ∀ p ∈ LinRQSC889.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N990.nT).map (t4At (LRSpectrumFull.L5S4.dg N990.TT) N990.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h889 p hp
  · exact h901 p hp
)

#print axioms lines

end R990
end L5Reg
end LRSpectrumFull

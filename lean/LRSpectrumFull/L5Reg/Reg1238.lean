/-- the lines clause for every class of the local table of rep #1238. -/
theorem lines (t5 : List T5Rec) (h936 : ∀ p ∈ LinRQSC936.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1)) (h960 : ∀ p ∈ LinRQSC960.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1238.nT).map (t4At (LRSpectrumFull.L5S4.dg N1238.TT) N1238.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h936 p hp
  · exact h959 p hp
  · exact h960 p hp
)


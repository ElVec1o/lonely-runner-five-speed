/-
# L5Reg.Reg1017 : the lines clause for every class of the local table of rep #1017 (generated by l5reg)

Every local class `i < nT` of rep #1017 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1017T
import LRSpectrumFull.L5S4.LinRQSC891
import LRSpectrumFull.L5S4.LinRQSC906

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1017
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(891, LinRQSC891.blobs), (906, LinRQSC906.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(906, 46, [1, 0, 0, 0, 0, -1, 1, -1, 0]), (891, 105, [2, -1, 0, -3, 1, 0, 0, 0, 1]), (906, 47, [2, -1, 0, 0, 0, -1, 3, -1, 0]), (906, 48, [0, 0, 1, 0, -1, 2, -1, 0, 0]), (906, 49, [1, -1, 0, 0, 0, -1, 1, 0, -1]), (906, 50, [1, 0, -1, 0, 3, -2, 1, 2, -2]), (906, 51, [1, 0, 0, 0, 0, 1, 1, -1, 1]), (906, 52, [0, 1, 0, 3, 0, -1, 2, 1, -1]), (906, 53, [0, -2, 1, 1, 0, 0, 0, -1, 0]), (906, 54, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (906, 55, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (906, 56, [0, -2, 1, 3, 0, -1, 1, -1, 0]), (906, 57, [0, 1, 0, 1, 2, -1, 1, -2, 0]), (906, 58, [0, 1, 0, 3, 2, -1, 1, -3, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1017.TT) N1017.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1017.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1017. -/
theorem lines (t5 : List T5Rec) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1017.nT).map (t4At (LRSpectrumFull.L5S4.dg N1017.TT) N1017.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h891 p hp
  · exact h906 p hp
)

#print axioms lines

end R1017
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #299. -/
theorem lines (t5 : List T5Rec) (h490 : ∀ p ∈ LinRQSC490.blobs, LinesCl t5 (t4OfRec p.1)) (h491 : ∀ p ∈ LinRQSC491.blobs, LinesCl t5 (t4OfRec p.1)) (h492 : ∀ p ∈ LinRQSC492.blobs, LinesCl t5 (t4OfRec p.1)) (h493 : ∀ p ∈ LinRQSC493.blobs, LinesCl t5 (t4OfRec p.1)) (h494 : ∀ p ∈ LinRQSC494.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N299.nT).map (t4At (LRSpectrumFull.L5S4.dg N299.TT) N299.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N299.nT := List.mem_range.1 hc
  have hn : N299.nT = 356 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 356) := by omega
  rcases hcase with h | h | h | h
  · exact P299_0.lines t5 h490 h491 c h.1 (by omega)
  · exact P299_1.lines t5 h491 h492 h493 c h.1 (by omega)
  · exact P299_2.lines t5 h493 c h.1 (by omega)
  · exact P299_3.lines t5 h493 h494 c h.1 (by omega)

#print axioms lines


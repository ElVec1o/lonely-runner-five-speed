theorem lines (t5 : List T5Rec) (h412 : ∀ p ∈ LinRQSC412.blobs, LinesCl t5 (t4OfRec p.1)) (h413 : ∀ p ∈ LinRQSC413.blobs, LinesCl t5 (t4OfRec p.1)) (h414 : ∀ p ∈ LinRQSC414.blobs, LinesCl t5 (t4OfRec p.1)) (h415 : ∀ p ∈ LinRQSC415.blobs, LinesCl t5 (t4OfRec p.1)) (h416 : ∀ p ∈ LinRQSC416.blobs, LinesCl t5 (t4OfRec p.1))

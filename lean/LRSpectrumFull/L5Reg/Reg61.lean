/-- the lines clause for every class of the local table of rep #61. -/
theorem lines (t5 : List T5Rec) (h2 : ∀ p ∈ LinRQSC2.blobs, LinesCl t5 (t4OfRec p.1)) (h4 : ∀ p ∈ LinRQSC4.blobs, LinesCl t5 (t4OfRec p.1)) (h39 : ∀ p ∈ LinRQSC39.blobs, LinesCl t5 (t4OfRec p.1)) (h40 : ∀ p ∈ LinRQSC40.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N61.nT).map (t4At (LRSpectrumFull.L5S4.dg N61.TT) N61.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h2 p hp
  · exact h4 p hp
  · exact h39 p hp
  · exact h40 p hp
)


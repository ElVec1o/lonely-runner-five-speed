namespace R70
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

/-- the lines clause for every class of the local table of rep #70. -/
theorem lines (t5 : List T5Rec) (h53 : ∀ p ∈ LinRQSC53.blobs, LinesCl t5 (t4OfRec p.1)) (h54 : ∀ p ∈ LinRQSC54.blobs, LinesCl t5 (t4OfRec p.1)) (h55 : ∀ p ∈ LinRQSC55.blobs, LinesCl t5 (t4OfRec p.1)) (h56 : ∀ p ∈ LinRQSC56.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N70.nT).map (t4At (LRSpectrumFull.L5S4.dg N70.TT) N70.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N70.nT := List.mem_range.1 hc
  have hn : N70.nT = 363 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 363) := by omega
  rcases hcase with h | h | h | h
  · exact P70_0.lines t5 h53 h54 c h.1 (by omega)
  · exact P70_1.lines t5 h54 h55 c h.1 (by omega)
  · exact P70_2.lines t5 h55 c h.1 (by omega)
  · exact P70_3.lines t5 h55 h56 c h.1 (by omega)

#print axioms lines

end R70
end L5Reg
end LRSpectrumFull

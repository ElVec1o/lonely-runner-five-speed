/-- the lines clause for local classes 200..299 of rep #68. -/
theorem lines (t5 : List T5Rec) (h48 : ∀ p ∈ LinRQSC48.blobs, LinesCl t5 (t4OfRec p.1)) (h49 : ∀ p ∈ LinRQSC49.blobs, LinesCl t5 (t4OfRec p.1))

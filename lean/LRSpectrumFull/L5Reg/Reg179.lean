/-
# L5Reg.Reg179 : the lines clause for every class of the local table of rep #179 (generated by l5reg)

Every local class `i < nT` of rep #179 (12 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O179T
import LRSpectrumFull.L5S4.LinRQSC162
import LRSpectrumFull.L5S4.LinRQSC194

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R179
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(162, LinRQSC162.blobs), (194, LinRQSC194.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(194, 9, [2, 1, -2, -1, 0, 1, -2, 4, 1]), (194, 10, [2, 0, -1, -1, 3, 1, 2, -1, -1]), (162, 95, [2, 0, -1, -1, 1, 0, 1, 2, -2]), (194, 11, [0, -2, 1, 2, 1, -1, -3, -1, 1]), (162, 93, [2, -1, -1, -1, 0, 1, 1, 1, -1]), (194, 12, [0, 2, -1, 2, -1, 0, -3, -1, 1]), (194, 13, [2, 0, -1, -1, -3, 1, 2, -1, -1]), (194, 14, [2, 0, -1, -1, 3, 0, 1, 2, -1]), (194, 15, [2, -1, -1, -1, -1, 1, 1, -1, 0]), (194, 16, [2, 0, -1, -1, -3, 1, -1, 2, 0]), (194, 17, [2, -1, 0, -1, 1, 2, 1, 0, 3]), (194, 18, [2, 0, -1, -1, -2, 1, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N179.TT) N179.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N179.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #179. -/
theorem lines (t5 : List T5Rec) (h162 : ∀ p ∈ LinRQSC162.blobs, LinesCl t5 (t4OfRec p.1)) (h194 : ∀ p ∈ LinRQSC194.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N179.nT).map (t4At (LRSpectrumFull.L5S4.dg N179.TT) N179.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h162 p hp
  · exact h194 p hp
)

#print axioms lines

end R179
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1325 : the lines clause for every class of the local table of rep #1325 (generated by l5reg)

Every local class `i < nT` of rep #1325 (8 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1325T
import LRSpectrumFull.L5S4.LinRQSC1003
import LRSpectrumFull.L5S4.LinRQSC1007

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1325
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1003, LinRQSC1003.blobs), (1007, LinRQSC1007.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1007, 178, [2, 0, -1, 1, 1, -1, -2, 1, 1]), (1007, 179, [2, 1, -2, 1, 1, -1, 3, -2, -2]), (1007, 180, [2, -1, -1, 1, 2, -1, -1, -1, 1]), (1007, 181, [2, -1, -1, 1, 2, -1, 2, 0, -1]), (1003, 36, [2, -1, 0, 2, 2, -1, -1, -2, 1]), (1007, 182, [1, 2, -2, 1, 1, -1, -3, 2, -1]), (1007, 183, [1, 2, -1, -2, 1, 0, 3, -1, 0]), (1007, 184, [1, -1, 0, 1, 2, -1, -3, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1325.TT) N1325.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1325.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1325. -/
theorem lines (t5 : List T5Rec) (h1003 : ∀ p ∈ LinRQSC1003.blobs, LinesCl t5 (t4OfRec p.1)) (h1007 : ∀ p ∈ LinRQSC1007.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1325.nT).map (t4At (LRSpectrumFull.L5S4.dg N1325.TT) N1325.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1003 p hp
  · exact h1007 p hp
)

#print axioms lines

end R1325
end L5Reg
end LRSpectrumFull

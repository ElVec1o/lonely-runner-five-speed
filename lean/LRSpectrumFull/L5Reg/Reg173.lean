/-- the lines clause for every class of the local table of rep #173. -/
theorem lines (t5 : List T5Rec) (h180 : ∀ p ∈ LinRQSC180.blobs, LinesCl t5 (t4OfRec p.1)) (h182 : ∀ p ∈ LinRQSC182.blobs, LinesCl t5 (t4OfRec p.1)) (h190 : ∀ p ∈ LinRQSC190.blobs, LinesCl t5 (t4OfRec p.1)) (h191 : ∀ p ∈ LinRQSC191.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N173.nT).map (t4At (LRSpectrumFull.L5S4.dg N173.TT) N173.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h180 p hp
  · exact h182 p hp
  · exact h190 p hp
  · exact h191 p hp
)


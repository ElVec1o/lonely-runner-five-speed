theorem lines (t5 : List T5Rec) (h45 : ∀ p ∈ LinRQSC45.blobs, LinesCl t5 (t4OfRec p.1)) (h46 : ∀ p ∈ LinRQSC46.blobs, LinesCl t5 (t4OfRec p.1)) (h102 : ∀ p ∈ LinRQSC102.blobs, LinesCl t5 (t4OfRec p.1)) (h103 : ∀ p ∈ LinRQSC103.blobs, LinesCl t5 (t4OfRec p.1))

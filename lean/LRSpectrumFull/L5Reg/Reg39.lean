theorem adv_len : adv.length = N39.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #39. -/
theorem lines (t5 : List T5Rec) (h27 : ∀ p ∈ LinRQSC27.blobs, LinesCl t5 (t4OfRec p.1)) (h28 : ∀ p ∈ LinRQSC28.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N39.nT).map (t4At (LRSpectrumFull.L5S4.dg N39.TT) N39.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h27 p hp
  · exact h28 p hp
)


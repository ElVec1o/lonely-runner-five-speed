/-- the lines clause for every class of the local table of rep #102. -/
theorem lines (t5 : List T5Rec) (h38 : ∀ p ∈ LinRQSC38.blobs, LinesCl t5 (t4OfRec p.1)) (h39 : ∀ p ∈ LinRQSC39.blobs, LinesCl t5 (t4OfRec p.1)) (h58 : ∀ p ∈ LinRQSC58.blobs, LinesCl t5 (t4OfRec p.1)) (h59 : ∀ p ∈ LinRQSC59.blobs, LinesCl t5 (t4OfRec p.1)) (h106 : ∀ p ∈ LinRQSC106.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N102.nT).map (t4At (LRSpectrumFull.L5S4.dg N102.TT) N102.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h38 p hp
  · exact h39 p hp
  · exact h58 p hp
  · exact h59 p hp
  · exact h106 p hp
)


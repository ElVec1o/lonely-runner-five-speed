theorem lines (t5 : List T5Rec) (h972 : ∀ p ∈ LinRQSC972.blobs, LinesCl t5 (t4OfRec p.1)) (h975 : ∀ p ∈ LinRQSC975.blobs, LinesCl t5 (t4OfRec p.1)) (h999 : ∀ p ∈ LinRQSC999.blobs, LinesCl t5 (t4OfRec p.1)) (h1000 : ∀ p ∈ LinRQSC1000.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h1028 : ∀ p ∈ LinRQSC1028.blobs, LinesCl t5 (t4OfRec p.1)) (h1041 : ∀ p ∈ LinRQSC1041.blobs, LinesCl t5 (t4OfRec p.1)) (h1042 : ∀ p ∈ LinRQSC1042.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N1709.TT) N1709.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h1028 p hpe
    · exact h1041 p hpe
    · exact h1042 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


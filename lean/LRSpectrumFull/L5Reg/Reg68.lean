namespace R68
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

/-- the lines clause for every class of the local table of rep #68. -/
theorem lines (t5 : List T5Rec) (h46 : ∀ p ∈ LinRQSC46.blobs, LinesCl t5 (t4OfRec p.1)) (h47 : ∀ p ∈ LinRQSC47.blobs, LinesCl t5 (t4OfRec p.1)) (h48 : ∀ p ∈ LinRQSC48.blobs, LinesCl t5 (t4OfRec p.1)) (h49 : ∀ p ∈ LinRQSC49.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N68.nT).map (t4At (LRSpectrumFull.L5S4.dg N68.TT) N68.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N68.nT := List.mem_range.1 hc
  have hn : N68.nT = 360 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 360) := by omega
  rcases hcase with h | h | h | h
  · exact P68_0.lines t5 h46 h47 c h.1 (by omega)
  · exact P68_1.lines t5 h47 h48 c h.1 (by omega)
  · exact P68_2.lines t5 h48 h49 c h.1 (by omega)
  · exact P68_3.lines t5 h49 c h.1 (by omega)

#print axioms lines

end R68
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg113 : the lines clause for every class of the local table of rep #113 (generated by l5reg)

Every local class `i < nT` of rep #113 (17 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O113T
import LRSpectrumFull.L5S4.LinRQSC41
import LRSpectrumFull.L5S4.LinRQSC96
import LRSpectrumFull.L5S4.LinRQSC112

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R113
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(41, LinRQSC41.blobs), (96, LinRQSC96.blobs), (112, LinRQSC112.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(112, 168, [2, 0, -1, -1, -2, 2, 1, 1, -1]), (112, 169, [2, -1, 0, -1, 0, -4, 1, -1, -3]), (112, 170, [2, 0, -1, -1, -4, 1, 1, -3, 0]), (112, 171, [2, 0, -1, -1, -4, 4, -2, -1, 2]), (112, 172, [2, 1, -2, -1, 1, 0, -2, 3, -1]), (112, 173, [2, 0, -1, -1, 1, -1, 2, 1, -2]), (41, 16, [2, -1, 0, -2, 1, -1, 1, -1, 2]), (96, 13, [2, 0, -1, -1, -3, 1, -1, 4, 0]), (112, 174, [2, 0, -1, -1, 2, -1, 0, 3, -2]), (96, 15, [2, 0, -1, -1, 0, 1, 1, 1, -1]), (112, 175, [2, -1, 0, -1, 1, 0, 1, 0, -1]), (112, 176, [2, 0, -1, -1, 1, 0, -2, -1, 2]), (41, 18, [2, -1, 0, -2, 1, -1, -1, 1, 1]), (112, 177, [0, 0, -1, -1, 0, 1, 1, -1, 0]), (112, 178, [2, 0, -1, -1, -4, 3, 0, 3, -2]), (112, 179, [2, -1, -1, -1, 1, -1, 1, 0, -1]), (112, 180, [2, -1, 0, -1, 1, -1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N113.TT) N113.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N113.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #113. -/
theorem lines (t5 : List T5Rec) (h41 : ∀ p ∈ LinRQSC41.blobs, LinesCl t5 (t4OfRec p.1)) (h96 : ∀ p ∈ LinRQSC96.blobs, LinesCl t5 (t4OfRec p.1)) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N113.nT).map (t4At (LRSpectrumFull.L5S4.dg N113.TT) N113.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h41 p hp
  · exact h96 p hp
  · exact h112 p hp
)

#print axioms lines

end R113
end L5Reg
end LRSpectrumFull

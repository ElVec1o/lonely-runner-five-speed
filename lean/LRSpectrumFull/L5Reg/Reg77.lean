/-- the lines clause for every class of the local table of rep #77. -/
theorem lines (t5 : List T5Rec) (h56 : ∀ p ∈ LinRQSC56.blobs, LinesCl t5 (t4OfRec p.1)) (h57 : ∀ p ∈ LinRQSC57.blobs, LinesCl t5 (t4OfRec p.1)) (h65 : ∀ p ∈ LinRQSC65.blobs, LinesCl t5 (t4OfRec p.1)) (h66 : ∀ p ∈ LinRQSC66.blobs, LinesCl t5 (t4OfRec p.1)) (h67 : ∀ p ∈ LinRQSC67.blobs, LinesCl t5 (t4OfRec p.1)) (h68 : ∀ p ∈ LinRQSC68.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N77.nT).map (t4At (LRSpectrumFull.L5S4.dg N77.TT) N77.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N77.nT := List.mem_range.1 hc
  have hn : N77.nT = 378 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 378) := by omega
  rcases hcase with h | h | h | h
  · exact P77_0.lines t5 h56 h65 c h.1 (by omega)
  · exact P77_1.lines t5 h57 h65 h66 c h.1 (by omega)
  · exact P77_2.lines t5 h67 c h.1 (by omega)
  · exact P77_3.lines t5 h57 h67 h68 c h.1 (by omega)

#print axioms lines


/-
# L5Reg.RegP1248_3 : part 3 of the lines clause of rep #1248: local classes 300..304 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1248T
import LRSpectrumFull.L5S4.LinRQSC966

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P1248_3
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(966, LinRQSC966.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(966, 50, [1, 1, -1, -2, -1, 2, 2, -2, -1]), (966, 51, [1, 2, -2, -2, 1, 1, 1, 0, -1]), (966, 52, [1, 2, -1, -2, 1, 0, 1, -1, 0]), (966, 53, [1, 0, 0, -2, 1, 0, 1, 3, -1]), (966, 54, [0, 1, 0, 1, 2, -1, 3, -1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1248.TT) N1248.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 5 := by decide +kernel

/-- the lines clause for local classes 300..304 of rep #1248. -/
theorem lines (t5 : List T5Rec) (h966 : ∀ p ∈ LinRQSC966.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 5 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N1248.TT) N1248.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h966 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P1248_3
end L5Reg
end LRSpectrumFull

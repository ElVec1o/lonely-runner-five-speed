/-- the lines clause for every class of the local table of rep #324. -/
theorem lines (t5 : List T5Rec) (h223 : ∀ p ∈ LinRQSC223.blobs, LinesCl t5 (t4OfRec p.1)) (h693 : ∀ p ∈ LinRQSC693.blobs, LinesCl t5 (t4OfRec p.1)) (h694 : ∀ p ∈ LinRQSC694.blobs, LinesCl t5 (t4OfRec p.1)) (h695 : ∀ p ∈ LinRQSC695.blobs, LinesCl t5 (t4OfRec p.1)) (h696 : ∀ p ∈ LinRQSC696.blobs, LinesCl t5 (t4OfRec p.1)) (h697 : ∀ p ∈ LinRQSC697.blobs, LinesCl t5 (t4OfRec p.1)) (h698 : ∀ p ∈ LinRQSC698.blobs, LinesCl t5 (t4OfRec p.1)) (h699 : ∀ p ∈ LinRQSC699.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N324.nT).map (t4At (LRSpectrumFull.L5S4.dg N324.TT) N324.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N324.nT := List.mem_range.1 hc
  have hn : N324.nT = 366 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 366) := by omega
  rcases hcase with h | h | h | h
  · exact P324_0.lines t5 h693 h694 c h.1 (by omega)
  · exact P324_1.lines t5 h694 h695 h696 c h.1 (by omega)
  · exact P324_2.lines t5 h223 h696 h697 h698 c h.1 (by omega)
  · exact P324_3.lines t5 h698 h699 c h.1 (by omega)


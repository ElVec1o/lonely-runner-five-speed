/-- the lines clause for local classes 100..199 of rep #262. -/
theorem lines (t5 : List T5Rec) (h205 : ∀ p ∈ LinRQSC205.blobs, LinesCl t5 (t4OfRec p.1)) (h206 : ∀ p ∈ LinRQSC206.blobs, LinesCl t5 (t4OfRec p.1)) (h207 : ∀ p ∈ LinRQSC207.blobs, LinesCl t5 (t4OfRec p.1)) (h208 : ∀ p ∈ LinRQSC208.blobs, LinesCl t5 (t4OfRec p.1)) (h209 : ∀ p ∈ LinRQSC209.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N262.TT) N262.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h205 p hpe
    · exact h206 p hpe
    · exact h207 p hpe
    · exact h208 p hpe
    · exact h209 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


/-
# L5Reg.RegFin107 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg44
import LRSpectrumFull.L5Reg.Reg165
import LRSpectrumFull.L5Reg.Reg80

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines44 : ∀ cl ∈ (List.range N44.nT).map (t4At (LRSpectrumFull.L5S4.dg N44.TT) N44.ST), LinesCl T5Store.t5 cl :=
  R44.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem31 p hp)) (fun p hp => FinalGlue.glines p (mem32 p hp))

theorem lines165 : ∀ cl ∈ (List.range N165.nT).map (t4At (LRSpectrumFull.L5S4.dg N165.TT) N165.ST), LinesCl T5Store.t5 cl :=
  R165.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem180 p hp)) (fun p hp => FinalGlue.glines p (mem181 p hp)) (fun p hp => FinalGlue.glines p (mem182 p hp)) (fun p hp => FinalGlue.glines p (mem183 p hp))

theorem lines80 : ∀ cl ∈ (List.range N80.nT).map (t4At (LRSpectrumFull.L5S4.dg N80.TT) N80.ST), LinesCl T5Store.t5 cl :=
  R80.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem31 p hp)) (fun p hp => FinalGlue.glines p (mem32 p hp)) (fun p hp => FinalGlue.glines p (mem76 p hp)) (fun p hp => FinalGlue.glines p (mem77 p hp)) (fun p hp => FinalGlue.glines p (mem78 p hp)) (fun p hp => FinalGlue.glines p (mem79 p hp))

#print axioms lines44

end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h477 : ∀ p ∈ LinRQSC477.blobs, LinesCl t5 (t4OfRec p.1)) (h478 : ∀ p ∈ LinRQSC478.blobs, LinesCl t5 (t4OfRec p.1)) (h479 : ∀ p ∈ LinRQSC479.blobs, LinesCl t5 (t4OfRec p.1)) (h480 : ∀ p ∈ LinRQSC480.blobs, LinesCl t5 (t4OfRec p.1))

theorem adv_len : adv.length = N1471.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1471. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1025 : ∀ p ∈ LinRQSC1025.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1471.nT).map (t4At (LRSpectrumFull.L5S4.dg N1471.TT) N1471.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h199 p hp
  · exact h1025 p hp
  · exact h1026 p hp
)


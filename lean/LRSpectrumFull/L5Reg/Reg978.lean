/-
# L5Reg.Reg978 : the lines clause for every class of the local table of rep #978 (generated by l5reg)

Every local class `i < nT` of rep #978 (44 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O978T
import LRSpectrumFull.L5S4.LinRQSC897

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R978
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(897, LinRQSC897.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(897, 112, [1, -2, 0, 3, -1, -2, 3, 2, -3]), (897, 113, [1, -2, 1, 3, -1, 0, 2, 3, -2]), (897, 114, [1, -2, 0, 3, -1, -1, 2, 2, -1]), (897, 115, [1, -1, 0, 3, -2, -1, 1, 0, 0]), (897, 116, [2, -1, 0, 1, -3, 2, -3, -2, 3]), (897, 117, [1, -2, 0, 3, 1, -3, -2, -1, 2]), (897, 118, [1, 0, -1, 3, -1, -2, 0, -3, 2]), (897, 119, [2, -2, 1, 1, 1, -1, -2, -3, 3]), (897, 120, [2, -2, -1, 1, 1, -1, -3, -2, 3]), (897, 121, [2, -2, 1, -1, -1, 1, 3, 2, -2]), (897, 122, [2, -1, -1, -1, 0, 1, 2, 0, -1]), (897, 123, [2, 2, -3, -1, 1, 0, 3, -2, -1]), (897, 124, [2, 2, -1, -1, 1, 0, 1, -2, 0]), (897, 125, [2, 2, -3, -1, 1, 0, 2, -1, -1]), (897, 126, [2, 0, -1, -1, 1, 0, 1, -2, 0]), (897, 127, [2, -1, 0, -1, -3, 3, 3, 1, -2]), (897, 128, [0, 2, -1, 1, -1, 0, 3, 2, -3]), (897, 129, [2, -1, 0, -1, -3, 3, -2, 0, 1]), (897, 130, [0, 1, 0, 1, -1, 0, -3, 1, 1]), (897, 131, [2, 0, -1, -1, 0, 1, 0, -1, -1]), (897, 132, [2, -1, 0, -1, -3, 2, -3, 0, 1]), (897, 133, [1, 0, 0, 3, -1, 0, 1, 3, 1]), (897, 134, [2, -1, -1, -1, -3, 2, -1, 2, 0]), (897, 135, [2, 1, -2, -1, 3, 0, -3, -1, 3]), (897, 136, [2, 0, -1, 1, 1, 0, 3, 0, -2]), (897, 137, [1, 0, 0, 3, -1, 0, 0, 3, 1]), (897, 138, [2, 1, -2, 1, 3, -2, 2, -2, -1]), (897, 139, [1, 2, -1, 3, 1, -1, -2, 3, -1]), (897, 140, [1, 2, -2, 3, 1, -3, -3, 2, 1]), (897, 141, [1, 2, -2, 3, -1, -1, -2, -1, 2]), (897, 142, [1, -2, 0, 3, 1, -1, 0, -1, 0]), (897, 143, [1, -2, 1, 3, 1, -1, 3, -1, 0]), (897, 144, [2, 0, -1, -1, 1, 0, -2, -1, 1]), (897, 145, [1, 0, 0, 3, 1, 0, 2, -2, 1]), (897, 146, [2, -1, 0, -1, -3, 2, -3, 0, 1]), (897, 147, [1, -2, 0, 3, 1, -2, -2, 1, 1]), (897, 148, [1, -2, 1, 3, 1, -1, 0, 2, -1]), (897, 149, [1, 0, -1, 3, 1, -3, 0, -2, 1]), (897, 150, [1, 0, -1, 3, 1, -3, 2, -1, -1]), (897, 151, [0, -1, 0, 0, -3, 1, 1, -1, 0]), (897, 152, [0, 0, -1, 0, -1, -3, 1, 0, 0]), (897, 153, [0, 2, -1, 0, -1, 0, 1, 0, 0]), (897, 154, [0, -2, 1, 0, 1, -1, 1, -1, 0]), (897, 155, [0, 2, -1, 0, -1, 1, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N978.TT) N978.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N978.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #978. -/
theorem lines (t5 : List T5Rec) (h897 : ∀ p ∈ LinRQSC897.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N978.nT).map (t4At (LRSpectrumFull.L5S4.dg N978.TT) N978.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h897 p hp
)

#print axioms lines

end R978
end L5Reg
end LRSpectrumFull

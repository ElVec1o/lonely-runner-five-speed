theorem lines (t5 : List T5Rec) (h965 : ∀ p ∈ LinRQSC965.blobs, LinesCl t5 (t4OfRec p.1)) (h966 : ∀ p ∈ LinRQSC966.blobs, LinesCl t5 (t4OfRec p.1))

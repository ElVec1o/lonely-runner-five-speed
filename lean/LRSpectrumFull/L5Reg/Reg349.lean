theorem lines (t5 : List T5Rec) (h716 : ∀ p ∈ LinRQSC716.blobs, LinesCl t5 (t4OfRec p.1)) (h717 : ∀ p ∈ LinRQSC717.blobs, LinesCl t5 (t4OfRec p.1)) (h718 : ∀ p ∈ LinRQSC718.blobs, LinesCl t5 (t4OfRec p.1))

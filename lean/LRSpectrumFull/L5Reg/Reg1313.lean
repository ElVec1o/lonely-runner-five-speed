/-
# L5Reg.Reg1313 : the lines clause for every class of the local table of rep #1313 (generated by l5reg)

Every local class `i < nT` of rep #1313 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1313T
import LRSpectrumFull.L5S4.LinRQSC1005

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1313
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1005, LinRQSC1005.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1005, 39, [1, 1, -1, -2, 2, -1, 3, 0, -1]), (1005, 40, [2, -1, 0, 1, 2, -2, 1, 1, -1]), (1005, 41, [1, 1, -1, -1, 2, -1, -3, -1, 2]), (1005, 42, [2, -1, 0, 1, 1, -1, 2, 1, -1]), (1005, 43, [1, -1, 0, -1, 2, -1, -3, -1, 3]), (1005, 44, [2, -1, -1, 1, -1, 0, 1, -1, -1]), (1005, 45, [2, 1, -1, 1, 2, -1, 3, -1, -1]), (1005, 46, [2, -1, 0, 1, 1, -1, 2, 3, -3]), (1005, 47, [2, -1, 0, 1, -1, 0, 3, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1313.TT) N1313.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1313.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1313. -/
theorem lines (t5 : List T5Rec) (h1005 : ∀ p ∈ LinRQSC1005.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1313.nT).map (t4At (LRSpectrumFull.L5S4.dg N1313.TT) N1313.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1005 p hp
)

#print axioms lines

end R1313
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h33 : ∀ p ∈ LinRQSC33.blobs, LinesCl t5 (t4OfRec p.1)) (h127 : ∀ p ∈ LinRQSC127.blobs, LinesCl t5 (t4OfRec p.1)) (h128 : ∀ p ∈ LinRQSC128.blobs, LinesCl t5 (t4OfRec p.1)) (h129 : ∀ p ∈ LinRQSC129.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N137.nT).map (t4At (LRSpectrumFull.L5S4.dg N137.TT) N137.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h33 p hp
  · exact h127 p hp
  · exact h128 p hp
  · exact h129 p hp
)

#print axioms lines

end R137
end L5Reg
end LRSpectrumFull

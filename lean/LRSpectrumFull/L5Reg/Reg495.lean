theorem adv_len : adv.length = N495.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #495. -/
theorem lines (t5 : List T5Rec) (h755 : ∀ p ∈ LinRQSC755.blobs, LinesCl t5 (t4OfRec p.1)) (h756 : ∀ p ∈ LinRQSC756.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N495.nT).map (t4At (LRSpectrumFull.L5S4.dg N495.TT) N495.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h755 p hp
  · exact h756 p hp
)


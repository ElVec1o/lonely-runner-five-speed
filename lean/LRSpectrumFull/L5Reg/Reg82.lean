/-- the lines clause for every class of the local table of rep #82. -/
theorem lines (t5 : List T5Rec) (h29 : ∀ p ∈ LinRQSC29.blobs, LinesCl t5 (t4OfRec p.1)) (h82 : ∀ p ∈ LinRQSC82.blobs, LinesCl t5 (t4OfRec p.1)) (h83 : ∀ p ∈ LinRQSC83.blobs, LinesCl t5 (t4OfRec p.1)) (h84 : ∀ p ∈ LinRQSC84.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N82.nT).map (t4At (LRSpectrumFull.L5S4.dg N82.TT) N82.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h29 p hp
  · exact h82 p hp
  · exact h83 p hp
  · exact h84 p hp
)


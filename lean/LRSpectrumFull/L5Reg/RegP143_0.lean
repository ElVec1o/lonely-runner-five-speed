theorem lines (t5 : List T5Rec) (h133 : ∀ p ∈ LinRQSC133.blobs, LinesCl t5 (t4OfRec p.1)) (h134 : ∀ p ∈ LinRQSC134.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h49 : ∀ p ∈ LinRQSC49.blobs, LinesCl t5 (t4OfRec p.1)) (h87 : ∀ p ∈ LinRQSC87.blobs, LinesCl t5 (t4OfRec p.1)) (h88 : ∀ p ∈ LinRQSC88.blobs, LinesCl t5 (t4OfRec p.1)) (h136 : ∀ p ∈ LinRQSC136.blobs, LinesCl t5 (t4OfRec p.1)) (h137 : ∀ p ∈ LinRQSC137.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h486 : ∀ p ∈ LinRQSC486.blobs, LinesCl t5 (t4OfRec p.1)) (h487 : ∀ p ∈ LinRQSC487.blobs, LinesCl t5 (t4OfRec p.1)) (h713 : ∀ p ∈ LinRQSC713.blobs, LinesCl t5 (t4OfRec p.1)) (h769 : ∀ p ∈ LinRQSC769.blobs, LinesCl t5 (t4OfRec p.1)) (h770 : ∀ p ∈ LinRQSC770.blobs, LinesCl t5 (t4OfRec p.1))

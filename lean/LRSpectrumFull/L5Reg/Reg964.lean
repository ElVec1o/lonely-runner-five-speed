/-
# L5Reg.Reg964 : the lines clause for every class of the local table of rep #964 (generated by l5reg)

Every local class `i < nT` of rep #964 (16 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O964T
import LRSpectrumFull.L5S4.LinRQSC892

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R964
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(892, 16, [2, -2, -1, 2, -1, -1, -1, 1, 1]), (892, 17, [2, 0, -1, -3, -1, 2, 2, -3, 0]), (892, 18, [2, -2, 1, -3, -2, 3, -1, -3, 3]), (892, 19, [2, 0, -1, -3, 0, 2, -1, -1, 1]), (892, 20, [2, -2, 1, -3, -2, 3, 0, 1, -1]), (892, 21, [2, 2, -1, -3, 2, 0, 1, -1, 0]), (892, 22, [2, -1, 1, -3, 1, 1, 0, 0, -1]), (892, 23, [2, -2, 1, -3, -2, 3, -1, -3, 3]), (892, 24, [2, -1, -1, -3, -1, 2, -1, -3, 1]), (892, 25, [2, 1, -2, -3, 1, 2, 1, 0, -1]), (892, 26, [2, -1, 1, -3, 1, 1, 0, 0, -1]), (892, 27, [2, 1, -2, -3, 1, 2, 1, 0, -1]), (892, 28, [2, 1, -1, -3, 1, 1, -1, 1, 0]), (892, 29, [2, 1, -2, -3, 1, 2, 1, 0, -1]), (892, 30, [2, 0, -1, -3, 0, 2, -1, -1, 1]), (892, 31, [2, 1, -1, -3, 1, 0, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N964.TT) N964.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N964.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #964. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N964.nT).map (t4At (LRSpectrumFull.L5S4.dg N964.TT) N964.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h892 p hp
)

#print axioms lines

end R964
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg361 : the lines clause for every class of the local table of rep #361 (generated by l5reg)

Every local class `i < nT` of rep #361 (10 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O361T
import LRSpectrumFull.L5S4.LinRQSC720

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R361
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(720, LinRQSC720.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(720, 46, [1, -1, 0, 3, 1, -3, 2, 3, -4]), (720, 47, [1, 0, -1, 3, 0, -2, 1, 1, 0]), (720, 48, [1, 0, -1, 3, -2, -2, -5, -1, 5]), (720, 49, [0, -1, 0, 4, -3, -3, 5, 2, -4]), (720, 50, [0, 1, 0, 4, 3, -1, 5, -2, -1]), (720, 51, [1, -1, 0, -1, 2, 0, -5, -2, 1]), (720, 52, [0, 1, 0, 4, 3, -1, 5, -1, -1]), (720, 53, [1, -1, 0, -1, 2, 0, -4, -4, 1]), (720, 54, [1, -1, 0, -2, 1, 0, 3, 4, 1]), (720, 55, [1, -1, 0, -2, 1, 1, 3, 4, -6])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N361.TT) N361.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N361.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #361. -/
theorem lines (t5 : List T5Rec) (h720 : ∀ p ∈ LinRQSC720.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N361.nT).map (t4At (LRSpectrumFull.L5S4.dg N361.TT) N361.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h720 p hp
)

#print axioms lines

end R361
end L5Reg
end LRSpectrumFull

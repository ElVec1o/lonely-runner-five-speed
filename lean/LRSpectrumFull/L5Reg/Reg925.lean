/-- the lines clause for every class of the local table of rep #925. -/
theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1)) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1)) (h887 : ∀ p ∈ LinRQSC887.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N925.nT).map (t4At (LRSpectrumFull.L5S4.dg N925.TT) N925.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h877 p hp
  · exact h878 p hp
  · exact h881 p hp
  · exact h882 p hp
  · exact h886 p hp
  · exact h887 p hp
)


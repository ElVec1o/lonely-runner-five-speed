theorem adv_len : adv.length = 51 := by decide +kernel

/-- the lines clause for local classes 400..450 of rep #268. -/
theorem lines (t5 : List T5Rec) (h428 : ∀ p ∈ LinRQSC428.blobs, LinesCl t5 (t4OfRec p.1)) (h429 : ∀ p ∈ LinRQSC429.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 51 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N268.TT) N268.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl
    · exact h428 p hpe
    · exact h429 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2


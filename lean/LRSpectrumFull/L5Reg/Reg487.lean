theorem adv_len : adv.length = N487.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #487. -/
theorem lines (t5 : List T5Rec) (h209 : ∀ p ∈ LinRQSC209.blobs, LinesCl t5 (t4OfRec p.1)) (h681 : ∀ p ∈ LinRQSC681.blobs, LinesCl t5 (t4OfRec p.1)) (h682 : ∀ p ∈ LinRQSC682.blobs, LinesCl t5 (t4OfRec p.1)) (h722 : ∀ p ∈ LinRQSC722.blobs, LinesCl t5 (t4OfRec p.1)) (h734 : ∀ p ∈ LinRQSC734.blobs, LinesCl t5 (t4OfRec p.1)) (h735 : ∀ p ∈ LinRQSC735.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N487.nT).map (t4At (LRSpectrumFull.L5S4.dg N487.TT) N487.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h209 p hp
  · exact h681 p hp
  · exact h682 p hp
  · exact h722 p hp
  · exact h734 p hp
  · exact h735 p hp
)


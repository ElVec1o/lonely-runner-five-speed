theorem lines (t5 : List T5Rec) (h699 : ∀ p ∈ LinRQSC699.blobs, LinesCl t5 (t4OfRec p.1)) (h700 : ∀ p ∈ LinRQSC700.blobs, LinesCl t5 (t4OfRec p.1)) (h701 : ∀ p ∈ LinRQSC701.blobs, LinesCl t5 (t4OfRec p.1))

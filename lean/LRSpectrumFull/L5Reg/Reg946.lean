/-
# L5Reg.Reg946 : the lines clause for every class of the local table of rep #946 (generated by l5reg)

Every local class `i < nT` of rep #946 (18 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O946T
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC880
import LRSpectrumFull.L5S4.LinRQSC881
import LRSpectrumFull.L5S4.LinRQSC888

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R946
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(879, LinRQSC879.blobs), (880, LinRQSC880.blobs), (881, LinRQSC881.blobs), (888, LinRQSC888.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(888, 142, [3, 0, -1, 0, -1, 0, -1, 1, 0]), (888, 143, [3, 0, -2, 0, 1, -1, 2, 1, -2]), (888, 144, [3, 0, -2, 0, -2, 1, 1, -1, 0]), (888, 145, [1, 0, -1, 2, -1, -1, -2, -1, 2]), (888, 146, [3, 1, -3, 0, 1, -1, -1, 3, -2]), (888, 147, [1, 0, 0, 0, -1, 1, 0, 0, -1]), (888, 148, [3, 0, -1, 0, -1, 0, -1, 0, 0]), (888, 149, [3, 0, -1, 0, 2, -1, -2, -1, 1]), (888, 150, [3, -2, 1, 0, -1, 1, -2, 0, 1]), (879, 223, [3, 0, -2, -1, -1, 1, 0, 1, 0]), (888, 151, [3, 0, -1, 0, -2, 1, -1, 1, 0]), (888, 152, [3, -1, -2, 0, -2, 1, 1, -2, 0]), (888, 153, [3, -2, 1, 0, -1, 1, -1, 0, 0]), (880, 111, [3, 1, -2, -2, 2, 1, 0, 1, 0]), (888, 154, [3, 0, -2, 0, -2, 1, 1, 3, -2]), (888, 155, [1, 0, 0, 0, 2, -1, 0, 3, -2]), (881, 132, [3, 0, -1, -1, -3, 2, 0, 2, -1]), (881, 126, [3, 0, -2, -1, -3, 2, 2, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N946.TT) N946.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N946.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #946. -/
theorem lines (t5 : List T5Rec) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N946.nT).map (t4At (LRSpectrumFull.L5S4.dg N946.TT) N946.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h879 p hp
  · exact h880 p hp
  · exact h881 p hp
  · exact h888 p hp
)

#print axioms lines

end R946
end L5Reg
end LRSpectrumFull

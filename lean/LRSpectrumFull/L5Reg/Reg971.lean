theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h893 : ∀ p ∈ LinRQSC893.blobs, LinesCl t5 (t4OfRec p.1)) (h894 : ∀ p ∈ LinRQSC894.blobs, LinesCl t5 (t4OfRec p.1))

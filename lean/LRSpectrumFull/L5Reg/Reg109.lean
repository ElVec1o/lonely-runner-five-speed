/-
# L5Reg.Reg109 : the lines clause for every class of the local table of rep #109 (generated by l5reg)

Every local class `i < nT` of rep #109 (23 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O109T
import LRSpectrumFull.L5S4.LinRQSC58
import LRSpectrumFull.L5S4.LinRQSC112

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R109
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(58, LinRQSC58.blobs), (112, LinRQSC112.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(112, 28, [0, -1, 0, 0, 0, -1, -1, 0, 1]), (112, 29, [1, 0, 0, 0, 0, -1, 0, 1, 1]), (112, 30, [0, 0, 1, -3, 2, -1, -1, 1, 0]), (112, 31, [0, -1, 1, 0, 0, 1, -1, 1, 0]), (112, 32, [0, 0, 1, -3, 2, -1, -2, 1, 0]), (112, 33, [0, -1, 1, 0, 0, 1, -1, 0, 0]), (112, 34, [1, 0, 0, 0, -3, 2, 0, -1, 1]), (112, 35, [0, 2, -1, -3, 0, 1, -4, 1, 1]), (112, 36, [0, 0, -1, 0, 1, 0, -1, 1, 0]), (112, 37, [0, 0, -1, 0, -1, 0, -1, 1, 0]), (112, 38, [0, -1, 1, -3, 0, 2, -2, -1, 2]), (112, 39, [1, 0, 0, 0, -3, 2, 1, -1, 1]), (112, 40, [2, 0, -1, 0, 3, -2, 1, 4, -3]), (112, 41, [1, 0, 0, 0, -1, -1, 0, -1, 0]), (112, 42, [1, 0, 0, 0, 3, -1, 1, 1, 0]), (112, 43, [1, 0, 0, 0, -1, -3, 1, 0, 1]), (112, 44, [2, -1, 0, 0, 0, 1, 1, 0, 0]), (58, 61, [2, 1, -1, -1, 4, -2, 0, -2, 1]), (58, 81, [2, 0, -1, -1, 0, 0, 0, -1, 2]), (112, 45, [1, 1, -1, 0, 2, -1, 1, -2, 1]), (58, 60, [2, 1, -1, -1, 4, -2, 0, 2, -1]), (112, 46, [2, 1, -2, 0, 2, -1, 1, -3, 1]), (112, 47, [1, 0, 0, 0, -3, 2, 1, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N109.TT) N109.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N109.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #109. -/
theorem lines (t5 : List T5Rec) (h58 : ∀ p ∈ LinRQSC58.blobs, LinesCl t5 (t4OfRec p.1)) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N109.nT).map (t4At (LRSpectrumFull.L5S4.dg N109.TT) N109.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h58 p hp
  · exact h112 p hp
)

#print axioms lines

end R109
end L5Reg
end LRSpectrumFull

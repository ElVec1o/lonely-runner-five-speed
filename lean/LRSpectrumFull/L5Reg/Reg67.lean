/-- the lines clause for every class of the local table of rep #67. -/
theorem lines (t5 : List T5Rec) (h43 : ∀ p ∈ LinRQSC43.blobs, LinesCl t5 (t4OfRec p.1)) (h44 : ∀ p ∈ LinRQSC44.blobs, LinesCl t5 (t4OfRec p.1)) (h45 : ∀ p ∈ LinRQSC45.blobs, LinesCl t5 (t4OfRec p.1)) (h46 : ∀ p ∈ LinRQSC46.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N67.nT).map (t4At (LRSpectrumFull.L5S4.dg N67.TT) N67.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N67.nT := List.mem_range.1 hc
  have hn : N67.nT = 320 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 320) := by omega
  rcases hcase with h | h | h | h
  · exact P67_0.lines t5 h43 h44 c h.1 (by omega)
  · exact P67_1.lines t5 h44 h45 c h.1 (by omega)
  · exact P67_2.lines t5 h45 h46 c h.1 (by omega)
  · exact P67_3.lines t5 h46 c h.1 (by omega)

#print axioms lines

end R67

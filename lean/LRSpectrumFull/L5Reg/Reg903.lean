/-
# L5Reg.Reg903 : the lines clause for every class of the local table of rep #903 (generated by l5reg)

Every local class `i < nT` of rep #903 (26 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O903T
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC880
import LRSpectrumFull.L5S4.LinRQSC881
import LRSpectrumFull.L5S4.LinRQSC882

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R903
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(879, LinRQSC879.blobs), (880, LinRQSC880.blobs), (881, LinRQSC881.blobs), (882, LinRQSC882.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(879, 127, [3, -2, 0, 0, -1, 1, 2, 0, -1]), (882, 195, [3, -2, 0, -2, 1, 0, 2, -1, 1]), (882, 196, [3, 1, -1, 0, -3, 2, 2, -2, 1]), (882, 197, [3, 0, -1, -2, -1, 1, 2, -1, 0]), (882, 198, [3, 0, -2, -2, -1, 1, -2, 0, 1]), (882, 199, [3, -1, -1, -2, -2, 1, -2, -1, 1]), (879, 138, [3, -2, -1, 0, 0, -1, -2, 1, 0]), (879, 106, [3, -2, -1, 0, 0, -1, -2, 1, 0]), (879, 107, [3, -2, -1, 0, 0, -1, -1, 1, -1]), (881, 53, [3, -2, 0, -2, 1, 0, 2, 0, -1]), (882, 200, [3, 0, -1, 0, -1, 1, 2, 1, -2]), (882, 201, [3, -1, 0, -2, 1, 0, 2, -1, 1]), (882, 202, [3, 0, -1, -2, -1, 1, 2, 0, -1]), (882, 203, [3, 0, -2, -2, 1, 1, 0, -1, 0]), (882, 204, [1, -3, 0, -1, 2, 0, -3, -2, 1]), (882, 205, [3, 0, -2, -2, -1, 2, 0, 1, -1]), (882, 206, [3, 0, -1, -2, -1, 1, -2, 1, 0]), (882, 207, [3, -2, 0, -2, 1, -1, -2, 1, 0]), (882, 208, [3, 0, -2, -2, -1, 2, 0, -2, 1]), (882, 209, [3, 1, -3, -2, -1, 2, 0, -3, 1]), (882, 210, [1, 0, -1, 2, -1, -1, 0, 2, -1]), (882, 211, [3, -2, 0, -2, 1, 0, 1, -1, -1]), (882, 212, [3, 0, -2, 0, -1, 1, 2, 2, -3]), (880, 203, [3, 0, -2, 1, 0, -1, 0, -1, 1]), (882, 213, [1, 0, 0, 3, -1, 0, -2, -2, 1]), (882, 214, [1, 0, 0, 2, 2, 1, 1, -3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N903.TT) N903.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N903.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #903. -/
theorem lines (t5 : List T5Rec) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h882 : ∀ p ∈ LinRQSC882.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N903.nT).map (t4At (LRSpectrumFull.L5S4.dg N903.TT) N903.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h879 p hp
  · exact h880 p hp
  · exact h881 p hp
  · exact h882 p hp
)

#print axioms lines

end R903
end L5Reg
end LRSpectrumFull

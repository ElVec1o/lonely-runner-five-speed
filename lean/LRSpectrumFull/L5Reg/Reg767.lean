theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N767.TT) N767.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N767.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #767. -/
theorem lines (t5 : List T5Rec) (h869 : ∀ p ∈ LinRQSC869.blobs, LinesCl t5 (t4OfRec p.1)) (h870 : ∀ p ∈ LinRQSC870.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N767.nT).map (t4At (LRSpectrumFull.L5S4.dg N767.TT) N767.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h869 p hp
  · exact h870 p hp
)

#print axioms lines


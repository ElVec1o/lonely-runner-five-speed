/-
# L5Reg.RegFin66 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg512
import LRSpectrumFull.L5Reg.Reg458
import LRSpectrumFull.L5Reg.Reg527

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines512 : ∀ cl ∈ (List.range N512.nT).map (t4At (LRSpectrumFull.L5S4.dg N512.TT) N512.ST), LinesCl T5Store.t5 cl :=
  R512.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem756 p hp))

theorem lines458 : ∀ cl ∈ (List.range N458.nT).map (t4At (LRSpectrumFull.L5S4.dg N458.TT) N458.ST), LinesCl T5Store.t5 cl :=
  R458.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem726 p hp))

theorem lines527 : ∀ cl ∈ (List.range N527.nT).map (t4At (LRSpectrumFull.L5S4.dg N527.TT) N527.ST), LinesCl T5Store.t5 cl :=
  R527.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem798 p hp)) (fun p hp => FinalGlue.glines p (mem799 p hp))

#print axioms lines512

end L5Reg
end LRSpectrumFull

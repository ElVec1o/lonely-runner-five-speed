/-- the lines clause for every class of the local table of rep #365. -/
theorem lines (t5 : List T5Rec) (h203 : ∀ p ∈ LinRQSC203.blobs, LinesCl t5 (t4OfRec p.1)) (h681 : ∀ p ∈ LinRQSC681.blobs, LinesCl t5 (t4OfRec p.1)) (h682 : ∀ p ∈ LinRQSC682.blobs, LinesCl t5 (t4OfRec p.1)) (h722 : ∀ p ∈ LinRQSC722.blobs, LinesCl t5 (t4OfRec p.1)) (h723 : ∀ p ∈ LinRQSC723.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N365.nT).map (t4At (LRSpectrumFull.L5S4.dg N365.TT) N365.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h203 p hp
  · exact h681 p hp
  · exact h682 p hp
  · exact h722 p hp
  · exact h723 p hp
)


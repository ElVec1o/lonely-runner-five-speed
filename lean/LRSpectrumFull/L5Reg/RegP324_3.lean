/-- the lines clause for local classes 300..365 of rep #324. -/
theorem lines (t5 : List T5Rec) (h698 : ∀ p ∈ LinRQSC698.blobs, LinesCl t5 (t4OfRec p.1)) (h699 : ∀ p ∈ LinRQSC699.blobs, LinesCl t5 (t4OfRec p.1))

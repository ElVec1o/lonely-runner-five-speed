/-- the lines clause for local classes 300..379 of rep #525. -/
theorem lines (t5 : List T5Rec) (h794 : ∀ p ∈ LinRQSC794.blobs, LinesCl t5 (t4OfRec p.1)) (h795 : ∀ p ∈ LinRQSC795.blobs, LinesCl t5 (t4OfRec p.1))

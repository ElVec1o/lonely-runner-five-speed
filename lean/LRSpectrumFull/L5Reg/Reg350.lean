theorem lines (t5 : List T5Rec) (h490 : ∀ p ∈ LinRQSC490.blobs, LinesCl t5 (t4OfRec p.1)) (h493 : ∀ p ∈ LinRQSC493.blobs, LinesCl t5 (t4OfRec p.1)) (h494 : ∀ p ∈ LinRQSC494.blobs, LinesCl t5 (t4OfRec p.1)) (h718 : ∀ p ∈ LinRQSC718.blobs, LinesCl t5 (t4OfRec p.1)) (h719 : ∀ p ∈ LinRQSC719.blobs, LinesCl t5 (t4OfRec p.1)) (h720 : ∀ p ∈ LinRQSC720.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N350.nT).map (t4At (LRSpectrumFull.L5S4.dg N350.TT) N350.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h490 p hp
  · exact h493 p hp
  · exact h494 p hp
  · exact h718 p hp
  · exact h719 p hp
  · exact h720 p hp
)


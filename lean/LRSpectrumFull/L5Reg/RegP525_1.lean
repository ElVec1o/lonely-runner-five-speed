/-- the lines clause for local classes 100..199 of rep #525. -/
theorem lines (t5 : List T5Rec) (h540 : ∀ p ∈ LinRQSC540.blobs, LinesCl t5 (t4OfRec p.1)) (h791 : ∀ p ∈ LinRQSC791.blobs, LinesCl t5 (t4OfRec p.1)) (h792 : ∀ p ∈ LinRQSC792.blobs, LinesCl t5 (t4OfRec p.1)) (h793 : ∀ p ∈ LinRQSC793.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N525.TT) N525.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h540 p hpe
    · exact h791 p hpe
    · exact h792 p hpe
    · exact h793 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


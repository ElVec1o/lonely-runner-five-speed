/-
# L5Reg.Reg775 : the lines clause for every class of the local table of rep #775 (generated by l5reg)

Every local class `i < nT` of rep #775 (29 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O775T
import LRSpectrumFull.L5S4.LinRQSC871

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R775
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(871, LinRQSC871.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(871, 96, [1, 0, 0, 2, -1, 0, -2, -1, 1]), (871, 97, [1, 0, 0, 2, 2, -1, -3, 1, 0]), (871, 98, [0, 1, 0, 0, 0, 1, -1, 0, 0]), (871, 99, [2, 0, -1, 0, 1, 0, -1, 0, 1]), (871, 100, [1, 0, 0, 2, -2, 1, -1, -3, 2]), (871, 101, [0, 1, 0, 2, 2, -1, 3, -1, -1]), (871, 102, [0, -1, 1, 2, -2, 1, 3, 1, -2]), (871, 103, [2, -1, -1, 0, -2, 1, -1, -1, 1]), (871, 104, [2, -1, -1, 0, -2, 1, -1, -1, 1]), (871, 105, [0, -1, 0, 2, 1, -1, 1, -2, 0]), (871, 106, [0, 1, -1, 2, 2, -3, 1, -2, 1]), (871, 107, [0, -1, 0, 2, 1, -1, 1, -1, 0]), (871, 108, [2, -1, 0, 0, -1, 1, -1, 1, 0]), (871, 109, [0, 1, -1, 2, -1, 0, 1, 2, -2]), (871, 110, [0, 1, -1, 2, 2, -3, 1, -2, 1]), (871, 111, [2, 0, -1, 0, -1, 0, -1, 0, 0]), (871, 112, [2, 0, -1, 0, -1, 0, -1, 0, 1]), (871, 113, [1, 0, 0, 0, -2, 1, -1, -1, 1]), (871, 114, [1, 1, -1, 0, -1, 0, -1, 2, 0]), (871, 115, [1, -1, 0, 0, -1, 0, -1, 0, 1]), (871, 116, [0, 1, -1, 2, -1, 0, 1, 2, -2]), (871, 117, [0, 1, -1, 2, -1, 0, 1, 2, -2]), (871, 118, [2, 1, -1, 0, -1, 0, -1, 2, 0]), (871, 119, [1, 0, 0, -1, 2, -1, 3, 1, -1]), (871, 120, [1, 2, -2, -1, 0, 1, 2, -1, -1]), (871, 121, [1, 0, 0, -1, 2, -1, 2, 1, -1]), (871, 122, [1, 0, -1, -1, 1, 0, 2, 1, -2]), (871, 123, [1, 2, -2, -1, 0, 1, 2, -1, -1]), (871, 124, [1, -2, 0, -1, 0, 1, 3, 1, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N775.TT) N775.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N775.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #775. -/
theorem lines (t5 : List T5Rec) (h871 : ∀ p ∈ LinRQSC871.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N775.nT).map (t4At (LRSpectrumFull.L5S4.dg N775.TT) N775.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h871 p hp
)

#print axioms lines

end R775
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1221 : the lines clause for every class of the local table of rep #1221 (generated by l5reg)

Every local class `i < nT` of rep #1221 (6 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1221T
import LRSpectrumFull.L5S4.LinRQSC958

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1221
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(958, LinRQSC958.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(958, 64, [2, 1, -2, 0, 4, -1, -1, -1, 1]), (958, 65, [1, -1, 0, 4, 1, -3, 0, 3, -2]), (958, 66, [1, 1, -1, 4, 0, -3, -2, 1, 1]), (958, 67, [1, 1, -1, 4, 0, -3, 2, -1, -1]), (958, 68, [1, 0, 0, 4, -1, -1, 0, 0, 1]), (958, 69, [1, 1, -1, 4, 0, -1, -2, -3, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1221.TT) N1221.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1221.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1221. -/
theorem lines (t5 : List T5Rec) (h958 : ∀ p ∈ LinRQSC958.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1221.nT).map (t4At (LRSpectrumFull.L5S4.dg N1221.TT) N1221.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h958 p hp
)

#print axioms lines

end R1221
end L5Reg
end LRSpectrumFull

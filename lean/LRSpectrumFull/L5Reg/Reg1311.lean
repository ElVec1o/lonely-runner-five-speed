theorem adv_len : adv.length = N1311.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1311. -/
theorem lines (t5 : List T5Rec) (h943 : ∀ p ∈ LinRQSC943.blobs, LinesCl t5 (t4OfRec p.1)) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1311.nT).map (t4At (LRSpectrumFull.L5S4.dg N1311.TT) N1311.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h943 p hp
  · exact h1004 p hp
)

#print axioms lines


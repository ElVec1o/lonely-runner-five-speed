/-
# L5Reg.Reg989 : the lines clause for every class of the local table of rep #989 (generated by l5reg)

Every local class `i < nT` of rep #989 (38 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O989T
import LRSpectrumFull.L5S4.LinRQSC888
import LRSpectrumFull.L5S4.LinRQSC891
import LRSpectrumFull.L5S4.LinRQSC901

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R989
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(888, LinRQSC888.blobs), (891, LinRQSC891.blobs), (901, LinRQSC901.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(901, 99, [2, 0, -1, 1, 1, -1, -3, 0, 2]), (901, 100, [0, 0, 1, 0, 1, -1, -1, 0, 0]), (901, 101, [2, 2, -1, 1, -2, 0, -2, 3, 0]), (891, 94, [2, -2, -1, -1, -2, 1, -2, -3, 2]), (901, 102, [2, -1, -1, -2, 2, 1, 1, 0, -1]), (901, 103, [2, -2, 1, -2, 1, 0, 1, 0, 0]), (901, 104, [2, -1, 0, 1, -2, 1, 2, 3, -3]), (901, 105, [2, 1, -2, 1, -1, 0, 2, 0, -1]), (901, 106, [0, 2, -1, 0, 1, 0, -1, 0, 0]), (901, 107, [2, -2, -1, -2, -1, 2, 3, 2, -3]), (901, 108, [0, 1, 0, 0, 2, -1, -1, 0, 0]), (901, 109, [0, 2, -1, 0, 1, 0, -1, 0, 1]), (901, 110, [1, -1, 0, -1, -2, 2, 1, 0, -1]), (901, 111, [1, 2, -1, -1, 1, 0, 1, -3, 1]), (901, 112, [1, -2, 0, -1, -1, 1, 1, 3, -2]), (901, 113, [2, -1, -1, -2, 0, 1, 3, -1, -2]), (901, 114, [2, -1, -1, -2, 2, 1, 3, -2, -2]), (901, 115, [2, -2, 1, -2, -1, 1, 3, 2, -2]), (901, 116, [1, -2, 1, 2, 2, -3, -1, 1, 0]), (901, 117, [1, 0, -1, -1, -2, 2, 0, -3, 2]), (901, 118, [1, -2, 1, 2, -1, 0, -3, -2, 2]), (901, 119, [1, 2, -1, -1, 1, 0, 0, -2, 1]), (888, 199, [1, -2, 1, 2, -1, 0, -3, -2, 2]), (901, 120, [1, 0, 0, -1, -1, 1, 1, -1, 0]), (901, 121, [1, 0, -1, -1, -2, 2, 0, -3, 2]), (901, 122, [2, -1, -1, -2, 0, 1, 1, -2, 0]), (901, 123, [2, -1, 0, -2, 1, -1, -1, 1, 0]), (901, 124, [1, -2, 1, 2, 2, -3, -3, -1, 3]), (901, 125, [2, -1, -1, -2, 1, 0, 1, 0, 0]), (901, 126, [1, 0, 0, -1, 2, -1, 1, 3, -2]), (901, 127, [2, 0, -1, -2, 1, 1, 3, 1, -2]), (901, 128, [1, -1, 0, 2, 1, -1, -1, 0, 0]), (901, 129, [1, -1, 0, 2, 1, -2, -4, 0, 3]), (901, 130, [1, 0, -1, 2, -2, -1, -2, -3, 3]), (901, 131, [1, -1, 0, 2, 0, -1, -2, 1, 0]), (901, 132, [0, -2, 1, 1, 2, -2, 1, -3, 1]), (901, 133, [0, -2, 1, 1, 2, -2, 1, -1, 0]), (901, 134, [1, 0, -1, 2, -2, -1, -2, -3, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N989.TT) N989.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N989.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #989. -/
theorem lines (t5 : List T5Rec) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1)) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N989.nT).map (t4At (LRSpectrumFull.L5S4.dg N989.TT) N989.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h888 p hp
  · exact h891 p hp
  · exact h901 p hp
)

#print axioms lines

end R989
end L5Reg
end LRSpectrumFull

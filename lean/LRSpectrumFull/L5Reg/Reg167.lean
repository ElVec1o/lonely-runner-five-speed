/-
# L5Reg.Reg167 : the lines clause for every class of the local table of rep #167 (generated by l5reg)

Every local class `i < nT` of rep #167 (2 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O167T
import LRSpectrumFull.L5S4.LinRQSC112
import LRSpectrumFull.L5S4.LinRQSC185

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R167
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(112, LinRQSC112.blobs), (185, LinRQSC185.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(185, 55, [2, -1, 0, -2, 2, -1, 1, -1, 0]), (112, 26, [2, -1, 0, -1, 1, 0, -2, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N167.TT) N167.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N167.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #167. -/
theorem lines (t5 : List T5Rec) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1)) (h185 : ∀ p ∈ LinRQSC185.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N167.nT).map (t4At (LRSpectrumFull.L5S4.dg N167.TT) N167.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h112 p hp
  · exact h185 p hp
)

#print axioms lines

end R167
end L5Reg
end LRSpectrumFull

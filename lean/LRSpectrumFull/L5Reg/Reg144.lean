/-- the lines clause for every class of the local table of rep #144. -/
theorem lines (t5 : List T5Rec) (h48 : ∀ p ∈ LinRQSC48.blobs, LinesCl t5 (t4OfRec p.1)) (h49 : ∀ p ∈ LinRQSC49.blobs, LinesCl t5 (t4OfRec p.1)) (h87 : ∀ p ∈ LinRQSC87.blobs, LinesCl t5 (t4OfRec p.1)) (h88 : ∀ p ∈ LinRQSC88.blobs, LinesCl t5 (t4OfRec p.1)) (h136 : ∀ p ∈ LinRQSC136.blobs, LinesCl t5 (t4OfRec p.1)) (h137 : ∀ p ∈ LinRQSC137.blobs, LinesCl t5 (t4OfRec p.1)) (h138 : ∀ p ∈ LinRQSC138.blobs, LinesCl t5 (t4OfRec p.1)) (h139 : ∀ p ∈ LinRQSC139.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N144.nT).map (t4At (LRSpectrumFull.L5S4.dg N144.TT) N144.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N144.nT := List.mem_range.1 hc
  have hn : N144.nT = 342 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 342) := by omega
  rcases hcase with h | h | h | h
  · exact P144_0.lines t5 h49 h87 h88 h136 h137 c h.1 (by omega)
  · exact P144_1.lines t5 h48 h87 h88 h137 h138 c h.1 (by omega)
  · exact P144_2.lines t5 h48 h49 h138 h139 c h.1 (by omega)
  · exact P144_3.lines t5 h139 c h.1 (by omega)

#print axioms lines

end R144

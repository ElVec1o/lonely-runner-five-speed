/-- the lines clause for every class of the local table of rep #490. -/
theorem lines (t5 : List T5Rec) (h739 : ∀ p ∈ LinRQSC739.blobs, LinesCl t5 (t4OfRec p.1)) (h740 : ∀ p ∈ LinRQSC740.blobs, LinesCl t5 (t4OfRec p.1)) (h741 : ∀ p ∈ LinRQSC741.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N490.nT).map (t4At (LRSpectrumFull.L5S4.dg N490.TT) N490.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h739 p hp
  · exact h740 p hp
  · exact h741 p hp
)


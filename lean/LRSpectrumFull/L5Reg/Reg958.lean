/-- the lines clause for every class of the local table of rep #958. -/
theorem lines (t5 : List T5Rec) (h889 : ∀ p ∈ LinRQSC889.blobs, LinesCl t5 (t4OfRec p.1)) (h890 : ∀ p ∈ LinRQSC890.blobs, LinesCl t5 (t4OfRec p.1)) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N958.nT).map (t4At (LRSpectrumFull.L5S4.dg N958.TT) N958.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h889 p hp
  · exact h890 p hp
  · exact h891 p hp
)


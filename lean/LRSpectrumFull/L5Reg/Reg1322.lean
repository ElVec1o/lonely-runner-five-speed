/-- the lines clause for every class of the local table of rep #1322. -/
theorem lines (t5 : List T5Rec) (h926 : ∀ p ∈ LinRQSC926.blobs, LinesCl t5 (t4OfRec p.1)) (h1006 : ∀ p ∈ LinRQSC1006.blobs, LinesCl t5 (t4OfRec p.1)) (h1007 : ∀ p ∈ LinRQSC1007.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1322.nT).map (t4At (LRSpectrumFull.L5S4.dg N1322.TT) N1322.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h926 p hp
  · exact h1006 p hp
  · exact h1007 p hp
)


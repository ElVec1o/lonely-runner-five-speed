theorem lines (t5 : List T5Rec) (h220 : ∀ p ∈ LinRQSC220.blobs, LinesCl t5 (t4OfRec p.1)) (h221 : ∀ p ∈ LinRQSC221.blobs, LinesCl t5 (t4OfRec p.1)) (h222 : ∀ p ∈ LinRQSC222.blobs, LinesCl t5 (t4OfRec p.1)) (h223 : ∀ p ∈ LinRQSC223.blobs, LinesCl t5 (t4OfRec p.1)) (h224 : ∀ p ∈ LinRQSC224.blobs, LinesCl t5 (t4OfRec p.1))

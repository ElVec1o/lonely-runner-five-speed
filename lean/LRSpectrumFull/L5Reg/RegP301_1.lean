/-- the lines clause for local classes 100..199 of rep #301. -/
theorem lines (t5 : List T5Rec) (h528 : ∀ p ∈ LinRQSC528.blobs, LinesCl t5 (t4OfRec p.1)) (h529 : ∀ p ∈ LinRQSC529.blobs, LinesCl t5 (t4OfRec p.1)) (h530 : ∀ p ∈ LinRQSC530.blobs, LinesCl t5 (t4OfRec p.1)) (h531 : ∀ p ∈ LinRQSC531.blobs, LinesCl t5 (t4OfRec p.1)) (h532 : ∀ p ∈ LinRQSC532.blobs, LinesCl t5 (t4OfRec p.1)) (h533 : ∀ p ∈ LinRQSC533.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N301.TT) N301.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl
    · exact h528 p hpe
    · exact h529 p hpe
    · exact h530 p hpe
    · exact h531 p hpe
    · exact h532 p hpe
    · exact h533 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


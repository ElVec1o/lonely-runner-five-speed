/-- the lines clause for every class of the local table of rep #1923. -/
theorem lines (t5 : List T5Rec) (h886 : ∀ p ∈ LinRQSC886.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1)) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1)) (h1050 : ∀ p ∈ LinRQSC1050.blobs, LinesCl t5 (t4OfRec p.1)) (h1051 : ∀ p ∈ LinRQSC1051.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1923.nT).map (t4At (LRSpectrumFull.L5S4.dg N1923.TT) N1923.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h886 p hp
  · exact h1048 p hp
  · exact h1049 p hp
  · exact h1050 p hp
  · exact h1051 p hp
)


/-
# L5Reg.Reg764 : the lines clause for every class of the local table of rep #764 (generated by l5reg)

Every local class `i < nT` of rep #764 (16 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O764T
import LRSpectrumFull.L5S4.LinRQSC869

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R764
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(869, LinRQSC869.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(869, 225, [1, -2, 0, 2, 0, -1, 2, 1, -1]), (869, 226, [1, -1, 0, 2, -1, -1, 1, 0, 0]), (869, 227, [0, -1, 1, 1, -2, 1, 2, 1, -2]), (869, 228, [1, 2, -1, -1, 0, 0, 2, -1, 0]), (869, 229, [0, 1, -1, 1, 2, -2, 2, -1, 0]), (869, 230, [1, 0, -1, 2, 0, -1, -1, 1, 1]), (869, 231, [1, 0, 0, 0, -1, 1, 1, 0, -1]), (869, 232, [2, 1, -1, 0, 2, -1, 1, -2, 1]), (869, 233, [1, 0, 0, 2, -1, 0, 1, 2, -1]), (869, 234, [1, 0, 0, 2, 1, -1, 0, -2, 1]), (869, 235, [1, 0, 0, 2, 0, -1, 1, 1, -1]), (869, 236, [1, 0, -1, 2, 0, -1, -1, -1, 1]), (869, 237, [0, -1, 0, 0, -2, -1, 1, 1, 1]), (869, 238, [1, -1, 0, 2, 1, -2, -2, 1, 1]), (869, 239, [1, -1, 0, 2, 1, -1, 0, 1, 0]), (869, 240, [1, -1, 1, 2, -1, 0, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N764.TT) N764.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N764.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #764. -/
theorem lines (t5 : List T5Rec) (h869 : ∀ p ∈ LinRQSC869.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N764.nT).map (t4At (LRSpectrumFull.L5S4.dg N764.TT) N764.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h869 p hp
)

#print axioms lines

end R764
end L5Reg
end LRSpectrumFull

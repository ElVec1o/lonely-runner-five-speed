/-- the lines clause for every class of the local table of rep #1033. -/
theorem lines (t5 : List T5Rec) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1)) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg857 : the lines clause for every class of the local table of rep #857 (generated by l5reg)

Every local class `i < nT` of rep #857 (24 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O857T
import LRSpectrumFull.L5S4.LinRQSC877
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC880

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R857
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(877, LinRQSC877.blobs), (879, LinRQSC879.blobs), (880, LinRQSC880.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(879, 215, [3, 0, -1, -1, 0, 0, 0, -1, 0]), (879, 216, [0, 3, -2, 0, -1, 1, -1, -1, 1]), (879, 217, [0, 1, -1, 1, -2, 1, 1, 2, -2]), (879, 218, [0, -1, 1, 2, -1, 0, -3, 2, -1]), (879, 219, [0, 1, 0, 2, 2, -1, 3, -1, -1]), (879, 220, [3, -2, 0, -1, 1, 0, 0, 0, 1]), (879, 221, [3, 0, -1, -1, 0, 0, 2, 1, -2]), (879, 222, [3, 0, -1, -1, 2, 0, 0, 1, 0]), (879, 223, [3, 0, -2, -1, -1, 1, 0, 1, 0]), (880, 0, [3, 0, -1, -1, 0, 0, 1, 1, -1]), (880, 1, [1, 0, 0, 2, -2, 1, -1, -3, 2]), (880, 2, [1, 3, -2, 2, -1, -1, -3, 0, 2]), (880, 3, [1, 3, -2, -2, -1, 2, -2, 2, 1]), (880, 4, [1, 3, -1, 2, -1, -1, -2, 0, 1]), (880, 5, [1, 3, -2, 2, -1, 0, -1, 2, -1]), (880, 6, [3, 0, -1, -1, 1, 0, 2, 0, -1]), (880, 7, [3, 0, -1, -1, -1, 1, 2, 0, -1]), (877, 1, [1, -3, 0, 3, 2, -2, -2, 1, 1]), (880, 8, [1, 0, 0, 2, 2, -1, -3, 1, 0]), (880, 9, [3, 1, -1, -1, -2, 1, 2, -3, 1]), (880, 10, [3, -1, -1, -1, 2, -1, 2, 2, -3]), (880, 11, [3, -1, 0, -1, -2, 2, 2, 3, -3]), (880, 12, [3, 0, -1, -1, -1, 1, 2, 0, -1]), (880, 13, [3, -1, -1, -1, 2, 0, 1, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N857.TT) N857.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N857.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #857. -/
theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N857.nT).map (t4At (LRSpectrumFull.L5S4.dg N857.TT) N857.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h877 p hp
  · exact h879 p hp
  · exact h880 p hp
)

#print axioms lines

end R857
end L5Reg
end LRSpectrumFull

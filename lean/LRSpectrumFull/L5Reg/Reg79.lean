/-- the lines clause for every class of the local table of rep #79. -/
theorem lines (t5 : List T5Rec) (h72 : ∀ p ∈ LinRQSC72.blobs, LinesCl t5 (t4OfRec p.1)) (h73 : ∀ p ∈ LinRQSC73.blobs, LinesCl t5 (t4OfRec p.1)) (h74 : ∀ p ∈ LinRQSC74.blobs, LinesCl t5 (t4OfRec p.1)) (h75 : ∀ p ∈ LinRQSC75.blobs, LinesCl t5 (t4OfRec p.1)) (h76 : ∀ p ∈ LinRQSC76.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N79.nT).map (t4At (LRSpectrumFull.L5S4.dg N79.TT) N79.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N79.nT := List.mem_range.1 hc
  have hn : N79.nT = 399 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 399) := by omega
  rcases hcase with h | h | h | h
  · exact P79_0.lines t5 h72 h73 c h.1 (by omega)
  · exact P79_1.lines t5 h73 h74 c h.1 (by omega)
  · exact P79_2.lines t5 h74 h75 c h.1 (by omega)
  · exact P79_3.lines t5 h75 h76 c h.1 (by omega)

#print axioms lines


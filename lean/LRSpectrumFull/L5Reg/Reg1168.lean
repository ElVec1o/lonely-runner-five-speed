/-
# L5Reg.Reg1168 : the lines clause for every class of the local table of rep #1168 (generated by l5reg)

Every local class `i < nT` of rep #1168 (13 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1168T
import LRSpectrumFull.L5S4.LinRQSC934

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1168
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(934, LinRQSC934.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(934, 102, [1, 0, -1, 3, 0, -2, -1, 1, 0]), (934, 103, [1, 2, -2, 3, -1, -2, -1, 3, -1]), (934, 104, [1, 2, -1, 3, -1, -1, 0, 3, -1]), (934, 105, [1, 2, -2, 3, -1, 0, 0, 1, -1]), (934, 106, [1, 2, -1, 3, -1, -2, -2, 2, 1]), (934, 107, [1, 1, -1, 3, -1, 0, -1, -2, 2]), (934, 108, [1, 0, 0, 3, -1, -1, -2, 0, 1]), (934, 109, [1, 1, -1, 3, -1, -2, 0, -3, 1]), (934, 110, [1, -1, 0, -1, -3, 3, -3, 2, 1]), (934, 111, [1, 0, -1, 3, 0, -2, 1, -1, 0]), (934, 112, [1, -1, 0, 3, -1, -1, -1, 2, 0]), (934, 113, [1, -1, 0, 3, 1, -3, 0, 3, -2]), (934, 114, [1, -1, 0, 3, 1, -3, -1, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1168.TT) N1168.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1168.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1168. -/
theorem lines (t5 : List T5Rec) (h934 : ∀ p ∈ LinRQSC934.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1168.nT).map (t4At (LRSpectrumFull.L5S4.dg N1168.TT) N1168.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h934 p hp
)

#print axioms lines

end R1168
end L5Reg
end LRSpectrumFull

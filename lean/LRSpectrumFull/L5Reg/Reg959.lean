/-- the lines clause for every class of the local table of rep #959. -/
theorem lines (t5 : List T5Rec) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N959.nT).map (t4At (LRSpectrumFull.L5S4.dg N959.TT) N959.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h891 p hp
)


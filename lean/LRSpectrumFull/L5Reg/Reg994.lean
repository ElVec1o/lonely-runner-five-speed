/-
# L5Reg.Reg994 : the lines clause for every class of the local table of rep #994 (generated by l5reg)

Every local class `i < nT` of rep #994 (8 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O994T
import LRSpectrumFull.L5S4.LinRQSC892
import LRSpectrumFull.L5S4.LinRQSC902

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R994
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs), (902, LinRQSC902.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(902, 101, [2, 2, -3, -1, 1, 0, -3, 2, 1]), (892, 40, [2, 1, -2, -2, 1, 1, 1, 2, -2]), (902, 102, [0, 2, -1, 0, -1, 0, -1, -2, 1]), (902, 103, [0, 1, 0, 1, -1, 0, 2, -1, -1]), (902, 104, [2, -2, 1, 1, 0, 0, 3, -1, 0]), (902, 105, [2, -1, -1, 1, -3, 0, 3, 0, -2]), (892, 33, [2, 2, -3, -2, 3, -1, -1, 1, 0]), (902, 106, [1, -2, 0, 3, -1, -2, -3, -2, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N994.TT) N994.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N994.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #994. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N994.nT).map (t4At (LRSpectrumFull.L5S4.dg N994.TT) N994.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h892 p hp
  · exact h902 p hp
)

#print axioms lines

end R994
end L5Reg
end LRSpectrumFull

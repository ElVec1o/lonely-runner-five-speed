/-- the lines clause for every class of the local table of rep #992. -/
theorem lines (t5 : List T5Rec) (h894 : ∀ p ∈ LinRQSC894.blobs, LinesCl t5 (t4OfRec p.1)) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h900 : ∀ p ∈ LinRQSC900.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N992.nT).map (t4At (LRSpectrumFull.L5S4.dg N992.TT) N992.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h894 p hp
  · exact h896 p hp
  · exact h900 p hp
  · exact h901 p hp
  · exact h902 p hp
)


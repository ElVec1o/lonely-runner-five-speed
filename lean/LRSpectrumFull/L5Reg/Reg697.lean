/-
# L5Reg.Reg697 : the lines clause for every class of the local table of rep #697 (generated by l5reg)

Every local class `i < nT` of rep #697 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O697T
import LRSpectrumFull.L5S4.LinRQSC438
import LRSpectrumFull.L5S4.LinRQSC439
import LRSpectrumFull.L5S4.LinRQSC841
import LRSpectrumFull.L5S4.LinRQSC866

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R697
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(438, LinRQSC438.blobs), (439, LinRQSC439.blobs), (841, LinRQSC841.blobs), (866, LinRQSC866.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(866, 67, [1, 0, -1, -1, 4, -2, -3, -3, 5]), (439, 16, [1, 0, -1, 4, 0, -3, -1, 1, 0]), (438, 81, [1, 0, 0, 4, 1, 0, 1, -4, 1]), (438, 60, [1, 0, 0, 4, 0, 1, 0, 1, -4]), (439, 28, [1, 0, 0, 4, 1, 0, 1, -3, 1]), (866, 68, [1, 0, -1, -1, -1, 1, -4, 0, 3]), (866, 69, [1, 0, -1, 0, 3, -2, -4, 1, 3]), (866, 70, [1, 0, -1, 0, -1, 1, -4, 0, 3]), (866, 71, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (841, 12, [1, 0, 0, 3, -2, 3, 1, 3, -4]), (439, 29, [1, 0, 0, 4, 0, 1, -1, 1, -3]), (438, 82, [1, 0, 0, 4, 1, 0, -1, -4, 1]), (439, 15, [1, 0, 0, 4, 0, 1, 1, 1, -3]), (866, 72, [1, 0, 0, 1, -1, 3, 4, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N697.TT) N697.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N697.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #697. -/
theorem lines (t5 : List T5Rec) (h438 : ∀ p ∈ LinRQSC438.blobs, LinesCl t5 (t4OfRec p.1)) (h439 : ∀ p ∈ LinRQSC439.blobs, LinesCl t5 (t4OfRec p.1)) (h841 : ∀ p ∈ LinRQSC841.blobs, LinesCl t5 (t4OfRec p.1)) (h866 : ∀ p ∈ LinRQSC866.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N697.nT).map (t4At (LRSpectrumFull.L5S4.dg N697.TT) N697.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h438 p hp
  · exact h439 p hp
  · exact h841 p hp
  · exact h866 p hp
)

#print axioms lines

end R697
end L5Reg
end LRSpectrumFull

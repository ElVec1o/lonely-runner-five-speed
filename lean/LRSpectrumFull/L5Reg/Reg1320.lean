/-- the lines clause for every class of the local table of rep #1320. -/
theorem lines (t5 : List T5Rec) (h936 : ∀ p ∈ LinRQSC936.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1)) (h991 : ∀ p ∈ LinRQSC991.blobs, LinesCl t5 (t4OfRec p.1)) (h1003 : ∀ p ∈ LinRQSC1003.blobs, LinesCl t5 (t4OfRec p.1)) (h1005 : ∀ p ∈ LinRQSC1005.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1320.nT).map (t4At (LRSpectrumFull.L5S4.dg N1320.TT) N1320.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h936 p hp
  · exact h959 p hp
  · exact h991 p hp
  · exact h1003 p hp
  · exact h1005 p hp
)


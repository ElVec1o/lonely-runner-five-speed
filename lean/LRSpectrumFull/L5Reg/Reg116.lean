/-
# L5Reg.Reg116 : the lines clause for every class of the local table of rep #116 (generated by l5reg)

Every local class `i < nT` of rep #116 (29 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O116T
import LRSpectrumFull.L5S4.LinRQSC36
import LRSpectrumFull.L5S4.LinRQSC113

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R116
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(36, LinRQSC36.blobs), (113, LinRQSC113.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(113, 38, [2, -1, -1, 0, 1, 0, -1, 0, 1]), (113, 39, [1, 0, 0, 0, 0, 1, -1, 1, 0]), (113, 40, [2, -1, -1, 0, -1, 2, -1, 0, 1]), (113, 41, [1, 0, 0, 0, -2, 3, 0, -1, 1]), (113, 42, [2, -1, 0, 0, -1, -1, -1, 0, -1]), (113, 43, [2, -1, 0, 0, -1, -1, -1, 0, -1]), (113, 44, [2, -1, -1, 0, 0, 1, -1, 1, 0]), (113, 45, [2, 0, -1, 0, 1, 0, -1, 0, 1]), (113, 46, [1, 0, 0, 0, 4, -3, -1, 1, -1]), (113, 47, [2, 0, -1, 0, -1, 1, -1, 0, 0]), (113, 48, [0, -1, 0, -4, 0, 3, 3, 0, -2]), (113, 49, [2, -1, 0, 0, 1, -1, -1, 0, 0]), (113, 50, [1, 0, 0, 0, 2, -1, 0, -1, 0]), (113, 51, [0, 2, -1, 1, 0, 0, -4, -1, 0]), (113, 52, [0, 1, 0, 1, 0, 0, -4, 0, 1]), (113, 53, [1, 0, 0, 0, 2, -1, -1, -1, 0]), (113, 54, [1, 0, 0, 0, 4, -3, -1, 1, -1]), (113, 55, [1, 0, 0, 0, 1, 4, -1, 0, 1]), (113, 56, [1, 0, 0, 0, -1, 2, -1, 0, -1]), (113, 57, [0, 0, -1, -4, 3, 0, 3, -2, 1]), (113, 58, [0, 0, -1, -1, 1, 0, 0, 1, 0]), (113, 59, [2, -1, -1, 0, 2, -1, -1, 1, 0]), (113, 60, [0, -1, 1, -4, 0, 3, -1, 0, 1]), (113, 61, [0, -1, 1, -4, 2, 1, -1, 1, 0]), (113, 62, [2, -1, -1, 0, 2, -1, -1, -1, 1]), (113, 63, [1, 0, 0, 0, 1, 4, -1, -1, -3]), (36, 102, [0, 2, -1, 0, -1, 1, -1, 0, 0]), (113, 64, [0, 0, -1, -1, 0, 0, 0, -1, 1]), (113, 65, [0, 0, -1, -1, 0, 0, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N116.TT) N116.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N116.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #116. -/
theorem lines (t5 : List T5Rec) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1)) (h113 : ∀ p ∈ LinRQSC113.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N116.nT).map (t4At (LRSpectrumFull.L5S4.dg N116.TT) N116.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h36 p hp
  · exact h113 p hp
)

#print axioms lines

end R116
end L5Reg
end LRSpectrumFull

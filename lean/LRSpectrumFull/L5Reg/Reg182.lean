/-
# L5Reg.Reg182 : the lines clause for every class of the local table of rep #182 (generated by l5reg)

Every local class `i < nT` of rep #182 (16 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O182T
import LRSpectrumFull.L5S4.LinRQSC37
import LRSpectrumFull.L5S4.LinRQSC84
import LRSpectrumFull.L5S4.LinRQSC194

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R182
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(37, LinRQSC37.blobs), (84, LinRQSC84.blobs), (194, LinRQSC194.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(194, 29, [2, -1, 0, -1, 0, 2, -1, 1, -3]), (84, 21, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (194, 30, [2, 0, -1, -1, -1, 2, 0, 1, -2]), (194, 31, [2, 0, -1, -1, -1, 1, 0, -1, 1]), (194, 32, [2, 0, -1, -1, -2, 1, 1, 1, -1]), (194, 33, [2, 0, -1, -1, -2, 0, -1, 3, 1]), (37, 136, [2, 0, -1, -1, 1, 0, 1, 2, -1]), (84, 17, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (84, 18, [2, -1, -1, -2, 1, 2, 1, -1, -1]), (194, 34, [0, 2, -1, 2, -1, 0, 3, 1, -1]), (194, 35, [2, 0, -1, -1, 3, 0, -1, -4, 1]), (37, 127, [2, 0, -1, -1, -4, 1, 1, -3, 0]), (194, 36, [2, 0, -1, -1, -1, 1, 1, 0, 0]), (194, 37, [2, 0, -1, -1, -3, 0, -1, 4, 1]), (194, 38, [2, 0, -1, -1, 2, 0, 1, 1, -1]), (194, 39, [0, -2, 1, 2, 1, -1, 3, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N182.TT) N182.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N182.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #182. -/
theorem lines (t5 : List T5Rec) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1)) (h84 : ∀ p ∈ LinRQSC84.blobs, LinesCl t5 (t4OfRec p.1)) (h194 : ∀ p ∈ LinRQSC194.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N182.nT).map (t4At (LRSpectrumFull.L5S4.dg N182.TT) N182.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h37 p hp
  · exact h84 p hp
  · exact h194 p hp
)

#print axioms lines

end R182
end L5Reg
end LRSpectrumFull

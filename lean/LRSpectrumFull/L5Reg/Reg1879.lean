/-
# L5Reg.Reg1879 : the lines clause for every class of the local table of rep #1879 (generated by l5reg)

Every local class `i < nT` of rep #1879 (32 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1879T
import LRSpectrumFull.L5S4.LinRQSC883
import LRSpectrumFull.L5S4.LinRQSC1047
import LRSpectrumFull.L5S4.LinRQSC1048
import LRSpectrumFull.L5S4.LinRQSC1050

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1879
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(883, LinRQSC883.blobs), (1047, LinRQSC1047.blobs), (1048, LinRQSC1048.blobs), (1050, LinRQSC1050.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1048, 147, [1, -2, 0, -2, -1, 1, -3, 0, 1]), (1050, 14, [2, -1, 0, 1, 0, 0, 3, -1, -1]), (1048, 140, [1, 2, -1, -2, 1, 0, -2, -1, 1]), (1048, 131, [1, 2, -2, -2, 1, 0, -3, 0, 1]), (1048, 130, [1, 0, -1, -2, 1, 1, -3, 1, 1]), (1048, 121, [1, 2, -2, -1, 1, 0, 3, -1, -1]), (1048, 119, [1, -1, 0, -1, 2, -1, 3, 2, -4]), (1048, 120, [1, -1, 0, -1, 2, -1, 3, 1, -3]), (883, 118, [3, 1, -3, 1, -1, 0, 1, -2, 1]), (1050, 15, [1, 0, -1, 1, -1, 2, 3, -1, 1]), (1048, 139, [1, -2, 0, -2, -1, 2, -2, 1, 1]), (1048, 141, [1, -2, 1, -2, -1, 2, -2, 0, 1]), (1048, 142, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1048, 118, [1, 1, -1, -1, -2, 1, -3, 1, 2]), (1050, 16, [1, -2, 2, 1, -1, 1, 2, 2, -1]), (1048, 132, [1, -1, 0, -2, 1, 0, -1, -3, 1]), (1048, 133, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1048, 134, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1050, 17, [2, -1, 0, 1, -1, 0, -2, -2, 1]), (1048, 143, [1, -1, 0, -2, 1, 0, -3, -1, 1]), (1048, 145, [1, 1, 0, -2, -1, 0, -2, 1, 1]), (1050, 18, [2, 0, 1, 1, 0, 1, -2, 1, 1]), (1048, 126, [2, -1, 0, 1, 2, -1, -1, 0, 0]), (1048, 127, [2, -1, -1, 1, 0, 0, -3, 1, 0]), (1050, 19, [1, 2, -2, -2, 1, 0, 1, 1, -1]), (1048, 136, [1, 1, 0, -2, -1, 0, -1, 2, 1]), (1047, 276, [2, -1, -1, -1, -1, 0, -2, -1, 0]), (1048, 137, [2, -1, -1, 1, 1, 0, -2, 0, 1]), (1048, 146, [1, 0, 0, -2, 0, 1, -2, 1, 0]), (1048, 129, [2, -1, 0, 1, 1, -1, -3, -1, 2]), (1050, 20, [1, 0, 0, -2, 0, 1, 1, -1, 0]), (1050, 21, [1, 0, 0, -2, 1, 0, 3, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1879.TT) N1879.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1879.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1879. -/
theorem lines (t5 : List T5Rec) (h883 : ∀ p ∈ LinRQSC883.blobs, LinesCl t5 (t4OfRec p.1)) (h1047 : ∀ p ∈ LinRQSC1047.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1)) (h1050 : ∀ p ∈ LinRQSC1050.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1879.nT).map (t4At (LRSpectrumFull.L5S4.dg N1879.TT) N1879.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h883 p hp
  · exact h1047 p hp
  · exact h1048 p hp
  · exact h1050 p hp
)

#print axioms lines

end R1879
end L5Reg
end LRSpectrumFull

namespace P67_3
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(46, LinRQSC46.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(46, 50, [0, 0, 1, 0, 1, 0, 1, 0, 0]), (46, 51, [0, 0, 1, 0, -1, 0, 1, 0, 0]), (46, 52, [0, 1, 0, 0, 0, -1, 1, 0, 1]), (46, 53, [0, 0, 1, 0, -1, 0, 1, 0, 0]), (46, 54, [0, 0, 1, 0, 1, 0, 1, -1, 0]), (46, 55, [0, 0, 1, 0, -1, 0, 1, 0, 0]), (46, 56, [0, 1, -1, 0, 0, -1, 1, 0, 0]), (46, 57, [0, 1, -1, 0, 0, -1, 1, 0, 0]), (46, 58, [0, 1, -1, 0, 0, -1, 1, 0, 0]), (46, 59, [0, 1, -1, 0, 0, -1, 1, -1, 0]), (46, 60, [0, 1, 0, 0, 0, -1, 1, 0, 0]), (46, 61, [0, 0, 1, 0, 1, 0, 1, 0, 0]), (46, 62, [0, 0, 1, 0, 1, 0, 1, -1, 0]), (46, 63, [0, 1, 0, 0, 0, -1, 1, -1, -1]), (46, 64, [0, 1, -1, 0, 0, -1, 1, 0, 0]), (46, 65, [0, 1, -1, 0, 0, -1, 1, 0, 0]), (46, 66, [0, 1, 0, 0, 0, 1, 1, 0, -1]), (46, 67, [0, 1, -1, 0, 0, -1, 1, -1, 0]), (46, 68, [0, 1, -1, 0, 0, -1, 1, 0, 0]), (46, 69, [0, 1, -1, 0, 0, -1, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N67.TT) N67.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 20 := by decide +kernel

/-- the lines clause for local classes 300..319 of rep #67. -/
theorem lines (t5 : List T5Rec) (h46 : ∀ p ∈ LinRQSC46.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 20 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N67.TT) N67.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h46 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P67_3
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1228 : the lines clause for every class of the local table of rep #1228 (generated by l5reg)

Every local class `i < nT` of rep #1228 (35 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1228T
import LRSpectrumFull.L5S4.LinRQSC958

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1228
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(958, LinRQSC958.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(958, 98, [1, -1, 0, 3, 2, -4, -3, 2, 1]), (958, 99, [1, 2, -2, 3, -1, -1, 1, -2, 1]), (958, 100, [1, 2, -2, 3, -1, 0, 0, -1, 1]), (958, 101, [1, 2, -1, 3, -1, -2, 0, 1, 0]), (958, 102, [1, 0, 0, 3, 1, -1, 0, -2, 1]), (958, 103, [1, 2, -2, 3, -1, 0, -1, -1, 1]), (958, 104, [1, 0, 0, 3, -1, 0, 0, 1, -1]), (958, 105, [1, -1, 0, 0, 2, -1, 3, 0, -2]), (958, 106, [1, 1, -1, -2, 3, 0, 3, 0, -2]), (958, 107, [1, 1, -1, -2, 3, -2, 2, 3, -3]), (958, 108, [1, -1, 0, 0, -1, 0, 3, -2, -1]), (958, 109, [1, 2, -1, 3, -1, -2, -1, -1, 1]), (958, 110, [1, -1, 0, -2, -3, 1, 4, 0, -1]), (958, 111, [1, -2, 0, -2, 1, 1, 2, 3, -2]), (958, 112, [1, 1, -1, 3, -2, 1, 3, 2, -2]), (958, 113, [2, -1, -1, -1, -3, 3, -1, 0, 1]), (958, 114, [2, -1, -1, -1, 0, 1, -2, -3, 4]), (958, 115, [1, -1, 0, -2, -3, 1, 4, 0, -1]), (958, 116, [2, 0, -1, -1, -1, 1, -3, 0, 1]), (958, 117, [1, -1, 0, 3, -2, 0, 0, -1, 1]), (958, 118, [1, 1, -1, 0, 3, -1, 3, -2, -1]), (958, 119, [2, -1, 0, -1, 1, 1, -1, 0, 0]), (958, 120, [1, 1, -1, 0, 3, -1, 3, -2, -1]), (958, 121, [2, 0, -1, -1, 1, 1, -2, -1, 1]), (958, 122, [1, 2, -1, 3, -1, -2, -1, -1, 1]), (958, 123, [1, -2, 0, -2, 1, 1, 3, 2, -3]), (958, 124, [2, -1, 0, -1, -3, 1, -1, 0, 0]), (958, 125, [2, -1, 0, -1, 0, 0, -2, -3, 1]), (958, 126, [1, 0, 0, 3, -1, -1, -2, 1, 0]), (958, 127, [2, -1, 0, -1, 2, -1, -2, -3, 3]), (958, 128, [2, 1, -1, -1, 0, 0, -1, 2, -1]), (958, 129, [2, -1, -1, -1, 0, 1, -2, -2, 3]), (958, 130, [2, 1, -2, -1, -2, 2, -2, 3, -1]), (958, 131, [2, -1, -1, -1, 0, 1, -1, -3, 3]), (958, 132, [2, -1, -1, -1, 0, 1, -2, -3, 4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1228.TT) N1228.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1228.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1228. -/
theorem lines (t5 : List T5Rec) (h958 : ∀ p ∈ LinRQSC958.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1228.nT).map (t4At (LRSpectrumFull.L5S4.dg N1228.TT) N1228.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h958 p hp
)

#print axioms lines

end R1228
end L5Reg
end LRSpectrumFull

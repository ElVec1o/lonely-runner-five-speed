/-
# L5Reg.Reg233 : the lines clause for every class of the local table of rep #233 (generated by l5reg)

Every local class `i < nT` of rep #233 (8 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O233T
import LRSpectrumFull.L5S4.LinRQSC199

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R233
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(199, 160, [3, 0, -2, 0, 1, -1, -2, -3, 4]), (199, 179, [3, 0, -2, 2, 3, -3, -2, -1, 2]), (199, 164, [3, 2, -3, 0, -3, 2, -2, 0, 1]), (199, 180, [3, 1, -2, 2, 0, -1, -1, 2, 0]), (199, 181, [3, 2, -3, 2, 0, -1, -2, 3, -1]), (199, 182, [3, 0, -1, 2, 3, -2, 2, 1, -1]), (199, 183, [0, -3, 1, -1, -2, 1, 0, -2, 1]), (199, 184, [3, 0, -2, 0, -1, 1, 2, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N233.TT) N233.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N233.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #233. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N233.nT).map (t4At (LRSpectrumFull.L5S4.dg N233.TT) N233.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h199 p hp
)

#print axioms lines

end R233
end L5Reg
end LRSpectrumFull

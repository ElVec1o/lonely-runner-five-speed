/-
# L5Reg.Reg714 : the lines clause for every class of the local table of rep #714 (generated by l5reg)

Every local class `i < nT` of rep #714 (19 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O714T
import LRSpectrumFull.L5S4.LinRQSC866

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R714
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(866, LinRQSC866.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(866, 98, [1, 0, -1, 2, 1, -2, 2, -1, -1]), (866, 99, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (866, 100, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (866, 101, [1, 0, -1, -1, 3, -1, -4, -2, 5]), (866, 102, [1, -1, 0, -2, 1, 0, 4, 3, -1]), (866, 103, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (866, 104, [1, 0, -1, -2, 1, 1, 4, 0, -3]), (866, 105, [1, 0, -1, -2, -1, 2, 4, 0, -3]), (866, 106, [1, 0, -1, -2, 3, 1, -4, -1, 4]), (866, 107, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (866, 108, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (866, 109, [1, 0, 0, 2, -3, 1, 4, 1, 0]), (866, 110, [1, 0, -1, -1, -1, 2, 4, 0, -3]), (866, 111, [1, 0, -1, -1, 3, 0, 4, 1, -4]), (866, 112, [1, 0, 0, 2, -3, 1, 4, 1, 0]), (866, 113, [1, 0, -1, -1, -3, 2, 4, 1, -4]), (866, 114, [1, 0, -1, -1, 1, 0, 4, 0, -3]), (866, 115, [1, 0, -1, -1, 3, -1, 3, 2, -4]), (866, 116, [1, 0, -1, 2, -3, -1, 4, 1, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N714.TT) N714.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N714.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #714. -/
theorem lines (t5 : List T5Rec) (h866 : ∀ p ∈ LinRQSC866.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N714.nT).map (t4At (LRSpectrumFull.L5S4.dg N714.TT) N714.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h866 p hp
)

#print axioms lines

end R714
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h173 : ∀ p ∈ LinRQSC173.blobs, LinesCl t5 (t4OfRec p.1)) (h174 : ∀ p ∈ LinRQSC174.blobs, LinesCl t5 (t4OfRec p.1)) (h175 : ∀ p ∈ LinRQSC175.blobs, LinesCl t5 (t4OfRec p.1)) (h176 : ∀ p ∈ LinRQSC176.blobs, LinesCl t5 (t4OfRec p.1)) (h177 : ∀ p ∈ LinRQSC177.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N163.nT).map (t4At (LRSpectrumFull.L5S4.dg N163.TT) N163.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N163.nT := List.mem_range.1 hc
  have hn : N163.nT = 381 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 381) := by omega
  rcases hcase with h | h | h | h
  · exact P163_0.lines t5 h173 h174 c h.1 (by omega)
  · exact P163_1.lines t5 h174 h175 c h.1 (by omega)
  · exact P163_2.lines t5 h175 h176 c h.1 (by omega)
  · exact P163_3.lines t5 h176 h177 c h.1 (by omega)

#print axioms lines


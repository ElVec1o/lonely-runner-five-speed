/-
# L5Reg.Reg73 : the lines clause for every class of the local table of rep #73 (generated by l5reg)

Every local class `i < nT` of rep #73 (36 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O73T
import LRSpectrumFull.L5S4.LinRQSC58

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R73
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(58, LinRQSC58.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(58, 56, [2, -1, -1, -1, 1, 0, 1, -1, -1]), (58, 57, [2, 1, -2, -1, 4, 0, -2, 3, 1]), (58, 58, [0, 2, -1, -2, -1, 1, 5, 1, -2]), (58, 59, [2, -1, 0, -1, 1, 0, 0, 0, 1]), (58, 60, [2, 1, -1, -1, 4, -2, 0, 2, -1]), (58, 61, [2, 1, -1, -1, 4, -2, 0, -2, 1]), (58, 62, [0, 2, -1, 1, -1, 0, 4, 1, -2]), (58, 63, [2, -1, -1, -1, 2, 0, -1, 1, 0]), (58, 64, [2, 0, -1, -1, -1, 1, 1, -4, 1]), (58, 65, [2, 0, -1, -1, 0, 0, 0, 1, 2]), (58, 66, [2, 0, -1, -1, 0, 1, 0, 1, 0]), (58, 67, [2, 0, -1, -1, 0, 1, 2, 1, -2]), (58, 68, [2, 0, -1, -1, 0, 1, 0, 1, 0]), (58, 69, [2, 0, -1, -1, 0, 1, -1, 1, 0]), (58, 70, [2, 0, -1, -1, 0, 1, 1, -1, 0]), (58, 71, [2, 1, -2, -1, 4, 0, -2, 3, 1]), (58, 72, [2, 0, -1, -1, -1, 1, -1, 2, 0]), (58, 73, [2, 0, -1, -1, 0, 0, 1, -1, 2]), (58, 74, [2, 0, -1, -1, 1, 0, 1, -4, 1]), (58, 75, [2, -1, 0, -1, 0, 0, 0, 2, -1]), (58, 76, [2, 0, -1, -1, -1, 1, -2, 3, -1]), (58, 77, [2, 0, -1, -1, 0, 1, 1, 1, -1]), (58, 78, [2, 0, -1, -1, 1, 0, 0, -3, 2]), (58, 79, [2, -1, 0, -1, 1, 0, -2, 0, 1]), (58, 80, [2, 0, -1, -1, -1, 1, -2, 1, 1]), (58, 81, [2, 0, -1, -1, 0, 0, 0, -1, 2]), (58, 82, [2, -1, -1, -1, 0, 1, 1, 1, -1]), (58, 83, [2, 0, -1, -1, -1, 1, 0, 3, -1]), (58, 84, [2, -1, 0, -1, 2, -1, 2, -2, 1]), (58, 85, [2, 0, -1, -1, -1, 1, 1, 2, -1]), (58, 86, [2, 0, -1, -1, 0, 0, 1, -1, 1]), (58, 87, [2, 0, -1, -1, 0, 0, -1, -1, 1]), (58, 88, [2, 0, -1, -1, 0, 0, 0, -1, 1]), (58, 89, [2, 0, -1, -1, 0, 1, -1, 1, 0]), (58, 90, [0, 0, -1, 0, -1, 1, 1, 0, 0]), (58, 91, [2, 0, -1, -1, 0, 0, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N73.TT) N73.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N73.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #73. -/
theorem lines (t5 : List T5Rec) (h58 : ∀ p ∈ LinRQSC58.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N73.nT).map (t4At (LRSpectrumFull.L5S4.dg N73.TT) N73.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h58 p hp
)

#print axioms lines

end R73
end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h900 : ∀ p ∈ LinRQSC900.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1)) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1)) (h910 : ∀ p ∈ LinRQSC910.blobs, LinesCl t5 (t4OfRec p.1)) (h916 : ∀ p ∈ LinRQSC916.blobs, LinesCl t5 (t4OfRec p.1)) (h917 : ∀ p ∈ LinRQSC917.blobs, LinesCl t5 (t4OfRec p.1)) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1102.nT).map (t4At (LRSpectrumFull.L5S4.dg N1102.TT) N1102.ST), LinesCl t5 cl :=

/-
# L5Reg.Reg483 : the lines clause for every class of the local table of rep #483 (generated by l5reg)

Every local class `i < nT` of rep #483 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O483T
import LRSpectrumFull.L5S4.LinRQSC732

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R483
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(732, LinRQSC732.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(732, 97, [1, -1, 0, -3, 0, 2, 2, 3, -3]), (732, 98, [1, 0, -1, -3, 3, 2, -2, -4, 3]), (732, 99, [1, 0, -1, -3, -3, 5, -4, 1, 3]), (732, 100, [1, 0, -1, -3, -1, 3, 3, -1, -2]), (732, 101, [1, 0, 0, -3, 3, 1, -4, -2, -1]), (732, 102, [1, 0, -1, -3, -1, 3, 1, -1, 0]), (732, 103, [1, -1, 0, -3, 0, 1, 4, 4, -3]), (732, 104, [1, 0, 0, -3, 3, 1, -1, -5, -2]), (732, 105, [1, -1, 0, 0, 3, -1, -4, -4, 3]), (732, 106, [1, 0, -1, -3, -1, 3, 2, -1, -1]), (732, 107, [1, 0, -1, -3, 1, 2, 4, 1, -4]), (732, 108, [1, -1, 0, 0, 3, -1, -4, -1, 2]), (732, 109, [0, -1, 0, -3, 0, 1, 5, 0, -2]), (732, 110, [1, 0, -1, 0, -1, 1, -4, 0, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N483.TT) N483.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N483.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #483. -/
theorem lines (t5 : List T5Rec) (h732 : ∀ p ∈ LinRQSC732.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N483.nT).map (t4At (LRSpectrumFull.L5S4.dg N483.TT) N483.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h732 p hp
)

#print axioms lines

end R483
end L5Reg
end LRSpectrumFull

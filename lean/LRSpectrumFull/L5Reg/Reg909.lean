/-- the lines clause for every class of the local table of rep #909. -/
theorem lines (t5 : List T5Rec) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1)) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N909.nT).map (t4At (LRSpectrumFull.L5S4.dg N909.TT) N909.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h878 p hp
  · exact h881 p hp
  · exact h884 p hp
)


/-- the lines clause for every class of the local table of rep #80. -/
theorem lines (t5 : List T5Rec) (h31 : ∀ p ∈ LinRQSC31.blobs, LinesCl t5 (t4OfRec p.1)) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1)) (h76 : ∀ p ∈ LinRQSC76.blobs, LinesCl t5 (t4OfRec p.1)) (h77 : ∀ p ∈ LinRQSC77.blobs, LinesCl t5 (t4OfRec p.1)) (h78 : ∀ p ∈ LinRQSC78.blobs, LinesCl t5 (t4OfRec p.1)) (h79 : ∀ p ∈ LinRQSC79.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N80.nT).map (t4At (LRSpectrumFull.L5S4.dg N80.TT) N80.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N80.nT := List.mem_range.1 hc
  have hn : N80.nT = 369 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 369) := by omega
  rcases hcase with h | h | h | h
  · exact P80_0.lines t5 h31 h76 h77 c h.1 (by omega)
  · exact P80_1.lines t5 h77 h78 c h.1 (by omega)
  · exact P80_2.lines t5 h32 h78 h79 c h.1 (by omega)
  · exact P80_3.lines t5 h79 c h.1 (by omega)

#print axioms lines

end R80

/-- the lines clause for every class of the local table of rep #156. -/
theorem lines (t5 : List T5Rec) (h30 : ∀ p ∈ LinRQSC30.blobs, LinesCl t5 (t4OfRec p.1)) (h31 : ∀ p ∈ LinRQSC31.blobs, LinesCl t5 (t4OfRec p.1)) (h160 : ∀ p ∈ LinRQSC160.blobs, LinesCl t5 (t4OfRec p.1)) (h161 : ∀ p ∈ LinRQSC161.blobs, LinesCl t5 (t4OfRec p.1)) (h162 : ∀ p ∈ LinRQSC162.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N156.nT).map (t4At (LRSpectrumFull.L5S4.dg N156.TT) N156.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h30 p hp
  · exact h31 p hp
  · exact h160 p hp
  · exact h161 p hp
  · exact h162 p hp
)


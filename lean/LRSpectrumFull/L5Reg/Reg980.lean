/-
# L5Reg.Reg980 : the lines clause for every class of the local table of rep #980 (generated by l5reg)

Every local class `i < nT` of rep #980 (11 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O980T
import LRSpectrumFull.L5S4.LinRQSC892
import LRSpectrumFull.L5S4.LinRQSC899

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R980
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs), (899, LinRQSC899.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(899, 106, [1, -1, 0, 3, -2, -2, 2, -1, -1]), (899, 107, [1, 0, -1, 3, 1, -3, -2, 3, 1]), (899, 108, [2, -1, 0, -2, -3, 3, 3, 1, -2]), (899, 109, [1, 0, -1, 2, 1, -2, -1, 1, 0]), (899, 110, [2, -1, 0, -2, -3, 3, -3, -1, 2]), (892, 37, [1, -1, 0, -1, 0, 0, -1, -1, -1]), (899, 111, [1, -1, 0, 3, -2, -2, -2, 1, 1]), (899, 112, [1, 0, -1, 3, 0, -2, -2, -1, 2]), (899, 113, [1, -2, 0, 3, 2, -3, -2, 1, 1]), (899, 114, [1, -2, 1, 3, 2, -2, 2, 1, -1]), (899, 115, [1, -1, 0, 3, -1, -1, -2, 1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N980.TT) N980.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N980.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #980. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1)) (h899 : ∀ p ∈ LinRQSC899.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N980.nT).map (t4At (LRSpectrumFull.L5S4.dg N980.TT) N980.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h892 p hp
  · exact h899 p hp
)

#print axioms lines

end R980
end L5Reg
end LRSpectrumFull

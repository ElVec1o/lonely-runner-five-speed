theorem lines (t5 : List T5Rec) (h752 : ∀ p ∈ LinRQSC752.blobs, LinesCl t5 (t4OfRec p.1)) (h753 : ∀ p ∈ LinRQSC753.blobs, LinesCl t5 (t4OfRec p.1))

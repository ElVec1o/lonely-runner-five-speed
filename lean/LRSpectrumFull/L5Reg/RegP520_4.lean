/-- the lines clause for local classes 400..499 of rep #520. -/
theorem lines (t5 : List T5Rec) (h487 : ∀ p ∈ LinRQSC487.blobs, LinesCl t5 (t4OfRec p.1)) (h713 : ∀ p ∈ LinRQSC713.blobs, LinesCl t5 (t4OfRec p.1)) (h770 : ∀ p ∈ LinRQSC770.blobs, LinesCl t5 (t4OfRec p.1)) (h771 : ∀ p ∈ LinRQSC771.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N520.TT) N520.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h487 p hpe
    · exact h713 p hpe
    · exact h770 p hpe
    · exact h771 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2


/-- the lines clause for every class of the local table of rep #86. -/
theorem lines (t5 : List T5Rec) (h47 : ∀ p ∈ LinRQSC47.blobs, LinesCl t5 (t4OfRec p.1)) (h86 : ∀ p ∈ LinRQSC86.blobs, LinesCl t5 (t4OfRec p.1)) (h87 : ∀ p ∈ LinRQSC87.blobs, LinesCl t5 (t4OfRec p.1)) (h88 : ∀ p ∈ LinRQSC88.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N86.nT).map (t4At (LRSpectrumFull.L5S4.dg N86.TT) N86.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h47 p hp
  · exact h86 p hp
  · exact h87 p hp
  · exact h88 p hp
)


/-
# L5Reg.Reg1019 : the lines clause for every class of the local table of rep #1019 (generated by l5reg)

Every local class `i < nT` of rep #1019 (42 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1019T
import LRSpectrumFull.L5S4.LinRQSC894
import LRSpectrumFull.L5S4.LinRQSC906

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1019
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(894, LinRQSC894.blobs), (906, LinRQSC906.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(906, 97, [0, 0, -1, 3, -2, -1, -1, 1, -1]), (906, 98, [0, 0, -1, 3, -1, -1, 1, 0, -2]), (906, 99, [0, -2, 1, 1, 1, -1, 0, 3, -2]), (906, 100, [0, 0, -1, 1, 0, 0, 0, 1, 0]), (894, 68, [0, 0, -1, 0, -1, 2, 1, 0, 0]), (906, 101, [2, 0, -1, -1, -3, 1, 3, -2, -1]), (906, 102, [0, 0, -1, 3, -1, -1, 1, 0, -1]), (906, 103, [0, 0, -1, 3, -2, -1, 2, -1, -2]), (906, 104, [0, -2, 1, 3, 1, -3, 2, -3, 0]), (906, 105, [0, -1, 0, 3, -1, -2, 2, -2, -1]), (906, 106, [2, -1, 0, -1, -1, 1, 3, -1, 0]), (906, 107, [0, -2, 1, 3, 1, -3, 2, -1, -1]), (906, 108, [0, -2, 1, 3, 1, -3, -1, -2, 2]), (906, 109, [0, 2, -1, 3, -1, 0, 1, 2, -1]), (906, 110, [2, 0, -1, -1, 3, -2, 2, 1, -2]), (906, 111, [0, 1, 0, 3, -2, -2, -1, 2, 1]), (906, 112, [2, -1, -1, -1, 2, 0, 3, -1, -2]), (906, 113, [0, -2, -1, 1, 1, 0, 0, -1, 0]), (906, 114, [0, 2, -1, 3, -1, 0, 1, 2, -1]), (906, 115, [2, 0, -1, -1, 1, 0, 3, 0, -2]), (906, 116, [0, 1, 0, 3, -2, -2, 2, 0, -1]), (906, 117, [0, 1, 0, 3, -2, -1, 1, 1, 0]), (906, 118, [0, 2, -1, 3, -1, -2, 2, 3, -3]), (906, 119, [0, 2, -1, 3, -1, -2, -1, 2, 0]), (906, 120, [0, 2, -1, 3, -1, -2, -1, 2, 0]), (906, 121, [0, -1, 0, 3, -1, 1, -1, 0, 0]), (906, 122, [0, 2, -1, 3, -1, -2, -1, 2, 0]), (906, 123, [0, 2, -1, 3, -1, 0, 1, 2, -1]), (906, 124, [0, 2, -1, 3, -1, -2, 1, 2, -2]), (906, 125, [0, 1, 0, 3, -2, -1, 2, 0, -1]), (906, 126, [0, 2, -1, 3, -1, 0, 2, 1, -1]), (906, 127, [0, 1, 0, 3, -2, -2, 2, 0, -1]), (906, 128, [0, -2, 1, 3, 1, -1, 2, -1, 0]), (906, 129, [0, 2, -1, 3, -1, -2, 1, 2, -2]), (906, 130, [0, 1, 0, 1, 0, -1, 0, -3, 1]), (906, 131, [0, 2, -1, 3, -1, 0, 2, 3, -2]), (906, 132, [0, 1, 0, 3, 0, -2, 2, -2, -1]), (906, 133, [0, 2, -1, 1, -1, 0, 0, 1, -1]), (906, 134, [0, 1, 0, 1, 0, -1, 0, -3, 1]), (906, 135, [0, -1, 1, 3, -1, 0, -1, 0, 0]), (906, 136, [0, 1, 0, 3, 0, -1, 1, -3, 0]), (906, 137, [0, -1, 1, 3, -1, -1, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1019.TT) N1019.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1019.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1019. -/
theorem lines (t5 : List T5Rec) (h894 : ∀ p ∈ LinRQSC894.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1019.nT).map (t4At (LRSpectrumFull.L5S4.dg N1019.TT) N1019.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h894 p hp
  · exact h906 p hp
)

#print axioms lines

end R1019
end L5Reg
end LRSpectrumFull

/-
# L5Reg.RegFin30 : the lines clause for the local class tables of 4 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg1162
import LRSpectrumFull.L5Reg.Reg1137
import LRSpectrumFull.L5Reg.Reg1296
import LRSpectrumFull.L5Reg.Reg1246

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines1162 : ∀ cl ∈ (List.range N1162.nT).map (t4At (LRSpectrumFull.L5S4.dg N1162.TT) N1162.ST), LinesCl T5Store.t5 cl :=
  R1162.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem933 p hp))

theorem lines1137 : ∀ cl ∈ (List.range N1137.nT).map (t4At (LRSpectrumFull.L5S4.dg N1137.TT) N1137.ST), LinesCl T5Store.t5 cl :=
  R1137.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem924 p hp))

theorem lines1296 : ∀ cl ∈ (List.range N1296.nT).map (t4At (LRSpectrumFull.L5S4.dg N1296.TT) N1296.ST), LinesCl T5Store.t5 cl :=
  R1296.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem936 p hp)) (fun p hp => FinalGlue.glines p (mem1003 p hp)) (fun p hp => FinalGlue.glines p (mem1004 p hp))

theorem lines1246 : ∀ cl ∈ (List.range N1246.nT).map (t4At (LRSpectrumFull.L5S4.dg N1246.TT) N1246.ST), LinesCl T5Store.t5 cl :=
  R1246.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem962 p hp)) (fun p hp => FinalGlue.glines p (mem963 p hp))


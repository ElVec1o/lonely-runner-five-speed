/-- the lines clause for every class of the local table of rep #159. -/
theorem lines (t5 : List T5Rec) (h118 : ∀ p ∈ LinRQSC118.blobs, LinesCl t5 (t4OfRec p.1)) (h119 : ∀ p ∈ LinRQSC119.blobs, LinesCl t5 (t4OfRec p.1)) (h163 : ∀ p ∈ LinRQSC163.blobs, LinesCl t5 (t4OfRec p.1)) (h164 : ∀ p ∈ LinRQSC164.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N159.nT).map (t4At (LRSpectrumFull.L5S4.dg N159.TT) N159.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h118 p hp
  · exact h119 p hp
  · exact h163 p hp
  · exact h164 p hp
)


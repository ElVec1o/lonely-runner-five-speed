/-- the lines clause for every class of the local table of rep #627. -/
theorem lines (t5 : List T5Rec) (h444 : ∀ p ∈ LinRQSC444.blobs, LinesCl t5 (t4OfRec p.1)) (h705 : ∀ p ∈ LinRQSC705.blobs, LinesCl t5 (t4OfRec p.1)) (h727 : ∀ p ∈ LinRQSC727.blobs, LinesCl t5 (t4OfRec p.1)) (h728 : ∀ p ∈ LinRQSC728.blobs, LinesCl t5 (t4OfRec p.1)) (h758 : ∀ p ∈ LinRQSC758.blobs, LinesCl t5 (t4OfRec p.1)) (h841 : ∀ p ∈ LinRQSC841.blobs, LinesCl t5 (t4OfRec p.1)) (h842 : ∀ p ∈ LinRQSC842.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N627.nT).map (t4At (LRSpectrumFull.L5S4.dg N627.TT) N627.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h444 p hp
  · exact h705 p hp
  · exact h727 p hp
  · exact h728 p hp
  · exact h758 p hp
  · exact h841 p hp
  · exact h842 p hp
)


/-- the lines clause for every class of the local table of rep #152. -/
theorem lines (t5 : List T5Rec) (h33 : ∀ p ∈ LinRQSC33.blobs, LinesCl t5 (t4OfRec p.1)) (h62 : ∀ p ∈ LinRQSC62.blobs, LinesCl t5 (t4OfRec p.1)) (h63 : ∀ p ∈ LinRQSC63.blobs, LinesCl t5 (t4OfRec p.1)) (h64 : ∀ p ∈ LinRQSC64.blobs, LinesCl t5 (t4OfRec p.1)) (h147 : ∀ p ∈ LinRQSC147.blobs, LinesCl t5 (t4OfRec p.1)) (h148 : ∀ p ∈ LinRQSC148.blobs, LinesCl t5 (t4OfRec p.1)) (h149 : ∀ p ∈ LinRQSC149.blobs, LinesCl t5 (t4OfRec p.1)) (h150 : ∀ p ∈ LinRQSC150.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N152.nT).map (t4At (LRSpectrumFull.L5S4.dg N152.TT) N152.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N152.nT := List.mem_range.1 hc
  have hn : N152.nT = 324 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 324) := by omega
  rcases hcase with h | h | h | h
  · exact P152_0.lines t5 h63 h64 h147 h148 c h.1 (by omega)
  · exact P152_1.lines t5 h63 h148 h149 c h.1 (by omega)
  · exact P152_2.lines t5 h33 h62 h149 h150 c h.1 (by omega)
  · exact P152_3.lines t5 h150 c h.1 (by omega)

#print axioms lines


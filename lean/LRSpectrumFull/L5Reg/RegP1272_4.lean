namespace P1272_4
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(987, LinRQSC987.blobs), (988, LinRQSC988.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(987, 117, [0, -2, 1, 1, 0, -1, 3, 1, -3]), (988, 0, [1, -1, 0, -2, 1, 0, 3, -2, 1]), (988, 1, [1, -1, 0, -2, -1, 2, 2, -1, -1]), (988, 2, [1, -1, 0, -2, -1, 1, 3, -1, -1]), (988, 3, [1, -1, 0, -2, 1, 0, 2, 3, -1]), (988, 4, [1, 1, -1, -1, 1, 0, -3, 0, 1]), (988, 5, [1, 0, -1, -2, -1, 2, 3, -1, -2]), (988, 6, [1, 2, -1, -2, 0, 1, 2, -1, -1]), (988, 7, [1, -1, 0, -2, 1, 1, 2, 2, -3]), (988, 8, [1, 0, -1, -2, 1, 1, 2, 2, -3]), (988, 9, [1, 0, -1, -2, -1, 2, 1, -2, 0]), (988, 10, [1, 1, -1, -2, -1, 2, 2, -2, -1]), (988, 11, [1, -1, 0, -2, 1, 1, 2, 2, -3]), (988, 12, [1, 1, -1, -2, -1, 2, 2, -2, -1]), (988, 13, [1, 0, 0, -2, 1, 0, 1, 3, -1]), (988, 14, [1, 0, 0, -2, 1, 0, 2, 3, -1]), (988, 15, [1, 0, -1, -2, -1, 2, 3, -1, -2]), (988, 16, [1, 0, -1, -2, -1, 2, 2, -2, -1]), (988, 17, [1, 0, -1, -2, 1, 1, 2, 2, -3]), (988, 18, [1, -1, 0, -2, 1, 1, 3, 2, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1272.TT) N1272.ST (assoc bls) 400 adv = true := by decide +kernel

theorem adv_len : adv.length = 20 := by decide +kernel

/-- the lines clause for local classes 400..419 of rep #1272. -/
theorem lines (t5 : List T5Rec) (h987 : ∀ p ∈ LinRQSC987.blobs, LinesCl t5 (t4OfRec p.1)) (h988 : ∀ p ∈ LinRQSC988.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 20 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N1272.TT) N1272.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl
    · exact h987 p hpe
    · exact h988 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P1272_4

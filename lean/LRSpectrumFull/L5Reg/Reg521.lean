/-- the lines clause for every class of the local table of rep #521. -/
theorem lines (t5 : List T5Rec) (h772 : ∀ p ∈ LinRQSC772.blobs, LinesCl t5 (t4OfRec p.1)) (h773 : ∀ p ∈ LinRQSC773.blobs, LinesCl t5 (t4OfRec p.1)) (h774 : ∀ p ∈ LinRQSC774.blobs, LinesCl t5 (t4OfRec p.1)) (h775 : ∀ p ∈ LinRQSC775.blobs, LinesCl t5 (t4OfRec p.1)) (h776 : ∀ p ∈ LinRQSC776.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N521.nT).map (t4At (LRSpectrumFull.L5S4.dg N521.TT) N521.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N521.nT := List.mem_range.1 hc
  have hn : N521.nT = 337 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 337) := by omega
  rcases hcase with h | h | h | h
  · exact P521_0.lines t5 h772 h773 c h.1 (by omega)
  · exact P521_1.lines t5 h773 h774 c h.1 (by omega)
  · exact P521_2.lines t5 h774 h775 c h.1 (by omega)
  · exact P521_3.lines t5 h775 h776 c h.1 (by omega)

#print axioms lines


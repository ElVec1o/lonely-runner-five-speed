/-- the lines clause for every class of the local table of rep #1084. -/
theorem lines (t5 : List T5Rec) (h890 : ∀ p ∈ LinRQSC890.blobs, LinesCl t5 (t4OfRec p.1)) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h910 : ∀ p ∈ LinRQSC910.blobs, LinesCl t5 (t4OfRec p.1)) (h913 : ∀ p ∈ LinRQSC913.blobs, LinesCl t5 (t4OfRec p.1)) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1084.nT).map (t4At (LRSpectrumFull.L5S4.dg N1084.TT) N1084.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h890 p hp
  · exact h896 p hp
  · exact h905 p hp
  · exact h910 p hp
  · exact h913 p hp
  · exact h920 p hp
)

#print axioms lines


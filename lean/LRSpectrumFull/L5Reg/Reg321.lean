theorem lines (t5 : List T5Rec) (h683 : ∀ p ∈ LinRQSC683.blobs, LinesCl t5 (t4OfRec p.1)) (h684 : ∀ p ∈ LinRQSC684.blobs, LinesCl t5 (t4OfRec p.1)) (h685 : ∀ p ∈ LinRQSC685.blobs, LinesCl t5 (t4OfRec p.1)) (h686 : ∀ p ∈ LinRQSC686.blobs, LinesCl t5 (t4OfRec p.1)) (h687 : ∀ p ∈ LinRQSC687.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N321.nT).map (t4At (LRSpectrumFull.L5S4.dg N321.TT) N321.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h683 p hp
  · exact h684 p hp
  · exact h685 p hp
  · exact h686 p hp
  · exact h687 p hp
)


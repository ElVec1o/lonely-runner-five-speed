theorem lines (t5 : List T5Rec) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1)) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1)) (h911 : ∀ p ∈ LinRQSC911.blobs, LinesCl t5 (t4OfRec p.1)) (h914 : ∀ p ∈ LinRQSC914.blobs, LinesCl t5 (t4OfRec p.1)) (h915 : ∀ p ∈ LinRQSC915.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.RegFin80 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg648
import LRSpectrumFull.L5Reg.Reg716

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines648 : ∀ cl ∈ (List.range N648.nT).map (t4At (LRSpectrumFull.L5S4.dg N648.TT) N648.ST), LinesCl T5Store.t5 cl :=
  R648.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem680 p hp)) (fun p hp => FinalGlue.glines p (mem722 p hp)) (fun p hp => FinalGlue.glines p (mem840 p hp)) (fun p hp => FinalGlue.glines p (mem853 p hp)) (fun p hp => FinalGlue.glines p (mem854 p hp))

theorem lines716 : ∀ cl ∈ (List.range N716.nT).map (t4At (LRSpectrumFull.L5S4.dg N716.TT) N716.ST), LinesCl T5Store.t5 cl :=
  R716.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem734 p hp)) (fun p hp => FinalGlue.glines p (mem800 p hp)) (fun p hp => FinalGlue.glines p (mem801 p hp)) (fun p hp => FinalGlue.glines p (mem867 p hp))

#print axioms lines648

end L5Reg
end LRSpectrumFull

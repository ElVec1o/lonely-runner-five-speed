/-
# L5Reg.Reg339 : the lines clause for every class of the local table of rep #339 (generated by l5reg)

Every local class `i < nT` of rep #339 (7 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O339T
import LRSpectrumFull.L5S4.LinRQSC434
import LRSpectrumFull.L5S4.LinRQSC703

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R339
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(434, LinRQSC434.blobs), (703, LinRQSC703.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(703, 43, [1, -1, 0, -1, 2, 0, -4, -4, 1]), (434, 60, [1, -1, 0, 4, 2, -1, -1, 2, 0]), (703, 44, [1, -1, 0, -1, 2, 0, -4, -4, 1]), (703, 45, [1, -1, 0, -2, 1, 1, 3, 4, -6]), (434, 65, [1, -1, 0, 4, 3, -6, -2, -4, 5]), (703, 46, [1, -1, 0, 4, 1, -2, 0, 2, -1]), (703, 47, [1, -1, 0, -1, 2, 0, 4, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N339.TT) N339.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N339.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #339. -/
theorem lines (t5 : List T5Rec) (h434 : ∀ p ∈ LinRQSC434.blobs, LinesCl t5 (t4OfRec p.1)) (h703 : ∀ p ∈ LinRQSC703.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N339.nT).map (t4At (LRSpectrumFull.L5S4.dg N339.TT) N339.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h434 p hp
  · exact h703 p hp
)

#print axioms lines

end R339
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1278 : the lines clause for every class of the local table of rep #1278 (generated by l5reg)

Every local class `i < nT` of rep #1278 (29 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1278T
import LRSpectrumFull.L5S4.LinRQSC936
import LRSpectrumFull.L5S4.LinRQSC991

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1278
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(936, LinRQSC936.blobs), (991, LinRQSC991.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(991, 171, [2, -1, 0, -1, -1, 1, 0, -2, 1]), (991, 172, [2, 1, -1, -1, 1, 0, 1, -2, 0]), (991, 173, [2, 1, -2, -1, 1, 0, -1, 2, -1]), (991, 174, [1, -1, 0, 3, -1, -1, -3, -2, 2]), (991, 175, [1, -2, 1, 3, 1, -3, -1, 1, 0]), (991, 176, [1, -2, 1, 0, 1, -1, -3, 0, 2]), (991, 177, [1, 0, -1, 3, -1, -2, 0, -1, 0]), (991, 178, [1, -2, 0, 3, 1, -1, 3, 0, -1]), (936, 49, [2, 1, -1, -2, -2, 1, 1, -3, 0]), (991, 179, [2, 1, -1, -1, 3, -2, 1, 0, 0]), (991, 180, [2, -1, 0, -1, 1, -1, -3, 1, 0]), (991, 181, [1, 0, 0, 3, -1, 0, 2, -2, 1]), (991, 182, [1, -1, 0, 3, -2, -1, 2, 0, -1]), (991, 183, [1, 0, -1, 3, -1, -2, 1, 2, -2]), (991, 184, [2, 0, -1, 0, 3, -2, -1, -2, 2]), (991, 185, [2, -1, 0, -1, 1, 0, -2, 2, -1]), (991, 186, [2, 1, -2, -1, 3, -2, 1, 3, -3]), (991, 187, [2, 1, -2, -1, 3, -1, 0, 2, -1]), (991, 188, [2, -1, 0, -1, -3, 2, 0, -2, 1]), (991, 189, [2, -1, 0, -1, 0, 0, 0, 1, -1]), (991, 190, [2, -1, -1, -1, -3, 3, 1, 0, -1]), (991, 191, [2, 1, -1, -1, 1, 0, 2, -3, 0]), (991, 192, [1, -1, 0, 1, 0, -1, -3, 1, 1]), (991, 193, [2, -1, 0, -1, -1, 1, -1, -2, 2]), (991, 194, [1, -1, 0, 1, -3, 1, -3, 0, 1]), (991, 195, [2, -1, 0, -1, -3, 1, 1, 0, 0]), (991, 196, [2, -1, -1, -1, -3, 2, 0, -2, 1]), (991, 197, [1, 1, -1, 1, 3, -2, -3, 2, 1]), (991, 198, [1, 2, -2, 1, -1, 0, 3, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1278.TT) N1278.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1278.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1278. -/
theorem lines (t5 : List T5Rec) (h936 : ∀ p ∈ LinRQSC936.blobs, LinesCl t5 (t4OfRec p.1)) (h991 : ∀ p ∈ LinRQSC991.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1278.nT).map (t4At (LRSpectrumFull.L5S4.dg N1278.TT) N1278.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h936 p hp
  · exact h991 p hp
)

#print axioms lines

end R1278
end L5Reg
end LRSpectrumFull

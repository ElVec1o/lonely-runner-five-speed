/-
# L5Reg.Reg1871 : the lines clause for every class of the local table of rep #1871 (generated by l5reg)

Every local class `i < nT` of rep #1871 (17 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1871T
import LRSpectrumFull.L5S4.LinRQSC1049

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1871
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1049, LinRQSC1049.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1049, 165, [1, 2, -1, 0, -1, 0, 3, -1, -2]), (1049, 166, [1, -2, 0, 3, 1, -3, 2, 1, -2]), (1049, 167, [1, 0, -2, 0, 0, 1, -3, 1, 0]), (1049, 168, [1, -2, 0, 0, 1, 0, -3, -2, 1]), (1049, 169, [1, 2, -1, 0, 2, -1, -3, 1, 0]), (1049, 170, [1, -2, 0, 0, -2, 1, 3, 1, -3]), (1049, 171, [2, -1, -1, -1, 0, 1, 2, 2, -3]), (1049, 172, [2, 1, -1, -1, 0, 0, 3, -1, 2]), (1049, 173, [2, -1, 0, -1, 0, 0, 2, 2, -1]), (1049, 174, [2, -1, 0, -1, 0, 0, 2, 2, -1]), (1049, 175, [1, -2, 1, 3, 1, -1, 3, -1, 0]), (1049, 176, [2, -1, -1, -1, -3, 1, 2, -2, -1]), (1049, 177, [2, 1, -1, -1, 0, 0, 3, -1, 0]), (1049, 178, [1, -1, 0, 3, -2, 0, 3, -1, -1]), (1049, 179, [1, 2, -2, 3, -1, -1, 3, 2, -3]), (1049, 180, [2, 1, -2, -1, 3, 0, 3, 1, -3]), (1049, 181, [2, -1, 0, -1, 0, 0, 4, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1871.TT) N1871.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1871.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1871. -/
theorem lines (t5 : List T5Rec) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1871.nT).map (t4At (LRSpectrumFull.L5S4.dg N1871.TT) N1871.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1049 p hp
)

#print axioms lines

end R1871
end L5Reg
end LRSpectrumFull

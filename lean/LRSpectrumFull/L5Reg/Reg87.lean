theorem lines (t5 : List T5Rec) (h35 : ∀ p ∈ LinRQSC35.blobs, LinesCl t5 (t4OfRec p.1)) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1)) (h88 : ∀ p ∈ LinRQSC88.blobs, LinesCl t5 (t4OfRec p.1)) (h89 : ∀ p ∈ LinRQSC89.blobs, LinesCl t5 (t4OfRec p.1)) (h90 : ∀ p ∈ LinRQSC90.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N87.nT).map (t4At (LRSpectrumFull.L5S4.dg N87.TT) N87.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h35 p hp
  · exact h36 p hp
  · exact h88 p hp
  · exact h89 p hp
  · exact h90 p hp
)


theorem adv_len : adv.length = N127.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #127. -/
theorem lines (t5 : List T5Rec) (h41 : ∀ p ∈ LinRQSC41.blobs, LinesCl t5 (t4OfRec p.1)) (h113 : ∀ p ∈ LinRQSC113.blobs, LinesCl t5 (t4OfRec p.1)) (h115 : ∀ p ∈ LinRQSC115.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N127.nT).map (t4At (LRSpectrumFull.L5S4.dg N127.TT) N127.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h41 p hp
  · exact h113 p hp
  · exact h115 p hp
)

#print axioms lines


/-- the lines clause for local classes 300..355 of rep #76. -/
theorem lines (t5 : List T5Rec) (h34 : ∀ p ∈ LinRQSC34.blobs, LinesCl t5 (t4OfRec p.1)) (h64 : ∀ p ∈ LinRQSC64.blobs, LinesCl t5 (t4OfRec p.1))

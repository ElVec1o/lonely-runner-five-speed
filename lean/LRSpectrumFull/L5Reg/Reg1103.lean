/-
# L5Reg.Reg1103 : the lines clause for every class of the local table of rep #1103 (generated by l5reg)

Every local class `i < nT` of rep #1103 (29 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1103T
import LRSpectrumFull.L5S4.LinRQSC896
import LRSpectrumFull.L5S4.LinRQSC905
import LRSpectrumFull.L5S4.LinRQSC910
import LRSpectrumFull.L5S4.LinRQSC920

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1103
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(896, LinRQSC896.blobs), (905, LinRQSC905.blobs), (910, LinRQSC910.blobs), (920, LinRQSC920.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(920, 196, [1, 0, -1, 0, -2, 1, -3, -1, 3]), (920, 23, [1, 0, -1, 0, 2, -1, 3, 1, -3]), (920, 197, [2, 0, -1, -1, -1, 1, 3, 0, -1]), (920, 198, [2, 0, -1, -1, -2, 1, 2, -1, -1]), (920, 199, [2, 0, -1, -1, -2, 2, 3, -1, -1]), (920, 200, [2, 0, -1, -1, 2, 0, 2, 1, -1]), (920, 201, [2, -1, -1, -1, 1, 0, 2, -1, 0]), (920, 202, [2, 0, -1, -1, 2, -1, 3, 1, -2]), (920, 203, [2, 0, -1, -1, 1, 0, 3, 0, -1]), (920, 204, [2, 0, -1, -1, 2, -1, 3, 1, -2]), (920, 205, [2, 2, -3, 1, -1, 0, 3, -2, -1]), (920, 206, [2, -1, -1, -1, 0, 1, -2, 0, 1]), (920, 207, [2, -1, -1, 1, 0, -1, 2, 1, -2]), (910, 189, [2, -2, 1, -1, -2, 2, -1, -1, 1]), (920, 208, [2, 0, -1, 1, -1, 1, 2, 1, -2]), (920, 209, [2, -1, -1, 1, -1, 0, 1, 0, 0]), (896, 76, [2, -1, -1, -2, 1, 0, 1, 0, 0]), (920, 210, [1, 0, -1, 0, -1, 0, -3, 0, 2]), (920, 211, [1, 0, -1, 0, -2, 1, -3, -1, 3]), (920, 212, [1, -2, 0, 0, -1, 0, -3, -1, 1]), (920, 213, [2, -1, -1, 1, 0, -1, 3, 1, -3]), (920, 214, [2, 1, -1, 1, 0, -1, 2, -1, -2]), (920, 215, [2, 0, -1, 1, -2, 0, 2, 1, -1]), (920, 216, [1, 2, -2, 0, -1, 1, -2, 2, -1]), (920, 217, [0, -1, 1, -1, 1, 0, 1, 0, 0]), (920, 218, [0, -1, 0, -2, 0, 1, 3, 0, -1]), (920, 219, [0, 2, -1, -2, -1, 2, 3, 0, -2]), (905, 144, [0, 2, -1, 3, 1, -1, 2, -1, 0]), (920, 220, [0, -1, 0, -2, 0, 1, 3, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1103.TT) N1103.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1103.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1103. -/
theorem lines (t5 : List T5Rec) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h910 : ∀ p ∈ LinRQSC910.blobs, LinesCl t5 (t4OfRec p.1)) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1103.nT).map (t4At (LRSpectrumFull.L5S4.dg N1103.TT) N1103.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h896 p hp
  · exact h905 p hp
  · exact h910 p hp
  · exact h920 p hp
)

#print axioms lines

end R1103
end L5Reg
end LRSpectrumFull

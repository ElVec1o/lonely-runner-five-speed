/-- the lines clause for every class of the local table of rep #1208. -/
theorem lines (t5 : List T5Rec) (h931 : ∀ p ∈ LinRQSC931.blobs, LinesCl t5 (t4OfRec p.1)) (h933 : ∀ p ∈ LinRQSC933.blobs, LinesCl t5 (t4OfRec p.1)) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1)) (h956 : ∀ p ∈ LinRQSC956.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1208.nT).map (t4At (LRSpectrumFull.L5S4.dg N1208.TT) N1208.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h931 p hp
  · exact h933 p hp
  · exact h955 p hp
  · exact h956 p hp
)


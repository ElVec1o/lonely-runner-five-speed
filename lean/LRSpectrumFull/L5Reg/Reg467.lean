/-
# L5Reg.Reg467 : the lines clause for every class of the local table of rep #467 (generated by l5reg)

Every local class `i < nT` of rep #467 (39 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O467T
import LRSpectrumFull.L5S4.LinRQSC732

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R467
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(732, LinRQSC732.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(732, 46, [1, 0, -1, 0, 1, 0, -4, 0, 3]), (732, 47, [1, 0, -1, 0, 1, 0, -4, 0, 3]), (732, 48, [0, 1, -1, -1, 0, 0, 0, -4, 3]), (732, 49, [1, 0, 0, 0, -4, 1, 4, 1, 0]), (732, 50, [1, 0, 0, 0, 0, -1, 4, -1, 1]), (732, 51, [0, -1, 0, -4, 0, 1, 1, 1, 0]), (732, 52, [0, 1, 0, -4, 0, 1, 1, 0, 0]), (732, 53, [1, 0, 0, 0, 0, -1, 3, -1, 1]), (732, 54, [0, 1, 0, -2, 0, 1, 1, 0, 0]), (732, 55, [1, 0, 0, 0, 0, -1, 3, -1, 1]), (732, 56, [1, 0, -1, 0, -2, 1, 3, 1, -3]), (732, 57, [1, 0, -1, 0, -4, 3, 4, -1, -3]), (732, 58, [0, -1, 0, -4, 0, 3, -1, 1, 1]), (732, 59, [1, 0, 0, 0, 0, -1, 3, -1, 0]), (732, 60, [0, -1, 0, -1, 0, 0, 0, 1, 1]), (732, 61, [0, 1, 0, -1, 0, 0, 0, 0, 1]), (732, 62, [1, 0, 0, 0, 0, -1, 3, -1, 0]), (732, 63, [0, -1, 0, -2, 0, 1, 1, 1, 0]), (732, 64, [0, -1, 0, -2, 0, 1, 1, 0, 0]), (732, 65, [0, 1, 0, -4, 0, 3, -1, 0, 1]), (732, 66, [0, -1, 0, -4, 0, 3, -1, 1, 1]), (732, 67, [0, -1, 0, -4, 0, 3, -1, 0, 1]), (732, 68, [0, -1, -1, -1, 0, 0, 0, 1, 2]), (732, 69, [0, -1, 0, -4, 0, 1, 1, 0, 0]), (732, 70, [0, -1, 0, -2, 0, 1, 1, 0, 0]), (732, 71, [0, -1, 1, -4, 0, 3, -1, 1, 0]), (732, 72, [0, -1, 0, -4, 0, 3, -1, 1, 1]), (732, 73, [0, 1, 0, -4, 0, 3, -1, 0, 1]), (732, 74, [0, -1, -1, -1, 0, 0, 0, 1, 2]), (732, 75, [0, -1, 0, -4, 0, 1, 1, 1, 0]), (732, 76, [0, 1, 0, -4, 0, 1, 1, 0, 0]), (732, 77, [0, -1, 0, -2, 0, 1, 1, 1, -1]), (732, 78, [0, -1, 0, -2, 0, 1, 1, 0, -1]), (732, 79, [0, -1, 0, -4, 0, 1, -1, 0, 0]), (732, 80, [0, -1, 0, -4, 0, 1, -1, 1, 0]), (732, 81, [0, 1, 0, -4, 0, 1, -1, 0, 0]), (732, 82, [0, 0, -1, -4, 1, 0, -1, 0, 0]), (732, 83, [0, 1, 0, -1, 0, 0, 0, 0, -1]), (732, 84, [0, 0, -1, -4, 3, 0, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N467.TT) N467.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N467.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #467. -/
theorem lines (t5 : List T5Rec) (h732 : ∀ p ∈ LinRQSC732.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N467.nT).map (t4At (LRSpectrumFull.L5S4.dg N467.TT) N467.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h732 p hp
)

#print axioms lines


/-
# L5Reg.RegFin52 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg276
import LRSpectrumFull.L5Reg.Reg1676

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines276 : ∀ cl ∈ (List.range N276.nT).map (t4At (LRSpectrumFull.L5S4.dg N276.TT) N276.ST), LinesCl T5Store.t5 cl :=
  R276.lines T5Store.t5 

theorem lines1676 : ∀ cl ∈ (List.range N1676.nT).map (t4At (LRSpectrumFull.L5S4.dg N1676.TT) N1676.ST), LinesCl T5Store.t5 cl :=
  R1676.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem1027 p hp)) (fun p hp => FinalGlue.glines p (mem1028 p hp))

#print axioms lines276

end L5Reg
end LRSpectrumFull

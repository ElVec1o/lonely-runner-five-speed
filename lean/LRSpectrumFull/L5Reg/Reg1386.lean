/-- the lines clause for every class of the local table of rep #1386. -/
theorem lines (t5 : List T5Rec) (h943 : ∀ p ∈ LinRQSC943.blobs, LinesCl t5 (t4OfRec p.1)) (h966 : ∀ p ∈ LinRQSC966.blobs, LinesCl t5 (t4OfRec p.1)) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1)) (h1021 : ∀ p ∈ LinRQSC1021.blobs, LinesCl t5 (t4OfRec p.1)) (h1022 : ∀ p ∈ LinRQSC1022.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1386.nT).map (t4At (LRSpectrumFull.L5S4.dg N1386.TT) N1386.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h943 p hp
  · exact h966 p hp
  · exact h1004 p hp
  · exact h1021 p hp
  · exact h1022 p hp
)


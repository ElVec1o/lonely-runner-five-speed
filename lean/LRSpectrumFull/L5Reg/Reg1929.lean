/-
# L5Reg.Reg1929 : the lines clause for every class of the local table of rep #1929 (generated by l5reg)

Every local class `i < nT` of rep #1929 (19 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1929T
import LRSpectrumFull.L5S4.LinRQSC1049
import LRSpectrumFull.L5S4.LinRQSC1051

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1929
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1049, LinRQSC1049.blobs), (1051, LinRQSC1051.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1051, 227, [2, -1, 0, 0, 0, -1, -3, 1, -1]), (1051, 228, [2, 1, -2, 3, -2, -2, 3, 1, -3]), (1051, 229, [2, -1, 0, 3, 0, -1, 0, -1, 1]), (1051, 230, [1, -2, 0, 0, -3, 1, -3, 1, 2]), (1051, 231, [1, 1, 0, -1, 1, 1, -1, 0, 0]), (1051, 232, [2, -1, 0, 0, 0, -1, -3, 1, 2]), (1051, 233, [1, -1, 0, -3, 0, 1, 0, -2, 1]), (1051, 234, [1, -1, -1, -3, -1, 2, 0, 1, 0]), (1051, 235, [2, -1, 0, 0, -1, 1, -3, 0, 1]), (1051, 236, [1, -2, 1, -2, -3, 4, 3, 0, -2]), (1051, 237, [2, 1, -1, 0, -2, 1, -3, 1, 0]), (1051, 238, [1, -2, 0, -2, -3, 1, 3, 0, -1]), (1049, 167, [1, 0, -2, 0, 0, 1, -3, 1, 0]), (1051, 239, [1, -1, 0, -2, 0, 1, 2, 1, -2]), (1051, 240, [1, 1, -2, -2, 1, -3, 2, 0, 1]), (1051, 241, [2, 1, -1, 0, -2, 1, -3, 2, 0]), (1051, 242, [1, 0, 0, 0, -1, 1, -1, 1, 0]), (1051, 243, [1, -2, 0, -2, 0, 1, 4, 1, -2]), (1051, 244, [1, 1, -1, 0, -2, 1, -1, 2, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1929.TT) N1929.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1929.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1929. -/
theorem lines (t5 : List T5Rec) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1)) (h1051 : ∀ p ∈ LinRQSC1051.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1929.nT).map (t4At (LRSpectrumFull.L5S4.dg N1929.TT) N1929.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1049 p hp
  · exact h1051 p hp
)

#print axioms lines

end R1929
end L5Reg
end LRSpectrumFull

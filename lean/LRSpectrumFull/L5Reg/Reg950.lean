/-
# L5Reg.Reg950 : the lines clause for every class of the local table of rep #950 (generated by l5reg)

Every local class `i < nT` of rep #950 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O950T
import LRSpectrumFull.L5S4.LinRQSC888

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R950
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(888, LinRQSC888.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(888, 200, [1, -1, 1, 3, -2, 1, 1, -1, 0]), (888, 201, [1, -2, 0, 3, 1, -1, 1, -3, 0]), (888, 202, [1, -2, 0, 3, 1, -2, -1, -2, 1]), (888, 203, [1, -2, 0, 3, 1, -3, 2, -2, -1]), (888, 204, [1, -2, 1, 3, 1, -3, 1, -1, 0]), (888, 205, [1, -2, 0, 3, 1, -2, -1, -2, 1]), (888, 206, [1, -2, 0, 3, 1, -3, 2, -2, -1]), (888, 207, [1, 0, -1, 3, 0, -2, 0, 1, -1]), (888, 208, [1, 0, -1, 3, 0, -2, 1, 1, -1]), (888, 209, [0, 1, 0, 0, 3, -1, 1, -1, 0]), (888, 210, [0, 1, 0, 0, 3, -1, 1, -1, 0]), (888, 211, [0, 1, 0, 0, 3, -1, 1, 1, -1]), (888, 212, [1, 0, -1, 3, 0, -2, 1, 1, -1]), (888, 213, [1, 0, -1, 3, 0, -2, -1, 1, 0]), (888, 214, [1, 0, -1, 3, 0, -2, -1, 1, 0]), (888, 215, [1, -1, 1, 3, -2, 1, 1, -1, 0]), (888, 216, [1, -2, 1, 3, 1, -1, 0, -2, 1]), (888, 217, [1, -2, 1, 3, 1, -2, 0, -3, 2]), (888, 218, [1, -2, 0, 3, 1, -2, -1, -2, 1]), (888, 219, [1, 0, -1, 3, 0, -2, -1, 1, 0]), (888, 220, [1, 0, -1, 3, 0, -2, 1, 1, -1]), (888, 221, [1, 0, -1, 3, 0, -2, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N950.TT) N950.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N950.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #950. -/
theorem lines (t5 : List T5Rec) (h888 : ∀ p ∈ LinRQSC888.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N950.nT).map (t4At (LRSpectrumFull.L5S4.dg N950.TT) N950.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h888 p hp
)

#print axioms lines

end R950
end L5Reg
end LRSpectrumFull

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N517.TT) N517.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 33 := by decide +kernel

/-- the lines clause for local classes 300..332 of rep #517. -/
theorem lines (t5 : List T5Rec) (h761 : ∀ p ∈ LinRQSC761.blobs, LinesCl t5 (t4OfRec p.1)) (h762 : ∀ p ∈ LinRQSC762.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 33 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N517.TT) N517.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl
    · exact h761 p hpe
    · exact h762 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines


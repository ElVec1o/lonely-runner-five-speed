/-- the lines clause for every class of the local table of rep #99. -/
theorem lines (t5 : List T5Rec) (h43 : ∀ p ∈ LinRQSC43.blobs, LinesCl t5 (t4OfRec p.1)) (h45 : ∀ p ∈ LinRQSC45.blobs, LinesCl t5 (t4OfRec p.1)) (h46 : ∀ p ∈ LinRQSC46.blobs, LinesCl t5 (t4OfRec p.1)) (h102 : ∀ p ∈ LinRQSC102.blobs, LinesCl t5 (t4OfRec p.1)) (h103 : ∀ p ∈ LinRQSC103.blobs, LinesCl t5 (t4OfRec p.1)) (h104 : ∀ p ∈ LinRQSC104.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N99.nT).map (t4At (LRSpectrumFull.L5S4.dg N99.TT) N99.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N99.nT := List.mem_range.1 hc
  have hn : N99.nT = 321 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 321) := by omega
  rcases hcase with h | h | h | h
  · exact P99_0.lines t5 h45 h46 h102 h103 c h.1 (by omega)
  · exact P99_1.lines t5 h45 h46 h103 c h.1 (by omega)
  · exact P99_2.lines t5 h43 h103 h104 c h.1 (by omega)
  · exact P99_3.lines t5 h104 c h.1 (by omega)

#print axioms lines

end R99

open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

/-- the lines clause for every class of the local table of rep #160. -/
theorem lines (t5 : List T5Rec) (h44 : ∀ p ∈ LinRQSC44.blobs, LinesCl t5 (t4OfRec p.1)) (h103 : ∀ p ∈ LinRQSC103.blobs, LinesCl t5 (t4OfRec p.1)) (h104 : ∀ p ∈ LinRQSC104.blobs, LinesCl t5 (t4OfRec p.1)) (h164 : ∀ p ∈ LinRQSC164.blobs, LinesCl t5 (t4OfRec p.1)) (h165 : ∀ p ∈ LinRQSC165.blobs, LinesCl t5 (t4OfRec p.1)) (h166 : ∀ p ∈ LinRQSC166.blobs, LinesCl t5 (t4OfRec p.1)) (h167 : ∀ p ∈ LinRQSC167.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N160.nT).map (t4At (LRSpectrumFull.L5S4.dg N160.TT) N160.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N160.nT := List.mem_range.1 hc
  have hn : N160.nT = 316 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 316) := by omega
  rcases hcase with h | h | h | h
  · exact P160_0.lines t5 h44 h103 h104 h164 h165 c h.1 (by omega)
  · exact P160_1.lines t5 h44 h165 h166 c h.1 (by omega)
  · exact P160_2.lines t5 h103 h104 h166 h167 c h.1 (by omega)
  · exact P160_3.lines t5 h167 c h.1 (by omega)

#print axioms lines

end R160
end L5Reg
end LRSpectrumFull

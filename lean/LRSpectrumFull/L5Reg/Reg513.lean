/-
# L5Reg.Reg513 : the lines clause for every class of the local table of rep #513 (generated by l5reg)

Every local class `i < nT` of rep #513 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O513T
import LRSpectrumFull.L5S4.LinRQSC439
import LRSpectrumFull.L5S4.LinRQSC756

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R513
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(439, LinRQSC439.blobs), (756, LinRQSC756.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(756, 60, [1, 0, -1, 4, -2, -3, -3, -3, 4]), (756, 61, [1, 0, 0, 4, -2, 1, 3, 3, -1]), (756, 62, [1, -1, 0, 4, 1, -2, -3, -4, 3]), (756, 63, [1, 0, 0, 4, 2, 1, 3, -3, -1]), (756, 64, [1, 0, -1, -1, 1, 0, 4, 0, -3]), (756, 65, [1, 0, -1, 4, 1, -4, -3, 1, 2]), (756, 66, [1, 1, -1, -2, -1, 2, -2, 4, 1]), (756, 67, [1, -1, 0, -1, -4, 1, 4, 0, -1]), (756, 68, [1, 0, -1, 4, 1, -4, -1, -2, 2]), (756, 69, [1, -1, 0, -2, -1, 1, -2, 1, 0]), (756, 70, [1, -1, 0, -2, 1, 1, -4, -3, 6]), (756, 71, [1, -1, 0, -1, 2, 0, 3, 4, -1]), (439, 116, [1, -1, 0, -3, -4, 1, -1, 2, 0]), (756, 72, [1, -1, 0, -1, -4, 2, 4, 3, -3]), (756, 73, [1, -1, 0, -1, 0, 0, 4, -3, -1]), (756, 74, [1, -1, 0, -2, -4, 1, -2, 1, 0]), (756, 75, [1, 0, 0, -2, 3, -2, -4, 2, -1]), (756, 76, [1, -1, 0, -2, 1, 1, -2, -4, 5]), (756, 77, [1, 0, -1, -2, -1, 2, -3, 1, 2]), (756, 78, [1, -1, 0, -1, 2, 0, 4, 3, -1]), (756, 79, [1, 0, -1, -1, -2, 2, 4, -1, -3]), (756, 80, [1, 0, -1, -2, 1, 1, -3, -1, 3]), (756, 81, [1, 1, -1, -2, 4, -3, -4, 1, 0]), (756, 82, [1, -1, 0, -2, 1, 1, -4, -3, 6]), (756, 83, [1, -1, 0, -2, 1, 1, -3, -4, 6]), (756, 84, [1, -1, 0, -1, 2, 0, 4, 4, -1]), (756, 85, [1, -1, 0, -2, -1, 1, -4, 2, 1]), (756, 86, [1, -1, 0, -2, 1, 0, -3, -4, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N513.TT) N513.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N513.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #513. -/
theorem lines (t5 : List T5Rec) (h439 : ∀ p ∈ LinRQSC439.blobs, LinesCl t5 (t4OfRec p.1)) (h756 : ∀ p ∈ LinRQSC756.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N513.nT).map (t4At (LRSpectrumFull.L5S4.dg N513.TT) N513.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h439 p hp
  · exact h756 p hp
)

#print axioms lines

end R513
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1399 : the lines clause for every class of the local table of rep #1399 (generated by l5reg)

Every local class `i < nT` of rep #1399 (26 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1399T
import LRSpectrumFull.L5S4.LinRQSC931
import LRSpectrumFull.L5S4.LinRQSC1025

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1399
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(931, LinRQSC931.blobs), (1025, LinRQSC1025.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1025, 71, [0, -2, 1, 1, 0, 0, 0, 3, -1]), (1025, 72, [0, -2, 1, 3, 0, -1, 2, -1, 0]), (1025, 73, [0, -1, 0, 3, 0, -1, 1, -1, 0]), (1025, 74, [0, -2, 1, 3, 0, -2, -2, 1, 1]), (931, 2, [0, -2, 1, 0, 1, -1, -1, 0, 1]), (1025, 75, [0, -1, 0, 1, -1, 0, 0, 2, -1]), (1025, 76, [1, 0, -1, 1, -3, 0, 3, 1, -3]), (1025, 77, [0, 1, -1, 3, 1, -3, 1, -2, 1]), (1025, 78, [0, -1, 0, 3, -1, -1, -1, 2, 0]), (1025, 79, [1, 0, -1, 1, 3, -3, 3, -1, -2]), (1025, 80, [1, 0, -1, 1, 3, -2, 3, -2, -2]), (1025, 81, [1, 0, -1, 1, 3, -3, 3, -1, -2]), (1025, 82, [0, 1, 0, 3, 1, -1, 1, -1, 0]), (1025, 83, [0, -1, 1, 3, -1, -1, -2, -2, 3]), (1025, 84, [0, 1, 1, 1, 1, 1, 0, 2, 1]), (1025, 85, [0, 1, 0, 3, 1, -1, -1, 2, 0]), (1025, 86, [0, 1, 0, 3, 1, -2, 1, 2, -1]), (1025, 87, [0, 1, 0, 3, 1, -2, 1, 2, -1]), (1025, 88, [1, 0, 0, 1, 1, -1, -3, 0, 1]), (1025, 89, [1, 0, -1, 1, -3, 1, -3, 1, 2]), (1025, 90, [0, 1, -1, 1, 1, -1, 0, 2, -3]), (1025, 91, [0, -1, 1, 2, 2, -3, 3, -1, -1]), (1025, 92, [0, -1, 1, 3, -1, -1, 2, 2, -3]), (1025, 93, [0, -1, 1, 3, -1, 0, 1, 3, -3]), (1025, 94, [0, 1, -1, 3, 1, -3, -1, 1, 0]), (1025, 95, [0, 1, 0, 3, 1, -2, 1, 3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1399.TT) N1399.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1399.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1399. -/
theorem lines (t5 : List T5Rec) (h931 : ∀ p ∈ LinRQSC931.blobs, LinesCl t5 (t4OfRec p.1)) (h1025 : ∀ p ∈ LinRQSC1025.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1399.nT).map (t4At (LRSpectrumFull.L5S4.dg N1399.TT) N1399.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h931 p hp
  · exact h1025 p hp
)

#print axioms lines

end R1399
end L5Reg
end LRSpectrumFull

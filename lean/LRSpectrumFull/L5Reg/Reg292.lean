theorem adv_len : adv.length = N292.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #292. -/
theorem lines (t5 : List T5Rec) (h444 : ∀ p ∈ LinRQSC444.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N292.nT).map (t4At (LRSpectrumFull.L5S4.dg N292.TT) N292.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h444 p hp
)


/-
# L5Reg.Reg1036 : the lines clause for every class of the local table of rep #1036 (generated by l5reg)

Every local class `i < nT` of rep #1036 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1036T
import LRSpectrumFull.L5S4.LinRQSC908

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1036
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(908, LinRQSC908.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(908, 68, [2, -1, 0, -1, 2, -1, 2, 0, -1]), (908, 69, [2, -1, 0, -1, 1, -1, 3, -2, 0]), (908, 70, [2, 0, -1, -1, 3, 0, -3, -2, 2]), (908, 71, [2, -1, -1, -1, 1, 1, -3, 2, 1]), (908, 72, [0, 0, -1, -3, 1, 2, 2, -1, 0]), (908, 73, [0, -2, 1, -3, 1, 2, -1, -2, 2]), (908, 74, [2, 1, -1, -1, 1, 0, 2, 0, -1]), (908, 75, [2, -2, 1, -1, 1, -1, 3, -2, 1]), (908, 76, [2, -1, 0, -1, 2, 1, -2, 0, -1]), (908, 77, [2, -1, -1, -1, 0, 1, -2, 0, 1]), (908, 78, [2, 0, -1, -1, -1, 1, 3, 0, -1]), (908, 79, [0, 0, -1, -1, 1, 0, 0, 1, 0]), (908, 80, [2, 0, -1, -1, 3, 1, -1, -2, 0]), (908, 81, [0, -1, 0, -1, -1, 1, 0, -2, 1]), (908, 82, [0, 0, -1, -3, 1, -1, 2, -1, -2]), (908, 83, [0, 1, 0, -1, 0, 1, 0, 0, 1]), (908, 84, [0, 0, -1, -1, 0, -1, 1, -1, -1]), (908, 85, [1, 0, 0, 1, -1, 3, 2, 1, -2]), (908, 86, [0, -1, 0, -3, -1, 1, 2, -2, -1]), (908, 87, [0, -1, 1, -1, 1, 0, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1036.TT) N1036.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1036.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1036. -/
theorem lines (t5 : List T5Rec) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1036.nT).map (t4At (LRSpectrumFull.L5S4.dg N1036.TT) N1036.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h908 p hp
)

#print axioms lines

end R1036
end L5Reg
end LRSpectrumFull

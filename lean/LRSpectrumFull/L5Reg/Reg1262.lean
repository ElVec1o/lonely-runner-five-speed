/-- the lines clause for every class of the local table of rep #1262. -/
theorem lines (t5 : List T5Rec) (h972 : ∀ p ∈ LinRQSC972.blobs, LinesCl t5 (t4OfRec p.1)) (h975 : ∀ p ∈ LinRQSC975.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1262.nT).map (t4At (LRSpectrumFull.L5S4.dg N1262.TT) N1262.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h972 p hp
  · exact h975 p hp
)


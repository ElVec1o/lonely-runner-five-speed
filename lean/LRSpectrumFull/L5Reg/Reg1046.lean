theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1046.TT) N1046.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1046.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1046. -/
theorem lines (t5 : List T5Rec) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1)) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1)) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1046.nT).map (t4At (LRSpectrumFull.L5S4.dg N1046.TT) N1046.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h901 p hp
  · exact h905 p hp
  · exact h906 p hp
  · exact h907 p hp
  · exact h909 p hp
)

#print axioms lines


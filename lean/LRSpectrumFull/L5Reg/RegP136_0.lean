theorem lines (t5 : List T5Rec) (h124 : ∀ p ∈ LinRQSC124.blobs, LinesCl t5 (t4OfRec p.1)) (h125 : ∀ p ∈ LinRQSC125.blobs, LinesCl t5 (t4OfRec p.1))

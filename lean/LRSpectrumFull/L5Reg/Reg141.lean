/-- the lines clause for every class of the local table of rep #141. -/
theorem lines (t5 : List T5Rec) (h130 : ∀ p ∈ LinRQSC130.blobs, LinesCl t5 (t4OfRec p.1)) (h131 : ∀ p ∈ LinRQSC131.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N141.nT).map (t4At (LRSpectrumFull.L5S4.dg N141.TT) N141.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h130 p hp
  · exact h131 p hp
)


/-
# L5Reg.Reg1043 : the lines clause for every class of the local table of rep #1043 (generated by l5reg)

Every local class `i < nT` of rep #1043 (42 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1043T
import LRSpectrumFull.L5S4.LinRQSC901
import LRSpectrumFull.L5S4.LinRQSC904
import LRSpectrumFull.L5S4.LinRQSC909

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1043
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(901, LinRQSC901.blobs), (904, LinRQSC904.blobs), (909, LinRQSC909.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(909, 18, [1, 0, -1, 1, 1, -1, -1, 0, 0]), (909, 19, [1, -1, 0, -1, 0, 1, 0, -2, 1]), (909, 20, [2, -1, 0, -2, 0, 1, -3, 2, 0]), (909, 21, [1, -2, 1, 0, 2, -1, 3, 1, -1]), (909, 22, [2, 0, -1, 2, -1, -1, -3, -1, 2]), (909, 23, [1, 0, -1, 1, -1, 0, -1, 1, -1]), (909, 24, [1, 0, -1, 1, 2, -2, 0, 3, -2]), (909, 25, [2, -1, -1, 2, 0, -1, -1, 2, 0]), (909, 26, [2, -2, 1, -2, 1, 0, -3, 2, 0]), (901, 120, [1, 0, 0, -1, -1, 1, 1, -1, 0]), (909, 27, [1, 0, -1, 1, -1, 0, -1, -1, 1]), (909, 28, [2, 0, -1, 2, -1, 0, -1, -2, 2]), (909, 29, [2, 1, -1, 2, -1, 0, -1, 0, 0]), (904, 84, [1, 1, -1, -1, 0, 0, -1, 1, 0]), (909, 30, [2, -1, -1, -2, 0, 1, -1, 2, 0]), (909, 31, [2, -1, -1, -2, 0, 1, -1, 2, 0]), (909, 32, [2, -1, -1, -2, 0, 1, -3, -2, 2]), (909, 33, [1, -1, 0, 0, -1, 0, 3, 1, -1]), (909, 34, [0, 0, -1, -1, 0, 1, 1, -1, 2]), (909, 35, [2, 1, -1, -2, 0, 1, -1, 3, 0]), (901, 110, [1, -1, 0, -1, -2, 2, 1, 0, -1]), (909, 36, [2, 0, -1, 2, -1, -1, -3, 1, 2]), (909, 37, [1, 2, -1, 1, -2, 0, 0, 1, 0]), (909, 38, [2, -1, 0, 2, 1, -1, -1, 0, 0]), (909, 39, [1, 1, -1, -1, 0, 0, -1, 2, -1]), (909, 40, [1, 1, -1, 1, 0, -1, -1, 2, 0]), (909, 41, [1, 1, -1, 1, 0, -1, 0, 2, -1]), (909, 42, [1, 1, -1, 1, 0, -1, 0, 2, -1]), (909, 43, [0, 2, -1, -1, -2, 1, 1, -1, 0]), (909, 44, [2, 1, -1, -2, 0, 1, -1, 2, 0]), (909, 45, [2, 0, -1, 2, 1, -2, -1, 2, -1]), (909, 46, [1, 0, 0, 1, -1, 0, 0, -3, 1]), (909, 47, [2, 0, -1, -2, 1, 0, -1, 0, 1]), (909, 48, [0, 1, 0, -2, 0, 1, 3, 0, -2]), (909, 49, [1, 2, -2, -1, 2, -1, 0, -1, 1]), (909, 50, [2, 1, -1, -2, 1, 0, 1, 0, 0]), (909, 51, [1, 2, 1, -1, 2, 0, 0, -1, 0]), (909, 52, [1, 1, -1, -1, 1, 0, -1, 0, 1]), (909, 53, [0, 0, -1, 1, 0, -1, 3, -1, 1]), (909, 54, [0, 2, -1, 1, -2, 0, 3, 1, -3]), (909, 55, [0, 1, 0, 1, 0, 0, 3, 0, -1]), (909, 56, [0, -1, 0, 1, 0, 0, 3, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1043.TT) N1043.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1043.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1043. -/
theorem lines (t5 : List T5Rec) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1)) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1043.nT).map (t4At (LRSpectrumFull.L5S4.dg N1043.TT) N1043.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h901 p hp
  · exact h904 p hp
  · exact h909 p hp
)

#print axioms lines

end R1043
end L5Reg
end LRSpectrumFull

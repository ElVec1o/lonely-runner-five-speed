theorem lines (t5 : List T5Rec) (h211 : ∀ p ∈ LinRQSC211.blobs, LinesCl t5 (t4OfRec p.1)) (h681 : ∀ p ∈ LinRQSC681.blobs, LinesCl t5 (t4OfRec p.1)) (h722 : ∀ p ∈ LinRQSC722.blobs, LinesCl t5 (t4OfRec p.1)) (h801 : ∀ p ∈ LinRQSC801.blobs, LinesCl t5 (t4OfRec p.1)) (h802 : ∀ p ∈ LinRQSC802.blobs, LinesCl t5 (t4OfRec p.1)) (h803 : ∀ p ∈ LinRQSC803.blobs, LinesCl t5 (t4OfRec p.1))

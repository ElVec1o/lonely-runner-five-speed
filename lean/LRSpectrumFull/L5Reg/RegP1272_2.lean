theorem lines (t5 : List T5Rec) (h926 : ∀ p ∈ LinRQSC926.blobs, LinesCl t5 (t4OfRec p.1)) (h927 : ∀ p ∈ LinRQSC927.blobs, LinesCl t5 (t4OfRec p.1)) (h982 : ∀ p ∈ LinRQSC982.blobs, LinesCl t5 (t4OfRec p.1)) (h986 : ∀ p ∈ LinRQSC986.blobs, LinesCl t5 (t4OfRec p.1)) (h987 : ∀ p ∈ LinRQSC987.blobs, LinesCl t5 (t4OfRec p.1))

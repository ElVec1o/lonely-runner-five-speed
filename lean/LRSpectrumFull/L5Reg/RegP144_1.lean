/-- the lines clause for local classes 100..199 of rep #144. -/
theorem lines (t5 : List T5Rec) (h48 : ∀ p ∈ LinRQSC48.blobs, LinesCl t5 (t4OfRec p.1)) (h87 : ∀ p ∈ LinRQSC87.blobs, LinesCl t5 (t4OfRec p.1)) (h88 : ∀ p ∈ LinRQSC88.blobs, LinesCl t5 (t4OfRec p.1)) (h137 : ∀ p ∈ LinRQSC137.blobs, LinesCl t5 (t4OfRec p.1)) (h138 : ∀ p ∈ LinRQSC138.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N144.TT) N144.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h48 p hpe
    · exact h87 p hpe
    · exact h88 p hpe
    · exact h137 p hpe
    · exact h138 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


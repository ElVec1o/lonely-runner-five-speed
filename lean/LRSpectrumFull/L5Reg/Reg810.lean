/-- the lines clause for every class of the local table of rep #810. -/
theorem lines (t5 : List T5Rec) (h871 : ∀ p ∈ LinRQSC871.blobs, LinesCl t5 (t4OfRec p.1)) (h874 : ∀ p ∈ LinRQSC874.blobs, LinesCl t5 (t4OfRec p.1)) (h875 : ∀ p ∈ LinRQSC875.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N810.nT).map (t4At (LRSpectrumFull.L5S4.dg N810.TT) N810.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h871 p hp
  · exact h874 p hp
  · exact h875 p hp
)


/-
# L5Reg.RegFin103 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg295
import LRSpectrumFull.L5Reg.Reg297

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines295 : ∀ cl ∈ (List.range N295.nT).map (t4At (LRSpectrumFull.L5S4.dg N295.TT) N295.ST), LinesCl T5Store.t5 cl :=
  R295.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem457 p hp)) (fun p hp => FinalGlue.glines p (mem458 p hp))

theorem lines297 : ∀ cl ∈ (List.range N297.nT).map (t4At (LRSpectrumFull.L5S4.dg N297.TT) N297.ST), LinesCl T5Store.t5 cl :=
  R297.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem485 p hp)) (fun p hp => FinalGlue.glines p (mem486 p hp)) (fun p hp => FinalGlue.glines p (mem487 p hp)) (fun p hp => FinalGlue.glines p (mem488 p hp))

#print axioms lines295

end L5Reg
end LRSpectrumFull

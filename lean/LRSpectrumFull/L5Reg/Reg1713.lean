/-- the lines clause for every class of the local table of rep #1713. -/
theorem lines (t5 : List T5Rec) (h1027 : ∀ p ∈ LinRQSC1027.blobs, LinesCl t5 (t4OfRec p.1)) (h1032 : ∀ p ∈ LinRQSC1032.blobs, LinesCl t5 (t4OfRec p.1)) (h1043 : ∀ p ∈ LinRQSC1043.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1713.nT).map (t4At (LRSpectrumFull.L5S4.dg N1713.TT) N1713.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h1027 p hp
  · exact h1032 p hp
  · exact h1043 p hp
)


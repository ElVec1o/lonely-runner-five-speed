/-- the lines clause for local classes 200..299 of rep #165. -/
theorem lines (t5 : List T5Rec) (h182 : ∀ p ∈ LinRQSC182.blobs, LinesCl t5 (t4OfRec p.1)) (h183 : ∀ p ∈ LinRQSC183.blobs, LinesCl t5 (t4OfRec p.1))

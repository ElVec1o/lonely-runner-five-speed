/-
# L5Reg.RegFin50 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg84
import LRSpectrumFull.L5Reg.Reg111

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines84 : ∀ cl ∈ (List.range N84.nT).map (t4At (LRSpectrumFull.L5S4.dg N84.TT) N84.ST), LinesCl T5Store.t5 cl :=
  R84.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem84 p hp))

theorem lines111 : ∀ cl ∈ (List.range N111.nT).map (t4At (LRSpectrumFull.L5S4.dg N111.TT) N111.ST), LinesCl T5Store.t5 cl :=
  R111.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem84 p hp)) (fun p hp => FinalGlue.glines p (mem112 p hp))

#print axioms lines84

end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg886 : the lines clause for every class of the local table of rep #886 (generated by l5reg)

Every local class `i < nT` of rep #886 (12 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O886T
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R886
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 138, [3, -1, -1, 0, -1, 1, -2, -3, 4]), (881, 139, [3, -1, -1, 0, 1, -1, -2, 1, 0]), (881, 140, [3, -1, -1, 0, -1, 0, -2, -2, 1]), (881, 141, [3, -2, -2, 0, 1, 0, -1, 0, 1]), (881, 142, [3, -1, 0, 0, -1, 1, -1, -2, 2]), (881, 143, [3, -2, 0, 0, 1, -1, -1, 0, 1]), (881, 144, [1, 0, 0, 0, 3, -2, 0, -2, 1]), (881, 145, [1, 0, -1, 1, 1, -1, 3, 0, -2]), (881, 146, [3, -1, -1, 0, -1, 0, -2, -2, 1]), (881, 147, [3, 1, -2, 0, 1, 0, -2, 2, 1]), (881, 148, [0, -1, 1, -1, 0, 1, 0, 0, 1]), (881, 149, [0, 0, -1, -1, 0, 0, 1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N886.TT) N886.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N886.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #886. -/
theorem lines (t5 : List T5Rec) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N886.nT).map (t4At (LRSpectrumFull.L5S4.dg N886.TT) N886.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h881 p hp
)

#print axioms lines

end R886
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1328 : the lines clause for every class of the local table of rep #1328 (generated by l5reg)

Every local class `i < nT` of rep #1328 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1328T
import LRSpectrumFull.L5S4.LinRQSC935
import LRSpectrumFull.L5S4.LinRQSC959
import LRSpectrumFull.L5S4.LinRQSC960
import LRSpectrumFull.L5S4.LinRQSC1007

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1328
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(935, LinRQSC935.blobs), (959, LinRQSC959.blobs), (960, LinRQSC960.blobs), (1007, LinRQSC1007.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1007, 186, [1, -1, 0, 3, -1, -1, -3, -2, 2]), (1007, 187, [0, -1, 1, 1, -3, 2, 1, 3, -3]), (1007, 188, [1, 0, 0, 3, -2, 1, 2, 3, -2]), (1007, 189, [1, -1, 0, 3, 0, -1, 3, 1, -1]), (1007, 190, [2, -1, 0, -1, 1, 0, 1, -1, -1]), (1007, 191, [1, 1, -1, 3, 1, -2, -1, 2, 0]), (935, 89, [1, -1, 0, -3, -2, 3, -3, 1, 1]), (1007, 192, [0, -2, 1, 1, 1, -1, 1, -2, 1]), (1007, 193, [1, 0, -1, 3, 2, -4, 1, -3, 1]), (1007, 194, [2, -1, -1, -1, -1, 1, 2, 3, -2]), (1007, 195, [1, 0, 0, 3, -1, 0, -3, 2, -1]), (1007, 196, [1, -1, 0, 3, 0, -1, -3, -1, 1]), (960, 173, [1, -2, 1, 3, 2, -2, 1, 1, -1]), (959, 44, [1, -1, 0, -3, -2, 2, -1, 3, -1]), (1007, 197, [2, 1, -2, -1, 3, -1, 2, -1, -1]), (1007, 198, [1, 1, -1, 0, 3, -1, 3, 1, -2]), (1007, 199, [0, 1, -1, 2, 3, -4, 3, -2, 0]), (935, 87, [1, -1, 0, -3, -2, 2, -1, 3, -1]), (1007, 200, [1, 1, -1, 1, 3, -2, -3, 0, 1]), (935, 91, [2, -1, 0, -1, -1, 1, 2, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1328.TT) N1328.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1328.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1328. -/
theorem lines (t5 : List T5Rec) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1)) (h960 : ∀ p ∈ LinRQSC960.blobs, LinesCl t5 (t4OfRec p.1)) (h1007 : ∀ p ∈ LinRQSC1007.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1328.nT).map (t4At (LRSpectrumFull.L5S4.dg N1328.TT) N1328.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h935 p hp
  · exact h959 p hp
  · exact h960 p hp
  · exact h1007 p hp
)

#print axioms lines

end R1328
end L5Reg
end LRSpectrumFull

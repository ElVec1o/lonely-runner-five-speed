/-
# L5Reg.Reg1026 : the lines clause for every class of the local table of rep #1026 (generated by l5reg)

Every local class `i < nT` of rep #1026 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1026T
import LRSpectrumFull.L5S4.LinRQSC906

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1026
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(906, LinRQSC906.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(906, 151, [1, 0, -1, 1, 3, -2, -2, 2, 1]), (906, 152, [2, -1, 0, -1, 1, 1, -3, 2, 2]), (906, 153, [2, -1, 1, -1, 1, 0, -2, 2, -1]), (906, 154, [2, 2, -3, -1, 1, 0, -2, 1, 1]), (906, 155, [2, 2, -3, 1, -1, 0, 2, -1, -1]), (906, 156, [2, 0, -1, -1, -1, 1, -3, 0, 1]), (906, 157, [0, 0, 1, -1, 0, 1, 0, -1, 3]), (906, 158, [0, 0, 1, -3, 2, 1, 2, -1, 2]), (906, 159, [0, -2, 1, -3, -1, 1, -1, 0, 0]), (906, 160, [2, 1, -1, -1, 1, 0, -3, 1, 1]), (906, 161, [2, 2, -1, 1, -1, 0, 2, -1, 0]), (906, 162, [2, -1, -1, 1, -2, 0, 2, 0, -1]), (906, 163, [2, 0, -1, -1, 1, 0, -2, -1, 2]), (906, 164, [2, -1, 0, -1, 0, 0, -2, 1, -1]), (906, 165, [2, -1, -1, 1, -1, 0, 2, -1, 0]), (906, 166, [0, -2, 1, -1, 1, 0, 1, 2, -2]), (906, 167, [0, 0, 1, -1, 0, 0, 1, -1, 0]), (906, 168, [0, 0, 1, -3, 2, 1, 2, -1, 2]), (906, 169, [0, 1, 0, 1, 1, -1, 3, 0, -2]), (906, 170, [2, 0, -1, -1, 3, 0, -2, -1, 1]), (906, 171, [2, 1, -1, -1, 1, 0, -2, 0, 1]), (906, 172, [2, -2, -1, -1, -1, 1, -1, -2, 1]), (906, 173, [2, 2, -3, 1, -1, 0, 2, -3, 1]), (906, 174, [0, -1, -1, -1, -1, 0, 1, -1, -1]), (906, 175, [0, -1, 0, -3, 2, 1, 2, 0, -1]), (906, 176, [0, 1, 0, -1, 0, 0, 1, -1, -1]), (906, 177, [0, 0, 1, -3, 1, 1, 1, 0, -2]), (906, 178, [0, 0, 1, -3, 1, -1, 1, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1026.TT) N1026.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1026.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1026. -/
theorem lines (t5 : List T5Rec) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1026.nT).map (t4At (LRSpectrumFull.L5S4.dg N1026.TT) N1026.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h906 p hp
)

#print axioms lines

end R1026
end L5Reg
end LRSpectrumFull

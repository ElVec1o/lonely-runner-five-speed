theorem adv_len : adv.length = N604.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #604. -/
theorem lines (t5 : List T5Rec) (h432 : ∀ p ∈ LinRQSC432.blobs, LinesCl t5 (t4OfRec p.1)) (h433 : ∀ p ∈ LinRQSC433.blobs, LinesCl t5 (t4OfRec p.1)) (h679 : ∀ p ∈ LinRQSC679.blobs, LinesCl t5 (t4OfRec p.1)) (h839 : ∀ p ∈ LinRQSC839.blobs, LinesCl t5 (t4OfRec p.1)) (h840 : ∀ p ∈ LinRQSC840.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N604.nT).map (t4At (LRSpectrumFull.L5S4.dg N604.TT) N604.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h432 p hp
  · exact h433 p hp
  · exact h679 p hp
  · exact h839 p hp
  · exact h840 p hp
)

#print axioms lines


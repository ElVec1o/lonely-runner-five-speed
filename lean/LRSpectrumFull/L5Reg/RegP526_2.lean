/-- the lines clause for local classes 200..299 of rep #526. -/
theorem lines (t5 : List T5Rec) (h797 : ∀ p ∈ LinRQSC797.blobs, LinesCl t5 (t4OfRec p.1)) (h798 : ∀ p ∈ LinRQSC798.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg1176 : the lines clause for every class of the local table of rep #1176 (generated by l5reg)

Every local class `i < nT` of rep #1176 (4 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1176T
import LRSpectrumFull.L5S4.LinRQSC935

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1176
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(935, LinRQSC935.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(935, 67, [1, 1, -1, 3, -2, -2, 2, 3, -2]), (935, 68, [1, 2, -2, -2, 0, 1, 4, -1, -1]), (935, 69, [1, 1, -1, -2, 0, 1, 2, -1, 0]), (935, 70, [2, -1, 0, 0, 0, -1, 3, -1, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1176.TT) N1176.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1176.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1176. -/
theorem lines (t5 : List T5Rec) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1176.nT).map (t4At (LRSpectrumFull.L5S4.dg N1176.TT) N1176.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h935 p hp
)

#print axioms lines

end R1176
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 100..199 of rep #494. -/
theorem lines (t5 : List T5Rec) (h753 : ∀ p ∈ LinRQSC753.blobs, LinesCl t5 (t4OfRec p.1)) (h754 : ∀ p ∈ LinRQSC754.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h548 : ∀ p ∈ LinRQSC548.blobs, LinesCl t5 (t4OfRec p.1)) (h549 : ∀ p ∈ LinRQSC549.blobs, LinesCl t5 (t4OfRec p.1)) (h550 : ∀ p ∈ LinRQSC550.blobs, LinesCl t5 (t4OfRec p.1))

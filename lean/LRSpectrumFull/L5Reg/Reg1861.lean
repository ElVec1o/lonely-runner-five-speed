/-
# L5Reg.Reg1861 : the lines clause for every class of the local table of rep #1861 (generated by l5reg)

Every local class `i < nT` of rep #1861 (40 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1861T
import LRSpectrumFull.L5S4.LinRQSC1049

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1861
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1049, LinRQSC1049.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1049, 38, [2, 1, -2, 3, 1, -3, 1, -3, 0]), (1049, 39, [2, -1, 0, 3, -1, -1, 0, 0, 1]), (1049, 40, [2, 1, -2, 3, -1, -2, 0, -2, 1]), (1049, 41, [2, -2, -1, 3, -2, 1, 2, -1, 1]), (1049, 42, [2, -2, -1, 3, 1, -1, 0, 1, 0]), (1049, 43, [2, -1, -1, 3, -1, 1, 0, 0, -1]), (1049, 44, [2, -1, 0, 3, -1, 0, -2, -3, 1]), (1049, 45, [2, 0, -1, 3, -1, -2, -1, 0, 0]), (1049, 46, [2, 0, -1, 3, -2, 0, 2, -1, 0]), (1049, 47, [2, 1, -2, 3, -1, -1, 2, 2, -3]), (1049, 48, [1, -2, 0, -1, -3, 2, 2, -1, -1]), (1049, 49, [2, -1, 0, 3, -2, -2, -2, 1, 1]), (1049, 50, [2, -2, 1, 3, 1, -1, 2, 1, -1]), (1049, 51, [2, 1, -1, 3, -1, -1, -2, 0, 1]), (1049, 52, [1, -1, 2, -1, 1, -1, 2, -1, -2]), (1049, 53, [1, 2, -2, -1, -1, 1, 2, -2, 1]), (1049, 54, [2, 1, -2, 3, -1, -2, -1, 0, 1]), (1049, 55, [2, -1, -1, 3, -1, 1, 0, 0, -1]), (1049, 56, [2, -1, -1, 3, 1, -2, 2, 0, -1]), (1049, 57, [1, 2, -2, 1, 3, -3, 3, -2, 1]), (1049, 58, [2, -1, -1, 3, 1, -2, 2, 0, -1]), (1049, 59, [2, 1, -1, 3, 1, -1, -1, 3, -2]), (1049, 60, [2, -1, -1, 3, 1, -2, 0, 1, 0]), (1049, 61, [2, -1, 0, 3, 1, -2, 0, 1, -1]), (1049, 62, [2, -1, 0, 3, 1, -3, -2, 0, 1]), (1049, 63, [2, -1, 0, 3, 1, -2, -1, -1, 1]), (1049, 64, [2, -1, -1, 3, 1, -2, -1, -1, 1]), (1049, 65, [2, 1, -1, 3, 1, -1, 0, 3, -2]), (1049, 66, [2, -1, -1, 3, 1, -3, 1, 0, -1]), (1049, 67, [2, -1, -1, 3, 1, -3, -2, -1, 2]), (1049, 68, [2, -2, -1, -1, 0, 1, -2, 1, 1]), (1049, 69, [2, -1, 0, 3, 1, -1, -1, 0, 0]), (1049, 70, [2, -1, 1, 3, -1, 0, -1, 0, 0]), (1049, 71, [2, 1, -1, -1, -1, 1, -2, 2, -1]), (1049, 72, [2, -2, 1, -1, 0, 1, -2, 1, 1]), (1049, 73, [2, -2, 1, -1, -3, 2, -1, 0, 0]), (1049, 74, [2, -2, 1, -1, -1, 1, -1, 0, 0]), (1049, 75, [2, -1, -1, 3, 1, -3, -2, -1, 2]), (1049, 76, [2, 1, -2, -1, -1, 1, -2, 2, 1]), (1049, 77, [2, 2, -1, -1, 3, -1, -1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1861.TT) N1861.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1861.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1861. -/
theorem lines (t5 : List T5Rec) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1861.nT).map (t4At (LRSpectrumFull.L5S4.dg N1861.TT) N1861.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1049 p hp
)

#print axioms lines

end R1861
end L5Reg
end LRSpectrumFull

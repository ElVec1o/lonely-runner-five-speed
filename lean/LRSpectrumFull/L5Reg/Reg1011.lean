/-
# L5Reg.Reg1011 : the lines clause for every class of the local table of rep #1011 (generated by l5reg)

Every local class `i < nT` of rep #1011 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1011T
import LRSpectrumFull.L5S4.LinRQSC899
import LRSpectrumFull.L5S4.LinRQSC901
import LRSpectrumFull.L5S4.LinRQSC904

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1011
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(899, LinRQSC899.blobs), (901, LinRQSC901.blobs), (904, LinRQSC904.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(904, 212, [2, 0, -1, -1, 1, 0, -2, -1, 1]), (904, 213, [0, 2, -1, 1, -1, 0, 1, 2, -2]), (904, 214, [2, -1, 0, -1, 1, -1, -3, 2, 0]), (904, 215, [1, 2, -1, 0, -1, 0, 1, -3, 0]), (899, 115, [1, -1, 0, 3, -1, -1, -2, 1, 0]), (904, 216, [2, 0, -1, 0, -3, 2, 3, -1, -1]), (904, 217, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (904, 218, [2, 2, -3, 0, -1, 1, 3, -1, -1]), (901, 79, [2, -1, 0, -3, -1, 1, 0, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1011.TT) N1011.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1011.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1011. -/
theorem lines (t5 : List T5Rec) (h899 : ∀ p ∈ LinRQSC899.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1011.nT).map (t4At (LRSpectrumFull.L5S4.dg N1011.TT) N1011.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h899 p hp
  · exact h901 p hp
  · exact h904 p hp
)

#print axioms lines

end R1011
end L5Reg
end LRSpectrumFull

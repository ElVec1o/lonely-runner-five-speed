theorem lines (t5 : List T5Rec) (h79 : ∀ p ∈ LinRQSC79.blobs, LinesCl t5 (t4OfRec p.1)) (h80 : ∀ p ∈ LinRQSC80.blobs, LinesCl t5 (t4OfRec p.1)) (h81 : ∀ p ∈ LinRQSC81.blobs, LinesCl t5 (t4OfRec p.1)) (h93 : ∀ p ∈ LinRQSC93.blobs, LinesCl t5 (t4OfRec p.1)) (h94 : ∀ p ∈ LinRQSC94.blobs, LinesCl t5 (t4OfRec p.1)) (h95 : ∀ p ∈ LinRQSC95.blobs, LinesCl t5 (t4OfRec p.1))

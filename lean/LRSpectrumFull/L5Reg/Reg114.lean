/-
# L5Reg.Reg114 : the lines clause for every class of the local table of rep #114 (generated by l5reg)

Every local class `i < nT` of rep #114 (34 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O114T
import LRSpectrumFull.L5S4.LinRQSC32
import LRSpectrumFull.L5S4.LinRQSC95
import LRSpectrumFull.L5S4.LinRQSC112

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R114
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(32, LinRQSC32.blobs), (95, LinRQSC95.blobs), (112, LinRQSC112.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(112, 181, [2, 0, -1, 0, 1, -2, 1, 0, 0]), (112, 182, [1, 0, 0, 0, -4, 1, 1, 1, 0]), (112, 183, [1, 0, 0, 0, -4, 3, 1, 1, -1]), (112, 184, [1, 1, -1, 0, 1, 0, -1, 4, 0]), (112, 185, [1, 1, -1, 0, 1, 0, -1, 3, 0]), (112, 186, [1, 0, 0, 0, -4, 1, 0, 3, -1]), (95, 113, [2, -1, 0, -1, 1, 0, 1, 0, 1]), (112, 187, [2, -1, 0, 0, 2, -1, -1, -1, 1]), (112, 188, [1, 0, 0, 0, 1, 0, -1, -1, 1]), (32, 60, [1, 1, -1, -1, 3, -2, 0, 1, -1]), (112, 189, [2, 0, -1, 0, 1, -1, 1, 0, 0]), (112, 190, [1, 0, 0, 0, -2, 1, 0, 1, -1]), (112, 191, [1, 0, 0, 0, -2, 1, 0, -1, 1]), (112, 192, [2, -1, 0, 0, 1, -1, 1, 0, 0]), (112, 193, [1, 0, 0, 0, 2, -1, 0, 3, -1]), (112, 194, [2, -1, 0, 0, -1, 1, 1, -1, 1]), (112, 195, [2, 0, -1, 0, -1, -1, 1, 1, 0]), (112, 196, [0, -2, 1, -1, 0, 1, 0, 1, 0]), (95, 108, [0, -2, 1, 0, 1, 0, -1, 0, 0]), (112, 197, [2, -1, 0, 0, -2, 1, -1, 2, -1]), (112, 198, [2, -1, 0, 0, 1, -1, 1, 0, 0]), (112, 199, [2, -1, 0, 0, -1, 1, 1, 0, 0]), (32, 58, [1, 0, 0, -1, 0, 1, 0, -1, 0]), (112, 200, [0, -1, 0, -1, 0, -1, 0, 1, -1]), (112, 201, [0, 0, -1, -1, 0, 0, 1, -1, 1]), (112, 202, [0, -2, 1, -1, 0, 1, 1, 1, -1]), (112, 203, [1, 0, 0, 0, -4, 1, 0, 3, -1]), (112, 204, [2, 0, -1, 0, 1, -1, -1, -3, 3]), (112, 205, [2, 0, -1, 0, -1, -2, 1, 0, -1]), (112, 206, [2, 0, -1, 0, 1, -1, 1, 0, 0]), (112, 207, [0, -2, 1, -1, 0, 1, 0, 1, 0]), (95, 110, [0, 0, 1, -1, 0, 0, 0, 1, 0]), (112, 208, [0, 0, -1, -1, 0, 0, 1, -1, 1]), (95, 111, [0, 0, -1, 0, -1, 1, -1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N114.TT) N114.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N114.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #114. -/
theorem lines (t5 : List T5Rec) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1)) (h95 : ∀ p ∈ LinRQSC95.blobs, LinesCl t5 (t4OfRec p.1)) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N114.nT).map (t4At (LRSpectrumFull.L5S4.dg N114.TT) N114.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h32 p hp
  · exact h95 p hp
  · exact h112 p hp
)

#print axioms lines

end R114
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1177 : the lines clause for every class of the local table of rep #1177 (generated by l5reg)

Every local class `i < nT` of rep #1177 (27 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1177T
import LRSpectrumFull.L5S4.LinRQSC926
import LRSpectrumFull.L5S4.LinRQSC935

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1177
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(926, LinRQSC926.blobs), (935, LinRQSC935.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(935, 71, [1, -1, 0, 1, 0, -1, 4, -1, -2]), (935, 72, [1, -1, 0, 1, -2, 1, -2, -3, 4]), (935, 73, [2, 1, -1, -1, -3, 1, -2, 3, 0]), (935, 74, [1, -1, 0, 2, 3, -1, 2, -3, 0]), (926, 26, [2, -1, -1, -3, -2, 2, -1, 3, 0]), (935, 75, [1, 1, -1, 2, -3, 1, 4, 1, -2]), (935, 76, [1, 1, -1, 2, -3, 2, 3, 2, -2]), (935, 77, [1, 1, -1, -3, 2, 1, -1, -3, 2]), (935, 78, [1, -1, 0, -3, -2, 3, -3, 1, 1]), (935, 79, [1, 1, -1, 2, -3, 1, -3, 0, 1]), (935, 80, [2, -1, -1, -1, -1, 1, 2, 1, -2]), (935, 81, [1, -1, 0, 2, -1, 0, -4, -1, 1]), (935, 82, [1, -1, 0, 2, -1, 0, -1, -3, 1]), (935, 83, [2, -1, -1, -1, -1, 1, 2, 3, -2]), (935, 84, [1, -1, 0, 1, -2, 1, 2, 3, -4]), (935, 85, [1, -1, 0, 1, -2, 1, 2, 3, -4]), (935, 86, [1, -2, 1, 1, 1, -1, -3, -2, 2]), (935, 87, [1, -1, 0, -3, -2, 2, -1, 3, -1]), (935, 88, [1, -1, 0, -3, -2, 2, -1, 3, -1]), (935, 89, [1, -1, 0, -3, -2, 3, -3, 1, 1]), (935, 90, [1, 1, -1, -3, 1, 0, -3, 0, 1]), (935, 91, [2, -1, 0, -1, -1, 1, 2, 1, -1]), (935, 92, [0, 1, 0, 0, 1, -1, 1, 1, -1]), (935, 93, [0, 2, -1, 0, -1, 1, 1, 1, -1]), (935, 94, [0, -1, 0, 0, -2, 1, 1, -1, 0]), (935, 95, [0, 1, -1, 0, 2, -1, 1, 1, -1]), (935, 96, [0, 1, -1, 0, -3, 2, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1177.TT) N1177.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1177.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1177. -/
theorem lines (t5 : List T5Rec) (h926 : ∀ p ∈ LinRQSC926.blobs, LinesCl t5 (t4OfRec p.1)) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1177.nT).map (t4At (LRSpectrumFull.L5S4.dg N1177.TT) N1177.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h926 p hp
  · exact h935 p hp
)

#print axioms lines

end R1177
end L5Reg
end LRSpectrumFull

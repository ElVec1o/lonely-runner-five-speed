/-- the lines clause for local classes 200..299 of rep #324. -/
theorem lines (t5 : List T5Rec) (h223 : ∀ p ∈ LinRQSC223.blobs, LinesCl t5 (t4OfRec p.1)) (h696 : ∀ p ∈ LinRQSC696.blobs, LinesCl t5 (t4OfRec p.1)) (h697 : ∀ p ∈ LinRQSC697.blobs, LinesCl t5 (t4OfRec p.1)) (h698 : ∀ p ∈ LinRQSC698.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N324.TT) N324.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h223 p hpe
    · exact h696 p hpe
    · exact h697 p hpe
    · exact h698 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


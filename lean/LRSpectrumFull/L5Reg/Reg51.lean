theorem adv_len : adv.length = N51.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #51. -/
theorem lines (t5 : List T5Rec) (h35 : ∀ p ∈ LinRQSC35.blobs, LinesCl t5 (t4OfRec p.1)) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N51.nT).map (t4At (LRSpectrumFull.L5S4.dg N51.TT) N51.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h35 p hp
  · exact h36 p hp
)


/-- the lines clause for local classes 300..399 of rep #38. -/
theorem lines (t5 : List T5Rec) (h20 : ∀ p ∈ LinRQSC20.blobs, LinesCl t5 (t4OfRec p.1)) (h21 : ∀ p ∈ LinRQSC21.blobs, LinesCl t5 (t4OfRec p.1)) (h22 : ∀ p ∈ LinRQSC22.blobs, LinesCl t5 (t4OfRec p.1)) (h23 : ∀ p ∈ LinRQSC23.blobs, LinesCl t5 (t4OfRec p.1)) (h24 : ∀ p ∈ LinRQSC24.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N38.TT) N38.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h20 p hpe
    · exact h21 p hpe
    · exact h22 p hpe
    · exact h23 p hpe
    · exact h24 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


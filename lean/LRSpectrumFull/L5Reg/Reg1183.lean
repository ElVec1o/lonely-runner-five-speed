/-
# L5Reg.Reg1183 : the lines clause for every class of the local table of rep #1183 (generated by l5reg)

Every local class `i < nT` of rep #1183 (23 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1183T
import LRSpectrumFull.L5S4.LinRQSC926
import LRSpectrumFull.L5S4.LinRQSC935

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1183
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(926, LinRQSC926.blobs), (935, LinRQSC935.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(935, 151, [1, 2, -1, -1, -1, 1, 4, 0, -3]), (926, 28, [2, -1, -1, -3, -2, 4, 0, 4, -3]), (935, 112, [1, 1, -1, 1, -3, 2, 3, -2, 1]), (935, 76, [1, 1, -1, 2, -3, 2, 3, 2, -2]), (935, 152, [2, 1, -1, -1, -1, 1, -1, 3, -2]), (935, 153, [2, 1, -1, -1, -1, 1, -3, 2, -1]), (935, 154, [1, 1, -1, 3, 2, -2, -1, 4, -3]), (935, 116, [1, -1, 0, 2, 3, -4, 3, -2, -1]), (935, 155, [2, 1, -2, -1, 3, -1, 0, -2, 1]), (935, 156, [1, -1, 0, 2, -3, 0, 4, 1, -1]), (935, 157, [1, 1, -1, 2, 3, -2, 2, -3, -1]), (935, 158, [1, 1, -1, 2, 3, -2, 4, -1, -3]), (935, 159, [1, 1, -1, 2, 3, -2, 3, -2, -2]), (935, 160, [1, -2, 1, 2, 1, -2, -3, 0, 2]), (935, 161, [1, -2, 0, 2, 1, -2, -3, -1, 3]), (935, 162, [1, 1, -1, 3, 2, -3, 1, -4, 0]), (935, 163, [1, -2, 1, 2, 1, -1, -3, -2, 2]), (935, 164, [1, -2, 0, 2, 1, -1, -2, 0, 1]), (935, 165, [2, 0, -1, -1, 0, 1, 2, 1, -2]), (935, 166, [1, -2, 0, 3, 1, -2, 2, 0, -1]), (935, 167, [1, -1, 1, 3, -2, -1, 3, -2, 0]), (935, 168, [1, -2, 0, 3, 1, -1, 3, 0, -1]), (935, 169, [1, 0, -1, 3, 0, -2, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1183.TT) N1183.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1183.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1183. -/
theorem lines (t5 : List T5Rec) (h926 : ∀ p ∈ LinRQSC926.blobs, LinesCl t5 (t4OfRec p.1)) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1183.nT).map (t4At (LRSpectrumFull.L5S4.dg N1183.TT) N1183.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h926 p hp
  · exact h935 p hp
)

#print axioms lines

end R1183
end L5Reg
end LRSpectrumFull

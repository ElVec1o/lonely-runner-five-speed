theorem lines (t5 : List T5Rec) (h743 : ∀ p ∈ LinRQSC743.blobs, LinesCl t5 (t4OfRec p.1)) (h744 : ∀ p ∈ LinRQSC744.blobs, LinesCl t5 (t4OfRec p.1))

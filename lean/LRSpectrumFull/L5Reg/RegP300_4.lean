/-- the lines clause for local classes 400..499 of rep #300. -/
theorem lines (t5 : List T5Rec) (h510 : ∀ p ∈ LinRQSC510.blobs, LinesCl t5 (t4OfRec p.1)) (h511 : ∀ p ∈ LinRQSC511.blobs, LinesCl t5 (t4OfRec p.1)) (h512 : ∀ p ∈ LinRQSC512.blobs, LinesCl t5 (t4OfRec p.1)) (h513 : ∀ p ∈ LinRQSC513.blobs, LinesCl t5 (t4OfRec p.1)) (h514 : ∀ p ∈ LinRQSC514.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N300.TT) N300.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h510 p hpe
    · exact h511 p hpe
    · exact h512 p hpe
    · exact h513 p hpe
    · exact h514 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2


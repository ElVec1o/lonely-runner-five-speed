def bls : List (ℕ × List (ℕ × ℕ)) := [(752, LinRQSC752.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(752, 36, [0, -1, 0, -3, -1, 2, 2, -2, -1]), (752, 37, [0, 1, 0, -3, 1, 1, 2, 2, -1]), (752, 38, [0, -1, 0, -3, 1, 2, 1, 3, -1]), (752, 39, [0, 1, 0, -1, 0, 1, 1, 0, 0]), (752, 40, [0, -1, 0, -3, -1, 1, 1, -2, 0]), (752, 41, [0, 0, -1, -3, 1, 1, 2, -1, 2]), (752, 42, [0, -1, 0, -1, 1, 1, 1, 2, 0]), (752, 43, [0, 1, 0, -1, -1, 1, 1, -2, 0]), (752, 44, [0, -1, 0, -3, 0, 2, 1, 0, -1]), (752, 45, [0, 1, 0, -3, 0, 1, 2, 0, -1]), (752, 46, [0, 1, 0, -3, 0, 1, 1, 0, 0]), (752, 47, [0, 1, 0, -3, 0, 2, 2, 0, -1]), (752, 48, [0, 1, 0, -3, 0, 1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N493.TT) N493.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 13 := by decide +kernel

/-- the lines clause for local classes 300..312 of rep #493. -/
theorem lines (t5 : List T5Rec) (h752 : ∀ p ∈ LinRQSC752.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 13 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N493.TT) N493.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h752 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines


/-
# L5Reg.RegFin39 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg381
import LRSpectrumFull.L5Reg.Reg456
import LRSpectrumFull.L5Reg.Reg382

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines381 : ∀ cl ∈ (List.range N381.nT).map (t4At (LRSpectrumFull.L5S4.dg N381.TT) N381.ST), LinesCl T5Store.t5 cl :=
  R381.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem725 p hp))

theorem lines456 : ∀ cl ∈ (List.range N456.nT).map (t4At (LRSpectrumFull.L5S4.dg N456.TT) N456.ST), LinesCl T5Store.t5 cl :=
  R456.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem726 p hp))

theorem lines382 : ∀ cl ∈ (List.range N382.nT).map (t4At (LRSpectrumFull.L5S4.dg N382.TT) N382.ST), LinesCl T5Store.t5 cl :=
  R382.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem434 p hp)) (fun p hp => FinalGlue.glines p (mem725 p hp))

#print axioms lines381

end L5Reg
end LRSpectrumFull

theorem lines (t5 : List T5Rec) (h787 : ∀ p ∈ LinRQSC787.blobs, LinesCl t5 (t4OfRec p.1)) (h788 : ∀ p ∈ LinRQSC788.blobs, LinesCl t5 (t4OfRec p.1))

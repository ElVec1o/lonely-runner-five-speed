/-- the lines clause for local classes 200..299 of rep #143. -/
theorem lines (t5 : List T5Rec) (h135 : ∀ p ∈ LinRQSC135.blobs, LinesCl t5 (t4OfRec p.1)) (h136 : ∀ p ∈ LinRQSC136.blobs, LinesCl t5 (t4OfRec p.1))

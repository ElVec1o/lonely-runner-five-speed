/-
# L5Reg.Reg341 : the lines clause for every class of the local table of rep #341 (generated by l5reg)

Every local class `i < nT` of rep #341 (13 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O341T
import LRSpectrumFull.L5S4.LinRQSC703

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R341
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(703, LinRQSC703.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(703, 66, [1, -1, 1, -2, 2, -1, -4, 3, -2]), (703, 67, [1, -1, 0, -2, 2, 1, 4, -3, -1]), (703, 68, [1, -1, 0, -2, 2, 1, -3, 2, 1]), (703, 69, [1, -1, 1, -2, 2, -1, 4, -3, 2]), (703, 70, [1, -1, 0, -2, 2, 1, 3, -2, -1]), (703, 71, [1, -1, 0, -2, 2, 1, 4, -3, -1]), (703, 72, [1, -1, 0, -2, -3, 1, 4, 0, -1]), (703, 73, [1, -1, 0, -2, -3, 3, 4, 3, -4]), (703, 74, [1, 0, -1, 3, 3, -4, -4, 2, 3]), (703, 75, [1, 0, -1, 3, 1, -3, -3, 1, 2]), (703, 76, [1, 1, -1, 3, -2, -2, 1, 0, -1]), (703, 77, [1, -1, 0, -2, 2, 1, -3, 2, 1]), (703, 78, [1, -1, 0, -2, 2, 1, -4, 3, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N341.TT) N341.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N341.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #341. -/
theorem lines (t5 : List T5Rec) (h703 : ∀ p ∈ LinRQSC703.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N341.nT).map (t4At (LRSpectrumFull.L5S4.dg N341.TT) N341.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h703 p hp
)

#print axioms lines

end R341
end L5Reg
end LRSpectrumFull

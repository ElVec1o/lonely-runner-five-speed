theorem lines349 : ∀ cl ∈ (List.range N349.nT).map (t4At (LRSpectrumFull.L5S4.dg N349.TT) N349.ST), LinesCl T5Store.t5 cl :=
  R349.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem716 p hp)) (fun p hp => FinalGlue.glines p (mem717 p hp)) (fun p hp => FinalGlue.glines p (mem718 p hp))


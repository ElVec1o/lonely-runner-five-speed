/-- the lines clause for every class of the local table of rep #136. -/
theorem lines (t5 : List T5Rec) (h124 : ∀ p ∈ LinRQSC124.blobs, LinesCl t5 (t4OfRec p.1)) (h125 : ∀ p ∈ LinRQSC125.blobs, LinesCl t5 (t4OfRec p.1)) (h126 : ∀ p ∈ LinRQSC126.blobs, LinesCl t5 (t4OfRec p.1)) (h127 : ∀ p ∈ LinRQSC127.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N136.nT).map (t4At (LRSpectrumFull.L5S4.dg N136.TT) N136.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N136.nT := List.mem_range.1 hc
  have hn : N136.nT = 497 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 400) ∨ (400 ≤ c ∧ c < 497) := by omega
  rcases hcase with h | h | h | h | h
  · exact P136_0.lines t5 h124 h125 c h.1 (by omega)
  · exact P136_1.lines t5 h125 c h.1 (by omega)
  · exact P136_2.lines t5 h125 h126 c h.1 (by omega)
  · exact P136_3.lines t5 h126 h127 c h.1 (by omega)
  · exact P136_4.lines t5 h127 c h.1 (by omega)


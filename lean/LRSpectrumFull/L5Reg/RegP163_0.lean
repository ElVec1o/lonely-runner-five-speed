/-- the lines clause for local classes 0..99 of rep #163. -/
theorem lines (t5 : List T5Rec) (h173 : ∀ p ∈ LinRQSC173.blobs, LinesCl t5 (t4OfRec p.1)) (h174 : ∀ p ∈ LinRQSC174.blobs, LinesCl t5 (t4OfRec p.1))

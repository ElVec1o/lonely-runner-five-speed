/-
# L5Reg.Reg1210 : the lines clause for every class of the local table of rep #1210 (generated by l5reg)

Every local class `i < nT` of rep #1210 (12 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1210T
import LRSpectrumFull.L5S4.LinRQSC935
import LRSpectrumFull.L5S4.LinRQSC956

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1210
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(935, LinRQSC935.blobs), (956, LinRQSC956.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(956, 45, [1, 0, 0, -3, 0, 1, -2, 1, 0]), (956, 46, [1, 1, -1, 1, -3, 0, 1, 2, -1]), (956, 47, [1, 1, -1, 1, -3, 2, -1, -2, 2]), (956, 48, [1, -2, 1, -3, -2, 4, -1, 1, 0]), (956, 49, [1, 2, -1, -3, 2, 0, 2, 1, -1]), (956, 50, [1, 0, -1, 0, -1, 0, -4, 1, 3]), (956, 51, [1, 1, -1, 0, -3, 1, -3, 2, 1]), (956, 52, [1, -1, 0, 2, 3, -4, 4, 0, -3]), (956, 53, [1, -1, 0, 0, 1, 0, -3, 1, 1]), (956, 54, [1, 0, 0, 2, -1, 0, 2, 0, -1]), (956, 55, [1, 1, -1, -3, 2, -1, 0, 4, -3]), (935, 144, [1, 1, -1, 0, -4, 3, -3, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1210.TT) N1210.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1210.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1210. -/
theorem lines (t5 : List T5Rec) (h935 : ∀ p ∈ LinRQSC935.blobs, LinesCl t5 (t4OfRec p.1)) (h956 : ∀ p ∈ LinRQSC956.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1210.nT).map (t4At (LRSpectrumFull.L5S4.dg N1210.TT) N1210.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h935 p hp
  · exact h956 p hp
)

#print axioms lines

end R1210
end L5Reg
end LRSpectrumFull

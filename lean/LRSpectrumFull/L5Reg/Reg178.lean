/-
# L5Reg.Reg178 : the lines clause for every class of the local table of rep #178 (generated by l5reg)

Every local class `i < nT` of rep #178 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O178T
import LRSpectrumFull.L5S4.LinRQSC112
import LRSpectrumFull.L5S4.LinRQSC194

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R178
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(112, LinRQSC112.blobs), (194, LinRQSC194.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(194, 2, [1, 0, 0, 0, -2, 1, -1, -1, 0]), (194, 3, [1, 0, 0, 0, -2, 1, -1, 1, 0]), (194, 4, [1, 0, 0, 0, 1, 3, 0, 1, 4]), (194, 5, [0, 1, -1, -3, 0, 1, 2, 0, -1]), (194, 6, [2, 0, -1, 0, -3, 1, -1, 1, 0]), (194, 7, [2, 0, -1, 0, -3, 2, 1, 1, -1]), (112, 178, [2, 0, -1, -1, -4, 3, 0, 3, -2]), (112, 174, [2, 0, -1, -1, 2, -1, 0, 3, -2]), (194, 8, [2, 0, -1, 0, -3, 2, -1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N178.TT) N178.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N178.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #178. -/
theorem lines (t5 : List T5Rec) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1)) (h194 : ∀ p ∈ LinRQSC194.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N178.nT).map (t4At (LRSpectrumFull.L5S4.dg N178.TT) N178.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h112 p hp
  · exact h194 p hp
)

#print axioms lines

end R178
end L5Reg
end LRSpectrumFull

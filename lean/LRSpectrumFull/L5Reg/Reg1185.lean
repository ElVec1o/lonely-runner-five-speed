/-- the lines clause for every class of the local table of rep #1185. -/
theorem lines (t5 : List T5Rec) (h933 : ∀ p ∈ LinRQSC933.blobs, LinesCl t5 (t4OfRec p.1)) (h934 : ∀ p ∈ LinRQSC934.blobs, LinesCl t5 (t4OfRec p.1)) (h936 : ∀ p ∈ LinRQSC936.blobs, LinesCl t5 (t4OfRec p.1)) (h937 : ∀ p ∈ LinRQSC937.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1185.nT).map (t4At (LRSpectrumFull.L5S4.dg N1185.TT) N1185.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h933 p hp
  · exact h934 p hp
  · exact h936 p hp
  · exact h937 p hp
)


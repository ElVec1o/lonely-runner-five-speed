/-- the lines clause for every class of the local table of rep #1904. -/
theorem lines (t5 : List T5Rec) (h883 : ∀ p ∈ LinRQSC883.blobs, LinesCl t5 (t4OfRec p.1)) (h884 : ∀ p ∈ LinRQSC884.blobs, LinesCl t5 (t4OfRec p.1)) (h1047 : ∀ p ∈ LinRQSC1047.blobs, LinesCl t5 (t4OfRec p.1)) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1)) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1)) (h1050 : ∀ p ∈ LinRQSC1050.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1904.nT).map (t4At (LRSpectrumFull.L5S4.dg N1904.TT) N1904.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h883 p hp
  · exact h884 p hp
  · exact h1047 p hp
  · exact h1048 p hp
  · exact h1049 p hp
  · exact h1050 p hp
)


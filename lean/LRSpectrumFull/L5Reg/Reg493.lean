/-- the lines clause for every class of the local table of rep #493. -/
theorem lines (t5 : List T5Rec) (h748 : ∀ p ∈ LinRQSC748.blobs, LinesCl t5 (t4OfRec p.1)) (h749 : ∀ p ∈ LinRQSC749.blobs, LinesCl t5 (t4OfRec p.1)) (h750 : ∀ p ∈ LinRQSC750.blobs, LinesCl t5 (t4OfRec p.1)) (h751 : ∀ p ∈ LinRQSC751.blobs, LinesCl t5 (t4OfRec p.1)) (h752 : ∀ p ∈ LinRQSC752.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N493.nT).map (t4At (LRSpectrumFull.L5S4.dg N493.TT) N493.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N493.nT := List.mem_range.1 hc
  have hn : N493.nT = 313 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 313) := by omega
  rcases hcase with h | h | h | h
  · exact P493_0.lines t5 h748 h749 c h.1 (by omega)
  · exact P493_1.lines t5 h749 h750 h751 c h.1 (by omega)
  · exact P493_2.lines t5 h751 h752 c h.1 (by omega)
  · exact P493_3.lines t5 h752 c h.1 (by omega)

#print axioms lines


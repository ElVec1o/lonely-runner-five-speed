theorem lines (t5 : List T5Rec) (h931 : ∀ p ∈ LinRQSC931.blobs, LinesCl t5 (t4OfRec p.1)) (h934 : ∀ p ∈ LinRQSC934.blobs, LinesCl t5 (t4OfRec p.1)) (h966 : ∀ p ∈ LinRQSC966.blobs, LinesCl t5 (t4OfRec p.1)) (h967 : ∀ p ∈ LinRQSC967.blobs, LinesCl t5 (t4OfRec p.1))

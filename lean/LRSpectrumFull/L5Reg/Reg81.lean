/-- the lines clause for every class of the local table of rep #81. -/
theorem lines (t5 : List T5Rec) (h79 : ∀ p ∈ LinRQSC79.blobs, LinesCl t5 (t4OfRec p.1)) (h80 : ∀ p ∈ LinRQSC80.blobs, LinesCl t5 (t4OfRec p.1)) (h81 : ∀ p ∈ LinRQSC81.blobs, LinesCl t5 (t4OfRec p.1)) (h82 : ∀ p ∈ LinRQSC82.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N81.nT).map (t4At (LRSpectrumFull.L5S4.dg N81.TT) N81.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N81.nT := List.mem_range.1 hc
  have hn : N81.nT = 365 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 365) := by omega
  rcases hcase with h | h | h | h
  · exact P81_0.lines t5 h79 h80 c h.1 (by omega)
  · exact P81_1.lines t5 h80 h81 c h.1 (by omega)
  · exact P81_2.lines t5 h81 h82 c h.1 (by omega)
  · exact P81_3.lines t5 h82 c h.1 (by omega)

#print axioms lines


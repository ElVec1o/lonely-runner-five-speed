/-- the lines clause for local classes 200..299 of rep #264. -/
theorem lines (t5 : List T5Rec) (h228 : ∀ p ∈ LinRQSC228.blobs, LinesCl t5 (t4OfRec p.1)) (h229 : ∀ p ∈ LinRQSC229.blobs, LinesCl t5 (t4OfRec p.1)) (h230 : ∀ p ∈ LinRQSC230.blobs, LinesCl t5 (t4OfRec p.1)) (h231 : ∀ p ∈ LinRQSC231.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N264.TT) N264.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h228 p hpe
    · exact h229 p hpe
    · exact h230 p hpe
    · exact h231 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


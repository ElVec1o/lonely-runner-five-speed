/-
# L5Reg.Reg1855 : the lines clause for every class of the local table of rep #1855 (generated by l5reg)

Every local class `i < nT` of rep #1855 (13 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1855T
import LRSpectrumFull.L5S4.LinRQSC1048

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1855
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1048, LinRQSC1048.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1048, 153, [1, -1, -1, 3, -2, -1, -2, 1, 1]), (1048, 154, [2, -1, 0, -1, -3, 3, 2, 0, -1]), (1048, 155, [2, -1, 0, -1, 0, 0, -2, -1, 1]), (1048, 156, [2, -2, 1, -1, 0, 0, -1, -3, 2]), (1048, 157, [2, -2, -1, -1, 0, 1, -1, -3, 2]), (1048, 158, [2, 1, -1, -1, 3, -2, 3, 1, -1]), (1048, 159, [1, 2, -1, 3, -1, -1, 0, 3, -1]), (1048, 160, [1, 1, -1, 0, 3, -2, 1, -1, 0]), (1048, 161, [2, -2, 1, 0, 1, -1, 3, 2, -3]), (1048, 162, [1, 0, 0, 3, -1, 0, 0, -1, 1]), (1048, 163, [2, 2, -3, 0, -1, 1, 3, -1, -1]), (1048, 164, [2, -1, 0, 0, -1, 1, 3, 1, -2]), (1048, 165, [2, -1, 0, 0, -1, 1, 3, 1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1855.TT) N1855.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1855.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1855. -/
theorem lines (t5 : List T5Rec) (h1048 : ∀ p ∈ LinRQSC1048.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1855.nT).map (t4At (LRSpectrumFull.L5S4.dg N1855.TT) N1855.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1048 p hp
)

#print axioms lines

end R1855
end L5Reg
end LRSpectrumFull

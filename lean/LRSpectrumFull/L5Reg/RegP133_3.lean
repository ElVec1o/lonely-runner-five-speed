/-- the lines clause for local classes 300..340 of rep #133. -/
theorem lines (t5 : List T5Rec) (h117 : ∀ p ∈ LinRQSC117.blobs, LinesCl t5 (t4OfRec p.1)) (h118 : ∀ p ∈ LinRQSC118.blobs, LinesCl t5 (t4OfRec p.1))

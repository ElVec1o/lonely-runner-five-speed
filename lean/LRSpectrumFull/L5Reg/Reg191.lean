/-- the lines clause for every class of the local table of rep #191. -/
theorem lines (t5 : List T5Rec) (h34 : ∀ p ∈ LinRQSC34.blobs, LinesCl t5 (t4OfRec p.1)) (h63 : ∀ p ∈ LinRQSC63.blobs, LinesCl t5 (t4OfRec p.1)) (h64 : ∀ p ∈ LinRQSC64.blobs, LinesCl t5 (t4OfRec p.1)) (h148 : ∀ p ∈ LinRQSC148.blobs, LinesCl t5 (t4OfRec p.1)) (h150 : ∀ p ∈ LinRQSC150.blobs, LinesCl t5 (t4OfRec p.1)) (h198 : ∀ p ∈ LinRQSC198.blobs, LinesCl t5 (t4OfRec p.1)) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N191.nT).map (t4At (LRSpectrumFull.L5S4.dg N191.TT) N191.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h34 p hp
  · exact h63 p hp
  · exact h64 p hp
  · exact h148 p hp
  · exact h150 p hp
  · exact h198 p hp
  · exact h199 p hp
)


/-
# L5Reg.Reg605 : the lines clause for every class of the local table of rep #605 (generated by l5reg)

Every local class `i < nT` of rep #605 (42 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O605T
import LRSpectrumFull.L5S4.LinRQSC680
import LRSpectrumFull.L5S4.LinRQSC722
import LRSpectrumFull.L5S4.LinRQSC840

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R605
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(680, LinRQSC680.blobs), (722, LinRQSC722.blobs), (840, LinRQSC840.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(840, 11, [1, 0, -1, 0, 2, -1, -3, -1, 3]), (840, 12, [1, 1, -1, 1, -1, 0, 3, -2, -1]), (840, 13, [1, 0, -1, 0, -1, 0, -4, 0, 3]), (680, 55, [1, 0, -1, -3, -1, 3, 0, 2, -1]), (840, 14, [1, 0, 0, 0, 4, 1, -4, 1, 0]), (840, 15, [1, 0, -1, 0, 1, -1, -4, 0, 3]), (840, 16, [1, -1, 0, 0, -1, 0, -4, -2, 1]), (840, 17, [1, -1, 0, 0, 1, 0, -4, -2, 1]), (840, 18, [1, 0, -1, 0, 2, -1, -4, -1, 4]), (840, 19, [1, 1, -1, 1, 0, -1, 3, -2, -2]), (840, 20, [1, -1, 0, 1, 0, -1, 4, 2, -5]), (840, 21, [1, 0, -1, 0, 1, -1, -4, 0, 3]), (840, 22, [1, 0, -1, 0, 2, -1, -3, -1, 3]), (840, 23, [1, 0, 0, 0, -1, 4, -4, 0, -1]), (840, 24, [1, -1, 0, 0, -1, 0, -4, -3, 1]), (840, 25, [1, 1, -1, 0, 1, -1, -3, 1, 0]), (840, 26, [1, -1, 0, 1, 0, 0, 4, -1, -1]), (840, 27, [1, 0, -1, 1, -2, 0, 4, 1, -4]), (840, 28, [1, 0, 0, 1, -1, 4, 4, 0, 1]), (840, 29, [1, -1, 0, 0, -1, 1, -3, -2, 4]), (840, 30, [1, 0, 0, 1, -1, 0, 4, -3, -1]), (840, 31, [1, -1, 0, 1, 0, -1, 4, 2, -5]), (840, 32, [1, 0, -1, 1, 2, -2, 3, -1, -2]), (840, 33, [1, 0, 0, 1, -4, 3, 3, 3, -2]), (840, 34, [1, 0, -1, 1, 1, -1, 4, 0, -3]), (840, 35, [1, 0, 0, 1, 4, -1, 3, -3, 1]), (840, 36, [1, 0, 0, 1, 4, 1, 4, -1, 0]), (840, 37, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (840, 38, [0, 1, 0, -2, 1, 1, 1, 3, -1]), (840, 39, [1, 0, 0, 1, 4, -1, 3, -3, 1]), (840, 40, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (840, 41, [1, 0, -1, 1, -2, 0, 3, 1, -3]), (840, 42, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (840, 43, [1, -1, 1, 1, 0, 0, 4, -1, 0]), (840, 44, [1, 1, -1, 1, 0, -1, 4, -2, -3]), (840, 45, [0, 1, 0, -1, 1, 0, 0, 3, -1]), (722, 22, [0, 0, -1, 0, -1, -2, 1, 0, 1]), (840, 46, [1, 0, 0, 1, -4, 1, 4, 1, 0]), (840, 47, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (840, 48, [0, 1, 0, -1, -1, 1, 1, -1, 0]), (840, 49, [0, 1, 0, -1, 0, 1, 0, 0, 1]), (840, 50, [0, 1, 0, -2, 0, 1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N605.TT) N605.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N605.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #605. -/
theorem lines (t5 : List T5Rec) (h680 : ∀ p ∈ LinRQSC680.blobs, LinesCl t5 (t4OfRec p.1)) (h722 : ∀ p ∈ LinRQSC722.blobs, LinesCl t5 (t4OfRec p.1)) (h840 : ∀ p ∈ LinRQSC840.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N605.nT).map (t4At (LRSpectrumFull.L5S4.dg N605.TT) N605.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h680 p hp
  · exact h722 p hp
  · exact h840 p hp
)

#print axioms lines

end R605
end L5Reg
end LRSpectrumFull

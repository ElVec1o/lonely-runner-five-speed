/-
# L5Reg.Reg879 : the lines clause for every class of the local table of rep #879 (generated by l5reg)

Every local class `i < nT` of rep #879 (30 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O879T
import LRSpectrumFull.L5S4.LinRQSC877
import LRSpectrumFull.L5S4.LinRQSC878
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R879
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(877, LinRQSC877.blobs), (878, LinRQSC878.blobs), (881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 87, [0, -3, 1, 3, -1, 0, -1, 0, 0]), (881, 88, [0, -3, 2, 3, -1, 0, -2, 2, -1]), (881, 89, [0, -3, 2, 3, -1, -1, 1, 2, -2]), (878, 66, [3, 1, -3, -1, 0, 1, -1, 3, 0]), (877, 177, [3, -1, -2, 1, 0, -1, -1, 3, -1]), (881, 90, [1, 0, 0, 1, 3, -2, 3, 1, -1]), (881, 70, [3, -1, 0, -1, 0, 0, 1, 3, -1]), (878, 3, [1, 3, -3, 0, 1, -1, -3, -1, 2]), (881, 91, [0, 0, 1, 3, -2, 1, 1, -1, 3]), (881, 65, [0, 1, -3, 0, 0, 1, -1, 0, -1]), (878, 56, [0, 0, -1, 0, -1, 0, 1, 0, -1]), (881, 92, [0, 0, -1, 3, -1, -2, -1, 0, 1]), (881, 93, [0, 0, -1, 3, -2, 0, -2, 1, 0]), (881, 94, [0, 0, -1, 3, -2, 1, 1, -1, 1]), (881, 95, [0, -1, 0, 3, -1, -1, 1, -3, 0]), (878, 140, [0, -3, 1, 0, 1, 0, 1, -1, 0]), (881, 96, [0, 1, 0, 2, -2, -1, 1, 3, -1]), (881, 97, [0, -1, 0, 3, -1, -2, -1, -3, 1]), (881, 98, [0, -1, 0, 3, -1, -1, 1, -3, 0]), (881, 99, [0, -1, 0, 1, -1, 0, 0, 0, -1]), (881, 100, [0, -1, 0, 1, 2, -1, 3, -1, -2]), (881, 101, [0, -3, 1, 3, -1, 0, 1, 3, -1]), (881, 102, [0, 0, 1, 1, 0, -2, 3, -1, 1]), (881, 103, [0, 0, -1, 3, -2, 1, 1, -1, 1]), (881, 104, [0, 1, -1, 1, 1, -1, 0, 2, -1]), (881, 105, [0, 1, -1, 3, 1, -2, 1, 2, -2]), (877, 167, [0, -1, 1, 0, 0, 1, 1, 0, -1]), (881, 106, [0, 0, -1, 0, -1, 0, 1, -1, 0]), (881, 107, [0, -3, 2, 3, -1, 0, 1, 1, -1]), (881, 108, [0, 0, -1, 0, -1, 0, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N879.TT) N879.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N879.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #879. -/
theorem lines (t5 : List T5Rec) (h877 : ∀ p ∈ LinRQSC877.blobs, LinesCl t5 (t4OfRec p.1)) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N879.nT).map (t4At (LRSpectrumFull.L5S4.dg N879.TT) N879.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h877 p hp
  · exact h878 p hp
  · exact h881 p hp
)

#print axioms lines

end R879
end L5Reg
end LRSpectrumFull

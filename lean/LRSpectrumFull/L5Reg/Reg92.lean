/-
# L5Reg.Reg92 : the lines clause for every class of the local table of rep #92 (generated by l5reg)

Every local class `i < nT` of rep #92 (42 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O92T
import LRSpectrumFull.L5S4.LinRQSC37
import LRSpectrumFull.L5S4.LinRQSC95
import LRSpectrumFull.L5S4.LinRQSC96

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R92
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(37, LinRQSC37.blobs), (95, LinRQSC95.blobs), (96, LinRQSC96.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(95, 125, [0, 2, -1, 0, -1, 0, -1, -1, 0]), (95, 126, [0, 0, -1, 0, -1, 1, -1, 0, 0]), (95, 127, [0, -2, 1, 0, 1, 0, -1, 0, -1]), (95, 128, [0, -2, 1, 0, 1, 0, -1, 0, 0]), (95, 129, [0, 0, -1, 0, -1, 1, -1, 0, 0]), (37, 189, [0, 1, 0, 0, 0, 1, 1, -1, 0]), (95, 130, [0, -2, 1, 0, 1, 0, -1, -1, 1]), (95, 131, [0, -2, 1, -4, 1, 3, -3, -1, 3]), (95, 132, [0, 0, -1, 0, -1, 1, -1, 0, 0]), (95, 133, [0, -2, 1, -1, 1, 0, 0, -1, 1]), (95, 134, [0, -2, 1, -4, 1, 1, -3, 0, 1]), (95, 135, [0, -2, 1, -4, 1, 1, -3, 0, 1]), (95, 136, [0, 0, -1, 0, -1, 1, -1, 0, 0]), (95, 137, [0, -1, 1, -1, 1, 0, 0, -1, 0]), (95, 138, [0, 2, -1, -4, -1, 2, -1, 1, 0]), (95, 139, [0, 0, 1, -4, 1, -1, 3, -1, 1]), (95, 140, [0, -2, 1, -4, 1, 2, -3, -2, 3]), (95, 141, [2, 0, -1, -1, 4, -3, 2, -1, 0]), (95, 142, [0, 2, -1, -4, -1, 2, 3, 0, -1]), (95, 143, [2, 0, -1, -1, 4, -1, 2, 3, -2]), (95, 144, [2, 0, -1, -1, -4, 4, 0, -1, 1]), (95, 145, [2, 0, -1, -1, 2, 0, 2, 1, -1]), (95, 146, [2, -1, 0, -1, 1, -2, 2, -1, 1]), (95, 147, [0, 2, -1, -4, -1, 4, 3, 1, -3]), (37, 186, [0, 0, 1, 0, -1, 0, 1, 0, 0]), (95, 148, [2, 0, -1, -1, 4, -3, 1, 3, -3]), (95, 149, [2, 0, -1, -1, -4, 3, 1, 1, -1]), (95, 150, [2, 0, -1, -1, -2, 1, 2, -1, -1]), (95, 151, [2, 0, -1, -1, -2, 1, 2, 1, -1]), (95, 152, [2, 0, -1, -1, 4, -3, 2, -1, 0]), (95, 153, [2, 0, -1, -1, 1, -1, 2, 1, -2]), (96, 0, [2, 0, -1, -1, 0, 0, 2, 1, -1]), (96, 1, [2, 0, -1, -1, -4, 4, 2, -1, 0]), (96, 2, [2, 0, -1, -1, 4, -2, 2, 3, -3]), (96, 3, [2, 1, -2, -1, 0, 1, 2, -3, -1]), (96, 4, [2, 0, -1, -1, -4, 4, 2, -1, 0]), (96, 5, [2, 0, -1, -1, -2, 1, 2, -1, -1]), (96, 6, [2, 0, -1, -1, 0, 0, 1, 1, -1]), (96, 7, [2, 1, -1, -1, 0, 0, 2, -3, 2]), (96, 8, [2, 1, -2, -1, 0, 1, 2, -4, -1]), (96, 9, [2, 1, -1, -1, 0, 0, 1, -4, 3]), (96, 10, [2, 1, -1, -1, 0, 0, 1, -4, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N92.TT) N92.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N92.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #92. -/
theorem lines (t5 : List T5Rec) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1)) (h95 : ∀ p ∈ LinRQSC95.blobs, LinesCl t5 (t4OfRec p.1)) (h96 : ∀ p ∈ LinRQSC96.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N92.nT).map (t4At (LRSpectrumFull.L5S4.dg N92.TT) N92.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h37 p hp
  · exact h95 p hp
  · exact h96 p hp
)

#print axioms lines

end R92
end L5Reg
end LRSpectrumFull

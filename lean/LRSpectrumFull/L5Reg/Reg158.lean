theorem lines (t5 : List T5Rec) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1)) (h38 : ∀ p ∈ LinRQSC38.blobs, LinesCl t5 (t4OfRec p.1)) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1)) (h113 : ∀ p ∈ LinRQSC113.blobs, LinesCl t5 (t4OfRec p.1)) (h114 : ∀ p ∈ LinRQSC114.blobs, LinesCl t5 (t4OfRec p.1)) (h144 : ∀ p ∈ LinRQSC144.blobs, LinesCl t5 (t4OfRec p.1)) (h162 : ∀ p ∈ LinRQSC162.blobs, LinesCl t5 (t4OfRec p.1)) (h163 : ∀ p ∈ LinRQSC163.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N158.nT).map (t4At (LRSpectrumFull.L5S4.dg N158.TT) N158.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h32 p hp
  · exact h38 p hp
  · exact h112 p hp
  · exact h113 p hp
  · exact h114 p hp
  · exact h144 p hp
  · exact h162 p hp
  · exact h163 p hp
)


/-- the lines clause for every class of the local table of rep #1734. -/
theorem lines (t5 : List T5Rec) (h1045 : ∀ p ∈ LinRQSC1045.blobs, LinesCl t5 (t4OfRec p.1)) (h1046 : ∀ p ∈ LinRQSC1046.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1734.nT).map (t4At (LRSpectrumFull.L5S4.dg N1734.TT) N1734.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1045 p hp
  · exact h1046 p hp
)


/-
# L5Reg.Reg1511 : the lines clause for every class of the local table of rep #1511 (generated by l5reg)

Every local class `i < nT` of rep #1511 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1511T
import LRSpectrumFull.L5S4.LinRQSC1025
import LRSpectrumFull.L5S4.LinRQSC1026

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1511
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1025, LinRQSC1025.blobs), (1026, LinRQSC1026.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1026, 140, [2, 0, -1, -1, -3, 1, 3, -2, -1]), (1026, 141, [0, 1, 0, 3, -2, -1, 2, 0, -1]), (1025, 203, [1, 2, -1, 2, -1, -1, 0, 1, 0]), (1026, 142, [0, -2, 1, 3, 1, -3, -2, 1, 1]), (1025, 345, [2, 2, -3, -3, 0, 2, 0, 1, -1]), (1025, 225, [1, 2, -1, 2, -2, -1, 0, 1, 0]), (1026, 143, [0, 2, -1, 3, -1, 0, -2, -3, 2]), (1026, 144, [0, -2, 1, 3, 1, -1, -1, 2, -1]), (1026, 145, [0, -2, 1, 3, 1, -3, 1, 2, -2]), (1026, 146, [0, -1, 0, 3, -1, -1, -1, 2, 0]), (1025, 323, [0, 2, -1, 1, 0, 0, 3, 1, -1]), (1026, 147, [0, 1, -1, 3, -2, 0, -2, 0, 1]), (1025, 137, [2, -1, -1, 3, 1, -3, -1, 0, 1]), (1025, 184, [1, 2, -1, 3, 1, -1, 0, 2, -1]), (1026, 148, [0, 1, -1, 3, 0, -1, 1, 3, -3]), (1026, 149, [0, -1, 0, 3, -1, -2, 1, 0, -1]), (1026, 150, [0, -2, 1, 3, 1, -1, 1, 0, 0]), (1026, 151, [0, -2, 1, 3, 1, -3, 1, 0, -1]), (1026, 152, [0, -1, 0, 3, -1, -1, 2, -1, -1]), (1025, 320, [1, 0, 0, 0, 1, 0, -3, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1511.TT) N1511.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1511.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1511. -/
theorem lines (t5 : List T5Rec) (h1025 : ∀ p ∈ LinRQSC1025.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1511.nT).map (t4At (LRSpectrumFull.L5S4.dg N1511.TT) N1511.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1025 p hp
  · exact h1026 p hp
)

#print axioms lines

end R1511
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg783 : the lines clause for every class of the local table of rep #783 (generated by l5reg)

Every local class `i < nT` of rep #783 (38 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O783T
import LRSpectrumFull.L5S4.LinRQSC872

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R783
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(872, LinRQSC872.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(872, 100, [0, 2, -1, 0, -1, 0, -1, -1, 1]), (872, 101, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (872, 102, [2, 0, -1, -1, 0, 1, -1, 1, 0]), (872, 103, [1, 0, -1, 1, -1, -1, -2, 1, 1]), (872, 104, [2, 0, -1, -1, 0, 1, -1, 1, 0]), (872, 105, [2, 0, -1, -1, 0, 1, 0, 1, -1]), (872, 106, [1, 2, -2, 1, -1, 0, -2, 0, 1]), (872, 107, [2, 0, -1, -1, 0, 1, -1, 1, 0]), (872, 108, [2, 0, -1, -1, 0, 1, 0, 1, -1]), (872, 109, [1, -1, 0, 1, -1, -1, -3, 2, 2]), (872, 110, [1, -1, 1, 1, -1, 0, -2, 1, 0]), (872, 111, [2, -1, 0, -1, 1, 0, 1, -1, 1]), (872, 112, [0, -1, 0, 0, -1, 1, -1, 0, 0]), (872, 113, [0, -2, 1, 0, 1, 0, -1, -1, 1]), (872, 114, [1, 0, 0, 1, -1, 1, -3, 2, -1]), (872, 115, [2, 1, -1, -1, 1, 0, 0, -2, 1]), (872, 116, [1, 0, 0, 1, -1, 1, -3, 2, -1]), (872, 117, [1, 2, -2, 1, -1, 0, -2, 1, 1]), (872, 118, [2, 1, -1, -1, 1, 0, 0, -2, 1]), (872, 119, [1, -2, 0, 1, 1, -1, -2, 0, 1]), (872, 120, [2, -1, 0, -1, 0, 0, 1, 0, 1]), (872, 121, [2, 1, -1, -1, 1, 1, 0, -1, 0]), (872, 122, [1, -1, 0, 1, 0, -1, -3, 1, 1]), (872, 123, [2, -1, 0, -1, -1, 1, 1, 2, -2]), (872, 124, [2, -1, 0, -1, 1, -1, 1, -1, 0]), (872, 125, [2, -1, -1, -1, -1, 1, 1, 2, -1]), (872, 126, [2, -1, -1, -1, -1, 1, 0, 2, -1]), (872, 127, [1, -2, 0, 1, 1, -1, -3, -1, 2]), (872, 128, [2, -1, 0, -1, 0, 0, 2, 0, -1]), (872, 129, [2, 0, -1, -1, -2, 2, 2, -1, 0]), (872, 130, [2, -1, 0, -1, -1, 1, 1, 2, -2]), (872, 131, [2, 1, -2, -1, 1, 0, 2, -1, -1]), (872, 132, [2, 0, -1, -1, -1, 1, 0, -1, 1]), (872, 133, [2, -1, -1, -1, 1, 0, 1, -1, -1]), (872, 134, [2, 0, -1, -1, -2, 1, 1, -1, 0]), (872, 135, [2, 0, -1, -1, -2, 2, 2, -1, 0]), (872, 136, [2, -1, 0, -1, 0, 0, 1, -1, 1]), (872, 137, [2, 1, -2, -1, 1, 0, 2, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N783.TT) N783.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N783.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #783. -/
theorem lines (t5 : List T5Rec) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N783.nT).map (t4At (LRSpectrumFull.L5S4.dg N783.TT) N783.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h872 p hp
)

#print axioms lines


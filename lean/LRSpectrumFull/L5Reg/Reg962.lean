/-
# L5Reg.Reg962 : the lines clause for every class of the local table of rep #962 (generated by l5reg)

Every local class `i < nT` of rep #962 (43 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O962T
import LRSpectrumFull.L5S4.LinRQSC891
import LRSpectrumFull.L5S4.LinRQSC892

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R962
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(891, LinRQSC891.blobs), (892, LinRQSC892.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(891, 102, [2, -1, -1, -3, -1, 2, 2, 0, -1]), (891, 103, [2, -1, 0, -3, -1, 2, 0, -1, 1]), (891, 104, [2, -2, -1, -3, -2, 3, 1, 1, -1]), (891, 105, [2, -1, 0, -3, 1, 0, 0, 0, 1]), (891, 106, [2, -1, 0, -3, -1, 1, 1, 0, 0]), (891, 107, [2, -2, 1, -3, -2, 3, 0, -1, 1]), (891, 108, [2, -2, 1, -3, -2, 2, 0, -3, 2]), (891, 109, [2, -2, -1, -3, -2, 3, -1, -1, 1]), (891, 110, [2, -2, -1, -3, -2, 2, 0, -1, 0]), (891, 111, [2, -1, 0, -3, -1, 2, 2, 0, -1]), (891, 112, [2, -1, -1, -3, -1, 2, 0, -1, 0]), (891, 113, [2, -2, 1, -3, -2, 3, 2, -1, 0]), (891, 114, [2, -1, 0, -3, -1, 1, 1, -1, 0]), (891, 115, [2, -1, -1, -3, -1, 2, 0, 1, 0]), (891, 116, [2, -2, -1, -3, 2, 2, -1, 1, 1]), (891, 117, [2, -1, 0, -3, -1, 2, -2, 0, 1]), (891, 118, [2, -2, 1, -3, -2, 2, 1, 1, -1]), (891, 119, [2, -1, 0, -3, 1, 0, 0, 0, -1]), (891, 120, [2, -2, -1, -3, -2, 3, 0, 3, -1]), (891, 121, [2, -1, 0, -3, -1, 2, 0, 1, -1]), (891, 122, [2, -1, -1, -3, -1, 2, -2, 0, 1]), (891, 123, [2, 0, -1, -3, 0, 1, 0, -1, 0]), (891, 124, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (891, 125, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (891, 126, [2, 0, -1, -3, 0, 1, 0, -1, 0]), (891, 127, [2, 0, -1, -3, 0, 1, 0, -1, 1]), (891, 128, [2, 0, -1, -3, 0, 1, -2, -1, 1]), (892, 0, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (892, 1, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (892, 2, [2, -2, 1, -3, 2, -1, -1, 1, -1]), (892, 3, [2, -2, 1, -3, -2, 3, 0, 1, -1]), (892, 4, [2, -2, 1, -3, -2, 2, 1, 1, -1]), (892, 5, [2, -2, -1, -3, -2, 3, -1, -1, 1]), (892, 6, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (892, 7, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (892, 8, [2, 0, -1, -3, 0, 1, 0, -1, 0]), (892, 9, [2, 0, -1, -3, 0, 1, 0, -1, 1]), (892, 10, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (892, 11, [2, 0, -1, -3, 0, 1, -2, -1, 1]), (892, 12, [2, 0, -1, -3, 0, 1, 0, -1, 1]), (892, 13, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (892, 14, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (892, 15, [2, 0, -1, -3, 0, 1, 0, 1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N962.TT) N962.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N962.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #962. -/
theorem lines (t5 : List T5Rec) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1)) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N962.nT).map (t4At (LRSpectrumFull.L5S4.dg N962.TT) N962.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h891 p hp
  · exact h892 p hp
)

#print axioms lines

end R962

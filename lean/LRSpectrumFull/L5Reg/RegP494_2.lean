/-- the lines clause for local classes 200..299 of rep #494. -/
theorem lines (t5 : List T5Rec) (h754 : ∀ p ∈ LinRQSC754.blobs, LinesCl t5 (t4OfRec p.1)) (h755 : ∀ p ∈ LinRQSC755.blobs, LinesCl t5 (t4OfRec p.1))

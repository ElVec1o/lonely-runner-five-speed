/-
# L5Reg.Reg829 : the lines clause for every class of the local table of rep #829 (generated by l5reg)

Every local class `i < nT` of rep #829 (28 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O829T
import LRSpectrumFull.L5S4.LinRQSC876

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R829
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(876, LinRQSC876.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(876, 203, [1, 0, 0, 0, 2, -1, 2, 1, -1]), (876, 204, [1, 0, -1, 0, -2, 1, -2, 1, 1]), (876, 205, [1, 0, -1, 1, 1, -1, -3, 0, 2]), (876, 206, [2, -1, -1, 0, -1, 0, -1, 1, 0]), (876, 207, [1, -2, 0, 1, 0, -1, 2, 1, -2]), (876, 208, [1, 2, -1, 1, 0, 0, 2, -1, 1]), (876, 209, [1, -1, 0, 0, -1, 0, -1, -2, 1]), (876, 210, [1, 0, 0, 1, -1, 0, 2, 1, -1]), (876, 211, [2, -1, 1, 0, 0, 1, -1, 1, 2]), (876, 212, [1, 0, 0, 1, -1, 2, 2, 0, 1]), (876, 213, [1, 0, 0, 1, -2, 1, 2, 1, 0]), (876, 214, [1, 0, 0, 0, -2, 1, -2, -1, 0]), (876, 215, [1, 0, 0, 0, -2, 1, -2, -1, 1]), (876, 216, [1, -1, 0, 0, -1, 1, -1, -2, 2]), (876, 217, [2, 1, -1, 0, 1, 0, -1, 2, 0]), (876, 218, [1, 1, -1, 1, 0, -1, 2, -1, -1]), (876, 219, [2, -1, 0, 0, 0, 1, -1, 1, -1]), (876, 220, [2, 0, -1, 0, 1, 0, -1, 0, 1]), (876, 221, [0, 1, -1, -2, 0, 1, 1, 0, 0]), (876, 222, [0, -1, -1, -2, 1, 0, 1, 0, 1]), (876, 223, [0, 1, 0, -2, 0, 1, 1, 0, 0]), (876, 224, [0, 1, 0, -2, 1, 1, 1, 1, -1]), (876, 225, [0, 0, -1, -2, 1, -1, 3, -2, 0]), (876, 226, [0, 1, 0, -2, 1, 1, 3, 0, -2]), (876, 227, [0, 0, -1, -2, 1, 0, 3, -2, 0]), (876, 228, [0, 1, 0, -2, 0, 1, 3, 0, -1]), (876, 229, [0, 0, -1, -2, 1, -1, 3, -2, 0]), (876, 230, [0, 0, 1, 2, -1, 0, 3, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N829.TT) N829.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N829.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #829. -/
theorem lines (t5 : List T5Rec) (h876 : ∀ p ∈ LinRQSC876.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N829.nT).map (t4At (LRSpectrumFull.L5S4.dg N829.TT) N829.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h876 p hp
)

#print axioms lines

end R829
end L5Reg
end LRSpectrumFull

theorem adv_len : adv.length = N140.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #140. -/
theorem lines (t5 : List T5Rec) (h84 : ∀ p ∈ LinRQSC84.blobs, LinesCl t5 (t4OfRec p.1)) (h112 : ∀ p ∈ LinRQSC112.blobs, LinesCl t5 (t4OfRec p.1)) (h114 : ∀ p ∈ LinRQSC114.blobs, LinesCl t5 (t4OfRec p.1)) (h130 : ∀ p ∈ LinRQSC130.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N140.nT).map (t4At (LRSpectrumFull.L5S4.dg N140.TT) N140.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h84 p hp
  · exact h112 p hp
  · exact h114 p hp
  · exact h130 p hp
)


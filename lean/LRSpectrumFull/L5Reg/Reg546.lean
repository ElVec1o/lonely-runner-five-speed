/-- the lines clause for every class of the local table of rep #546. -/
theorem lines (t5 : List T5Rec) (h733 : ∀ p ∈ LinRQSC733.blobs, LinesCl t5 (t4OfRec p.1)) (h734 : ∀ p ∈ LinRQSC734.blobs, LinesCl t5 (t4OfRec p.1)) (h800 : ∀ p ∈ LinRQSC800.blobs, LinesCl t5 (t4OfRec p.1)) (h801 : ∀ p ∈ LinRQSC801.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N546.nT).map (t4At (LRSpectrumFull.L5S4.dg N546.TT) N546.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h733 p hp
  · exact h734 p hp
  · exact h800 p hp
  · exact h801 p hp
)


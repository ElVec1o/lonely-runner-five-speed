theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N997.TT) N997.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N997.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #997. -/
theorem lines (t5 : List T5Rec) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1)) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1)) (h903 : ∀ p ∈ LinRQSC903.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N997.nT).map (t4At (LRSpectrumFull.L5S4.dg N997.TT) N997.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h901 p hp
  · exact h902 p hp
  · exact h903 p hp
)

#print axioms lines


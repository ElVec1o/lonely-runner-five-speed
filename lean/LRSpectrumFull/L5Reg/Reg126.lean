/-
# L5Reg.Reg126 : the lines clause for every class of the local table of rep #126 (generated by l5reg)

Every local class `i < nT` of rep #126 (41 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O126T
import LRSpectrumFull.L5S4.LinRQSC114
import LRSpectrumFull.L5S4.LinRQSC115

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R126
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(114, LinRQSC114.blobs), (115, LinRQSC115.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(114, 198, [2, 0, -1, -1, -3, 3, 0, 1, -1]), (114, 199, [2, 0, -1, -1, -1, 1, -1, 0, 0]), (114, 200, [2, -1, -1, -1, -1, 1, -1, 0, 1]), (114, 201, [2, 0, -1, -1, -3, 3, -1, 2, -1]), (114, 202, [2, 1, -1, -1, 1, 0, -2, 3, 0]), (114, 203, [2, -1, 0, -1, 1, 0, -2, 1, 1]), (114, 204, [2, -1, -1, -1, 1, 0, 1, -2, 0]), (114, 205, [2, 1, -2, -1, 1, 0, 2, -4, 1]), (115, 0, [2, 1, -1, -1, 1, 0, 2, -4, 1]), (115, 1, [2, -1, 0, -1, -1, 1, 2, -2, 1]), (115, 2, [2, -1, 0, -1, 1, -3, 1, 0, -2]), (115, 3, [2, -1, -1, -1, -1, 0, 2, -2, -1]), (115, 4, [2, 0, -1, -1, -1, -1, 1, 0, 0]), (115, 5, [2, 0, -1, -1, -3, 1, 2, 1, -1]), (115, 6, [2, -1, -1, -1, 0, 1, 2, -1, -2]), (115, 7, [2, 0, -1, -1, 1, 0, 2, 1, -2]), (115, 8, [2, 0, -1, -1, -3, 1, 1, -2, 0]), (115, 9, [2, -1, -1, -1, 0, 1, 1, 0, -2]), (115, 10, [2, 0, -1, -1, 1, 0, 1, 0, -1]), (115, 11, [2, 0, -1, -1, 3, 0, 2, 1, -1]), (115, 12, [2, 0, -1, -1, 3, 0, 2, 1, -1]), (115, 13, [2, 0, -1, -1, 1, 0, 0, 1, 0]), (115, 14, [2, -1, -1, -1, 0, 1, 0, 0, 1]), (115, 15, [2, -1, 0, -1, 0, 0, 0, 2, -1]), (115, 16, [2, 0, -1, -1, -1, 1, 1, 4, -3]), (115, 17, [2, -1, -1, -1, 1, 0, 0, 2, -1]), (115, 18, [2, 0, -1, -1, -1, 1, 1, 0, 0]), (115, 19, [2, -1, 0, -1, 1, 3, 1, 0, 4]), (115, 20, [0, -2, 1, -3, 1, 0, -4, -1, 1]), (115, 21, [2, 0, -1, -1, 3, 0, 2, 1, -1]), (115, 22, [0, 0, -1, -3, 1, 2, -2, 1, 0]), (115, 23, [0, -1, 0, -3, 2, 2, -4, 2, 3]), (115, 24, [2, 0, -1, -1, 3, 0, 1, 4, -1]), (115, 25, [2, -1, -1, -1, 2, 1, 0, 2, 1]), (115, 26, [2, 0, -1, -1, -3, 3, 1, -4, 3]), (115, 27, [0, 1, -1, -3, 1, 1, -4, 2, 1]), (115, 28, [0, 2, -1, -3, -1, 3, -4, -1, 4]), (115, 29, [0, 0, 1, -3, 2, 1, 4, -3, -2]), (115, 30, [0, 0, 1, -3, 1, 1, -2, 1, 1]), (115, 31, [0, 0, 1, -3, 1, 1, 2, -1, -1]), (115, 32, [0, 0, 1, -3, 1, -1, -2, 1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N126.TT) N126.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N126.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #126. -/
theorem lines (t5 : List T5Rec) (h114 : ∀ p ∈ LinRQSC114.blobs, LinesCl t5 (t4OfRec p.1)) (h115 : ∀ p ∈ LinRQSC115.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N126.nT).map (t4At (LRSpectrumFull.L5S4.dg N126.TT) N126.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h114 p hp
  · exact h115 p hp
)

#print axioms lines

end R126
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg30 : the lines clause for every class of the local table of rep #30 (generated by l5reg)

Every local class `i < nT` of rep #30 (32 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O30T
import LRSpectrumFull.L5S4.LinRQSC0
import LRSpectrumFull.L5S4.LinRQSC2

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R30
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(0, LinRQSC0.blobs), (2, LinRQSC2.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(2, 109, [1, 1, -1, 1, -1, 0, 1, -2, 0]), (2, 110, [1, 0, 0, 1, -1, 1, 1, -1, 0]), (2, 111, [1, 1, -1, 1, -1, 0, 1, -2, 0]), (2, 112, [1, 1, -1, 1, -1, 0, -2, 1, 0]), (2, 113, [1, 0, 0, 1, -1, 0, -2, 2, -1]), (2, 114, [1, 1, -1, 1, -1, 0, 1, -2, 1]), (2, 115, [1, 0, 0, 1, -1, 0, -2, -1, 1]), (2, 116, [1, 0, 0, 1, -1, 0, -2, -2, 1]), (2, 117, [0, 1, -1, -1, 1, 0, 3, 1, -3]), (2, 118, [0, 1, -1, -1, 1, 0, 3, 0, -2]), (2, 119, [0, 0, -1, -1, 1, -1, 2, -1, 0]), (2, 120, [0, 0, -1, -1, 1, -1, 2, -1, 0]), (2, 121, [1, 0, 0, 1, 1, -1, -1, 1, 0]), (2, 122, [1, 0, 0, 1, 1, -1, -1, 2, -1]), (2, 123, [1, 0, 0, 1, 1, -1, -1, 2, -1]), (2, 124, [1, 0, 0, 1, 1, 1, 1, -2, -1]), (2, 125, [0, 0, -1, -1, 0, -1, -2, 1, 0]), (2, 126, [0, 0, -1, -1, 0, -1, -2, 1, 1]), (2, 127, [0, -1, 0, -1, -1, 0, -3, 0, 1]), (2, 128, [0, -1, 1, -1, -1, 1, -3, 1, 0]), (2, 129, [1, 0, 0, 1, 1, -1, 1, -1, 2]), (2, 130, [1, 0, 0, 1, -1, 1, 1, 2, -1]), (2, 131, [1, 0, 0, 1, 1, 1, 0, -2, -1]), (2, 132, [1, 0, 0, 1, 1, 1, 0, -2, -1]), (2, 133, [0, 0, -1, -1, 0, -1, -2, 1, 0]), (0, 236, [0, -1, 0, -2, 0, 1, -1, -1, 0]), (2, 134, [0, -1, 1, -1, -1, 1, -2, 1, 0]), (2, 135, [0, 1, -1, -1, 1, 0, -2, -1, 2]), (2, 136, [0, 0, 1, -1, 0, 1, -2, 1, -2]), (2, 137, [1, 0, 0, 1, 1, -1, 1, -1, 0]), (2, 138, [1, 0, 0, 1, 1, -1, 0, -1, 2]), (2, 139, [0, -1, 1, -1, -1, 1, 2, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N30.TT) N30.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N30.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #30. -/
theorem lines (t5 : List T5Rec) (h0 : ∀ p ∈ LinRQSC0.blobs, LinesCl t5 (t4OfRec p.1)) (h2 : ∀ p ∈ LinRQSC2.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N30.nT).map (t4At (LRSpectrumFull.L5S4.dg N30.TT) N30.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h0 p hp
  · exact h2 p hp
)

#print axioms lines

end R30
end L5Reg
end LRSpectrumFull

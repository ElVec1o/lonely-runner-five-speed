theorem lines (t5 : List T5Rec) (h940 : ∀ p ∈ LinRQSC940.blobs, LinesCl t5 (t4OfRec p.1)) (h941 : ∀ p ∈ LinRQSC941.blobs, LinesCl t5 (t4OfRec p.1)) (h942 : ∀ p ∈ LinRQSC942.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1189.nT).map (t4At (LRSpectrumFull.L5S4.dg N1189.TT) N1189.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h940 p hp
  · exact h941 p hp

/-- the lines clause for every class of the local table of rep #100. -/
theorem lines (t5 : List T5Rec) (h104 : ∀ p ∈ LinRQSC104.blobs, LinesCl t5 (t4OfRec p.1)) (h105 : ∀ p ∈ LinRQSC105.blobs, LinesCl t5 (t4OfRec p.1)) (h106 : ∀ p ∈ LinRQSC106.blobs, LinesCl t5 (t4OfRec p.1))

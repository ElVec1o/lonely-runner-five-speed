/-
# L5Reg.Reg788 : the lines clause for every class of the local table of rep #788 (generated by l5reg)

Every local class `i < nT` of rep #788 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O788T
import LRSpectrumFull.L5S4.LinRQSC872

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R788
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(872, LinRQSC872.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(872, 139, [0, 2, -1, 0, -1, 0, -1, 0, 0]), (872, 140, [2, 0, -1, -1, -3, 3, -2, 1, 0]), (872, 141, [0, -1, 0, 3, -1, -2, -1, 1, 1]), (872, 142, [0, -2, 1, 3, 1, -1, -1, 0, 0]), (872, 143, [0, -1, 0, 3, 1, -2, 2, -2, -1]), (872, 144, [0, 1, -1, 3, -1, -1, 2, 2, -3]), (872, 145, [0, -1, 0, 3, 1, -2, 2, -2, -1]), (872, 146, [0, 2, -1, 3, -1, 0, -1, 0, 0]), (872, 147, [0, 1, -1, 3, -1, -1, 2, 2, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N788.TT) N788.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N788.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #788. -/
theorem lines (t5 : List T5Rec) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N788.nT).map (t4At (LRSpectrumFull.L5S4.dg N788.TT) N788.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h872 p hp
)

#print axioms lines

end R788
end L5Reg
end LRSpectrumFull

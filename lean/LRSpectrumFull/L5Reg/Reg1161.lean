/-- the lines clause for every class of the local table of rep #1161. -/
theorem lines (t5 : List T5Rec) (h932 : ∀ p ∈ LinRQSC932.blobs, LinesCl t5 (t4OfRec p.1)) (h933 : ∀ p ∈ LinRQSC933.blobs, LinesCl t5 (t4OfRec p.1))

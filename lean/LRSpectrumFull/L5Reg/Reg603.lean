/-
# L5Reg.Reg603 : the lines clause for every class of the local table of rep #603 (generated by l5reg)

Every local class `i < nT` of rep #603 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O603T
import LRSpectrumFull.L5S4.LinRQSC839

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R603
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(839, LinRQSC839.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(839, 27, [1, 0, -1, -1, -1, 1, 4, 0, -3]), (839, 28, [1, 0, -1, -1, 1, 0, 4, 0, -3]), (839, 29, [1, 0, -1, 2, 1, -2, -4, 0, 3]), (839, 30, [1, 0, -1, 2, 1, -2, -4, 0, 3]), (839, 31, [1, 0, 0, 2, 4, 1, 4, -1, 0]), (839, 32, [1, 0, 0, -1, -1, 4, -4, 0, -1]), (839, 33, [1, 0, -1, -1, -4, 4, -4, 1, 3]), (839, 34, [1, 0, -1, -1, 1, 1, 4, 0, -3]), (839, 35, [1, 0, -1, -1, 4, -2, 4, -1, -3]), (839, 36, [1, 0, 0, -1, 4, 1, 3, 3, 1]), (839, 37, [1, 0, 0, 2, 4, -1, -3, 3, -1]), (839, 38, [1, 0, 0, -1, -2, 1, -3, 1, -1]), (839, 39, [1, -1, 0, -1, -2, 2, -4, -3, 5]), (839, 40, [1, 0, -1, -1, -1, 1, -4, 0, 3]), (839, 41, [1, -1, 0, -1, 1, 1, 4, -3, 0]), (839, 42, [1, 0, -1, -1, 1, 0, 4, 0, -3]), (839, 43, [1, 0, 0, 2, 1, -2, -4, 0, -1]), (839, 44, [1, 0, -1, -1, -4, 2, 4, 1, -4]), (839, 45, [1, 0, -1, 2, -2, -1, -4, -1, 4]), (839, 46, [1, -1, 0, -1, -2, 2, 3, 1, -3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N603.TT) N603.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N603.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #603. -/
theorem lines (t5 : List T5Rec) (h839 : ∀ p ∈ LinRQSC839.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N603.nT).map (t4At (LRSpectrumFull.L5S4.dg N603.TT) N603.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h839 p hp
)

#print axioms lines

end R603
end L5Reg
end LRSpectrumFull

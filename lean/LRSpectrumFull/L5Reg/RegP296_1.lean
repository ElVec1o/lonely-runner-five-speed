theorem lines (t5 : List T5Rec) (h463 : ∀ p ∈ LinRQSC463.blobs, LinesCl t5 (t4OfRec p.1)) (h464 : ∀ p ∈ LinRQSC464.blobs, LinesCl t5 (t4OfRec p.1)) (h465 : ∀ p ∈ LinRQSC465.blobs, LinesCl t5 (t4OfRec p.1)) (h466 : ∀ p ∈ LinRQSC466.blobs, LinesCl t5 (t4OfRec p.1))

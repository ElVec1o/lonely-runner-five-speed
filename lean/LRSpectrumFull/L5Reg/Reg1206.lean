/-
# L5Reg.Reg1206 : the lines clause for every class of the local table of rep #1206 (generated by l5reg)

Every local class `i < nT` of rep #1206 (23 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1206T
import LRSpectrumFull.L5S4.LinRQSC955

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1206
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(955, LinRQSC955.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(955, 63, [1, -1, 0, 1, -3, 1, 2, 3, -2]), (955, 64, [1, -1, 0, 3, -1, -1, 0, 3, -2]), (955, 65, [1, -1, 0, 1, -3, 1, 3, 2, -3]), (955, 66, [1, -1, 0, 3, 2, -4, 1, -2, 1]), (955, 67, [1, -1, 0, 1, 0, -1, 3, 0, -2]), (955, 68, [1, 1, -1, 1, 3, -2, 3, -2, 0]), (955, 69, [1, -1, 0, 3, 2, -2, 3, -1, -1]), (955, 70, [1, 2, -1, 3, 0, -2, 0, -1, 0]), (955, 71, [1, 1, -1, 3, -2, 0, 1, 3, -2]), (955, 72, [1, -1, 0, 0, -1, 0, -1, -3, -1]), (955, 73, [2, -1, 0, 0, -1, 1, -1, -2, 2]), (955, 74, [1, -1, 0, -2, -3, 2, 3, 0, -1]), (955, 75, [1, 2, -1, -2, 0, 1, 1, -3, 0]), (955, 76, [2, -1, 0, 0, -1, 1, -3, -1, 2]), (955, 77, [1, 2, -2, -2, 0, 1, 2, -3, 1]), (955, 78, [1, 0, -1, -2, 1, 1, 3, -2, -2]), (955, 79, [2, 1, -2, 0, -2, 1, -3, 1, 2]), (955, 80, [1, -1, 0, 0, 1, -1, -1, -1, 1]), (955, 81, [2, -1, 0, 0, 2, -1, -3, -1, 1]), (955, 82, [1, 1, -1, -2, 3, -2, 2, 3, -3]), (955, 83, [2, 1, -1, 0, -2, 1, -3, 3, -1]), (955, 84, [2, -1, -1, 0, 2, -1, -3, -2, 3]), (955, 85, [1, -2, 0, -2, 0, 1, 2, 3, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1206.TT) N1206.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1206.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1206. -/
theorem lines (t5 : List T5Rec) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1206.nT).map (t4At (LRSpectrumFull.L5S4.dg N1206.TT) N1206.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h955 p hp
)

#print axioms lines

end R1206
end L5Reg
end LRSpectrumFull

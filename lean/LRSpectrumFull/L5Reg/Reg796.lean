/-
# L5Reg.Reg796 : the lines clause for every class of the local table of rep #796 (generated by l5reg)

Every local class `i < nT` of rep #796 (3 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O796T
import LRSpectrumFull.L5S4.LinRQSC869
import LRSpectrumFull.L5S4.LinRQSC872

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R796
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(869, LinRQSC869.blobs), (872, LinRQSC872.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(872, 155, [0, 1, 0, 1, 2, -1, -3, -1, 2]), (869, 94, [1, -2, 1, 3, 1, -1, -2, -1, 1]), (872, 150, [1, 0, 0, 1, 3, -2, 2, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N796.TT) N796.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N796.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #796. -/
theorem lines (t5 : List T5Rec) (h869 : ∀ p ∈ LinRQSC869.blobs, LinesCl t5 (t4OfRec p.1)) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N796.nT).map (t4At (LRSpectrumFull.L5S4.dg N796.TT) N796.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h869 p hp
  · exact h872 p hp
)

#print axioms lines

end R796
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 300..312 of rep #526. -/
theorem lines (t5 : List T5Rec) (h798 : ∀ p ∈ LinRQSC798.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 13 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N526.TT) N526.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h798 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


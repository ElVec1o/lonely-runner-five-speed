/-
# L5Reg.Reg1028 : the lines clause for every class of the local table of rep #1028 (generated by l5reg)

Every local class `i < nT` of rep #1028 (18 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1028T
import LRSpectrumFull.L5S4.LinRQSC907

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1028
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(907, LinRQSC907.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(907, 13, [2, -1, 0, -1, 1, -1, -2, 2, -1]), (907, 14, [1, 0, 0, 0, -3, -1, 3, 2, 1]), (907, 15, [2, 0, -1, -1, 1, -1, -2, -1, 2]), (907, 16, [1, -2, 0, 0, 1, 0, 3, 1, -1]), (907, 17, [2, -1, -1, -1, 1, 0, -2, 2, 1]), (907, 18, [2, 2, -3, -1, 1, 0, -2, 1, 1]), (907, 19, [2, 0, -1, -1, 1, -1, -2, -1, 2]), (907, 20, [2, 2, -3, -1, 1, 0, -3, 2, 1]), (907, 21, [2, 0, -1, -1, -3, 1, -1, 2, 0]), (907, 22, [2, 0, -1, -1, -3, 1, -3, 2, 1]), (907, 23, [2, -1, 0, -1, -1, 1, -2, 2, -1]), (907, 24, [2, -1, -1, -1, 1, 0, -2, 1, 0]), (907, 25, [2, 0, -1, -1, 1, 0, -3, 0, 1]), (907, 26, [2, -1, -1, -1, -1, 0, -2, 2, 1]), (907, 27, [2, -1, 0, -1, 0, 0, -2, 1, -1]), (907, 28, [2, -1, -1, -1, 0, 1, -3, -1, 3]), (907, 29, [2, 1, -2, -1, 0, 1, -2, 1, 1]), (907, 30, [0, -1, 0, -3, 0, 2, 2, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1028.TT) N1028.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1028.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1028. -/
theorem lines (t5 : List T5Rec) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1028.nT).map (t4At (LRSpectrumFull.L5S4.dg N1028.TT) N1028.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h907 p hp
)

#print axioms lines

end R1028
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #49. -/
theorem lines (t5 : List T5Rec) (h33 : ∀ p ∈ LinRQSC33.blobs, LinesCl t5 (t4OfRec p.1)) (h34 : ∀ p ∈ LinRQSC34.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N49.nT).map (t4At (LRSpectrumFull.L5S4.dg N49.TT) N49.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h33 p hp
  · exact h34 p hp
)


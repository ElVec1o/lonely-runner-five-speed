/-
# L5Reg.Reg129 : the lines clause for every class of the local table of rep #129 (generated by l5reg)

Every local class `i < nT` of rep #129 (39 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O129T
import LRSpectrumFull.L5S4.LinRQSC115

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R129
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(115, LinRQSC115.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(115, 141, [1, 0, 0, 0, 0, 1, -1, 1, -1]), (115, 142, [2, -1, 0, 0, 0, 1, -1, 1, 0]), (115, 143, [2, 0, -1, 0, 3, -1, -1, -1, 1]), (115, 144, [2, 0, -1, 0, 3, -2, -1, 1, 0]), (115, 145, [2, 0, -1, 0, 3, -1, -1, -2, 1]), (115, 146, [1, 0, 0, 0, 3, -2, 0, -2, 1]), (115, 147, [1, 0, 0, 0, -3, -1, 0, 1, 0]), (115, 148, [2, 0, -1, 0, -3, 2, -1, -1, 1]), (115, 149, [2, 0, -1, 0, 3, -2, -1, -1, 1]), (115, 150, [2, -1, 0, 0, 0, 1, -1, 1, 0]), (115, 151, [2, 0, -1, 0, 3, -1, -1, 1, 0]), (115, 152, [0, 2, -1, 1, 0, 0, -3, -1, 0]), (115, 153, [2, 0, -1, 0, 3, -1, -1, -2, 1]), (115, 154, [1, 0, 0, 0, 3, -2, -1, -2, 1]), (115, 155, [2, -1, -1, 0, 0, 1, -1, 1, 0]), (115, 156, [2, -1, 0, 0, 0, 1, -1, 1, -1]), (115, 157, [2, 0, -1, 0, 1, 0, -1, 0, 1]), (115, 158, [2, 0, -1, 0, 3, -1, -1, -2, 1]), (115, 159, [1, 0, 0, 0, -1, 1, 0, 4, -3]), (115, 160, [2, 0, -1, 0, 3, -1, -1, -2, 1]), (115, 161, [2, 0, -1, 0, 1, 0, -1, 0, 0]), (115, 162, [1, 0, 0, 0, 1, 0, -1, 0, 1]), (115, 163, [2, 0, -1, 0, 1, 0, -1, 0, 1]), (115, 164, [0, 2, -1, -1, 0, 0, -1, -1, 0]), (115, 165, [0, 2, -1, -3, 0, 2, -1, -1, 1]), (115, 166, [0, 2, -1, -3, 0, 2, -1, -1, 1]), (115, 167, [2, 0, -1, 0, 3, -2, -1, -1, 1]), (115, 168, [1, 0, 0, 0, 1, 1, -1, -2, -1]), (115, 169, [2, 0, -1, 0, 1, 0, -1, -2, 1]), (115, 170, [2, 0, -1, 0, 1, -1, -1, -1, 1]), (115, 171, [2, 0, -1, 0, 1, 1, -1, 0, 0]), (115, 172, [0, 2, -1, -3, 0, 2, -4, -1, 3]), (115, 173, [0, 0, 1, -3, 1, 0, -4, 1, 0]), (115, 174, [0, 0, 1, -3, 1, 1, -4, 1, 1]), (115, 175, [2, 0, -1, 0, 1, 1, -1, 0, 0]), (115, 176, [0, 0, 1, -3, 2, 0, -4, 3, 0]), (115, 177, [0, 0, 1, -3, 2, -1, -2, 1, -1]), (115, 178, [0, 1, 0, -3, 0, 2, -2, 0, 1]), (115, 179, [0, 0, 1, -3, 1, 1, -4, 1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N129.TT) N129.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N129.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #129. -/
theorem lines (t5 : List T5Rec) (h115 : ∀ p ∈ LinRQSC115.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N129.nT).map (t4At (LRSpectrumFull.L5S4.dg N129.TT) N129.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h115 p hp
)

#print axioms lines

end R129
end L5Reg
end LRSpectrumFull

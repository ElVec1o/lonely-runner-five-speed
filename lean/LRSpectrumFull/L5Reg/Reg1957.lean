/-
# L5Reg.Reg1957 : the lines clause for every class of the local table of rep #1957 (generated by l5reg)

Every local class `i < nT` of rep #1957 (26 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1957T
import LRSpectrumFull.L5S4.LinRQSC1050
import LRSpectrumFull.L5S4.LinRQSC1052

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1957
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1050, LinRQSC1050.blobs), (1052, LinRQSC1052.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1052, 186, [1, 2, -2, 3, 1, -2, 2, -2, 1]), (1052, 187, [1, -1, 1, 3, -2, 1, -2, 0, 1]), (1052, 188, [1, -2, 0, 3, 1, -3, 3, -1, -2]), (1052, 189, [1, -2, 1, 3, -1, 0, -2, -3, 2]), (1052, 190, [1, -1, 0, 1, -3, 1, -3, 0, 2]), (1052, 191, [1, -1, 0, 3, -1, 1, 3, -2, 1]), (1052, 103, [1, -1, -1, 1, -2, -1, -3, -1, 2]), (1052, 192, [1, -1, 0, -1, 0, 1, 2, -1, 0]), (1052, 193, [1, 2, -2, 3, -1, -2, -3, -1, 3]), (1052, 69, [1, 2, -1, 2, 2, -1, 3, -1, 0]), (1052, 194, [1, 0, -1, 1, -1, -1, -3, 1, 2]), (1052, 195, [2, 1, -1, 1, 3, -2, 2, -2, 1]), (1052, 196, [2, -1, 0, 1, 0, 0, 2, 0, -1]), (1052, 197, [1, 0, -1, 3, -2, -2, 0, 1, 0]), (1052, 198, [2, -1, -1, 1, -3, 1, 2, 1, -2]), (1052, 199, [1, -1, 0, 3, -1, -1, 0, -1, 1]), (1052, 200, [2, -1, -1, 1, 0, 0, 3, -1, -2]), (1052, 201, [1, 0, 0, -1, 1, 0, 2, 0, -1]), (1052, 202, [2, 1, -2, -1, 3, -1, -1, -2, 2]), (1052, 203, [2, 1, -2, -1, 3, -1, -3, 0, 2]), (1050, 131, [1, -1, 0, 2, -1, -1, 3, 1, -3]), (1052, 204, [2, 1, -1, 1, 3, -1, 3, 0, -1]), (1052, 205, [2, -1, -1, 1, -1, 0, 3, 1, -3]), (1052, 67, [2, 1, -1, -2, 1, 2, 1, -1, -1]), (1050, 114, [2, 0, -1, 0, -1, 0, -3, 2, 1]), (1052, 206, [2, -1, 0, 1, -1, 0, 2, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1957.TT) N1957.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1957.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1957. -/
theorem lines (t5 : List T5Rec) (h1050 : ∀ p ∈ LinRQSC1050.blobs, LinesCl t5 (t4OfRec p.1)) (h1052 : ∀ p ∈ LinRQSC1052.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1957.nT).map (t4At (LRSpectrumFull.L5S4.dg N1957.TT) N1957.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1050 p hp
  · exact h1052 p hp
)

#print axioms lines

end R1957
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg718 : the lines clause for every class of the local table of rep #718 (generated by l5reg)

Every local class `i < nT` of rep #718 (38 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O718T
import LRSpectrumFull.L5S4.LinRQSC803
import LRSpectrumFull.L5S4.LinRQSC867
import LRSpectrumFull.L5S4.LinRQSC868

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R718
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(803, LinRQSC803.blobs), (867, LinRQSC867.blobs), (868, LinRQSC868.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(867, 88, [1, -1, 0, 0, -1, 0, -3, -3, 1]), (867, 89, [1, 0, -1, 0, 1, -1, 4, 0, -3]), (803, 106, [1, 0, -1, 3, -1, -2, 0, 3, -2]), (867, 90, [0, -1, 0, 3, 1, -1, -4, 0, 1]), (867, 91, [1, 0, -1, 1, 3, -2, 2, -2, -1]), (868, 0, [1, 0, -1, 1, 1, -1, 4, 0, -3]), (868, 1, [1, 0, -1, 0, -1, 0, 4, 0, -3]), (868, 2, [0, -1, 0, 3, -1, -2, 1, 3, -1]), (868, 3, [0, -1, 0, 3, -1, -2, 4, 1, -3]), (868, 4, [0, 0, -1, 3, -2, 0, 2, -1, 0]), (868, 5, [1, -1, 0, 1, 0, -1, 3, 2, -4]), (868, 6, [1, 0, 0, 1, -1, 3, 4, 0, 1]), (868, 7, [1, 0, -1, 0, -3, 1, 4, 1, -4]), (868, 8, [1, 0, -1, 0, -3, 2, 3, -1, -2]), (868, 9, [1, 0, -1, 0, 3, -2, 3, -1, -2]), (868, 10, [0, -1, 0, 3, 0, -2, -2, 0, 1]), (868, 11, [0, 1, 0, 3, -1, -2, -4, -1, 3]), (868, 12, [1, 1, -1, 1, 0, -1, 3, -2, -2]), (868, 13, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (868, 14, [1, 0, -1, 1, 3, -2, 3, -2, -2]), (868, 15, [1, 0, -1, 1, -3, 0, 4, 1, -4]), (868, 16, [1, 0, -1, 0, 1, -1, 4, 0, -3]), (868, 17, [0, 1, 0, 3, 0, -1, -4, 0, 1]), (868, 18, [1, 0, -1, 1, 1, -1, 4, 0, -3]), (868, 19, [1, 0, -1, 0, 1, -1, 4, 0, -3]), (868, 20, [1, -1, 0, 0, -1, 0, 4, 2, -1]), (868, 21, [1, -1, 1, 1, 0, 0, 3, -1, 0]), (868, 22, [1, -1, 0, 1, 0, -1, 4, 2, -5]), (868, 23, [1, 0, -1, 1, 1, -1, 4, 0, -3]), (868, 24, [1, -1, 0, 1, 0, 0, 4, -1, -1]), (868, 25, [1, -1, 1, 1, 0, 0, 4, -1, 0]), (868, 26, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (868, 27, [1, 0, 0, 1, 3, -1, 3, -2, 1]), (868, 28, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (868, 29, [1, 0, -1, 1, -3, 1, 3, 2, -4]), (868, 30, [1, 0, 0, 1, 1, -3, 4, 0, 1]), (868, 31, [1, 0, -1, 1, -1, 0, 4, 0, -3]), (868, 32, [1, 0, 0, 1, -1, 3, 3, 1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N718.TT) N718.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N718.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #718. -/
theorem lines (t5 : List T5Rec) (h803 : ∀ p ∈ LinRQSC803.blobs, LinesCl t5 (t4OfRec p.1)) (h867 : ∀ p ∈ LinRQSC867.blobs, LinesCl t5 (t4OfRec p.1)) (h868 : ∀ p ∈ LinRQSC868.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N718.nT).map (t4At (LRSpectrumFull.L5S4.dg N718.TT) N718.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h803 p hp
  · exact h867 p hp
  · exact h868 p hp
)

#print axioms lines

end R718
end L5Reg
end LRSpectrumFull

/-
# L5Reg.RegFin71 : the lines clause for the local class tables of 1 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg543

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines543 : ∀ cl ∈ (List.range N543.nT).map (t4At (LRSpectrumFull.L5S4.dg N543.TT) N543.ST), LinesCl T5Store.t5 cl :=
  R543.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem799 p hp))

#print axioms lines543

end L5Reg
end LRSpectrumFull

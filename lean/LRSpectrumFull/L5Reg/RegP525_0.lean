/-- the lines clause for local classes 0..99 of rep #525. -/
theorem lines (t5 : List T5Rec) (h536 : ∀ p ∈ LinRQSC536.blobs, LinesCl t5 (t4OfRec p.1)) (h790 : ∀ p ∈ LinRQSC790.blobs, LinesCl t5 (t4OfRec p.1)) (h791 : ∀ p ∈ LinRQSC791.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 0 ≤ c → c < 0 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N525.TT) N525.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h536 p hpe
    · exact h790 p hpe
    · exact h791 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 0 advOk c h1 ?_
  rw [adv_len]; exact h2


theorem lines (t5 : List T5Rec) (h942 : ∀ p ∈ LinRQSC942.blobs, LinesCl t5 (t4OfRec p.1)) (h998 : ∀ p ∈ LinRQSC998.blobs, LinesCl t5 (t4OfRec p.1)) (h1013 : ∀ p ∈ LinRQSC1013.blobs, LinesCl t5 (t4OfRec p.1)) (h1014 : ∀ p ∈ LinRQSC1014.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1334.nT).map (t4At (LRSpectrumFull.L5S4.dg N1334.TT) N1334.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h942 p hp
  · exact h998 p hp
  · exact h1013 p hp
  · exact h1014 p hp
)


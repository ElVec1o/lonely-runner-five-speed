/-- the lines clause for every class of the local table of rep #1258. -/
theorem lines (t5 : List T5Rec) (h965 : ∀ p ∈ LinRQSC965.blobs, LinesCl t5 (t4OfRec p.1)) (h970 : ∀ p ∈ LinRQSC970.blobs, LinesCl t5 (t4OfRec p.1))

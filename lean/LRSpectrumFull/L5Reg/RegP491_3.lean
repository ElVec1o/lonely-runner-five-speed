/-- the lines clause for local classes 300..399 of rep #491. -/
theorem lines (t5 : List T5Rec) (h744 : ∀ p ∈ LinRQSC744.blobs, LinesCl t5 (t4OfRec p.1)) (h745 : ∀ p ∈ LinRQSC745.blobs, LinesCl t5 (t4OfRec p.1))

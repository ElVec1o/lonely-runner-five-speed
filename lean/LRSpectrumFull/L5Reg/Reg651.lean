/-- the lines clause for every class of the local table of rep #651. -/
theorem lines (t5 : List T5Rec) (h220 : ∀ p ∈ LinRQSC220.blobs, LinesCl t5 (t4OfRec p.1)) (h857 : ∀ p ∈ LinRQSC857.blobs, LinesCl t5 (t4OfRec p.1)) (h858 : ∀ p ∈ LinRQSC858.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N651.nT).map (t4At (LRSpectrumFull.L5S4.dg N651.TT) N651.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h220 p hp
  · exact h857 p hp
  · exact h858 p hp
)


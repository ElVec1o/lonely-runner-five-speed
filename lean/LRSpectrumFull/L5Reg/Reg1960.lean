/-
# L5Reg.Reg1960 : the lines clause for every class of the local table of rep #1960 (generated by l5reg)

Every local class `i < nT` of rep #1960 (29 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1960T
import LRSpectrumFull.L5S4.LinRQSC1049
import LRSpectrumFull.L5S4.LinRQSC1052

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1960
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1049, LinRQSC1049.blobs), (1052, LinRQSC1052.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1052, 252, [1, -1, -1, 2, 0, -1, -3, 2, 2]), (1052, 253, [2, -1, -1, 1, 0, -1, 2, -1, 0]), (1052, 254, [2, -1, -1, 1, 2, -2, -1, 0, 1]), (1052, 255, [2, 1, -2, 1, 2, -2, -3, 1, 1]), (1052, 256, [1, 1, -1, 2, -2, -1, 3, 0, -2]), (1049, 117, [1, 0, 0, -2, 2, -1, 2, -1, 0]), (1052, 257, [2, -1, 0, 1, 1, -1, 2, 1, -1]), (1052, 258, [1, 0, 1, 2, -1, 1, 4, -2, 1]), (1052, 259, [1, -1, 0, -2, -2, 1, 3, 0, -1]), (1052, 260, [1, 2, -1, 0, -2, 1, 3, 1, -1]), (1052, 261, [2, -1, 2, 1, 0, -2, -2, 1, -1]), (1052, 262, [1, 2, -1, -2, -2, 1, 3, -1, 0]), (1052, 263, [1, 2, -1, -2, 1, 0, 3, -1, 0]), (1052, 264, [1, -2, 1, 0, 2, -1, 3, 1, -1]), (1052, 265, [1, -1, 0, 0, 1, 0, 2, -1, 1]), (1052, 266, [1, 0, 0, 2, -2, 1, 3, -1, 0]), (1052, 267, [2, -1, 0, -2, 2, -1, -3, 2, -1]), (1052, 268, [1, -1, 1, -2, 1, -1, 2, -1, 0]), (1052, 269, [2, -1, -1, -2, 0, 1, -3, -1, 2]), (1052, 270, [2, -1, 0, 1, 0, 0, -3, -1, 1]), (1052, 271, [1, 1, -1, -2, 2, -1, 2, 3, -3]), (1052, 272, [1, 0, 0, 0, 1, 0, 3, -2, -1]), (1052, 273, [2, 2, -3, -2, 1, 1, -1, 1, 0]), (1049, 140, [2, -1, -1, 1, 2, -1, 2, 0, -1]), (1052, 274, [2, -1, -1, -2, 0, 1, -3, -1, 2]), (1052, 275, [1, -1, 0, -1, 0, 0, -1, -2, 1]), (1052, 276, [1, -1, 0, -1, 2, 0, -1, -3, 1]), (1052, 277, [1, 0, 0, -2, 1, 0, 2, 0, -1]), (1052, 278, [1, 0, 0, -2, 2, -1, 3, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1960.TT) N1960.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1960.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1960. -/
theorem lines (t5 : List T5Rec) (h1049 : ∀ p ∈ LinRQSC1049.blobs, LinesCl t5 (t4OfRec p.1)) (h1052 : ∀ p ∈ LinRQSC1052.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1960.nT).map (t4At (LRSpectrumFull.L5S4.dg N1960.TT) N1960.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1049 p hp
  · exact h1052 p hp
)

#print axioms lines

end R1960
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #347. -/
theorem lines (t5 : List T5Rec) (h485 : ∀ p ∈ LinRQSC485.blobs, LinesCl t5 (t4OfRec p.1)) (h486 : ∀ p ∈ LinRQSC486.blobs, LinesCl t5 (t4OfRec p.1)) (h487 : ∀ p ∈ LinRQSC487.blobs, LinesCl t5 (t4OfRec p.1)) (h488 : ∀ p ∈ LinRQSC488.blobs, LinesCl t5 (t4OfRec p.1)) (h710 : ∀ p ∈ LinRQSC710.blobs, LinesCl t5 (t4OfRec p.1)) (h711 : ∀ p ∈ LinRQSC711.blobs, LinesCl t5 (t4OfRec p.1)) (h712 : ∀ p ∈ LinRQSC712.blobs, LinesCl t5 (t4OfRec p.1)) (h713 : ∀ p ∈ LinRQSC713.blobs, LinesCl t5 (t4OfRec p.1)) (h714 : ∀ p ∈ LinRQSC714.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N347.nT).map (t4At (LRSpectrumFull.L5S4.dg N347.TT) N347.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N347.nT := List.mem_range.1 hc
  have hn : N347.nT = 324 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 324) := by omega
  rcases hcase with h | h | h | h
  · exact P347_0.lines t5 h485 h486 h710 h711 h712 c h.1 (by omega)
  · exact P347_1.lines t5 h487 h488 h712 h713 c h.1 (by omega)
  · exact P347_2.lines t5 h713 c h.1 (by omega)
  · exact P347_3.lines t5 h713 h714 c h.1 (by omega)

#print axioms lines


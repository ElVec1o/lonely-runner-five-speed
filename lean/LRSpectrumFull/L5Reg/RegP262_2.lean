/-- the lines clause for local classes 200..299 of rep #262. -/
theorem lines (t5 : List T5Rec) (h209 : ∀ p ∈ LinRQSC209.blobs, LinesCl t5 (t4OfRec p.1)) (h210 : ∀ p ∈ LinRQSC210.blobs, LinesCl t5 (t4OfRec p.1)) (h211 : ∀ p ∈ LinRQSC211.blobs, LinesCl t5 (t4OfRec p.1)) (h212 : ∀ p ∈ LinRQSC212.blobs, LinesCl t5 (t4OfRec p.1)) (h213 : ∀ p ∈ LinRQSC213.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N262.TT) N262.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    · exact h209 p hpe
    · exact h210 p hpe
    · exact h211 p hpe
    · exact h212 p hpe
    · exact h213 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


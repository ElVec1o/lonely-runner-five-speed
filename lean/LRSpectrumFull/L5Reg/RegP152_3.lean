import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O152T
import LRSpectrumFull.L5S4.LinRQSC150

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P152_3
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(150, LinRQSC150.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(150, 72, [0, 0, 1, -1, 0, 0, -1, 1, 0]), (150, 73, [0, 0, 1, -1, 0, 0, -1, 1, 0]), (150, 74, [0, 0, 1, -1, 0, 0, -2, 1, -1]), (150, 75, [0, 1, 0, -1, 0, 0, -2, 0, 1]), (150, 76, [0, 2, -1, -1, 0, 0, -2, 1, 0]), (150, 77, [0, -1, 1, -1, 0, 1, -2, 0, 1]), (150, 78, [0, 0, -1, -1, 0, 0, -2, 1, -1]), (150, 79, [0, 0, -1, -1, 0, 0, 2, -1, 1]), (150, 80, [0, -1, 1, -1, 0, 1, 1, 1, -1]), (150, 81, [0, 2, -1, -1, 0, 0, 1, -1, 0]), (150, 82, [0, 1, -1, -1, 0, 0, 1, 0, -1]), (150, 83, [0, 2, -1, -1, 0, 0, 1, -1, 0]), (150, 84, [1, 0, 0, 0, -1, -1, 0, 0, 1]), (150, 85, [2, 0, -1, 0, -1, 0, -1, 0, 1]), (150, 86, [0, 1, 0, -2, 0, 1, -3, 0, 2]), (150, 87, [0, 1, 0, -2, 1, 1, -3, 2, 2]), (150, 88, [0, 1, -1, -2, 0, 1, -3, 0, 2]), (150, 89, [0, 1, -1, -2, 1, 0, -3, 2, 0]), (150, 90, [0, -1, 1, -2, 0, 1, -3, 0, 1]), (150, 91, [0, 0, -1, -2, 1, 1, -3, 2, 1]), (150, 92, [2, 0, -1, 0, -1, 0, -1, 0, 1]), (150, 93, [0, 0, 1, -1, 0, 0, -2, 1, -1]), (150, 94, [0, 1, 0, -2, 0, 1, 3, 0, -1]), (150, 95, [0, 1, 0, -2, 1, 1, 3, -2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N152.TT) N152.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 24 := by decide +kernel

/-- the lines clause for local classes 300..323 of rep #152. -/
theorem lines (t5 : List T5Rec) (h150 : ∀ p ∈ LinRQSC150.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 24 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N152.TT) N152.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h150 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P152_3
end L5Reg
end LRSpectrumFull

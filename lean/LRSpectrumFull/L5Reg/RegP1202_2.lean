/-- the lines clause for local classes 200..299 of rep #1202. -/
theorem lines (t5 : List T5Rec) (h952 : ∀ p ∈ LinRQSC952.blobs, LinesCl t5 (t4OfRec p.1)) (h953 : ∀ p ∈ LinRQSC953.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h977 : ∀ p ∈ LinRQSC977.blobs, LinesCl t5 (t4OfRec p.1)) (h978 : ∀ p ∈ LinRQSC978.blobs, LinesCl t5 (t4OfRec p.1))

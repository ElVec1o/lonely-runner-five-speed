/-- the lines clause for local classes 100..199 of rep #526. -/
theorem lines (t5 : List T5Rec) (h550 : ∀ p ∈ LinRQSC550.blobs, LinesCl t5 (t4OfRec p.1)) (h551 : ∀ p ∈ LinRQSC551.blobs, LinesCl t5 (t4OfRec p.1)) (h796 : ∀ p ∈ LinRQSC796.blobs, LinesCl t5 (t4OfRec p.1)) (h797 : ∀ p ∈ LinRQSC797.blobs, LinesCl t5 (t4OfRec p.1))

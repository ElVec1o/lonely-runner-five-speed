/-
# L5Reg.Reg851 : the lines clause for every class of the local table of rep #851 (generated by l5reg)

Every local class `i < nT` of rep #851 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O851T
import LRSpectrumFull.L5S4.LinRQSC878
import LRSpectrumFull.L5S4.LinRQSC879

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R851
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(878, LinRQSC878.blobs), (879, LinRQSC879.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(878, 147, [3, -1, 0, -1, -3, 3, 0, 1, -1]), (878, 148, [1, -3, 0, 1, 1, -1, 3, 2, -3]), (879, 0, [3, -2, -2, -1, 0, 1, 2, -1, -1]), (879, 1, [3, 1, -1, -1, 1, 0, 0, 3, -1]), (879, 2, [3, -2, -2, -1, 1, 1, 1, 0, -1]), (879, 3, [1, 1, -1, 3, -2, -2, -3, 1, 2]), (879, 4, [1, 0, -1, 3, -1, -2, 0, 0, -1]), (879, 5, [1, -3, 0, 3, 1, -3, -2, -1, 2]), (879, 6, [3, -1, 0, -1, 2, -1, 2, -1, 0]), (879, 7, [3, 0, -1, -1, 1, 0, -1, -3, 1]), (879, 8, [3, -2, 1, -1, 1, -1, 0, -1, 1]), (879, 9, [3, 1, -3, -1, 3, 0, 1, 0, -1]), (879, 10, [3, 0, -1, -1, 0, 0, -1, -1, 1]), (879, 11, [3, -1, 0, -1, -3, 1, 1, 0, 0]), (879, 12, [3, -1, -1, -1, 1, 0, 1, 0, -1]), (879, 13, [3, -1, 0, -1, -3, 3, 0, 1, -1]), (879, 14, [3, -2, 1, -1, -1, 1, 1, 0, 0]), (879, 15, [3, 0, -1, -1, 0, 0, 1, 1, -1]), (879, 16, [3, -2, 1, -1, 0, 0, -1, 1, -1]), (879, 17, [3, -2, 1, -1, -1, 1, -1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N851.TT) N851.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N851.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #851. -/
theorem lines (t5 : List T5Rec) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N851.nT).map (t4At (LRSpectrumFull.L5S4.dg N851.TT) N851.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h878 p hp
  · exact h879 p hp
)

#print axioms lines

end R851
end L5Reg
end LRSpectrumFull

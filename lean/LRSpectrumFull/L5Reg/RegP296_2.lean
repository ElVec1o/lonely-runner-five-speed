theorem lines (t5 : List T5Rec) (h466 : ∀ p ∈ LinRQSC466.blobs, LinesCl t5 (t4OfRec p.1)) (h467 : ∀ p ∈ LinRQSC467.blobs, LinesCl t5 (t4OfRec p.1)) (h468 : ∀ p ∈ LinRQSC468.blobs, LinesCl t5 (t4OfRec p.1)) (h469 : ∀ p ∈ LinRQSC469.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg478 : the lines clause for every class of the local table of rep #478 (generated by l5reg)

Every local class `i < nT` of rep #478 (1 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O478T
import LRSpectrumFull.L5S4.LinRQSC732

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R478
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(732, LinRQSC732.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(732, 85, [1, 0, -1, -1, -3, 2, -4, 2, 3])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N478.TT) N478.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N478.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #478. -/
theorem lines (t5 : List T5Rec) (h732 : ∀ p ∈ LinRQSC732.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N478.nT).map (t4At (LRSpectrumFull.L5S4.dg N478.TT) N478.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h732 p hp
)

#print axioms lines

end R478
end L5Reg
end LRSpectrumFull

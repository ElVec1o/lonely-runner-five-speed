/-- the lines clause for every class of the local table of rep #170. -/
theorem lines (t5 : List T5Rec) (h186 : ∀ p ∈ LinRQSC186.blobs, LinesCl t5 (t4OfRec p.1)) (h187 : ∀ p ∈ LinRQSC187.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N170.nT).map (t4At (LRSpectrumFull.L5S4.dg N170.TT) N170.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h186 p hp
  · exact h187 p hp
)


/-- the lines clause for every class of the local table of rep #153. -/
theorem lines (t5 : List T5Rec) (h7 : ∀ p ∈ LinRQSC7.blobs, LinesCl t5 (t4OfRec p.1)) (h51 : ∀ p ∈ LinRQSC51.blobs, LinesCl t5 (t4OfRec p.1)) (h52 : ∀ p ∈ LinRQSC52.blobs, LinesCl t5 (t4OfRec p.1)) (h150 : ∀ p ∈ LinRQSC150.blobs, LinesCl t5 (t4OfRec p.1)) (h151 : ∀ p ∈ LinRQSC151.blobs, LinesCl t5 (t4OfRec p.1)) (h152 : ∀ p ∈ LinRQSC152.blobs, LinesCl t5 (t4OfRec p.1)) (h153 : ∀ p ∈ LinRQSC153.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N153.nT).map (t4At (LRSpectrumFull.L5S4.dg N153.TT) N153.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N153.nT := List.mem_range.1 hc
  have hn : N153.nT = 362 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 362) := by omega
  rcases hcase with h | h | h | h
  · exact P153_0.lines t5 h51 h52 h150 h151 c h.1 (by omega)
  · exact P153_1.lines t5 h7 h151 h152 c h.1 (by omega)
  · exact P153_2.lines t5 h51 h152 h153 c h.1 (by omega)
  · exact P153_3.lines t5 h51 h153 c h.1 (by omega)

#print axioms lines


/-
# L5Reg.Reg1031 : the lines clause for every class of the local table of rep #1031 (generated by l5reg)

Every local class `i < nT` of rep #1031 (36 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1031T
import LRSpectrumFull.L5S4.LinRQSC907

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1031
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(907, LinRQSC907.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(907, 43, [2, 1, -2, 0, 1, -1, -3, 0, 2]), (907, 44, [2, 1, -2, 0, 1, -1, -3, 1, 1]), (907, 45, [1, 2, -2, 0, -1, 1, -1, 3, -2]), (907, 46, [2, 2, -3, 0, -1, 1, -3, 1, 1]), (907, 47, [0, 0, -1, -3, 1, 1, 2, -1, 0]), (907, 48, [0, -1, 0, -3, 0, 2, -1, -1, 1]), (907, 49, [2, 2, -3, 0, -1, 1, 3, -2, 0]), (907, 50, [2, -2, 1, 0, 1, -1, 3, 1, -2]), (907, 51, [1, 0, 0, 0, 3, -1, -1, 1, 0]), (907, 52, [2, 2, -3, 0, -1, 1, -3, 2, 0]), (907, 53, [2, 1, -2, 0, 1, -1, -1, 2, -1]), (907, 54, [2, 0, -1, 0, -1, 1, 3, 0, -1]), (907, 55, [0, -2, 1, -3, 0, 2, 1, 1, -1]), (907, 56, [2, 0, -1, 0, 3, -1, -3, -1, 2]), (907, 57, [2, 0, -1, 0, 3, -1, -3, 1, 1]), (907, 58, [2, 1, -2, -1, 0, 1, -2, 1, 1]), (907, 59, [2, -2, -1, -1, 0, 1, -1, -3, 2]), (907, 60, [2, 0, -1, -1, -1, 1, -3, 0, 1]), (907, 61, [1, 0, 0, 0, -1, 3, -1, 0, -1]), (907, 62, [2, 0, -1, 0, -1, 1, -3, 0, 1]), (907, 63, [2, -1, 0, -1, -1, 1, -2, 0, 1]), (907, 64, [2, -1, 0, -1, 0, 0, -2, -1, 1]), (907, 65, [2, -1, 0, -1, 0, 0, -2, 1, -1]), (907, 66, [2, -1, 0, -1, 2, -1, -2, 0, 1]), (907, 67, [2, 0, -1, -1, -3, 3, -3, 2, 0]), (907, 68, [0, -1, 1, -3, 0, 1, -1, 0, 0]), (907, 69, [2, 1, -2, -1, 0, 1, -3, 1, 2]), (907, 70, [0, -1, 0, -3, -1, 2, 2, -2, -1]), (907, 71, [2, -1, 0, -1, -1, 1, -3, 2, 0]), (907, 72, [1, 2, -2, 1, 0, -1, 2, -1, -1]), (907, 73, [0, 0, -1, -1, 0, 1, 1, -1, 0]), (907, 74, [1, 0, 0, 1, -1, 3, 2, 1, -2]), (907, 75, [0, -1, 1, -3, 0, 1, 2, 0, -1]), (907, 76, [0, -1, 0, -1, -1, 1, 1, -1, 0]), (907, 77, [0, -1, 1, -3, 0, 1, 2, 0, -1]), (907, 78, [0, -1, 0, -3, -1, 2, 2, -2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1031.TT) N1031.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1031.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1031. -/
theorem lines (t5 : List T5Rec) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1031.nT).map (t4At (LRSpectrumFull.L5S4.dg N1031.TT) N1031.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h907 p hp
)

#print axioms lines

end R1031
end L5Reg
end LRSpectrumFull

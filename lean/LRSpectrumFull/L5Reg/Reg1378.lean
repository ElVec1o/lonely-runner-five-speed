theorem adv_len : adv.length = N1378.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1378. -/
theorem lines (t5 : List T5Rec) (h1005 : ∀ p ∈ LinRQSC1005.blobs, LinesCl t5 (t4OfRec p.1)) (h1016 : ∀ p ∈ LinRQSC1016.blobs, LinesCl t5 (t4OfRec p.1)) (h1022 : ∀ p ∈ LinRQSC1022.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1378.nT).map (t4At (LRSpectrumFull.L5S4.dg N1378.TT) N1378.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h1005 p hp
  · exact h1016 p hp
  · exact h1022 p hp
)

#print axioms lines


/-- the lines clause for every class of the local table of rep #465. -/
theorem lines (t5 : List T5Rec) (h451 : ∀ p ∈ LinRQSC451.blobs, LinesCl t5 (t4OfRec p.1)) (h456 : ∀ p ∈ LinRQSC456.blobs, LinesCl t5 (t4OfRec p.1)) (h729 : ∀ p ∈ LinRQSC729.blobs, LinesCl t5 (t4OfRec p.1)) (h730 : ∀ p ∈ LinRQSC730.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N465.nT).map (t4At (LRSpectrumFull.L5S4.dg N465.TT) N465.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h451 p hp
  · exact h456 p hp
  · exact h729 p hp
  · exact h730 p hp
)


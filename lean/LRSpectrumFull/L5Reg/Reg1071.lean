/-
# L5Reg.Reg1071 : the lines clause for every class of the local table of rep #1071 (generated by l5reg)

Every local class `i < nT` of rep #1071 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1071T
import LRSpectrumFull.L5S4.LinRQSC889
import LRSpectrumFull.L5S4.LinRQSC896
import LRSpectrumFull.L5S4.LinRQSC905
import LRSpectrumFull.L5S4.LinRQSC911
import LRSpectrumFull.L5S4.LinRQSC917

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1071
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(889, LinRQSC889.blobs), (896, LinRQSC896.blobs), (905, LinRQSC905.blobs), (911, LinRQSC911.blobs), (917, LinRQSC917.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(917, 124, [2, 0, -1, 2, -1, 0, -1, -2, 2]), (917, 125, [1, 2, -2, 1, -2, 1, 1, -1, 0]), (917, 126, [2, 1, -1, 2, -1, 0, 3, 0, -1]), (917, 127, [2, 0, -1, 2, -1, 0, -1, -2, 2]), (889, 87, [1, -2, 1, 3, 1, -1, 0, -2, 1]), (917, 128, [2, -1, 0, 2, 0, -1, 1, 3, -3]), (917, 129, [2, -1, 0, -2, 0, 1, -1, -3, 3]), (917, 130, [2, 0, -1, -2, 1, 1, -1, -2, 1]), (917, 131, [1, -1, 0, 0, 1, 0, 3, 0, -1]), (896, 58, [1, 0, 0, -1, -1, 1, 0, 2, -1]), (917, 132, [1, -2, 0, -1, -2, 1, -1, -1, 1]), (917, 133, [1, 2, -1, 0, -2, 1, 3, 1, -1]), (911, 2, [2, -1, 0, -1, -1, 1, -2, -1, 1]), (917, 134, [1, 0, -1, -1, 1, 0, 0, -3, 2]), (917, 135, [2, -1, -1, -2, 0, 1, -1, -2, 1]), (917, 136, [2, -2, 1, -2, 1, 0, -1, 1, 0]), (917, 137, [2, -1, 0, -2, -1, 1, -1, 0, 0]), (917, 138, [2, 1, -1, -2, 1, 0, -1, 0, 0]), (917, 139, [1, 2, -1, -1, 2, 0, 0, -1, 0]), (917, 140, [2, -1, 0, -2, 2, -1, 1, -1, 1]), (905, 147, [0, -2, 1, 1, -2, 0, 2, 1, -2]), (917, 141, [0, -1, 0, -1, 0, 1, 3, 0, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1071.TT) N1071.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1071.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1071. -/
theorem lines (t5 : List T5Rec) (h889 : ∀ p ∈ LinRQSC889.blobs, LinesCl t5 (t4OfRec p.1)) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1)) (h911 : ∀ p ∈ LinRQSC911.blobs, LinesCl t5 (t4OfRec p.1)) (h917 : ∀ p ∈ LinRQSC917.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1071.nT).map (t4At (LRSpectrumFull.L5S4.dg N1071.TT) N1071.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h889 p hp
  · exact h896 p hp
  · exact h905 p hp
  · exact h911 p hp
  · exact h917 p hp
)

#print axioms lines

end R1071
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #802. -/
theorem lines (t5 : List T5Rec) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1)) (h873 : ∀ p ∈ LinRQSC873.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N802.nT).map (t4At (LRSpectrumFull.L5S4.dg N802.TT) N802.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h872 p hp
  · exact h873 p hp
)


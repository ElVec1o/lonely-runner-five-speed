/-
# L5Reg.RegFin125 : the lines clause for the local class tables of 4 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg272
import LRSpectrumFull.L5Reg.Reg283
import LRSpectrumFull.L5Reg.Reg286
import LRSpectrumFull.L5Reg.Reg37

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines272 : ∀ cl ∈ (List.range N272.nT).map (t4At (LRSpectrumFull.L5S4.dg N272.TT) N272.ST), LinesCl T5Store.t5 cl :=
  R272.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem434 p hp))

theorem lines283 : ∀ cl ∈ (List.range N283.nT).map (t4At (LRSpectrumFull.L5S4.dg N283.TT) N283.ST), LinesCl T5Store.t5 cl :=
  R283.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem434 p hp))

theorem lines286 : ∀ cl ∈ (List.range N286.nT).map (t4At (LRSpectrumFull.L5S4.dg N286.TT) N286.ST), LinesCl T5Store.t5 cl :=
  R286.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem434 p hp))

theorem lines37 : ∀ cl ∈ (List.range N37.nT).map (t4At (LRSpectrumFull.L5S4.dg N37.TT) N37.ST), LinesCl T5Store.t5 cl :=
  R37.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem6 p hp)) (fun p hp => FinalGlue.glines p (mem7 p hp))

#print axioms lines272

end L5Reg
end LRSpectrumFull

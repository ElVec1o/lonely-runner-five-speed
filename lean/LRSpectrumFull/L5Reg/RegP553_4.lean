theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N553.TT) N553.ST (assoc bls) 400 adv = true := by decide +kernel

theorem adv_len : adv.length = 19 := by decide +kernel

/-- the lines clause for local classes 400..418 of rep #553. -/
theorem lines (t5 : List T5Rec) (h822 : ∀ p ∈ LinRQSC822.blobs, LinesCl t5 (t4OfRec p.1)) (h823 : ∀ p ∈ LinRQSC823.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 19 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N553.TT) N553.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl
    · exact h822 p hpe
    · exact h823 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines


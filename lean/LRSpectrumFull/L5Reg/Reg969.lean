/-
# L5Reg.Reg969 : the lines clause for every class of the local table of rep #969 (generated by l5reg)

Every local class `i < nT` of rep #969 (24 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O969T
import LRSpectrumFull.L5S4.LinRQSC892

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R969
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(892, 108, [1, -2, 0, 1, 3, -1, -2, 0, 1]), (892, 109, [1, -1, 1, 1, 0, 0, -3, 2, -1]), (892, 110, [2, -1, 0, 1, -1, 0, -3, -2, 1]), (892, 111, [2, 2, -3, 1, -3, 2, -2, -1, 2]), (892, 112, [2, -1, 0, -3, -1, 2, -1, 2, -1]), (892, 113, [2, -2, 1, 1, 0, 0, -2, 1, 0]), (892, 114, [2, -2, -1, 1, 3, -2, -1, 0, 1]), (892, 115, [2, -2, 1, -3, -1, 1, -1, 2, -1]), (892, 116, [2, 2, -3, -3, 1, 1, 2, 1, -2]), (892, 117, [2, -2, -1, -3, -1, 3, 1, 0, -1]), (892, 118, [2, 0, -1, -3, 1, 1, 0, 3, -2]), (892, 119, [2, -1, 0, -3, -1, 2, 1, 1, -1]), (892, 120, [2, 0, -1, -3, 0, 2, 1, -1, 0]), (892, 121, [2, -1, 0, -3, 1, 1, -1, 0, 0]), (892, 122, [2, -2, 1, -3, -1, 2, -1, -2, 2]), (892, 123, [2, 2, -1, 1, -3, 0, 3, 0, -1]), (892, 124, [2, 2, -3, 1, -3, 1, 1, 0, -1]), (892, 125, [2, 0, -1, -3, 0, 1, -1, -1, 0]), (892, 126, [2, 0, -1, 1, -1, 0, 1, 0, -1]), (892, 127, [2, 1, -1, 1, 1, -1, 3, -2, 1]), (892, 128, [2, 0, -1, -3, 0, 1, 1, 1, -1]), (892, 129, [2, 1, -1, -3, 1, 1, 1, -3, 0]), (892, 130, [2, 1, -1, -3, 1, 0, -1, -1, 1]), (892, 131, [0, -2, 1, 0, 3, -2, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N969.TT) N969.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N969.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #969. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N969.nT).map (t4At (LRSpectrumFull.L5S4.dg N969.TT) N969.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h892 p hp
)

#print axioms lines

end R969
end L5Reg
end LRSpectrumFull

import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg68

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines68 : ∀ cl ∈ (List.range N68.nT).map (t4At (LRSpectrumFull.L5S4.dg N68.TT) N68.ST), LinesCl T5Store.t5 cl :=
  R68.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem46 p hp)) (fun p hp => FinalGlue.glines p (mem47 p hp)) (fun p hp => FinalGlue.glines p (mem48 p hp)) (fun p hp => FinalGlue.glines p (mem49 p hp))

#print axioms lines68

end L5Reg
end LRSpectrumFull

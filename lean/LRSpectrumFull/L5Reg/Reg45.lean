theorem adv_len : adv.length = N45.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #45. -/
theorem lines (t5 : List T5Rec) (h28 : ∀ p ∈ LinRQSC28.blobs, LinesCl t5 (t4OfRec p.1)) (h29 : ∀ p ∈ LinRQSC29.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N45.nT).map (t4At (LRSpectrumFull.L5S4.dg N45.TT) N45.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h28 p hp
  · exact h29 p hp
)


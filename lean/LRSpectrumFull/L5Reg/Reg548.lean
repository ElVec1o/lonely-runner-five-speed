/-
# L5Reg.Reg548 : the lines clause for every class of the local table of rep #548 (generated by l5reg)

Every local class `i < nT` of rep #548 (42 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O548T
import LRSpectrumFull.L5S4.LinRQSC803
import LRSpectrumFull.L5S4.LinRQSC804

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R548
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(803, LinRQSC803.blobs), (804, LinRQSC804.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(803, 105, [1, 0, -1, 3, -1, -2, 1, 3, -3]), (803, 106, [1, 0, -1, 3, -1, -2, 0, 3, -2]), (803, 107, [1, 0, -1, 3, -1, -2, 1, 3, -3]), (803, 108, [1, 0, -1, 3, -1, -2, 0, 3, -2]), (803, 109, [1, 0, -1, 3, -1, -2, 1, 3, -3]), (803, 110, [1, 0, -1, 3, -1, -2, 3, 2, -4]), (803, 111, [1, -1, 0, 3, 0, -1, 2, -1, 0]), (803, 112, [1, -1, 0, 3, 0, -1, 0, -1, 0]), (803, 113, [1, -1, 0, 3, -2, -1, 2, -2, -1]), (803, 114, [1, -1, 0, 3, -2, -1, 3, -1, -1]), (804, 0, [1, -1, 0, 3, 0, -1, 1, 3, -1]), (804, 1, [1, -1, 0, 3, 0, -1, 3, 4, -2]), (804, 2, [1, -1, 0, 3, -2, -1, 2, 0, -1]), (804, 3, [1, -1, 0, 3, 0, -2, 1, 4, -3]), (804, 4, [1, -1, 0, 0, -3, 2, -4, -3, 5]), (804, 5, [1, -1, 0, 0, -1, 0, -4, 2, 1]), (804, 6, [1, -1, 0, 0, -3, 1, -4, -4, 3]), (804, 7, [1, -1, 0, 0, -3, 2, -4, -3, 5]), (804, 8, [1, 0, -1, -3, -1, 3, -1, 2, 0]), (804, 9, [1, -1, 0, -3, 0, 1, -3, -4, 2]), (804, 10, [1, 0, -1, 0, 1, 0, 4, 0, -3]), (804, 11, [1, -1, 0, 0, 3, -1, 4, 1, -2]), (804, 12, [1, 0, -1, -3, -1, 3, -1, 2, 0]), (804, 13, [1, 0, -1, -3, -1, 3, -3, 1, 2]), (804, 14, [1, 0, -1, -3, 1, 2, -1, -2, 2]), (804, 15, [1, 0, -1, -3, 1, 2, -2, -2, 3]), (804, 16, [1, 0, 0, -3, 1, 1, 0, -3, -4]), (804, 17, [1, 0, 0, 3, -1, 1, 0, 4, -3]), (804, 18, [1, 0, 0, 3, -1, 1, 2, 3, -2]), (804, 19, [1, 0, 0, -3, 1, 0, -3, -1, 1]), (804, 20, [1, 0, -1, -3, -1, 3, -3, 1, 2]), (804, 21, [1, 0, 0, -3, -1, 1, 0, 2, -3]), (804, 22, [1, 0, 0, -3, -1, 1, 0, 2, -3]), (804, 23, [1, -1, 0, -3, 0, 1, 0, 1, 0]), (804, 24, [1, 0, -1, -3, -1, 2, 0, 1, 0]), (804, 25, [1, -1, 0, -3, 1, 1, -3, 2, 0]), (804, 26, [1, -1, 0, -3, -3, 5, 0, 1, -1]), (804, 27, [1, -1, 0, -3, 0, 2, 0, 1, -1]), (804, 28, [1, 0, -1, -3, -1, 3, 0, 3, -1]), (804, 29, [1, 0, -1, -3, 1, 2, -2, -3, 4]), (804, 30, [1, 0, -1, -3, 1, 2, 0, -4, 3]), (804, 31, [1, 0, -1, -3, -1, 3, -2, 3, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N548.TT) N548.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N548.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #548. -/
theorem lines (t5 : List T5Rec) (h803 : ∀ p ∈ LinRQSC803.blobs, LinesCl t5 (t4OfRec p.1)) (h804 : ∀ p ∈ LinRQSC804.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N548.nT).map (t4At (LRSpectrumFull.L5S4.dg N548.TT) N548.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h803 p hp
  · exact h804 p hp
)

#print axioms lines

end R548
end L5Reg
end LRSpectrumFull

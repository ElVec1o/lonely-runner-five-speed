/-- the lines clause for local classes 600..624 of rep #523. -/
theorem lines (t5 : List T5Rec) (h787 : ∀ p ∈ LinRQSC787.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 600 ≤ c → c < 600 + 25 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N523.TT) N523.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h787 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 600 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines


theorem adv_len : adv.length = N317.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #317. -/
theorem lines (t5 : List T5Rec) (h430 : ∀ p ∈ LinRQSC430.blobs, LinesCl t5 (t4OfRec p.1)) (h679 : ∀ p ∈ LinRQSC679.blobs, LinesCl t5 (t4OfRec p.1)) (h680 : ∀ p ∈ LinRQSC680.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N317.nT).map (t4At (LRSpectrumFull.L5S4.dg N317.TT) N317.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h430 p hp
  · exact h679 p hp
  · exact h680 p hp
)

#print axioms lines


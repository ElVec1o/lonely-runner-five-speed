/-
# L5Reg.RegFin126 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg270
import LRSpectrumFull.L5Reg.Reg289

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines270 : ∀ cl ∈ (List.range N270.nT).map (t4At (LRSpectrumFull.L5S4.dg N270.TT) N270.ST), LinesCl T5Store.t5 cl :=
  R270.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem429 p hp))

theorem lines289 : ∀ cl ∈ (List.range N289.nT).map (t4At (LRSpectrumFull.L5S4.dg N289.TT) N289.ST), LinesCl T5Store.t5 cl :=
  R289.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem434 p hp)) (fun p hp => FinalGlue.glines p (mem435 p hp)) (fun p hp => FinalGlue.glines p (mem436 p hp)) (fun p hp => FinalGlue.glines p (mem437 p hp)) (fun p hp => FinalGlue.glines p (mem438 p hp)) (fun p hp => FinalGlue.glines p (mem439 p hp))

#print axioms lines270

end L5Reg
end LRSpectrumFull

/-
# L5Reg.RegP160_3 : part 3 of the lines clause of rep #160: local classes 300..315 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O160T
import LRSpectrumFull.L5S4.LinRQSC167

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P160_3
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(167, LinRQSC167.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(167, 17, [1, 0, 0, -1, -1, -1, 0, -2, -3]), (167, 18, [2, 0, -1, -2, -1, 1, -1, -3, 1]), (167, 19, [1, 0, 0, -1, -1, -1, 0, -3, -2]), (167, 20, [2, 0, -1, -2, -1, 1, 1, -3, 0]), (167, 21, [1, 0, 0, -1, -1, -1, 0, -3, -2]), (167, 22, [2, 0, -1, -2, -1, 1, 1, -3, 0]), (167, 23, [2, -1, -1, -2, 0, 1, -1, 2, 0]), (167, 24, [1, 0, 0, -1, -2, 1, 0, 3, -2]), (167, 25, [2, 0, -1, -2, -1, 1, -1, -2, 1]), (167, 26, [1, 0, 0, -1, -1, 0, 0, -2, 1]), (167, 27, [2, 0, -1, -2, -1, 1, 1, -2, 0]), (167, 28, [2, 0, -1, -2, -1, 2, 1, -2, 1]), (167, 29, [1, 0, 0, -1, -1, 1, 0, -3, 2]), (167, 30, [2, 0, -1, -2, -1, 2, -1, -3, 3]), (167, 31, [1, 0, 0, -1, -1, 1, 0, -3, 2]), (167, 32, [2, 0, -1, -2, -1, 2, 1, -3, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N160.TT) N160.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 16 := by decide +kernel

/-- the lines clause for local classes 300..315 of rep #160. -/
theorem lines (t5 : List T5Rec) (h167 : ∀ p ∈ LinRQSC167.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 16 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N160.TT) N160.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h167 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P160_3
end L5Reg
end LRSpectrumFull

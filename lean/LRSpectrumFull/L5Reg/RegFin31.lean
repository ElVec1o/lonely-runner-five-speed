/-
# L5Reg.RegFin31 : the lines clause for the local class tables of 3 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg47
import LRSpectrumFull.L5Reg.Reg121
import LRSpectrumFull.L5Reg.Reg59

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines47 : ∀ cl ∈ (List.range N47.nT).map (t4At (LRSpectrumFull.L5S4.dg N47.TT) N47.ST), LinesCl T5Store.t5 cl :=
  R47.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem32 p hp))

theorem lines121 : ∀ cl ∈ (List.range N121.nT).map (t4At (LRSpectrumFull.L5S4.dg N121.TT) N121.ST), LinesCl T5Store.t5 cl :=
  R121.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem32 p hp)) (fun p hp => FinalGlue.glines p (mem38 p hp)) (fun p hp => FinalGlue.glines p (mem112 p hp)) (fun p hp => FinalGlue.glines p (mem113 p hp)) (fun p hp => FinalGlue.glines p (mem114 p hp))

theorem lines59 : ∀ cl ∈ (List.range N59.nT).map (t4At (LRSpectrumFull.L5S4.dg N59.TT) N59.ST), LinesCl T5Store.t5 cl :=
  R59.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem32 p hp)) (fun p hp => FinalGlue.glines p (mem37 p hp)) (fun p hp => FinalGlue.glines p (mem38 p hp))

#print axioms lines47

end L5Reg
end LRSpectrumFull

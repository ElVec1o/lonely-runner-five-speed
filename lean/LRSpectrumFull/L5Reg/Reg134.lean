/-- the lines clause for every class of the local table of rep #134. -/
theorem lines (t5 : List T5Rec) (h118 : ∀ p ∈ LinRQSC118.blobs, LinesCl t5 (t4OfRec p.1)) (h119 : ∀ p ∈ LinRQSC119.blobs, LinesCl t5 (t4OfRec p.1)) (h120 : ∀ p ∈ LinRQSC120.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N134.nT).map (t4At (LRSpectrumFull.L5S4.dg N134.TT) N134.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N134.nT := List.mem_range.1 hc
  have hn : N134.nT = 435 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 400) ∨ (400 ≤ c ∧ c < 435) := by omega
  rcases hcase with h | h | h | h | h
  · exact P134_0.lines t5 h118 c h.1 (by omega)
  · exact P134_1.lines t5 h118 h119 c h.1 (by omega)
  · exact P134_2.lines t5 h119 h120 c h.1 (by omega)
  · exact P134_3.lines t5 h120 c h.1 (by omega)
  · exact P134_4.lines t5 h120 c h.1 (by omega)

#print axioms lines


theorem lines (t5 : List T5Rec) (h693 : ∀ p ∈ LinRQSC693.blobs, LinesCl t5 (t4OfRec p.1)) (h694 : ∀ p ∈ LinRQSC694.blobs, LinesCl t5 (t4OfRec p.1))

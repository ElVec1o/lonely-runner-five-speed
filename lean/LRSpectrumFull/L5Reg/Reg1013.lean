/-- the lines clause for every class of the local table of rep #1013. -/
theorem lines (t5 : List T5Rec) (h899 : ∀ p ∈ LinRQSC899.blobs, LinesCl t5 (t4OfRec p.1)) (h900 : ∀ p ∈ LinRQSC900.blobs, LinesCl t5 (t4OfRec p.1)) (h905 : ∀ p ∈ LinRQSC905.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1013.nT).map (t4At (LRSpectrumFull.L5S4.dg N1013.TT) N1013.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h899 p hp
  · exact h900 p hp
  · exact h905 p hp
)


theorem lines (t5 : List T5Rec) (h79 : ∀ p ∈ LinRQSC79.blobs, LinesCl t5 (t4OfRec p.1)) (h80 : ∀ p ∈ LinRQSC80.blobs, LinesCl t5 (t4OfRec p.1))

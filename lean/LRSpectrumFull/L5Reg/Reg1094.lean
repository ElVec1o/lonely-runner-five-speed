/-
# L5Reg.Reg1094 : the lines clause for every class of the local table of rep #1094 (generated by l5reg)

Every local class `i < nT` of rep #1094 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1094T
import LRSpectrumFull.L5S4.LinRQSC909
import LRSpectrumFull.L5S4.LinRQSC917
import LRSpectrumFull.L5S4.LinRQSC920

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1094
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(909, LinRQSC909.blobs), (917, LinRQSC917.blobs), (920, LinRQSC920.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(920, 85, [2, -1, 0, -1, 0, 0, 2, 1, -1]), (920, 86, [2, -1, -1, -1, 2, 0, 3, -2, -1]), (909, 16, [2, 0, 1, -3, 1, 0, -1, 0, 0]), (920, 87, [0, 0, -1, 1, 0, 0, 2, -1, 0]), (920, 88, [2, -1, 0, -1, 0, 0, -3, -1, 1]), (917, 146, [2, -1, 0, -3, 1, -1, -1, 2, 2]), (917, 147, [2, 0, -1, -2, 1, 0, 1, 2, -2]), (920, 89, [1, 0, 0, 0, -3, 2, 3, -1, 1]), (920, 90, [0, 2, -1, -1, -1, 1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1094.TT) N1094.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1094.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1094. -/
theorem lines (t5 : List T5Rec) (h909 : ∀ p ∈ LinRQSC909.blobs, LinesCl t5 (t4OfRec p.1)) (h917 : ∀ p ∈ LinRQSC917.blobs, LinesCl t5 (t4OfRec p.1)) (h920 : ∀ p ∈ LinRQSC920.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1094.nT).map (t4At (LRSpectrumFull.L5S4.dg N1094.TT) N1094.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h909 p hp
  · exact h917 p hp
  · exact h920 p hp
)

#print axioms lines

end R1094
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 0..99 of rep #80. -/
theorem lines (t5 : List T5Rec) (h31 : ∀ p ∈ LinRQSC31.blobs, LinesCl t5 (t4OfRec p.1)) (h76 : ∀ p ∈ LinRQSC76.blobs, LinesCl t5 (t4OfRec p.1)) (h77 : ∀ p ∈ LinRQSC77.blobs, LinesCl t5 (t4OfRec p.1))

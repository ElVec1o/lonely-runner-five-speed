theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N53.TT) N53.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N53.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #53. -/
theorem lines (t5 : List T5Rec) (h36 : ∀ p ∈ LinRQSC36.blobs, LinesCl t5 (t4OfRec p.1)) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N53.nT).map (t4At (LRSpectrumFull.L5S4.dg N53.TT) N53.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h36 p hp
  · exact h37 p hp
)

#print axioms lines


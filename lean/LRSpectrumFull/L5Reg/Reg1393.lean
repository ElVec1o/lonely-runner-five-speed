/-- the lines clause for every class of the local table of rep #1393. -/
theorem lines (t5 : List T5Rec) (h963 : ∀ p ∈ LinRQSC963.blobs, LinesCl t5 (t4OfRec p.1)) (h1002 : ∀ p ∈ LinRQSC1002.blobs, LinesCl t5 (t4OfRec p.1)) (h1024 : ∀ p ∈ LinRQSC1024.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1393.nT).map (t4At (LRSpectrumFull.L5S4.dg N1393.TT) N1393.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h963 p hp
  · exact h1002 p hp
  · exact h1024 p hp
)


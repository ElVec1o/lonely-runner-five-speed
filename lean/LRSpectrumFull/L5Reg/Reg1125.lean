/-
# L5Reg.Reg1125 : the lines clause for every class of the local table of rep #1125 (generated by l5reg)

Every local class `i < nT` of rep #1125 (34 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1125T
import LRSpectrumFull.L5S4.LinRQSC923

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1125
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(923, LinRQSC923.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(923, 80, [1, 1, -1, 1, -2, 0, 2, 1, -2]), (923, 81, [1, -1, 0, 1, -2, 1, -2, -2, 3]), (923, 82, [1, -1, 0, 1, -2, 1, -3, -1, 3]), (923, 83, [1, 0, 0, 1, -1, 1, 2, -1, 0]), (923, 84, [1, 1, -1, 1, -2, 1, 2, 0, -1]), (923, 85, [1, -1, 0, 2, 0, -1, 2, -1, 0]), (923, 86, [1, 1, -1, 2, -2, 1, 1, 2, -2]), (923, 87, [1, 1, -1, 0, -2, 1, -3, 0, 2]), (923, 88, [1, -1, 0, 0, 1, -1, -3, 1, 1]), (923, 89, [1, -1, 0, -2, 0, 1, 0, 3, -2]), (923, 90, [1, 1, -1, -2, 1, 1, -1, 0, 1]), (923, 91, [1, 0, -1, -2, 2, 1, 0, -1, 0]), (923, 92, [1, 0, -1, -2, 1, 0, 0, 0, 1]), (923, 93, [1, 0, -1, -2, 1, 1, -2, 2, 1]), (923, 94, [1, -1, 0, 2, 2, -3, -1, 2, -1]), (923, 95, [1, 0, 0, -2, 0, 1, 0, -1, 1]), (923, 96, [1, 1, -1, 2, 1, -1, -1, 2, -1]), (923, 97, [1, 0, 0, -2, 0, 1, 1, -1, -1]), (923, 98, [1, -1, 0, 2, -1, 0, -2, -2, 1]), (923, 99, [1, 1, -1, 1, 2, -1, 2, -1, -1]), (923, 100, [1, 1, -1, 1, -2, 1, -2, -1, 1]), (923, 101, [1, 1, -1, -2, 1, 0, -2, 0, 1]), (923, 102, [1, 0, -1, -2, 1, -2, 0, 0, 1]), (923, 103, [1, 1, -1, -2, 1, 1, -1, 0, 1]), (923, 104, [1, 1, -1, -2, 1, 0, 0, -1, 1]), (923, 105, [1, -1, -1, -2, 1, 0, 0, 0, 1]), (923, 106, [1, 1, -1, -2, 1, 0, -2, 0, 1]), (923, 107, [1, 1, -1, -2, 1, 0, -2, -1, 1]), (923, 108, [1, -1, 0, -2, 1, -1, -2, 1, 0]), (923, 109, [1, 0, 0, -2, 0, 1, 0, -1, 0]), (923, 110, [1, -1, 0, -2, -1, 2, 0, -2, 1]), (923, 111, [1, -1, 0, -2, 1, 0, -1, 0, -1]), (923, 112, [1, 0, 0, -2, 0, 1, 1, -1, -1]), (923, 113, [1, 1, -1, -2, 1, 0, 0, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1125.TT) N1125.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1125.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1125. -/
theorem lines (t5 : List T5Rec) (h923 : ∀ p ∈ LinRQSC923.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1125.nT).map (t4At (LRSpectrumFull.L5S4.dg N1125.TT) N1125.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h923 p hp
)

#print axioms lines

end R1125
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1007 : the lines clause for every class of the local table of rep #1007 (generated by l5reg)

Every local class `i < nT` of rep #1007 (27 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1007T
import LRSpectrumFull.L5S4.LinRQSC904

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1007
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(904, LinRQSC904.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(904, 86, [2, 0, -1, 1, 3, -3, -1, 2, -1]), (904, 87, [2, -1, 0, 1, 1, -1, -3, 2, 0]), (904, 88, [2, 0, -1, 1, 1, -1, -3, 0, 2]), (904, 89, [2, 0, -1, 1, 3, -1, 2, -1, -1]), (904, 90, [2, -1, -1, 1, 1, -1, 2, -2, -1]), (904, 91, [2, -2, -1, 1, 1, -1, -2, -3, 2]), (904, 92, [2, -2, -1, 1, 0, -1, -3, 1, 2]), (904, 93, [2, 0, -1, 1, 3, -3, 3, -2, 0]), (904, 94, [2, -1, -1, 1, -1, 0, 2, 2, -3]), (904, 95, [0, 2, 1, 0, 1, 1, -1, -1, -1]), (904, 96, [2, -2, 1, 1, 1, -1, -3, -2, 2]), (904, 97, [2, 0, -1, 1, 3, -3, 2, 1, -2]), (904, 98, [2, -2, 1, -1, 0, 0, 1, 1, -1]), (904, 99, [0, 2, -1, 3, 1, -1, 2, -1, 0]), (904, 100, [2, -1, 0, -1, 0, 0, 2, -1, 1]), (904, 101, [2, -1, 0, -1, 0, 0, 2, 0, -1]), (904, 102, [2, 1, -1, -1, 1, 0, 3, -1, -1]), (904, 103, [2, 0, -1, -1, 1, 0, 3, -2, -1]), (904, 104, [1, 0, -1, 1, 3, -2, -3, -1, 3]), (904, 105, [1, -2, 0, 1, -1, 0, -3, -1, 1]), (904, 106, [0, 1, 1, 1, 0, 1, 0, -1, -2]), (904, 107, [0, -1, 0, 3, -2, -2, 1, 0, -1]), (904, 108, [2, -1, -1, -1, 2, 0, 3, -1, -2]), (904, 109, [0, -1, 0, 1, -1, 0, 0, 2, -1]), (904, 110, [0, 2, -1, 1, -1, 0, 1, 2, -1]), (904, 111, [0, 2, -1, 3, -1, -2, 2, 3, -3]), (904, 112, [0, -1, 1, 3, -1, 0, 2, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1007.TT) N1007.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1007.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1007. -/
theorem lines (t5 : List T5Rec) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1007.nT).map (t4At (LRSpectrumFull.L5S4.dg N1007.TT) N1007.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h904 p hp
)

#print axioms lines

end R1007
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #96. -/
theorem lines (t5 : List T5Rec) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1)) (h96 : ∀ p ∈ LinRQSC96.blobs, LinesCl t5 (t4OfRec p.1)) (h97 : ∀ p ∈ LinRQSC97.blobs, LinesCl t5 (t4OfRec p.1)) (h98 : ∀ p ∈ LinRQSC98.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N96.nT).map (t4At (LRSpectrumFull.L5S4.dg N96.TT) N96.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h37 p hp
  · exact h96 p hp
  · exact h97 p hp
  · exact h98 p hp
)


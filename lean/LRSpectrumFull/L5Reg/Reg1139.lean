/-
# L5Reg.Reg1139 : the lines clause for every class of the local table of rep #1139 (generated by l5reg)

Every local class `i < nT` of rep #1139 (37 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1139T
import LRSpectrumFull.L5S4.LinRQSC923
import LRSpectrumFull.L5S4.LinRQSC924
import LRSpectrumFull.L5S4.LinRQSC925

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1139
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(923, LinRQSC923.blobs), (924, LinRQSC924.blobs), (925, LinRQSC925.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(924, 146, [1, -1, 0, 1, 1, -1, -3, 0, 2]), (924, 147, [1, -1, 0, 1, 0, 0, -2, 1, 1]), (924, 148, [1, 1, -1, 1, -1, 0, 2, -1, 0]), (924, 149, [1, -1, 0, 1, 1, -1, -2, -1, 2]), (924, 150, [1, 1, -1, 1, -1, 0, 3, 0, -1]), (924, 151, [1, -1, 0, 1, 1, -1, -1, 0, 0]), (924, 152, [1, -1, 0, 1, 1, -1, -2, -1, 1]), (924, 153, [0, -1, 0, 1, 1, -1, 2, -1, -1]), (924, 154, [0, -1, 0, 1, 1, -1, 2, -1, -1]), (924, 155, [0, -1, 0, 1, 1, -1, 3, 0, -2]), (924, 156, [0, -1, 1, 1, -1, 0, -3, -1, 3]), (924, 157, [1, 0, -1, 1, -1, 1, 2, -1, 1]), (924, 158, [0, 1, -1, 1, -1, 1, -2, -1, 0]), (924, 159, [0, -1, 1, 1, -1, 0, -2, -1, 2]), (924, 160, [1, 1, -1, 1, -1, 0, 1, 0, 0]), (924, 161, [1, 1, -1, 1, -1, 0, 1, 0, 0]), (924, 162, [0, -1, 1, 1, -1, 0, -2, -1, 2]), (924, 163, [1, 0, 0, 1, 0, 1, 2, -1, -1]), (924, 164, [1, 0, 0, 1, -1, 0, 2, -1, 1]), (924, 165, [1, 0, 0, 1, -1, 0, 2, -1, 1]), (924, 166, [0, -1, 1, 1, -1, 0, -2, 0, 1]), (924, 167, [1, 0, 0, 1, 0, 1, 2, -1, -1]), (924, 168, [1, 0, 0, 1, -1, 0, 1, 1, -1]), (924, 169, [1, -1, 0, 1, -1, 1, 2, -1, 1]), (924, 170, [1, 0, 0, 1, 0, 1, 2, -1, 0]), (923, 118, [1, -1, -1, 1, 0, 0, -1, 1, 0]), (924, 171, [1, 0, 0, 1, -1, 0, 2, 2, -1]), (924, 172, [1, 0, 0, 1, -1, 0, 2, 1, -1]), (924, 173, [1, 0, 0, 1, 1, 0, 2, -1, -1]), (924, 174, [1, 0, 0, 1, -1, 0, 2, 1, -1]), (924, 175, [1, 0, 0, 1, -1, 0, 1, 1, -1]), (924, 176, [1, 0, 0, 1, 1, 0, 1, -1, -1]), (924, 177, [1, 0, 0, 1, 0, 1, 2, -1, 0]), (923, 121, [1, 0, 0, 1, 0, -1, -1, -1, 0]), (924, 178, [1, 0, 0, 1, 1, 0, 1, -1, -1]), (925, 0, [1, 0, 0, 1, 0, 1, 2, -1, 0]), (925, 1, [1, 0, 0, 1, 1, 0, 2, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1139.TT) N1139.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1139.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1139. -/
theorem lines (t5 : List T5Rec) (h923 : ∀ p ∈ LinRQSC923.blobs, LinesCl t5 (t4OfRec p.1)) (h924 : ∀ p ∈ LinRQSC924.blobs, LinesCl t5 (t4OfRec p.1)) (h925 : ∀ p ∈ LinRQSC925.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1139.nT).map (t4At (LRSpectrumFull.L5S4.dg N1139.TT) N1139.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h923 p hp
  · exact h924 p hp
  · exact h925 p hp
)

#print axioms lines

end R1139
end L5Reg
end LRSpectrumFull

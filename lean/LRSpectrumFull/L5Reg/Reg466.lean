theorem lines (t5 : List T5Rec) (h458 : ∀ p ∈ LinRQSC458.blobs, LinesCl t5 (t4OfRec p.1)) (h706 : ∀ p ∈ LinRQSC706.blobs, LinesCl t5 (t4OfRec p.1)) (h730 : ∀ p ∈ LinRQSC730.blobs, LinesCl t5 (t4OfRec p.1)) (h731 : ∀ p ∈ LinRQSC731.blobs, LinesCl t5 (t4OfRec p.1)) (h732 : ∀ p ∈ LinRQSC732.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N466.nT).map (t4At (LRSpectrumFull.L5S4.dg N466.TT) N466.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h458 p hp
  · exact h706 p hp
  · exact h730 p hp
  · exact h731 p hp
  · exact h732 p hp
)


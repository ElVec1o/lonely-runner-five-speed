/-
# L5Reg.Reg316 : the lines clause for every class of the local table of rep #316 (generated by l5reg)

Every local class `i < nT` of rep #316 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O316T
import LRSpectrumFull.L5S4.LinRQSC200
import LRSpectrumFull.L5S4.LinRQSC679

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R316
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(200, LinRQSC200.blobs), (679, LinRQSC679.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(679, 30, [1, 0, -1, 4, -1, -3, 3, 2, -4]), (679, 31, [1, 0, -1, 4, -2, -3, 4, 3, -5]), (679, 32, [1, 0, -1, 4, -2, -3, 1, 5, -3]), (679, 33, [1, -1, 0, 4, 3, -6, 2, -1, -1]), (679, 34, [1, -1, 0, 4, 3, -4, 0, -2, 1]), (679, 35, [0, 1, 0, 1, -3, 0, 2, 3, -1]), (679, 36, [1, 0, -1, -3, 2, 2, 0, 5, -2]), (679, 37, [1, -1, 0, 4, 0, -3, 3, 4, -5]), (679, 38, [1, -1, 0, 4, -2, -1, 2, 1, -1]), (679, 39, [1, -1, 0, 4, 0, -1, 1, 4, -1]), (679, 40, [1, -1, 0, 4, -3, -1, 0, 1, 0]), (679, 41, [1, -1, 0, -3, -4, 3, 4, 1, -2]), (679, 42, [1, -1, 0, 4, 0, -3, 3, 4, -5]), (679, 43, [1, -1, 0, 4, 0, -1, 1, 4, -1]), (679, 44, [1, -1, 0, -3, -4, 1, 1, -2, 0]), (200, 7, [1, -1, 0, -4, -3, 2, 0, 4, -1]), (679, 45, [1, -1, 0, 0, 3, -1, -4, -4, 3]), (679, 46, [1, -1, 0, -3, 0, 2, 1, 4, -3]), (679, 47, [1, -1, 0, -3, 0, 2, 4, 4, -5]), (679, 48, [1, -1, 0, -3, 0, 2, 4, 4, -5])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N316.TT) N316.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N316.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #316. -/
theorem lines (t5 : List T5Rec) (h200 : ∀ p ∈ LinRQSC200.blobs, LinesCl t5 (t4OfRec p.1)) (h679 : ∀ p ∈ LinRQSC679.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N316.nT).map (t4At (LRSpectrumFull.L5S4.dg N316.TT) N316.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h200 p hp
  · exact h679 p hp
)

#print axioms lines

end R316
end L5Reg
end LRSpectrumFull

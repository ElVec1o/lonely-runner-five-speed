/-- the lines clause for every class of the local table of rep #155. -/
theorem lines (t5 : List T5Rec) (h88 : ∀ p ∈ LinRQSC88.blobs, LinesCl t5 (t4OfRec p.1)) (h89 : ∀ p ∈ LinRQSC89.blobs, LinesCl t5 (t4OfRec p.1)) (h157 : ∀ p ∈ LinRQSC157.blobs, LinesCl t5 (t4OfRec p.1)) (h158 : ∀ p ∈ LinRQSC158.blobs, LinesCl t5 (t4OfRec p.1)) (h159 : ∀ p ∈ LinRQSC159.blobs, LinesCl t5 (t4OfRec p.1)) (h160 : ∀ p ∈ LinRQSC160.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N155.nT).map (t4At (LRSpectrumFull.L5S4.dg N155.TT) N155.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N155.nT := List.mem_range.1 hc
  have hn : N155.nT = 371 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 371) := by omega
  rcases hcase with h | h | h | h
  · exact P155_0.lines t5 h89 h157 h158 c h.1 (by omega)
  · exact P155_1.lines t5 h88 h89 h158 h159 c h.1 (by omega)
  · exact P155_2.lines t5 h159 h160 c h.1 (by omega)
  · exact P155_3.lines t5 h160 c h.1 (by omega)


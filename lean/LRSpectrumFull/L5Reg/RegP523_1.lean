/-- the lines clause for local classes 100..199 of rep #523. -/
theorem lines (t5 : List T5Rec) (h492 : ∀ p ∈ LinRQSC492.blobs, LinesCl t5 (t4OfRec p.1)) (h718 : ∀ p ∈ LinRQSC718.blobs, LinesCl t5 (t4OfRec p.1)) (h719 : ∀ p ∈ LinRQSC719.blobs, LinesCl t5 (t4OfRec p.1)) (h781 : ∀ p ∈ LinRQSC781.blobs, LinesCl t5 (t4OfRec p.1)) (h782 : ∀ p ∈ LinRQSC782.blobs, LinesCl t5 (t4OfRec p.1))

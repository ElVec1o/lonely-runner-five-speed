/-
# L5Reg.Reg884 : the lines clause for every class of the local table of rep #884 (generated by l5reg)

Every local class `i < nT` of rep #884 (10 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O884T
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R884
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 111, [3, 0, -1, 1, -3, 1, 0, 2, -1]), (881, 112, [3, -1, -1, 1, -2, 1, -3, -3, 4]), (881, 113, [3, -1, 0, 1, 0, 0, 3, 2, -1]), (881, 114, [3, 0, -1, 1, -1, 0, -1, 3, -1]), (881, 115, [1, 0, 0, 0, 3, -1, -3, -2, 1]), (881, 116, [3, -1, -1, 1, -2, 1, -1, -2, 2]), (881, 117, [0, 1, -1, -1, 1, -1, 0, 0, -1]), (881, 118, [3, -2, 0, 1, -1, 0, 0, 0, -1]), (881, 119, [0, -1, 1, -1, -2, 2, 0, -3, 2]), (881, 120, [0, -3, 2, -3, -1, 2, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N884.TT) N884.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N884.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #884. -/
theorem lines (t5 : List T5Rec) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N884.nT).map (t4At (LRSpectrumFull.L5S4.dg N884.TT) N884.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h881 p hp
)

#print axioms lines

end R884
end L5Reg
end LRSpectrumFull

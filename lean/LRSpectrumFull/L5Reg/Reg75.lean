/-- the lines clause for every class of the local table of rep #75. -/
theorem lines (t5 : List T5Rec) (h59 : ∀ p ∈ LinRQSC59.blobs, LinesCl t5 (t4OfRec p.1)) (h60 : ∀ p ∈ LinRQSC60.blobs, LinesCl t5 (t4OfRec p.1)) (h61 : ∀ p ∈ LinRQSC61.blobs, LinesCl t5 (t4OfRec p.1))

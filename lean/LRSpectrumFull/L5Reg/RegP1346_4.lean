/-- the lines clause for local classes 400..417 of rep #1346. -/
theorem lines (t5 : List T5Rec) (h985 : ∀ p ∈ LinRQSC985.blobs, LinesCl t5 (t4OfRec p.1)) (h986 : ∀ p ∈ LinRQSC986.blobs, LinesCl t5 (t4OfRec p.1)) (h987 : ∀ p ∈ LinRQSC987.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 400 ≤ c → c < 400 + 18 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N1346.TT) N1346.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h985 p hpe
    · exact h986 p hpe
    · exact h987 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 400 advOk c h1 ?_
  rw [adv_len]; exact h2


/-- the lines clause for every class of the local table of rep #132. -/
theorem lines (t5 : List T5Rec) (h115 : ∀ p ∈ LinRQSC115.blobs, LinesCl t5 (t4OfRec p.1)) (h116 : ∀ p ∈ LinRQSC116.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N132.nT).map (t4At (LRSpectrumFull.L5S4.dg N132.TT) N132.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h115 p hp
  · exact h116 p hp
)


/-- the lines clause for every class of the local table of rep #559. -/
theorem lines (t5 : List T5Rec) (h597 : ∀ p ∈ LinRQSC597.blobs, LinesCl t5 (t4OfRec p.1)) (h837 : ∀ p ∈ LinRQSC837.blobs, LinesCl t5 (t4OfRec p.1)) (h838 : ∀ p ∈ LinRQSC838.blobs, LinesCl t5 (t4OfRec p.1)) (h839 : ∀ p ∈ LinRQSC839.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N559.nT).map (t4At (LRSpectrumFull.L5S4.dg N559.TT) N559.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h597 p hp
  · exact h837 p hp
  · exact h838 p hp
  · exact h839 p hp
)


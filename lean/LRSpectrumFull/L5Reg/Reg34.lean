/-
# L5Reg.Reg34 : the lines clause for every class of the local table of rep #34 (generated by l5reg)

Every local class `i < nT` of rep #34 (11 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O34T
import LRSpectrumFull.L5S4.LinRQSC2

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R34
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(2, LinRQSC2.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(2, 193, [2, -1, 0, -2, 2, -1, -1, 1, 0]), (2, 194, [2, 1, -2, -2, 4, -1, 1, -1, 0]), (2, 195, [2, -1, -1, -2, 2, 1, -1, 1, 0]), (2, 196, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (2, 197, [1, 0, 0, -1, 0, 1, 0, -1, 0]), (2, 198, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (2, 199, [1, 1, -1, -1, 4, -2, -1, 2, -1]), (2, 200, [2, 1, -1, -2, 4, -1, 1, -1, 0]), (2, 201, [1, 1, -1, -1, 4, -2, -1, 2, -1]), (2, 202, [2, -1, -1, -2, 1, 2, -1, 0, 1]), (2, 203, [1, 0, 0, -1, 0, 1, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N34.TT) N34.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N34.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #34. -/
theorem lines (t5 : List T5Rec) (h2 : ∀ p ∈ LinRQSC2.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N34.nT).map (t4At (LRSpectrumFull.L5S4.dg N34.TT) N34.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h2 p hp
)

#print axioms lines

end R34
end L5Reg
end LRSpectrumFull

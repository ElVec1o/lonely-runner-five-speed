theorem lines (t5 : List T5Rec) (h74 : ∀ p ∈ LinRQSC74.blobs, LinesCl t5 (t4OfRec p.1)) (h75 : ∀ p ∈ LinRQSC75.blobs, LinesCl t5 (t4OfRec p.1)) (h177 : ∀ p ∈ LinRQSC177.blobs, LinesCl t5 (t4OfRec p.1)) (h178 : ∀ p ∈ LinRQSC178.blobs, LinesCl t5 (t4OfRec p.1))

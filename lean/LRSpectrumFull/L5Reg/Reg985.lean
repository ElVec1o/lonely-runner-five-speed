theorem adv_len : adv.length = N985.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #985. -/
theorem lines (t5 : List T5Rec) (h891 : ∀ p ∈ LinRQSC891.blobs, LinesCl t5 (t4OfRec p.1)) (h895 : ∀ p ∈ LinRQSC895.blobs, LinesCl t5 (t4OfRec p.1)) (h901 : ∀ p ∈ LinRQSC901.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N985.nT).map (t4At (LRSpectrumFull.L5S4.dg N985.TT) N985.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h891 p hp
  · exact h895 p hp
  · exact h901 p hp
)

#print axioms lines


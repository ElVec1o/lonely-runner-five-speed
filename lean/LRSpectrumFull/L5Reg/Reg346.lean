theorem adv_len : adv.length = N346.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #346. -/
theorem lines (t5 : List T5Rec) (h709 : ∀ p ∈ LinRQSC709.blobs, LinesCl t5 (t4OfRec p.1)) (h710 : ∀ p ∈ LinRQSC710.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N346.nT).map (t4At (LRSpectrumFull.L5S4.dg N346.TT) N346.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h709 p hp
  · exact h710 p hp
)


/-- the lines clause for every class of the local table of rep #995. -/
theorem lines (t5 : List T5Rec) (h902 : ∀ p ∈ LinRQSC902.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N995.nT).map (t4At (LRSpectrumFull.L5S4.dg N995.TT) N995.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h902 p hp
)


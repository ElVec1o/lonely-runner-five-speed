theorem lines (t5 : List T5Rec) (h4 : ∀ p ∈ LinRQSC4.blobs, LinesCl t5 (t4OfRec p.1)) (h5 : ∀ p ∈ LinRQSC5.blobs, LinesCl t5 (t4OfRec p.1)) (h39 : ∀ p ∈ LinRQSC39.blobs, LinesCl t5 (t4OfRec p.1)) (h40 : ∀ p ∈ LinRQSC40.blobs, LinesCl t5 (t4OfRec p.1)) (h41 : ∀ p ∈ LinRQSC41.blobs, LinesCl t5 (t4OfRec p.1)) (h42 : ∀ p ∈ LinRQSC42.blobs, LinesCl t5 (t4OfRec p.1)) (h116 : ∀ p ∈ LinRQSC116.blobs, LinesCl t5 (t4OfRec p.1)) (h117 : ∀ p ∈ LinRQSC117.blobs, LinesCl t5 (t4OfRec p.1)) (h118 : ∀ p ∈ LinRQSC118.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N133.nT).map (t4At (LRSpectrumFull.L5S4.dg N133.TT) N133.ST), LinesCl t5 cl := by

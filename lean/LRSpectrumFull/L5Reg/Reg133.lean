  have hn : N133.nT = 341 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 341) := by omega
  rcases hcase with h | h | h | h
  · exact P133_0.lines t5 h4 h5 h41 h42 h116 c h.1 (by omega)
  · exact P133_1.lines t5 h39 h40 h41 h42 h116 h117 c h.1 (by omega)
  · exact P133_2.lines t5 h39 h40 h42 h117 c h.1 (by omega)
  · exact P133_3.lines t5 h117 h118 c h.1 (by omega)


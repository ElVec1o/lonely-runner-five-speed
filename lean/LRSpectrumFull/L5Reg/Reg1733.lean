theorem lines (t5 : List T5Rec) (h1029 : ∀ p ∈ LinRQSC1029.blobs, LinesCl t5 (t4OfRec p.1)) (h1030 : ∀ p ∈ LinRQSC1030.blobs, LinesCl t5 (t4OfRec p.1)) (h1045 : ∀ p ∈ LinRQSC1045.blobs, LinesCl t5 (t4OfRec p.1))

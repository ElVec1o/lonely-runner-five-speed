/-
# L5Reg.Reg1001 : the lines clause for every class of the local table of rep #1001 (generated by l5reg)

Every local class `i < nT` of rep #1001 (33 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1001T
import LRSpectrumFull.L5S4.LinRQSC904

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1001
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(904, LinRQSC904.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(904, 30, [0, -1, 0, 0, -2, -1, -1, 0, 0]), (904, 31, [2, 1, -1, -1, 2, -1, 2, -1, 0]), (904, 32, [2, -2, -1, -1, 1, 1, 3, -2, -2]), (904, 33, [2, 0, -1, -1, 0, 1, 2, -1, -1]), (904, 34, [2, -2, -1, -1, 1, 1, 2, -1, -1]), (904, 35, [0, -2, 1, 0, 1, 0, -1, 0, 1]), (904, 36, [2, -2, 1, -1, 1, 0, 2, -1, 0]), (904, 37, [2, -1, 0, -1, 1, -2, 1, -1, 1]), (904, 38, [2, 1, -2, -1, 2, 0, 1, 0, -1]), (904, 39, [0, 1, 0, 0, 2, -1, -1, 0, 0]), (904, 40, [2, -1, 0, -1, 1, -1, 3, -2, 0]), (904, 41, [0, 2, -1, 0, -1, 1, -1, 0, 0]), (904, 42, [2, -1, 0, -1, -2, 1, 2, 2, -1]), (904, 43, [2, -1, -1, -1, -2, 2, 2, 1, -2]), (904, 44, [2, -1, 0, -1, -2, 1, 2, 2, -1]), (904, 45, [2, -1, 0, -1, -2, 1, 2, 2, -1]), (904, 46, [2, -1, -1, -1, -2, 1, 2, 0, -1]), (904, 47, [2, -1, -1, -1, -2, 2, 2, 1, -2]), (904, 48, [2, -1, -1, -1, -2, 1, 2, 0, -1]), (904, 49, [2, -1, -1, -1, -2, 2, 2, 2, -3]), (904, 50, [2, -1, 0, -1, -2, 2, 1, 1, -1]), (904, 51, [2, -1, 0, -1, -2, 1, 2, 2, -1]), (904, 52, [2, -1, 0, -1, -2, 2, 3, 2, -3]), (904, 53, [1, 0, -1, 2, 0, -1, -1, -1, 1]), (904, 54, [1, -2, 0, 2, 1, -1, -2, -2, 1]), (904, 55, [1, 0, 0, 2, -1, 1, -2, 1, 0]), (904, 56, [1, 0, -1, 2, 2, -3, -3, 1, 2]), (904, 57, [1, 2, -1, 2, -1, -1, -3, 0, 2]), (904, 58, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (904, 59, [1, 0, -1, 2, 2, -3, -3, 1, 2]), (904, 60, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (904, 61, [1, 2, -2, 2, -1, -1, -1, 0, 1]), (904, 62, [1, 0, -1, 2, 2, -3, -1, 3, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1001.TT) N1001.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1001.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1001. -/
theorem lines (t5 : List T5Rec) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1001.nT).map (t4At (LRSpectrumFull.L5S4.dg N1001.TT) N1001.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h904 p hp
)

#print axioms lines

end R1001
end L5Reg
end LRSpectrumFull

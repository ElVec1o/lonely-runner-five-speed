/-- the lines clause for local classes 100..199 of rep #1270. -/
theorem lines (t5 : List T5Rec) (h973 : ∀ p ∈ LinRQSC973.blobs, LinesCl t5 (t4OfRec p.1)) (h979 : ∀ p ∈ LinRQSC979.blobs, LinesCl t5 (t4OfRec p.1)) (h980 : ∀ p ∈ LinRQSC980.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 100 ≤ c → c < 100 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N1270.TT) N1270.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h973 p hpe
    · exact h979 p hpe
    · exact h980 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 100 advOk c h1 ?_
  rw [adv_len]; exact h2


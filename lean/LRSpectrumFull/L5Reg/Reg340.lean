/-
# L5Reg.Reg340 : the lines clause for every class of the local table of rep #340 (generated by l5reg)

Every local class `i < nT` of rep #340 (18 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O340T
import LRSpectrumFull.L5S4.LinRQSC703

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R340
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(703, LinRQSC703.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(703, 48, [1, 0, -1, 3, -3, -1, -4, -2, 5]), (703, 49, [0, 1, 0, 3, -3, -1, -5, -2, 2]), (703, 50, [1, 0, -1, 3, -3, -1, -1, -5, 4]), (703, 51, [1, -1, 0, 3, -2, -1, -1, 0, 0]), (703, 52, [1, -1, 0, -3, 0, 1, -2, 1, 0]), (703, 53, [1, -1, 0, 3, 1, -1, -4, -3, 2]), (703, 54, [1, -1, 0, 3, -2, 0, -1, 0, -1]), (703, 55, [1, -1, 0, -3, -3, 5, -2, 1, 1]), (703, 56, [1, -1, 0, -3, 1, 1, -4, -3, 3]), (703, 57, [1, -1, 0, 3, 1, -1, -1, -4, 1]), (703, 58, [1, -1, 0, -3, 1, 1, -3, -4, 3]), (703, 59, [1, -1, 0, -3, 2, 1, -2, -1, 2]), (703, 60, [1, -1, 0, -1, 0, 0, 4, -3, -1]), (703, 61, [1, -1, 0, -3, 2, 1, -4, 0, 3]), (703, 62, [1, -1, 0, -1, 2, 0, 4, -1, -1]), (703, 63, [1, -1, 0, -1, -3, 1, 4, 3, -2]), (703, 64, [1, -1, 0, -1, 3, -1, 4, 3, -4]), (703, 65, [1, -1, 0, -1, 3, -1, 5, 2, -4])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N340.TT) N340.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N340.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #340. -/
theorem lines (t5 : List T5Rec) (h703 : ∀ p ∈ LinRQSC703.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N340.nT).map (t4At (LRSpectrumFull.L5S4.dg N340.TT) N340.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h703 p hp
)

#print axioms lines

end R340
end L5Reg
end LRSpectrumFull

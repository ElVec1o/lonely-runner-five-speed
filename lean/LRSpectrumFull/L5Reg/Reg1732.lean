/-
# L5Reg.Reg1732 : the lines clause for every class of the local table of rep #1732 (generated by l5reg)

Every local class `i < nT` of rep #1732 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1732T
import LRSpectrumFull.L5S4.LinRQSC1030
import LRSpectrumFull.L5S4.LinRQSC1045

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1732
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1030, LinRQSC1030.blobs), (1045, LinRQSC1045.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1045, 74, [1, 1, -1, 3, 0, -2, 0, -1, 0]), (1045, 75, [1, -1, 0, -2, 0, 1, 3, 2, -3]), (1045, 76, [1, 1, -1, 0, -2, 1, 3, 0, -2]), (1045, 77, [1, 1, -1, 0, 3, -1, -3, -1, 2]), (1045, 78, [1, -1, 0, 0, 1, -1, -3, -1, 3]), (1045, 79, [1, -1, 0, -1, -2, 2, -2, 0, 1]), (1045, 80, [1, -1, 0, -2, 1, 1, 2, 3, -4]), (1045, 81, [1, -1, 0, -1, -1, 1, -3, 2, 1]), (1045, 82, [1, -1, 0, -1, -1, 1, -3, 2, 0]), (1045, 83, [1, -1, 0, -1, -3, 1, -4, -1, 1]), (1030, 60, [1, -1, 0, -4, -1, 4, 1, 3, -3]), (1045, 84, [1, 1, -1, -2, 3, 1, 1, 2, -1]), (1045, 85, [1, 1, -1, -1, -2, 1, -4, 1, 3]), (1045, 86, [1, 1, -1, -2, 2, 1, 2, 1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1732.TT) N1732.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1732.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1732. -/
theorem lines (t5 : List T5Rec) (h1030 : ∀ p ∈ LinRQSC1030.blobs, LinesCl t5 (t4OfRec p.1)) (h1045 : ∀ p ∈ LinRQSC1045.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1732.nT).map (t4At (LRSpectrumFull.L5S4.dg N1732.TT) N1732.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1030 p hp
  · exact h1045 p hp
)

#print axioms lines

end R1732
end L5Reg
end LRSpectrumFull

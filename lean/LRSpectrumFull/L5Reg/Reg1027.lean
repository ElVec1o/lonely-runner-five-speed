/-
# L5Reg.Reg1027 : the lines clause for every class of the local table of rep #1027 (generated by l5reg)

Every local class `i < nT` of rep #1027 (36 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1027T
import LRSpectrumFull.L5S4.LinRQSC896
import LRSpectrumFull.L5S4.LinRQSC906
import LRSpectrumFull.L5S4.LinRQSC907

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1027
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(896, LinRQSC896.blobs), (906, LinRQSC906.blobs), (907, LinRQSC907.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(906, 179, [1, 0, -1, 0, 3, -1, -3, -1, 3]), (906, 180, [1, 0, -1, 0, 3, -1, 3, 1, -3]), (906, 181, [1, 1, 1, -1, 0, 0, -1, 1, 0]), (906, 182, [1, -1, 0, 0, 0, -1, 1, 0, 2]), (906, 183, [2, 0, -1, -2, 1, 0, -1, -2, 2]), (906, 184, [0, 1, 0, -3, 0, 1, 2, 2, -1]), (906, 185, [0, -1, 0, -3, 0, 2, 1, 2, -1]), (906, 186, [0, 1, 0, -3, 0, 1, 2, 2, -1]), (896, 26, [2, 0, -1, -3, 0, 1, 0, -1, -1]), (906, 187, [1, 0, 0, 0, 1, 3, -3, 0, 1]), (906, 188, [1, -1, 1, 0, 0, -1, -3, 2, 1]), (906, 189, [2, 1, -2, -2, 0, 1, -1, 1, 0]), (906, 190, [2, 1, -2, 0, -1, 1, 3, -1, -1]), (906, 191, [1, 0, 0, -1, 1, -3, -1, -1, 2]), (906, 192, [1, 0, 0, 1, 0, 1, 1, 1, -2]), (906, 193, [2, 0, -1, 0, -1, 2, 3, 0, -1]), (906, 194, [0, -1, 0, -3, 0, 1, -1, -1, 0]), (906, 195, [2, 1, -2, -2, 0, 1, -3, 1, 1]), (906, 196, [2, 1, -1, 0, -1, 0, 3, -1, -2]), (906, 197, [2, 1, -2, 0, -1, 1, 1, -1, 0]), (906, 198, [1, 0, -1, -1, -3, 2, -1, 2, 0]), (906, 199, [2, 0, -1, 0, -3, 1, 3, 2, -2]), (906, 200, [1, 0, -1, -1, -1, 1, -1, 1, 0]), (907, 0, [2, 0, -1, -2, -1, 1, -3, 0, 1]), (907, 1, [2, 0, -1, 0, -1, 1, 3, 0, -1]), (907, 2, [1, 0, -1, 0, -1, 1, 1, 0, 0]), (907, 3, [1, 0, 0, -1, -3, -1, -1, 1, 0]), (907, 4, [2, 0, -1, 0, 3, -2, 3, -2, 0]), (907, 5, [0, 2, -1, -1, -2, 1, 1, -1, 0]), (907, 6, [0, -1, 0, -1, 1, 0, 1, 1, -1]), (907, 7, [0, 0, 1, -1, 0, -1, 0, -1, -1]), (907, 8, [2, 0, -1, 0, -1, 0, 3, -2, -2]), (907, 9, [0, -1, 0, -1, 1, 0, 1, 1, -1]), (907, 10, [2, -1, 1, 0, 0, -1, 3, -2, -1]), (907, 11, [2, -1, -1, 0, 0, -1, 1, 0, 0]), (907, 12, [0, 2, -1, -1, -2, 1, 1, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1027.TT) N1027.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1027.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1027. -/
theorem lines (t5 : List T5Rec) (h896 : ∀ p ∈ LinRQSC896.blobs, LinesCl t5 (t4OfRec p.1)) (h906 : ∀ p ∈ LinRQSC906.blobs, LinesCl t5 (t4OfRec p.1)) (h907 : ∀ p ∈ LinRQSC907.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1027.nT).map (t4At (LRSpectrumFull.L5S4.dg N1027.TT) N1027.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h896 p hp
  · exact h906 p hp
  · exact h907 p hp
)

#print axioms lines

end R1027
end L5Reg
end LRSpectrumFull

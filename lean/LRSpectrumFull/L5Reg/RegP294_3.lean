/-- the lines clause for local classes 300..399 of rep #294. -/
theorem lines (t5 : List T5Rec) (h454 : ∀ p ∈ LinRQSC454.blobs, LinesCl t5 (t4OfRec p.1)) (h455 : ∀ p ∈ LinRQSC455.blobs, LinesCl t5 (t4OfRec p.1)) (h456 : ∀ p ∈ LinRQSC456.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N294.TT) N294.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h454 p hpe
    · exact h455 p hpe
    · exact h456 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


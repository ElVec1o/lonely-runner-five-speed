/-
# L5Reg.Reg647 : the lines clause for every class of the local table of rep #647 (generated by l5reg)

Every local class `i < nT` of rep #647 (14 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O647T
import LRSpectrumFull.L5S4.LinRQSC432
import LRSpectrumFull.L5S4.LinRQSC839
import LRSpectrumFull.L5S4.LinRQSC853

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R647
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(432, LinRQSC432.blobs), (839, LinRQSC839.blobs), (853, LinRQSC853.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(432, 28, [1, -1, 0, -4, 3, 1, -2, 2, 1]), (853, 61, [1, -1, 0, -2, 2, 1, 3, -2, -1]), (853, 62, [1, -1, 1, -2, 2, -1, 4, -3, 2]), (853, 63, [1, 0, -1, 3, 1, -3, -3, 1, 2]), (853, 64, [1, 0, 0, 3, -2, 1, 3, 3, -1]), (853, 65, [1, 0, 0, 3, 1, 2, 4, -1, -1]), (853, 66, [1, 0, -1, 3, -1, -2, 4, 1, -4]), (853, 67, [1, 0, -1, -2, 1, 1, -2, -1, 2]), (853, 68, [1, -1, 0, -2, -3, 4, -4, -2, 5]), (853, 69, [1, -1, 0, -2, 2, 1, -4, 3, 1]), (853, 70, [1, -1, 0, -2, 2, 1, -4, 3, 0]), (853, 71, [1, -1, 0, -2, 2, -1, -4, 3, 0]), (853, 72, [1, 0, 0, 3, -1, 0, 3, -1, 1]), (839, 52, [1, 1, -1, 2, -1, 0, 2, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N647.TT) N647.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N647.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #647. -/
theorem lines (t5 : List T5Rec) (h432 : ∀ p ∈ LinRQSC432.blobs, LinesCl t5 (t4OfRec p.1)) (h839 : ∀ p ∈ LinRQSC839.blobs, LinesCl t5 (t4OfRec p.1)) (h853 : ∀ p ∈ LinRQSC853.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N647.nT).map (t4At (LRSpectrumFull.L5S4.dg N647.TT) N647.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h432 p hp
  · exact h839 p hp
  · exact h853 p hp
)

#print axioms lines

end R647
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #770. -/
theorem lines (t5 : List T5Rec) (h869 : ∀ p ∈ LinRQSC869.blobs, LinesCl t5 (t4OfRec p.1)) (h870 : ∀ p ∈ LinRQSC870.blobs, LinesCl t5 (t4OfRec p.1)) (h871 : ∀ p ∈ LinRQSC871.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N770.nT).map (t4At (LRSpectrumFull.L5S4.dg N770.TT) N770.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h869 p hp
  · exact h870 p hp
  · exact h871 p hp
)


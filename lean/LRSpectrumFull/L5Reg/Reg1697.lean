theorem lines (t5 : List T5Rec) (h1030 : ∀ p ∈ LinRQSC1030.blobs, LinesCl t5 (t4OfRec p.1)) (h1031 : ∀ p ∈ LinRQSC1031.blobs, LinesCl t5 (t4OfRec p.1)) (h1032 : ∀ p ∈ LinRQSC1032.blobs, LinesCl t5 (t4OfRec p.1))

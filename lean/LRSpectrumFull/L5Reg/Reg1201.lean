/-
# L5Reg.Reg1201 : the lines clause for every class of the local table of rep #1201 (generated by l5reg)

Every local class `i < nT` of rep #1201 (19 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1201T
import LRSpectrumFull.L5S4.LinRQSC942
import LRSpectrumFull.L5S4.LinRQSC949

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1201
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(942, LinRQSC942.blobs), (949, LinRQSC949.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(949, 100, [2, -1, 0, -3, 1, 0, 0, -1, 1]), (942, 130, [2, 1, -2, -1, 0, 1, 3, -2, -2]), (949, 101, [2, 1, -1, -3, 2, 1, 1, 3, -1]), (949, 102, [1, -2, 1, 0, 3, -2, 3, 2, -2]), (949, 103, [2, 1, -1, -3, 2, 0, 1, 2, -1]), (949, 104, [2, 1, -1, -3, 0, 1, -1, 3, -1]), (949, 105, [1, -2, 1, 2, 3, -4, 3, 0, -2]), (949, 106, [2, 1, -2, -3, 1, 2, 0, -3, 1]), (949, 107, [2, 1, -2, -3, 1, 1, -1, -2, 2]), (949, 108, [1, -2, 1, 1, 3, -3, -2, 0, 1]), (949, 109, [1, -2, 0, 1, 3, -1, -3, 0, 1]), (949, 110, [1, 2, -1, 3, -1, 0, -1, 3, -1]), (949, 111, [2, 0, -1, -3, 0, 2, -1, 1, 1]), (949, 112, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (949, 113, [1, -2, 0, 2, 3, -1, -3, 0, 1]), (949, 114, [2, -1, -1, -3, -2, 4, 0, 4, -3]), (949, 115, [2, 0, -1, -3, 0, 2, 1, 1, -2]), (949, 116, [2, 1, -1, -3, 0, 1, 2, -3, 0]), (949, 117, [2, 1, -2, -3, 1, 1, -1, 1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1201.TT) N1201.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1201.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1201. -/
theorem lines (t5 : List T5Rec) (h942 : ∀ p ∈ LinRQSC942.blobs, LinesCl t5 (t4OfRec p.1)) (h949 : ∀ p ∈ LinRQSC949.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1201.nT).map (t4At (LRSpectrumFull.L5S4.dg N1201.TT) N1201.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h942 p hp
  · exact h949 p hp
)

#print axioms lines

end R1201
end L5Reg
end LRSpectrumFull

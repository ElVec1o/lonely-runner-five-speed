/-
# L5Reg.Reg871 : the lines clause for every class of the local table of rep #871 (generated by l5reg)

Every local class `i < nT` of rep #871 (27 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O871T
import LRSpectrumFull.L5S4.LinRQSC878
import LRSpectrumFull.L5S4.LinRQSC880
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R871
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(878, LinRQSC878.blobs), (880, LinRQSC880.blobs), (881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(881, 14, [0, 1, 0, 0, -1, -1, -1, 0, 1]), (881, 15, [1, -1, 0, 1, 0, 0, -2, 1, 1]), (881, 16, [1, -1, 0, 1, 0, 0, 3, 0, -1]), (878, 143, [3, 1, -1, -1, 3, 0, 0, 1, 0]), (881, 17, [3, -2, -1, 0, 1, 0, -2, 1, 1]), (880, 47, [0, 3, -1, 0, -2, 1, -1, 0, 0]), (881, 18, [0, -1, -1, 0, 0, 1, -1, 0, -1]), (881, 19, [1, -3, 1, 1, 0, 0, 3, 2, -1]), (881, 20, [3, -1, 0, 0, -1, 1, -1, -2, 2]), (881, 21, [1, 0, 0, 0, 3, -1, 0, -1, 0]), (881, 22, [0, 0, 1, 0, 1, 0, -1, 1, 0]), (881, 23, [0, 1, 0, 0, 0, -1, -1, 0, 1]), (881, 24, [0, -1, 1, 1, -1, 0, 0, 3, -2]), (881, 25, [3, -1, 0, 0, -1, 1, -1, -3, 3]), (881, 26, [3, -1, 0, 0, -1, 1, -1, -3, 3]), (880, 93, [0, 1, -1, 3, -1, -1, -2, -2, 3]), (881, 27, [3, -1, -2, 0, 1, 0, -1, 0, 1]), (881, 28, [3, -1, -1, 0, 1, 0, -2, 1, 1]), (881, 29, [3, -1, 0, 0, -1, 1, -1, -3, 3]), (878, 6, [0, -1, 1, 3, -2, 1, -1, 1, -1]), (881, 30, [3, 0, -1, 0, 1, 0, -2, 0, 1]), (881, 31, [1, 0, 0, 0, 3, -2, 0, -1, 1]), (881, 32, [3, -2, -2, 0, 1, 0, -1, 1, 1]), (881, 33, [1, -1, 0, 0, -1, 1, 0, -3, 2]), (881, 34, [3, -2, 0, 0, 1, -1, -2, 1, 0]), (881, 35, [1, 0, -1, 0, 3, -2, 0, 1, -1]), (881, 36, [3, 0, -1, 0, 1, 0, -2, 0, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N871.TT) N871.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N871.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #871. -/
theorem lines (t5 : List T5Rec) (h878 : ∀ p ∈ LinRQSC878.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N871.nT).map (t4At (LRSpectrumFull.L5S4.dg N871.TT) N871.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h878 p hp
  · exact h880 p hp
  · exact h881 p hp
)

#print axioms lines

end R871
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #1136. -/
theorem lines (t5 : List T5Rec) (h923 : ∀ p ∈ LinRQSC923.blobs, LinesCl t5 (t4OfRec p.1)) (h924 : ∀ p ∈ LinRQSC924.blobs, LinesCl t5 (t4OfRec p.1))

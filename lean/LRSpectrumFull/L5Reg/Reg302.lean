/-- the lines clause for every class of the local table of rep #302. -/
theorem lines (t5 : List T5Rec) (h548 : ∀ p ∈ LinRQSC548.blobs, LinesCl t5 (t4OfRec p.1)) (h549 : ∀ p ∈ LinRQSC549.blobs, LinesCl t5 (t4OfRec p.1)) (h550 : ∀ p ∈ LinRQSC550.blobs, LinesCl t5 (t4OfRec p.1)) (h551 : ∀ p ∈ LinRQSC551.blobs, LinesCl t5 (t4OfRec p.1)) (h552 : ∀ p ∈ LinRQSC552.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N302.nT).map (t4At (LRSpectrumFull.L5S4.dg N302.TT) N302.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N302.nT := List.mem_range.1 hc
  have hn : N302.nT = 328 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 328) := by omega
  rcases hcase with h | h | h | h
  · exact P302_0.lines t5 h548 h549 h550 c h.1 (by omega)
  · exact P302_1.lines t5 h550 h551 c h.1 (by omega)
  · exact P302_2.lines t5 h551 h552 c h.1 (by omega)
  · exact P302_3.lines t5 h552 c h.1 (by omega)

#print axioms lines


theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N648.TT) N648.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N648.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #648. -/
theorem lines (t5 : List T5Rec) (h680 : ∀ p ∈ LinRQSC680.blobs, LinesCl t5 (t4OfRec p.1)) (h722 : ∀ p ∈ LinRQSC722.blobs, LinesCl t5 (t4OfRec p.1)) (h840 : ∀ p ∈ LinRQSC840.blobs, LinesCl t5 (t4OfRec p.1)) (h853 : ∀ p ∈ LinRQSC853.blobs, LinesCl t5 (t4OfRec p.1)) (h854 : ∀ p ∈ LinRQSC854.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N648.nT).map (t4At (LRSpectrumFull.L5S4.dg N648.TT) N648.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h680 p hp
  · exact h722 p hp
  · exact h840 p hp
  · exact h853 p hp
  · exact h854 p hp
)

#print axioms lines


/-- the lines clause for every class of the local table of rep #1340. -/
theorem lines (t5 : List T5Rec) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1)) (h1016 : ∀ p ∈ LinRQSC1016.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1340.nT).map (t4At (LRSpectrumFull.L5S4.dg N1340.TT) N1340.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1004 p hp
  · exact h1016 p hp
)


/-- the lines clause for every class of the local table of rep #88. -/
theorem lines (t5 : List T5Rec) (h90 : ∀ p ∈ LinRQSC90.blobs, LinesCl t5 (t4OfRec p.1)) (h91 : ∀ p ∈ LinRQSC91.blobs, LinesCl t5 (t4OfRec p.1)) (h92 : ∀ p ∈ LinRQSC92.blobs, LinesCl t5 (t4OfRec p.1)) (h93 : ∀ p ∈ LinRQSC93.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N88.nT).map (t4At (LRSpectrumFull.L5S4.dg N88.TT) N88.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h90 p hp
  · exact h91 p hp
  · exact h92 p hp
  · exact h93 p hp
)


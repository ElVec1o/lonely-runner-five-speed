/-
# L5Reg.Reg270 : the lines clause for every class of the local table of rep #270 (generated by l5reg)

Every local class `i < nT` of rep #270 (24 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O270T
import LRSpectrumFull.L5S4.LinRQSC429

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R270
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(429, LinRQSC429.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(429, 27, [1, -1, 0, -4, -4, 5, 0, 5, -3]), (429, 28, [1, -1, 0, -4, -4, 3, -1, 4, -1]), (429, 29, [1, -1, 0, -4, -4, 1, -2, 3, 0]), (429, 30, [1, -1, 0, -4, 3, 1, -2, 2, 1]), (429, 31, [1, -1, 0, -4, 0, 3, -3, 2, 1]), (429, 32, [1, -1, 0, -4, 2, 1, 0, 1, 0]), (429, 33, [1, -1, 0, -4, -4, 5, -4, 1, 2]), (429, 34, [1, -1, 0, -4, -4, 7, -3, 2, 1]), (429, 35, [1, -1, 0, -4, -4, 5, -4, 1, 2]), (429, 36, [1, -1, 0, -4, -4, 5, -3, 0, 2]), (429, 37, [1, -1, 0, -4, -4, 5, -3, 0, 2]), (429, 38, [1, 0, -1, -4, 0, 3, -2, -1, 2]), (429, 39, [0, -1, 0, 0, 4, -1, 1, -2, 0]), (429, 40, [0, -1, 0, 0, 4, -1, 1, -2, 0]), (429, 41, [1, 0, -1, -4, 0, 3, 2, -1, -1]), (429, 42, [0, 1, 0, 0, -4, 1, -1, 2, 0]), (429, 43, [1, 0, -1, -4, 0, 3, -3, -1, 3]), (429, 44, [1, 0, -1, -4, 0, 3, -3, -1, 3]), (429, 45, [1, -1, 0, -4, -4, 5, -4, 1, 2]), (429, 46, [1, 0, -1, -4, 0, 3, -3, -1, 3]), (429, 47, [1, -1, 0, -4, -4, 5, -3, 0, 2]), (429, 48, [1, 0, -1, -4, 0, 3, -2, -1, 2]), (429, 49, [1, 0, -1, -4, 0, 3, 2, -1, -1]), (429, 50, [1, 0, -1, -4, 0, 3, 2, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N270.TT) N270.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N270.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #270. -/
theorem lines (t5 : List T5Rec) (h429 : ∀ p ∈ LinRQSC429.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N270.nT).map (t4At (LRSpectrumFull.L5S4.dg N270.TT) N270.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h429 p hp
)

#print axioms lines

end R270
end L5Reg
end LRSpectrumFull

/-
# L5Reg.Reg1237 : the lines clause for every class of the local table of rep #1237 (generated by l5reg)

Every local class `i < nT` of rep #1237 (24 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1237T
import LRSpectrumFull.L5S4.LinRQSC959

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1237
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(959, LinRQSC959.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(959, 140, [1, -1, 0, 3, -1, -1, 1, 0, 0]), (959, 141, [2, 1, -1, 0, -1, 0, -3, 1, 1]), (959, 142, [2, -1, -1, 0, 1, 0, 3, 2, -2]), (959, 143, [2, 1, -1, 0, 3, -2, 1, 0, 0]), (959, 144, [2, -1, 0, 0, -1, 1, 3, -1, 0]), (959, 145, [1, -2, 1, 3, 0, -2, -2, -3, 4]), (959, 146, [1, -1, 0, 3, 0, -2, 0, -1, 1]), (959, 147, [1, -1, 0, 3, 1, -3, -1, 2, -1]), (959, 148, [1, -1, 0, 3, -1, -1, -1, 0, 0]), (959, 149, [1, -1, -1, 3, -2, -1, -2, 2, 1]), (959, 150, [1, 2, -2, 3, 0, -1, -1, 3, -2]), (959, 151, [1, -1, 0, 3, 1, -3, 2, -1, -1]), (959, 152, [1, 0, 0, -1, -1, 2, -3, 0, 1]), (959, 153, [1, 1, -1, -1, 3, -2, -3, -2, 2]), (959, 154, [1, -1, -1, -1, 1, 0, -3, 2, 2]), (959, 155, [1, 2, -1, -1, 0, 0, -3, 1, 0]), (959, 156, [1, -1, 0, 3, 1, -3, -1, -2, 2]), (959, 157, [1, -1, 0, -1, -3, 1, -2, 1, 0]), (959, 158, [1, -1, 0, -1, 0, 0, -3, -1, 1]), (959, 159, [1, 0, 0, -1, 1, 0, -2, 0, 1]), (959, 160, [1, 0, -1, -1, 1, 0, -3, -1, 3]), (959, 161, [1, -1, 0, 3, -2, 0, -1, 0, 1]), (959, 162, [1, 0, -1, -1, -1, 0, -3, 0, 2]), (959, 163, [1, -1, 0, 3, 1, -3, 1, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1237.TT) N1237.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1237.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1237. -/
theorem lines (t5 : List T5Rec) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1237.nT).map (t4At (LRSpectrumFull.L5S4.dg N1237.TT) N1237.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h959 p hp
)

#print axioms lines

end R1237
end L5Reg
end LRSpectrumFull

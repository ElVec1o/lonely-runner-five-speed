theorem lines (t5 : List T5Rec) (h1010 : ∀ p ∈ LinRQSC1010.blobs, LinesCl t5 (t4OfRec p.1)) (h1011 : ∀ p ∈ LinRQSC1011.blobs, LinesCl t5 (t4OfRec p.1))

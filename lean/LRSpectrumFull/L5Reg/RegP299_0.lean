theorem lines (t5 : List T5Rec) (h490 : ∀ p ∈ LinRQSC490.blobs, LinesCl t5 (t4OfRec p.1)) (h491 : ∀ p ∈ LinRQSC491.blobs, LinesCl t5 (t4OfRec p.1))

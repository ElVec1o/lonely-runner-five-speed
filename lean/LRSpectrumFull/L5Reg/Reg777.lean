/-
# L5Reg.Reg777 : the lines clause for every class of the local table of rep #777 (generated by l5reg)

Every local class `i < nT` of rep #777 (20 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O777T
import LRSpectrumFull.L5S4.LinRQSC869
import LRSpectrumFull.L5S4.LinRQSC871

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R777
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(869, LinRQSC869.blobs), (871, LinRQSC871.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(871, 125, [1, 0, -1, 2, -1, -1, -2, 1, 0]), (869, 81, [1, 2, -2, -2, 0, 1, 2, -1, 0]), (871, 126, [1, 0, 0, 2, 2, -1, -3, 1, 0]), (871, 127, [1, 2, -2, 2, -1, 0, 1, 1, -1]), (869, 91, [2, 0, -1, 0, 1, 0, -1, 0, 1]), (871, 128, [1, 0, 0, 2, 2, -1, -1, 3, -1]), (871, 129, [1, -2, 1, 2, 1, -2, -3, 0, 2]), (871, 130, [2, 0, -1, -1, 0, 1, 1, 1, -1]), (871, 131, [2, 1, -2, -1, 2, -1, 0, 1, -1]), (871, 132, [1, -2, 0, 2, 1, -2, -1, 0, 1]), (871, 133, [0, -1, 0, 2, -2, -1, 3, 1, -2]), (871, 134, [1, -1, 0, 0, -1, 1, -2, 1, 0]), (871, 135, [0, -2, 1, 2, 1, -2, 1, -2, 0]), (871, 136, [2, 1, -2, -1, 2, -1, 1, -1, 0]), (871, 137, [1, -2, 0, 0, 1, 0, -3, 0, 1]), (871, 138, [0, 2, -1, 2, -1, 0, 3, 0, -1]), (871, 139, [2, -1, -1, -1, 0, 1, 0, 3, -2]), (871, 140, [2, 1, -2, -1, 0, 1, 2, -2, -1]), (871, 141, [2, 0, -1, -1, 2, 0, 2, 1, -1]), (871, 142, [2, 0, -1, -1, 2, -1, 1, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N777.TT) N777.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N777.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #777. -/
theorem lines (t5 : List T5Rec) (h869 : ∀ p ∈ LinRQSC869.blobs, LinesCl t5 (t4OfRec p.1)) (h871 : ∀ p ∈ LinRQSC871.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N777.nT).map (t4At (LRSpectrumFull.L5S4.dg N777.TT) N777.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h869 p hp
  · exact h871 p hp
)

#print axioms lines

end R777
end L5Reg
end LRSpectrumFull

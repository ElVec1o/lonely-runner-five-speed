/-
# L5Reg.RegP98_3 : part 3 of the lines clause of rep #98: local classes 300..305 (generated by l5reg `genchunk`)

Same check as `Reg<c>` (`L5Reg.Equiv.eqAll`, UNTRUSTED advice, kernel-checked) on a sub-range of classes, so that the kernel check stays small.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O98T
import LRSpectrumFull.L5S4.LinRQSC102

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace P98_3
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(102, LinRQSC102.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(102, 45, [0, 0, 1, -1, 1, 0, 1, 0, -1]), (102, 46, [0, 0, 1, -1, 1, 0, 1, 0, 0]), (102, 47, [0, 0, -1, 2, -1, -1, 3, -2, -2]), (102, 48, [0, 0, 1, -1, 1, 0, 1, 0, 0]), (102, 49, [0, 0, 1, -1, 1, 0, 1, 0, -1]), (102, 50, [0, 0, -1, 2, -1, -1, 3, -1, -2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N98.TT) N98.ST (assoc bls) 300 adv = true := by decide +kernel

theorem adv_len : adv.length = 6 := by decide +kernel

/-- the lines clause for local classes 300..305 of rep #98. -/
theorem lines (t5 : List T5Rec) (h102 : ∀ p ∈ LinRQSC102.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 6 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N98.TT) N98.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl
    exact h102 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2

#print axioms lines

end P98_3
end L5Reg
end LRSpectrumFull

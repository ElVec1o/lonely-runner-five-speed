/-- the lines clause for local classes 200..299 of rep #76. -/
theorem lines (t5 : List T5Rec) (h63 : ∀ p ∈ LinRQSC63.blobs, LinesCl t5 (t4OfRec p.1)) (h64 : ∀ p ∈ LinRQSC64.blobs, LinesCl t5 (t4OfRec p.1))

/-- the lines clause for local classes 0..99 of rep #79. -/
theorem lines (t5 : List T5Rec) (h72 : ∀ p ∈ LinRQSC72.blobs, LinesCl t5 (t4OfRec p.1)) (h73 : ∀ p ∈ LinRQSC73.blobs, LinesCl t5 (t4OfRec p.1))

/-- the lines clause for local classes 200..299 of rep #38. -/
theorem lines (t5 : List T5Rec) (h15 : ∀ p ∈ LinRQSC15.blobs, LinesCl t5 (t4OfRec p.1)) (h16 : ∀ p ∈ LinRQSC16.blobs, LinesCl t5 (t4OfRec p.1)) (h17 : ∀ p ∈ LinRQSC17.blobs, LinesCl t5 (t4OfRec p.1)) (h18 : ∀ p ∈ LinRQSC18.blobs, LinesCl t5 (t4OfRec p.1)) (h19 : ∀ p ∈ LinRQSC19.blobs, LinesCl t5 (t4OfRec p.1)) (h20 : ∀ p ∈ LinRQSC20.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 200 ≤ c → c < 200 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N38.TT) N38.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl
    · exact h15 p hpe
    · exact h16 p hpe
    · exact h17 p hpe
    · exact h18 p hpe
    · exact h19 p hpe
    · exact h20 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 200 advOk c h1 ?_
  rw [adv_len]; exact h2


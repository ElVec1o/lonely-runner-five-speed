/-
# L5Reg.Reg1039 : the lines clause for every class of the local table of rep #1039 (generated by l5reg)

Every local class `i < nT` of rep #1039 (31 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1039T
import LRSpectrumFull.L5S4.LinRQSC889
import LRSpectrumFull.L5S4.LinRQSC890
import LRSpectrumFull.L5S4.LinRQSC908

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1039
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(889, LinRQSC889.blobs), (890, LinRQSC890.blobs), (908, LinRQSC908.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(889, 107, [0, 1, -1, 0, 3, -2, -1, 0, 0]), (908, 191, [0, 2, -1, -1, 0, 0, 0, -3, 1]), (890, 67, [2, 0, -1, -3, 0, 2, 0, 1, 0]), (908, 192, [2, 0, -1, 0, 1, 0, -3, 0, 1]), (908, 193, [2, -1, -1, 0, 0, 1, -3, 2, 1]), (908, 194, [2, 0, -1, 0, 3, -2, -3, -1, 2]), (908, 195, [1, 0, 0, 0, 3, -1, -1, -1, 0]), (908, 196, [0, 2, -1, -3, 0, 2, 1, 1, -1]), (908, 197, [1, 0, 0, 0, -3, 1, 3, 1, 0]), (908, 198, [2, -1, -1, 0, 0, 1, -3, 1, 2]), (908, 199, [2, 0, -1, 0, 3, -2, -3, 1, 1]), (908, 200, [2, -1, -1, 0, 0, 1, -3, 1, 2]), (908, 201, [0, 2, -1, -3, 0, 1, -1, 1, 0]), (908, 202, [0, 2, -1, -3, 0, 1, -1, 1, 0]), (908, 203, [1, 0, 0, 0, 0, -1, 3, -1, 0]), (908, 204, [0, -1, -2, -1, 0, 0, 0, 0, 1]), (908, 205, [0, 1, 0, -3, 0, 2, 1, 1, -1]), (908, 206, [0, 2, -1, -3, 0, 2, 1, 1, -1]), (908, 207, [0, -1, 0, -3, 0, 2, 2, 0, -1]), (908, 208, [0, 1, 0, -3, 0, 2, 2, 1, -1]), (908, 209, [0, 1, 0, -3, 0, 1, 2, 1, -1]), (908, 210, [0, 1, -1, -3, 0, 2, 2, 1, -2]), (908, 211, [0, 1, -1, -3, 0, 2, 2, 0, -1]), (908, 212, [0, 2, -1, -3, 0, 1, 2, 1, -1]), (908, 213, [0, -1, 0, -3, 0, 2, 2, 0, -1]), (908, 214, [0, 1, 0, -3, 0, 2, 1, 1, -1]), (908, 215, [0, -2, 1, -3, 0, 2, 1, 1, -1]), (908, 216, [0, 2, -1, -3, 0, 1, 2, 1, -1]), (908, 217, [0, -2, 1, -3, 0, 2, 2, 1, -2]), (908, 218, [0, -1, 0, -1, 0, 0, 0, 0, -1]), (908, 219, [0, 1, 0, -1, 0, 0, 0, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1039.TT) N1039.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1039.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1039. -/
theorem lines (t5 : List T5Rec) (h889 : ∀ p ∈ LinRQSC889.blobs, LinesCl t5 (t4OfRec p.1)) (h890 : ∀ p ∈ LinRQSC890.blobs, LinesCl t5 (t4OfRec p.1)) (h908 : ∀ p ∈ LinRQSC908.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1039.nT).map (t4At (LRSpectrumFull.L5S4.dg N1039.TT) N1039.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h889 p hp
  · exact h890 p hp
  · exact h908 p hp
)

#print axioms lines

end R1039
end L5Reg
end LRSpectrumFull

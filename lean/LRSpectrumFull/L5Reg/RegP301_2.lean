/-- the lines clause for local classes 200..299 of rep #301. -/
theorem lines (t5 : List T5Rec) (h533 : ∀ p ∈ LinRQSC533.blobs, LinesCl t5 (t4OfRec p.1)) (h534 : ∀ p ∈ LinRQSC534.blobs, LinesCl t5 (t4OfRec p.1)) (h535 : ∀ p ∈ LinRQSC535.blobs, LinesCl t5 (t4OfRec p.1)) (h536 : ∀ p ∈ LinRQSC536.blobs, LinesCl t5 (t4OfRec p.1)) (h537 : ∀ p ∈ LinRQSC537.blobs, LinesCl t5 (t4OfRec p.1))

/-
# L5Reg.Reg602 : the lines clause for every class of the local table of rep #602 (generated by l5reg)

Every local class `i < nT` of rep #602 (9 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O602T
import LRSpectrumFull.L5S4.LinRQSC200
import LRSpectrumFull.L5S4.LinRQSC839

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R602
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(200, LinRQSC200.blobs), (839, LinRQSC839.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(200, 45, [1, 0, -1, -4, 0, 3, 1, -1, 0]), (200, 44, [1, 0, -1, -4, 0, 3, -1, -1, 2]), (839, 21, [1, 0, -1, -1, -2, 2, 4, 1, -4]), (839, 22, [1, 0, 0, -1, 4, 1, -3, -3, -1]), (839, 23, [1, 0, -1, -1, -2, 2, -4, -1, 4]), (839, 24, [1, 0, -1, 2, 1, -2, 4, 0, -3]), (200, 47, [1, 0, -1, -4, 0, 3, 2, -1, -1]), (839, 25, [1, 0, 0, 2, -2, 1, 4, 1, 0]), (839, 26, [1, 0, 0, 2, 4, 1, 4, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N602.TT) N602.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N602.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #602. -/
theorem lines (t5 : List T5Rec) (h200 : ∀ p ∈ LinRQSC200.blobs, LinesCl t5 (t4OfRec p.1)) (h839 : ∀ p ∈ LinRQSC839.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N602.nT).map (t4At (LRSpectrumFull.L5S4.dg N602.TT) N602.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h200 p hp
  · exact h839 p hp
)

#print axioms lines

end R602
end L5Reg
end LRSpectrumFull

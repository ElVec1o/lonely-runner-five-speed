theorem lines (t5 : List T5Rec) (h51 : ∀ p ∈ LinRQSC51.blobs, LinesCl t5 (t4OfRec p.1)) (h153 : ∀ p ∈ LinRQSC153.blobs, LinesCl t5 (t4OfRec p.1))

theorem lines (t5 : List T5Rec) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1)) (h39 : ∀ p ∈ LinRQSC39.blobs, LinesCl t5 (t4OfRec p.1)) (h59 : ∀ p ∈ LinRQSC59.blobs, LinesCl t5 (t4OfRec p.1)) (h106 : ∀ p ∈ LinRQSC106.blobs, LinesCl t5 (t4OfRec p.1)) (h194 : ∀ p ∈ LinRQSC194.blobs, LinesCl t5 (t4OfRec p.1)) (h195 : ∀ p ∈ LinRQSC195.blobs, LinesCl t5 (t4OfRec p.1))

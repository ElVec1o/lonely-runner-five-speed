/-
# L5Reg.RegFin85 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg654
import LRSpectrumFull.L5Reg.Reg99

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines654 : ∀ cl ∈ (List.range N654.nT).map (t4At (LRSpectrumFull.L5S4.dg N654.TT) N654.ST), LinesCl T5Store.t5 cl :=
  R654.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem232 p hp)) (fun p hp => FinalGlue.glines p (mem693 p hp)) (fun p hp => FinalGlue.glines p (mem694 p hp)) (fun p hp => FinalGlue.glines p (mem695 p hp)) (fun p hp => FinalGlue.glines p (mem864 p hp)) (fun p hp => FinalGlue.glines p (mem865 p hp)) (fun p hp => FinalGlue.glines p (mem866 p hp))

theorem lines99 : ∀ cl ∈ (List.range N99.nT).map (t4At (LRSpectrumFull.L5S4.dg N99.TT) N99.ST), LinesCl T5Store.t5 cl :=
  R99.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem43 p hp)) (fun p hp => FinalGlue.glines p (mem45 p hp)) (fun p hp => FinalGlue.glines p (mem46 p hp)) (fun p hp => FinalGlue.glines p (mem102 p hp)) (fun p hp => FinalGlue.glines p (mem103 p hp)) (fun p hp => FinalGlue.glines p (mem104 p hp))

#print axioms lines654

end L5Reg
end LRSpectrumFull

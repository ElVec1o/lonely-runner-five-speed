/-- the lines clause for every class of the local table of rep #190. -/
theorem lines (t5 : List T5Rec) (h6 : ∀ p ∈ LinRQSC6.blobs, LinesCl t5 (t4OfRec p.1)) (h101 : ∀ p ∈ LinRQSC101.blobs, LinesCl t5 (t4OfRec p.1)) (h197 : ∀ p ∈ LinRQSC197.blobs, LinesCl t5 (t4OfRec p.1)) (h198 : ∀ p ∈ LinRQSC198.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N190.nT).map (t4At (LRSpectrumFull.L5S4.dg N190.TT) N190.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact h6 p hp
  · exact h101 p hp
  · exact h197 p hp
  · exact h198 p hp
)


theorem lines (t5 : List T5Rec) (h33 : ∀ p ∈ LinRQSC33.blobs, LinesCl t5 (t4OfRec p.1)) (h34 : ∀ p ∈ LinRQSC34.blobs, LinesCl t5 (t4OfRec p.1)) (h61 : ∀ p ∈ LinRQSC61.blobs, LinesCl t5 (t4OfRec p.1)) (h62 : ∀ p ∈ LinRQSC62.blobs, LinesCl t5 (t4OfRec p.1)) (h63 : ∀ p ∈ LinRQSC63.blobs, LinesCl t5 (t4OfRec p.1)) (h64 : ∀ p ∈ LinRQSC64.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N76.nT).map (t4At (LRSpectrumFull.L5S4.dg N76.TT) N76.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N76.nT := List.mem_range.1 hc
  have hn : N76.nT = 356 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 356) := by omega
  rcases hcase with h | h | h | h
  · exact P76_0.lines t5 h33 h61 h62 c h.1 (by omega)
  · exact P76_1.lines t5 h62 h63 c h.1 (by omega)
  · exact P76_2.lines t5 h63 h64 c h.1 (by omega)
  · exact P76_3.lines t5 h34 h64 c h.1 (by omega)


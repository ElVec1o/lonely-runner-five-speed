theorem lines (t5 : List T5Rec) (h942 : ∀ p ∈ LinRQSC942.blobs, LinesCl t5 (t4OfRec p.1)) (h998 : ∀ p ∈ LinRQSC998.blobs, LinesCl t5 (t4OfRec p.1)) (h1013 : ∀ p ∈ LinRQSC1013.blobs, LinesCl t5 (t4OfRec p.1)) (h1023 : ∀ p ∈ LinRQSC1023.blobs, LinesCl t5 (t4OfRec p.1))

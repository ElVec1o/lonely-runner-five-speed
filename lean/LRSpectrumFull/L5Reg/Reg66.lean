theorem lines (t5 : List T5Rec) (h42 : ∀ p ∈ LinRQSC42.blobs, LinesCl t5 (t4OfRec p.1)) (h43 : ∀ p ∈ LinRQSC43.blobs, LinesCl t5 (t4OfRec p.1))

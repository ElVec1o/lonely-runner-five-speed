theorem lines (t5 : List T5Rec) (h189 : ∀ p ∈ LinRQSC189.blobs, LinesCl t5 (t4OfRec p.1)) (h190 : ∀ p ∈ LinRQSC190.blobs, LinesCl t5 (t4OfRec p.1))

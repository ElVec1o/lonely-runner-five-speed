/-
# L5Reg.Reg57 : the lines clause for every class of the local table of rep #57 (generated by l5reg)

Every local class `i < nT` of rep #57 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O57T
import LRSpectrumFull.L5S4.LinRQSC37

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R57
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(37, LinRQSC37.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(37, 120, [2, -1, 0, -1, 1, -1, -1, 1, 0]), (37, 121, [2, -1, -1, -1, 1, 0, 2, -2, -1]), (37, 122, [2, 0, -1, -1, 0, 0, 1, 1, -1]), (37, 123, [2, -1, -1, -1, 1, 1, 2, -1, -2]), (37, 124, [0, 1, 0, -1, 0, 0, -1, 1, 1]), (37, 125, [0, 1, 0, -1, 0, 1, 0, 1, -1]), (37, 126, [0, 0, 1, -1, 0, 0, 0, -1, 1]), (37, 127, [2, 0, -1, -1, -4, 1, 1, -3, 0]), (37, 128, [0, 0, 1, -1, 0, 0, 0, 1, 0]), (37, 129, [2, 0, -1, -1, 0, 1, 2, 1, 0]), (37, 130, [2, 0, -1, -1, 0, 0, 0, -1, -1]), (37, 131, [2, 0, -1, -1, 0, 0, 1, -1, -2]), (37, 132, [2, 0, -1, -1, 0, 0, 0, 1, 1]), (37, 133, [2, 0, -1, -1, -1, -1, 0, -1, -1]), (37, 134, [2, 0, -1, -1, 1, 0, 2, 1, -1]), (37, 135, [2, -1, 0, -1, 1, 0, 1, 1, 1]), (37, 136, [2, 0, -1, -1, 1, 0, 1, 2, -1]), (37, 137, [2, 0, -1, -1, 0, 0, 1, 1, 0]), (37, 138, [2, 0, -1, -1, 0, 0, 0, 1, 1]), (37, 139, [2, 0, -1, -1, 0, 0, 0, 1, 1]), (37, 140, [0, 2, -1, 0, -1, 0, 1, 1, 0]), (37, 141, [0, 0, 1, 0, -1, 0, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N57.TT) N57.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N57.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #57. -/
theorem lines (t5 : List T5Rec) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N57.nT).map (t4At (LRSpectrumFull.L5S4.dg N57.TT) N57.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h37 p hp
)

#print axioms lines

end R57
end L5Reg
end LRSpectrumFull

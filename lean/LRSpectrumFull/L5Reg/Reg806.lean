/-
# L5Reg.Reg806 : the lines clause for every class of the local table of rep #806 (generated by l5reg)

Every local class `i < nT` of rep #806 (17 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O806T
import LRSpectrumFull.L5S4.LinRQSC870
import LRSpectrumFull.L5S4.LinRQSC873

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R806
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(870, LinRQSC870.blobs), (873, LinRQSC873.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(873, 221, [2, 0, -1, 0, 1, 0, -1, 0, 0]), (870, 35, [0, -1, 1, 1, -1, 0, -2, -1, 2]), (873, 222, [0, 2, -1, -1, 0, 0, 0, -1, 1]), (873, 223, [0, 2, 1, 1, 0, 0, 2, 1, 1]), (870, 73, [0, -1, 0, 0, 2, -1, 1, 0, 0]), (873, 224, [1, -1, 0, 0, -1, 1, -1, -1, 1]), (873, 225, [1, 0, 0, 0, 0, 1, -1, 1, 0]), (873, 226, [1, 1, 0, 0, 1, 0, 1, -1, -1]), (873, 227, [0, 1, 0, -1, 0, 0, 1, 0, -1]), (873, 228, [1, -1, 0, 0, -1, 0, -2, 0, 1]), (873, 229, [2, 0, -1, 0, 1, 0, 1, 0, 0]), (873, 230, [2, -1, 0, 0, -1, 1, -1, -1, 1]), (873, 231, [0, -2, 1, -1, 0, 0, 1, 1, -1]), (873, 232, [0, 1, -1, -1, 1, 0, 1, 1, -1]), (873, 233, [0, -1, 0, 1, -1, 0, 2, 1, -1]), (873, 234, [0, 2, -1, -1, 0, 1, 1, -1, 0]), (873, 235, [0, 0, -1, -1, 0, 0, 1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N806.TT) N806.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N806.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #806. -/
theorem lines (t5 : List T5Rec) (h870 : ∀ p ∈ LinRQSC870.blobs, LinesCl t5 (t4OfRec p.1)) (h873 : ∀ p ∈ LinRQSC873.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N806.nT).map (t4At (LRSpectrumFull.L5S4.dg N806.TT) N806.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h870 p hp
  · exact h873 p hp
)

#print axioms lines

end R806
end L5Reg
end LRSpectrumFull

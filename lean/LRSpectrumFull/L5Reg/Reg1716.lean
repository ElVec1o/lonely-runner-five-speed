/-
# L5Reg.Reg1716 : the lines clause for every class of the local table of rep #1716 (generated by l5reg)

Every local class `i < nT` of rep #1716 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1716T
import LRSpectrumFull.L5S4.LinRQSC1044

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1716
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1044, LinRQSC1044.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1044, 10, [1, 1, -1, -1, -2, 1, 4, -1, -3]), (1044, 11, [1, 1, -1, -1, -2, 1, 4, -1, -3]), (1044, 12, [1, -1, 0, -1, 2, -1, 4, 1, -4]), (1044, 13, [1, 0, -1, -1, 1, 1, 3, -1, -2]), (1044, 14, [1, 1, -1, -1, 2, 0, 4, -1, -2]), (1044, 15, [1, 0, -1, -1, 1, 1, 3, -1, -2]), (1044, 16, [1, -1, 0, -2, 1, 0, -3, -2, 1]), (1044, 17, [1, -1, 1, -2, 1, 2, -3, 2, 0]), (1044, 18, [1, -1, 0, -2, -2, 1, -2, 1, 0]), (1044, 19, [1, -1, 1, -2, 0, 1, -2, 1, -1]), (1044, 20, [1, -1, 0, -2, 1, 0, -2, -2, 1]), (1044, 21, [1, 1, -1, -2, 2, 1, -3, 0, 2]), (1044, 22, [1, 1, -1, -2, 2, -1, -2, -1, 1]), (1044, 23, [1, -1, 0, -2, 2, 1, -3, 2, 1]), (1044, 24, [1, -1, 0, -2, 1, 0, -4, -1, 1]), (1044, 25, [1, 0, 1, -2, 0, -1, -2, 1, 2]), (1044, 26, [1, -1, 0, -2, 2, 1, -4, 3, 1]), (1044, 27, [1, 0, 0, -2, 2, -1, -3, 1, 0]), (1044, 28, [1, 1, -1, -2, 2, -1, -3, 0, 1]), (1044, 29, [1, 0, 0, -2, 1, 0, -4, 1, 1]), (1044, 30, [1, 1, -1, -2, 2, -1, -2, -1, 1]), (1044, 31, [1, 0, -1, -2, 2, 1, -3, 1, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1716.TT) N1716.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1716.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1716. -/
theorem lines (t5 : List T5Rec) (h1044 : ∀ p ∈ LinRQSC1044.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1716.nT).map (t4At (LRSpectrumFull.L5S4.dg N1716.TT) N1716.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h1044 p hp
)

#print axioms lines

end R1716
end L5Reg
end LRSpectrumFull

/-- the lines clause for every class of the local table of rep #271. -/
theorem lines (t5 : List T5Rec) (h429 : ∀ p ∈ LinRQSC429.blobs, LinesCl t5 (t4OfRec p.1)) (h430 : ∀ p ∈ LinRQSC430.blobs, LinesCl t5 (t4OfRec p.1)) (h431 : ∀ p ∈ LinRQSC431.blobs, LinesCl t5 (t4OfRec p.1)) (h432 : ∀ p ∈ LinRQSC432.blobs, LinesCl t5 (t4OfRec p.1)) (h433 : ∀ p ∈ LinRQSC433.blobs, LinesCl t5 (t4OfRec p.1)) (h434 : ∀ p ∈ LinRQSC434.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N271.nT).map (t4At (LRSpectrumFull.L5S4.dg N271.TT) N271.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl
  · exact h429 p hp
  · exact h430 p hp
  · exact h431 p hp
  · exact h432 p hp
  · exact h433 p hp
  · exact h434 p hp
)


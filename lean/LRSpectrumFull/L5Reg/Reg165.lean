/-- the lines clause for every class of the local table of rep #165. -/
theorem lines (t5 : List T5Rec) (h180 : ∀ p ∈ LinRQSC180.blobs, LinesCl t5 (t4OfRec p.1)) (h181 : ∀ p ∈ LinRQSC181.blobs, LinesCl t5 (t4OfRec p.1)) (h182 : ∀ p ∈ LinRQSC182.blobs, LinesCl t5 (t4OfRec p.1)) (h183 : ∀ p ∈ LinRQSC183.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N165.nT).map (t4At (LRSpectrumFull.L5S4.dg N165.TT) N165.ST), LinesCl t5 cl := by
  intro cl hcl
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hcl
  have hc' : c < N165.nT := List.mem_range.1 hc
  have hn : N165.nT = 359 := rfl
  have hcase : (0 ≤ c ∧ c < 100) ∨ (100 ≤ c ∧ c < 200) ∨ (200 ≤ c ∧ c < 300) ∨ (300 ≤ c ∧ c < 359) := by omega
  rcases hcase with h | h | h | h
  · exact P165_0.lines t5 h180 h181 c h.1 (by omega)
  · exact P165_1.lines t5 h181 h182 c h.1 (by omega)
  · exact P165_2.lines t5 h182 h183 c h.1 (by omega)
  · exact P165_3.lines t5 h183 c h.1 (by omega)

#print axioms lines


/-
# L5Reg.Reg168 : the lines clause for every class of the local table of rep #168 (generated by l5reg)

Every local class `i < nT` of rep #168 (40 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O168T
import LRSpectrumFull.L5S4.LinRQSC185

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R168
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(185, LinRQSC185.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(185, 56, [2, 1, -2, -1, 4, 0, 2, -3, -1]), (185, 57, [2, -1, 0, -1, 1, 0, 0, 0, 1]), (185, 58, [2, 0, -1, -1, 1, 0, 0, 3, -2]), (185, 59, [2, 0, -1, -1, -1, 1, 0, -3, 1]), (185, 60, [2, 0, -1, -1, -1, 1, -1, 4, -1]), (185, 61, [2, -1, -1, -1, 2, 0, 1, -1, 0]), (185, 62, [2, 1, -2, -1, 4, -1, 0, -2, 1]), (185, 63, [2, 1, -1, -1, 4, -2, 0, 2, -1]), (185, 64, [2, 1, -1, -1, 4, -2, 0, -2, 1]), (185, 65, [2, 1, -2, -1, 4, -1, 1, -2, 0]), (185, 66, [2, -1, -1, -1, 2, 0, 2, -2, -1]), (185, 67, [2, 0, -1, -1, -1, 1, 0, -3, 1]), (185, 68, [2, -1, -1, -1, 2, 0, 1, -1, 0]), (185, 69, [2, -1, -1, -1, 2, 0, -1, 1, 0]), (185, 70, [2, -1, -1, -1, 1, 0, 0, 0, -1]), (185, 71, [2, -1, -1, -1, 0, 1, -1, 2, 0]), (185, 72, [2, 0, -1, -1, -1, 1, 0, 3, -1]), (185, 73, [2, -1, -1, -1, 0, 1, 0, -2, 1]), (185, 74, [2, 0, -1, -1, -1, 1, 1, -4, 1]), (185, 75, [2, 0, -1, -1, 1, 0, -2, -3, 2]), (185, 76, [2, -1, -1, -1, 0, 1, -2, 2, 1]), (185, 77, [2, 1, -1, -1, 4, 0, 1, -3, 0]), (185, 78, [2, 1, -2, -1, 4, 0, 2, -3, -1]), (185, 79, [2, -1, 0, -1, 1, 0, 0, 0, 1]), (185, 80, [2, 1, -2, -1, 4, -3, -1, 3, -2]), (185, 81, [2, 0, -1, -1, -1, 1, -2, 3, 0]), (185, 82, [2, 1, -2, -1, 4, -3, 0, -1, 1]), (185, 83, [2, 1, -1, -1, 4, -2, 0, -2, 1]), (185, 84, [2, -1, -1, -1, 2, 0, -1, 1, 0]), (185, 85, [2, -1, -1, -1, 0, 1, 0, 2, -1]), (185, 86, [2, -1, -1, -1, 0, 1, 0, 2, -1]), (185, 87, [2, 0, -1, -1, -1, 1, -2, 3, 0]), (185, 88, [2, 0, -1, -1, -1, 1, 2, -3, 0]), (185, 89, [2, 0, -1, -1, 1, 0, 1, 4, -3]), (185, 90, [2, 0, -1, -1, 1, 0, -1, -4, 3]), (185, 91, [2, 0, -1, -1, 1, 0, 1, -4, 2]), (185, 92, [2, 0, -1, -1, -1, 1, 1, 4, -2]), (185, 93, [2, -1, -1, -1, 0, 1, 0, 2, -1]), (185, 94, [2, 1, -2, -1, 4, -1, -1, 2, 0]), (185, 95, [2, 1, -1, -1, 4, -2, 0, 2, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N168.TT) N168.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N168.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #168. -/
theorem lines (t5 : List T5Rec) (h185 : ∀ p ∈ LinRQSC185.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N168.nT).map (t4At (LRSpectrumFull.L5S4.dg N168.TT) N168.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h185 p hp
)

#print axioms lines

end R168
end L5Reg
end LRSpectrumFull

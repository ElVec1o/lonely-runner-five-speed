/-
# L5Reg.Reg1080 : the lines clause for every class of the local table of rep #1080 (generated by l5reg)

Every local class `i < nT` of rep #1080 (15 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1080T
import LRSpectrumFull.L5S4.LinRQSC919

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1080
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(919, LinRQSC919.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(919, 41, [1, 0, -1, 3, 1, -3, 0, -2, 1]), (919, 42, [2, -1, -1, 0, -1, 0, -3, 1, 2]), (919, 43, [2, -2, -1, 0, 1, 0, -3, -2, 2]), (919, 44, [2, -1, -1, -1, 0, 1, 3, 1, -3]), (919, 45, [2, -2, -1, -1, 0, 1, 2, 3, -3]), (919, 46, [2, 2, -1, -1, 0, 0, 1, -3, 1]), (919, 47, [2, -1, 0, -1, -3, 3, 3, 1, -2]), (919, 48, [2, 0, -1, -1, -1, 0, -3, 0, 1]), (919, 49, [2, 1, -2, -1, 0, 1, -3, 1, 2]), (919, 50, [1, 2, -2, 0, -1, 1, 1, -2, 1]), (919, 51, [2, 1, -2, 0, 3, -1, 3, -2, -2]), (919, 52, [1, 0, 0, 3, 1, 1, 2, -2, -1]), (919, 53, [1, 0, -1, 3, 1, -3, -1, -3, 2]), (919, 54, [1, -2, 0, 3, 0, -1, -2, -3, 1]), (919, 55, [1, 2, -1, 3, -1, 0, 0, -2, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1080.TT) N1080.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1080.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1080. -/
theorem lines (t5 : List T5Rec) (h919 : ∀ p ∈ LinRQSC919.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1080.nT).map (t4At (LRSpectrumFull.L5S4.dg N1080.TT) N1080.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h919 p hp
)

#print axioms lines

end R1080
end L5Reg
end LRSpectrumFull

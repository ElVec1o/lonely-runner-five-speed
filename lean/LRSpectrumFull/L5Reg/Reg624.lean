/-
# L5Reg.Reg624 : the lines clause for every class of the local table of rep #624 (generated by l5reg)

Every local class `i < nT` of rep #624 (19 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O624T
import LRSpectrumFull.L5S4.LinRQSC438
import LRSpectrumFull.L5S4.LinRQSC439
import LRSpectrumFull.L5S4.LinRQSC841

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R624
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(438, LinRQSC438.blobs), (439, LinRQSC439.blobs), (841, LinRQSC841.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(438, 75, [1, -1, 0, 4, 3, -1, -2, 1, 0]), (841, 8, [1, 0, -1, -2, -1, 2, 4, 0, -3]), (841, 9, [1, -1, 0, -2, -3, 3, -3, 0, 2]), (438, 21, [1, 0, -1, 4, 0, -3, -1, -1, 2]), (841, 10, [1, 0, -1, -1, -2, 2, -3, 1, 2]), (841, 11, [1, 1, -1, -2, 3, 1, -4, 2, 3]), (439, 5, [1, -1, 0, 4, 3, -1, -1, 2, 0]), (841, 12, [1, 0, 0, 3, -2, 3, 1, 3, -4]), (841, 13, [1, 0, -1, -1, -1, 2, -4, 0, 3]), (841, 14, [1, 0, -1, 3, 2, -4, 1, -3, 1]), (841, 15, [1, 0, -1, -1, 1, 0, -4, 0, 3]), (438, 55, [1, 0, -1, 4, 1, -4, 1, -3, 0]), (841, 16, [1, 0, -1, -1, 1, 0, -3, -1, 3]), (439, 4, [1, -1, 0, 4, 3, -2, 1, 3, -1]), (841, 17, [1, 0, -1, 3, 1, -3, 2, -1, -1]), (438, 20, [1, 0, -1, 4, 0, -3, 1, -1, 0]), (841, 18, [0, 1, 0, -3, -1, 2, 5, 0, -3]), (841, 19, [1, 0, -1, 3, 3, -5, 4, -1, -3]), (841, 20, [1, 1, -1, 3, -2, -2, 1, 0, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N624.TT) N624.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N624.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #624. -/
theorem lines (t5 : List T5Rec) (h438 : ∀ p ∈ LinRQSC438.blobs, LinesCl t5 (t4OfRec p.1)) (h439 : ∀ p ∈ LinRQSC439.blobs, LinesCl t5 (t4OfRec p.1)) (h841 : ∀ p ∈ LinRQSC841.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N624.nT).map (t4At (LRSpectrumFull.L5S4.dg N624.TT) N624.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h438 p hp
  · exact h439 p hp
  · exact h841 p hp
)

#print axioms lines

end R624
end L5Reg
end LRSpectrumFull

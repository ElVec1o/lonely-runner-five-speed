/-
# L5Reg.Reg967 : the lines clause for every class of the local table of rep #967 (generated by l5reg)

Every local class `i < nT` of rep #967 (18 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O967T
import LRSpectrumFull.L5S4.LinRQSC892

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R967
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(892, LinRQSC892.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(892, 46, [2, -1, 0, -3, -2, 1, 1, -1, 0]), (892, 47, [2, -1, 0, -3, 1, 1, -1, 0, 0]), (892, 48, [1, -1, 0, 2, -1, -1, 4, -1, -2]), (892, 49, [2, 2, -3, -3, 1, 2, 2, -3, 0]), (892, 50, [2, 2, -1, 1, -3, 1, -2, 3, -1]), (892, 51, [2, -2, 1, -3, -1, 1, 2, 3, -2]), (892, 52, [2, -1, -1, -3, -2, 4, 0, 3, -2]), (892, 53, [2, 2, -1, -3, 1, 0, -2, 3, -1]), (892, 54, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (892, 55, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (892, 56, [2, -1, -1, -3, -2, 4, 0, 3, -2]), (892, 57, [2, 0, -1, -3, 0, 1, 0, 1, -2]), (892, 58, [2, -1, 0, -3, -2, 3, 1, 2, -2]), (892, 59, [2, 0, -1, -3, -1, 2, -2, 1, 0]), (892, 60, [2, 0, -1, -3, 0, 1, 1, -1, 0]), (892, 61, [2, -1, 0, -3, 1, 0, 0, 1, -1]), (892, 62, [2, 0, -1, -3, 0, 1, -1, -1, 1]), (892, 63, [2, 0, -1, -3, 0, 1, 1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N967.TT) N967.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N967.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #967. -/
theorem lines (t5 : List T5Rec) (h892 : ∀ p ∈ LinRQSC892.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N967.nT).map (t4At (LRSpectrumFull.L5S4.dg N967.TT) N967.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h892 p hp
)

#print axioms lines

end R967
end L5Reg
end LRSpectrumFull

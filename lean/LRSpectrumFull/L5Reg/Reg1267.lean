/-
# L5Reg.Reg1267 : the lines clause for every class of the local table of rep #1267 (generated by l5reg)

Every local class `i < nT` of rep #1267 (41 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1267T
import LRSpectrumFull.L5S4.LinRQSC955
import LRSpectrumFull.L5S4.LinRQSC958
import LRSpectrumFull.L5S4.LinRQSC977

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1267
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(955, LinRQSC955.blobs), (958, LinRQSC958.blobs), (977, LinRQSC977.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(977, 69, [2, 1, -1, -2, 0, 1, -1, 2, 0]), (977, 70, [1, 1, -1, 3, -1, 0, -3, 0, 1]), (977, 71, [2, 0, -1, -2, 1, 1, 1, 3, -1]), (977, 72, [1, 0, -1, 3, -1, -2, -1, 2, 0]), (977, 73, [1, 0, -1, 3, -1, -2, 2, 2, -3]), (977, 74, [1, 0, -1, -1, 1, 0, -1, -2, 2]), (977, 75, [1, -1, 0, 3, 0, -2, 1, 1, -1]), (977, 76, [1, -1, 0, -1, 0, 1, -1, -3, 3]), (977, 77, [1, 0, 0, 3, -1, 0, 0, -2, 1]), (977, 78, [1, -1, 0, 3, 1, -1, -2, 1, 0]), (977, 79, [1, 0, 0, 3, 1, -1, 0, -2, 1]), (977, 80, [1, -1, 0, -1, 0, 1, -1, -3, 3]), (977, 81, [2, 1, -2, -2, 3, -1, 1, 3, -3]), (955, 47, [2, -1, 0, -1, -3, 3, -2, 0, 1]), (977, 82, [1, 0, 0, 3, 1, -1, 0, -2, 1]), (958, 91, [1, 1, -1, -2, 3, 0, 3, 1, -2]), (977, 83, [1, 0, -1, -1, -1, 1, -1, 1, 0]), (977, 84, [1, 2, -2, 1, -2, 1, -4, 1, 1]), (977, 85, [1, 2, -1, 3, -2, -2, 0, 1, 0]), (977, 86, [1, 1, -1, 0, 3, -1, 3, -2, -1]), (977, 87, [0, -1, 0, 1, 1, -1, 3, -1, -2]), (977, 88, [1, 1, -1, 1, 3, -2, -2, 3, 0]), (958, 87, [1, 1, -1, 0, 3, -2, 1, 0, 0]), (977, 89, [2, 0, -1, -2, -1, 1, 1, -2, 0]), (977, 90, [1, -2, 0, 0, 2, -1, 3, 3, -4]), (977, 91, [1, -1, 0, 3, 1, -3, -3, 0, 2]), (955, 48, [2, 0, -1, -1, 0, 0, 2, 1, 0]), (977, 92, [1, 0, 0, 1, -1, 0, -3, 0, 1]), (958, 82, [1, 1, -1, 3, 0, -2, 1, -1, 0]), (977, 93, [1, 0, -1, -1, -1, 1, 0, -2, 1]), (977, 94, [1, 1, -1, 0, 3, -2, 3, -2, 0]), (977, 95, [1, 1, -1, 0, 3, -2, 3, 1, -2]), (958, 88, [1, -1, 0, 0, 1, 0, -1, -1, 1]), (977, 96, [2, -1, -1, -2, -3, 2, 1, 2, -1]), (977, 97, [0, 1, -1, 1, 3, -3, 4, 1, -2]), (958, 73, [1, -1, 0, 0, 1, 0, 1, 3, -1]), (977, 98, [1, -1, 0, -1, -1, 1, -1, 0, 0]), (977, 99, [2, 1, -1, -2, 1, 0, 1, -3, 1]), (977, 100, [2, -1, -1, -2, -3, 2, -1, -1, 1]), (977, 101, [1, 0, -1, -1, -1, 1, 1, -2, 0]), (977, 102, [2, -1, 0, -2, -3, 3, -1, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1267.TT) N1267.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1267.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1267. -/
theorem lines (t5 : List T5Rec) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1)) (h958 : ∀ p ∈ LinRQSC958.blobs, LinesCl t5 (t4OfRec p.1)) (h977 : ∀ p ∈ LinRQSC977.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1267.nT).map (t4At (LRSpectrumFull.L5S4.dg N1267.TT) N1267.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h955 p hp
  · exact h958 p hp
  · exact h977 p hp
)

#print axioms lines

end R1267
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 0..99 of rep #553. -/
theorem lines (t5 : List T5Rec) (h816 : ∀ p ∈ LinRQSC816.blobs, LinesCl t5 (t4OfRec p.1)) (h817 : ∀ p ∈ LinRQSC817.blobs, LinesCl t5 (t4OfRec p.1)) (h818 : ∀ p ∈ LinRQSC818.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 0 ≤ c → c < 0 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N553.TT) N553.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl
    · exact h816 p hpe
    · exact h817 p hpe
    · exact h818 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 0 advOk c h1 ?_
  rw [adv_len]; exact h2


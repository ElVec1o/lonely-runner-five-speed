/-- the lines clause for every class of the local table of rep #295. -/
theorem lines (t5 : List T5Rec) (h457 : ∀ p ∈ LinRQSC457.blobs, LinesCl t5 (t4OfRec p.1)) (h458 : ∀ p ∈ LinRQSC458.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N295.nT).map (t4At (LRSpectrumFull.L5S4.dg N295.TT) N295.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h457 p hp
  · exact h458 p hp
)


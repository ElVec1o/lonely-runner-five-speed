theorem adv_len : adv.length = N59.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #59. -/
theorem lines (t5 : List T5Rec) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1)) (h37 : ∀ p ∈ LinRQSC37.blobs, LinesCl t5 (t4OfRec p.1)) (h38 : ∀ p ∈ LinRQSC38.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N59.nT).map (t4At (LRSpectrumFull.L5S4.dg N59.TT) N59.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h32 p hp
  · exact h37 p hp
  · exact h38 p hp
)


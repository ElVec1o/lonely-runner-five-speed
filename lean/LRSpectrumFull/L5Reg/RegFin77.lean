/-
# L5Reg.RegFin77 : the lines clause for the local class tables of 2 reps, from the global lines clause (generated by l5reg `fin`)

`lines<c>` instantiates `L5Reg.R<c>.lines` with `FinalGlue.glines` (lines clause of every record of `LinRAll.blobs`) through `L5Reg.Mem`.
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Mem
import LRSpectrumFull.L5S5.FinalGlue
import LRSpectrumFull.L5Reg.Reg341
import LRSpectrumFull.L5Reg.Reg387

namespace LRSpectrumFull
namespace L5Reg
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S5

theorem lines341 : ∀ cl ∈ (List.range N341.nT).map (t4At (LRSpectrumFull.L5S4.dg N341.TT) N341.ST), LinesCl T5Store.t5 cl :=
  R341.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem703 p hp))

theorem lines387 : ∀ cl ∈ (List.range N387.nT).map (t4At (LRSpectrumFull.L5S4.dg N387.TT) N387.ST), LinesCl T5Store.t5 cl :=
  R387.lines T5Store.t5 (fun p hp => FinalGlue.glines p (mem439 p hp)) (fun p hp => FinalGlue.glines p (mem725 p hp)) (fun p hp => FinalGlue.glines p (mem726 p hp))

#print axioms lines341

end L5Reg
end LRSpectrumFull

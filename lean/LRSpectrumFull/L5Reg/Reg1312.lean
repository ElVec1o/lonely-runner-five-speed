theorem lines (t5 : List T5Rec) (h930 : ∀ p ∈ LinRQSC930.blobs, LinesCl t5 (t4OfRec p.1)) (h932 : ∀ p ∈ LinRQSC932.blobs, LinesCl t5 (t4OfRec p.1)) (h955 : ∀ p ∈ LinRQSC955.blobs, LinesCl t5 (t4OfRec p.1)) (h959 : ∀ p ∈ LinRQSC959.blobs, LinesCl t5 (t4OfRec p.1)) (h966 : ∀ p ∈ LinRQSC966.blobs, LinesCl t5 (t4OfRec p.1)) (h1004 : ∀ p ∈ LinRQSC1004.blobs, LinesCl t5 (t4OfRec p.1)) (h1005 : ∀ p ∈ LinRQSC1005.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1312.nT).map (t4At (LRSpectrumFull.L5S4.dg N1312.TT) N1312.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h930 p hp
  · exact h932 p hp
  · exact h955 p hp
  · exact h959 p hp
  · exact h966 p hp
  · exact h1004 p hp
  · exact h1005 p hp
)


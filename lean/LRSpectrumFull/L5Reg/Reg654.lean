theorem lines (t5 : List T5Rec) (h232 : ∀ p ∈ LinRQSC232.blobs, LinesCl t5 (t4OfRec p.1)) (h693 : ∀ p ∈ LinRQSC693.blobs, LinesCl t5 (t4OfRec p.1)) (h694 : ∀ p ∈ LinRQSC694.blobs, LinesCl t5 (t4OfRec p.1)) (h695 : ∀ p ∈ LinRQSC695.blobs, LinesCl t5 (t4OfRec p.1)) (h864 : ∀ p ∈ LinRQSC864.blobs, LinesCl t5 (t4OfRec p.1)) (h865 : ∀ p ∈ LinRQSC865.blobs, LinesCl t5 (t4OfRec p.1)) (h866 : ∀ p ∈ LinRQSC866.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N654.nT).map (t4At (LRSpectrumFull.L5S4.dg N654.TT) N654.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact h232 p hp
  · exact h693 p hp
  · exact h694 p hp
  · exact h695 p hp
  · exact h864 p hp
  · exact h865 p hp
  · exact h866 p hp
)


/-
# L5Reg.Reg47 : the lines clause for every class of the local table of rep #47 (generated by l5reg)

Every local class `i < nT` of rep #47 (37 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O47T
import LRSpectrumFull.L5S4.LinRQSC32

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R47
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(32, LinRQSC32.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(32, 65, [0, -2, 1, 0, 1, 0, -1, 0, 0]), (32, 66, [0, -2, 1, 0, 1, 0, -1, 1, 0]), (32, 67, [2, 0, -1, -1, 0, 1, 1, 1, -1]), (32, 68, [2, -1, 0, -1, 1, -1, 1, -1, 0]), (32, 69, [2, 1, -1, -1, 3, -1, 1, -1, 0]), (32, 70, [2, 1, -1, -1, 3, -1, 1, -1, 0]), (32, 71, [2, 1, -2, -1, 3, -1, 0, -2, 1]), (32, 72, [2, 1, -1, -1, 3, 0, 1, -4, 0]), (32, 73, [2, 1, -1, -1, 3, -1, 2, -4, 1]), (32, 74, [2, 1, -2, -1, 3, 0, -2, 3, 1]), (32, 75, [2, 1, -1, -1, 3, -1, -1, 1, 0]), (32, 76, [2, -1, 0, -1, 1, -1, -1, 1, 0]), (32, 77, [2, 1, -2, -1, 3, -2, 0, 1, -1]), (32, 78, [2, 1, -1, -1, 3, 0, 0, 1, 0]), (32, 79, [2, 1, -1, -1, 3, -2, -2, 3, -2]), (32, 80, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (32, 81, [2, 0, -1, -1, 0, 1, 0, -1, 1]), (32, 82, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (32, 83, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (32, 84, [2, 0, -1, -1, 0, 1, 0, -1, 1]), (32, 85, [2, 0, -1, -1, 0, 1, 1, -1, 0]), (32, 86, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (32, 87, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (32, 88, [0, 2, -1, 0, -1, 0, -1, 0, 0]), (32, 89, [0, 2, -1, 0, -1, 0, -1, -1, 1]), (32, 90, [0, 2, -1, 0, -1, 0, -1, 0, 1]), (32, 91, [2, 1, -2, -1, 3, 0, -2, 3, 1]), (32, 92, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (32, 93, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (32, 94, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (32, 95, [2, 0, -1, -1, 0, 1, -2, -1, 2]), (32, 96, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (32, 97, [2, 0, -1, -1, 0, 1, 0, -1, 0]), (32, 98, [2, 0, -1, -1, 0, 1, 0, -1, 1]), (32, 99, [2, 0, -1, -1, 0, 1, 1, -1, 0]), (32, 100, [2, 0, -1, -1, 0, 1, -1, -1, 1]), (32, 101, [2, 0, -1, -1, 0, 1, 0, -1, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N47.TT) N47.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N47.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #47. -/
theorem lines (t5 : List T5Rec) (h32 : ∀ p ∈ LinRQSC32.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N47.nT).map (t4At (LRSpectrumFull.L5S4.dg N47.TT) N47.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl
  exact h32 p hp
)

#print axioms lines

end R47
end L5Reg
end LRSpectrumFull

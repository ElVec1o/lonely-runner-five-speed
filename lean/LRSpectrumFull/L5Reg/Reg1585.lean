/-
# L5Reg.Reg1585 : the lines clause for every class of the local table of rep #1585 (generated by l5reg)

Every local class `i < nT` of rep #1585 (11 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1585T
import LRSpectrumFull.L5S4.LinRQSC199
import LRSpectrumFull.L5S4.LinRQSC1026

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1585
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(199, LinRQSC199.blobs), (1026, LinRQSC1026.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(199, 213, [0, 0, 1, -1, 0, 0, 1, -1, 0]), (199, 166, [3, 2, -1, 0, -3, 1, -2, 1, 0]), (199, 191, [3, 0, -1, 2, -2, 1, -3, -1, 2]), (199, 189, [3, -1, -1, 2, 0, -1, -2, 1, 1]), (199, 172, [3, 0, -1, 0, 1, -1, 2, -1, 0]), (199, 188, [3, 0, -2, 2, -1, -1, -2, -1, 2]), (199, 162, [0, -3, 2, -1, 0, 0, -1, 2, -1]), (199, 185, [3, 0, -2, 2, 2, -3, -1, 3, -2]), (199, 186, [0, 0, 1, 1, 0, 0, 1, -1, 0]), (1026, 167, [1, -1, 1, 0, 0, -1, -1, 0, 1]), (199, 212, [0, 0, -1, -3, 1, 0, -1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1585.TT) N1585.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1585.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1585. -/
theorem lines (t5 : List T5Rec) (h199 : ∀ p ∈ LinRQSC199.blobs, LinesCl t5 (t4OfRec p.1)) (h1026 : ∀ p ∈ LinRQSC1026.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1585.nT).map (t4At (LRSpectrumFull.L5S4.dg N1585.TT) N1585.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h199 p hp
  · exact h1026 p hp
)

#print axioms lines

end R1585
end L5Reg
end LRSpectrumFull

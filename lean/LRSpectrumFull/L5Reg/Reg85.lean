theorem adv_len : adv.length = N85.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #85. -/
theorem lines (t5 : List T5Rec) (h84 : ∀ p ∈ LinRQSC84.blobs, LinesCl t5 (t4OfRec p.1)) (h85 : ∀ p ∈ LinRQSC85.blobs, LinesCl t5 (t4OfRec p.1)) (h86 : ∀ p ∈ LinRQSC86.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N85.nT).map (t4At (LRSpectrumFull.L5S4.dg N85.TT) N85.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h84 p hp
  · exact h85 p hp
  · exact h86 p hp
)


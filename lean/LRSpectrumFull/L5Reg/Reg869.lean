/-
# L5Reg.Reg869 : the lines clause for every class of the local table of rep #869 (generated by l5reg)

Every local class `i < nT` of rep #869 (24 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O869T
import LRSpectrumFull.L5S4.LinRQSC879
import LRSpectrumFull.L5S4.LinRQSC880

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R869
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(879, LinRQSC879.blobs), (880, LinRQSC880.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(880, 203, [3, 0, -2, 1, 0, -1, 0, -1, 1]), (880, 204, [1, 3, -1, 3, 0, -2, 0, 1, 0]), (880, 205, [0, -1, 0, 0, -2, 1, -1, -1, 1]), (880, 206, [0, -1, 1, 1, -1, 0, 0, 0, 1]), (880, 207, [1, 0, -1, 0, 3, -2, -3, 1, 2]), (880, 208, [1, 3, -1, 0, 1, 0, -3, 1, 2]), (880, 209, [0, -1, 1, 1, -1, 1, 0, 0, -1]), (880, 210, [1, -3, 0, 0, -1, 0, -3, -2, 1]), (880, 211, [3, -1, 0, -1, -3, -1, 1, 0, 0]), (880, 212, [0, -3, 1, 2, -1, 0, -3, 1, 0]), (879, 94, [3, -1, -2, 0, -3, 2, 1, 3, -3]), (880, 213, [3, -1, -2, 1, 0, -1, 1, 3, -3]), (880, 214, [3, -1, -2, -1, -3, 3, 1, 0, -1]), (879, 172, [3, -1, -2, 0, -3, 2, -1, 0, 1]), (880, 215, [3, 0, -1, 1, -3, 1, 0, -2, 1]), (880, 216, [3, 0, -1, 1, -1, 0, 0, -1, 0]), (880, 217, [0, 3, -1, 1, 1, -1, 1, 0, -1]), (879, 77, [3, 0, -2, 0, 1, -1, -1, 3, -2]), (880, 218, [3, 0, -1, 1, 3, -1, 2, 2, -1]), (879, 171, [3, -1, -2, 0, -3, 1, 1, -2, 0]), (880, 219, [1, 0, -1, 2, 1, -2, -2, 1, 1]), (879, 95, [3, 0, -2, 0, -1, 0, -1, -3, 1]), (880, 220, [3, 0, -1, 1, 3, -1, 2, 2, -1]), (880, 221, [1, 0, -1, 2, 3, -3, -3, 2, 2])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N869.TT) N869.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N869.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #869. -/
theorem lines (t5 : List T5Rec) (h879 : ∀ p ∈ LinRQSC879.blobs, LinesCl t5 (t4OfRec p.1)) (h880 : ∀ p ∈ LinRQSC880.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N869.nT).map (t4At (LRSpectrumFull.L5S4.dg N869.TT) N869.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h879 p hp
  · exact h880 p hp
)

#print axioms lines

end R869
end L5Reg
end LRSpectrumFull

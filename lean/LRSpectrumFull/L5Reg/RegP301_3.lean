/-- the lines clause for local classes 300..399 of rep #301. -/
theorem lines (t5 : List T5Rec) (h537 : ∀ p ∈ LinRQSC537.blobs, LinesCl t5 (t4OfRec p.1)) (h538 : ∀ p ∈ LinRQSC538.blobs, LinesCl t5 (t4OfRec p.1)) (h539 : ∀ p ∈ LinRQSC539.blobs, LinesCl t5 (t4OfRec p.1)) (h540 : ∀ p ∈ LinRQSC540.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ c, 300 ≤ c → c < 300 + 100 → LinesCl t5 (t4At (LRSpectrumFull.L5S4.dg N301.TT) N301.ST c) := by
  intro c h1 h2
  have hbl : ∀ j, ∀ p ∈ assoc bls j, LinesCl t5 (t4OfRec p.1) := by
    intro j p hp
    obtain ⟨e, he, hpe⟩ := assoc_mem hp
    simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl
    · exact h537 p hpe
    · exact h538 p hpe
    · exact h539 p hpe
    · exact h540 p hpe
  refine eqAll_sound t5 _ _ (assoc bls) hbl adv 300 advOk c h1 ?_
  rw [adv_len]; exact h2


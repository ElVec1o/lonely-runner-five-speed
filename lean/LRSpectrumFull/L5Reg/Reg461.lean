/-
# L5Reg.Reg461 : the lines clause for every class of the local table of rep #461 (generated by l5reg)

Every local class `i < nT` of rep #461 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O461T
import LRSpectrumFull.L5S4.LinRQSC442
import LRSpectrumFull.L5S4.LinRQSC727

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R461
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(442, LinRQSC442.blobs), (727, LinRQSC727.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(727, 7, [1, 0, 0, 0, -4, -1, 4, -1, 0]), (727, 8, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (442, 13, [1, 0, -1, 4, 0, -3, 0, 1, 0]), (727, 9, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (727, 10, [1, -1, 0, 0, 2, -1, 4, 3, -4]), (727, 11, [1, 0, -1, 0, -1, 1, 4, 0, -3]), (727, 12, [1, 0, -1, 0, 1, 0, 4, 0, -3]), (727, 13, [1, 0, -1, 0, 1, 0, 3, 0, -2]), (727, 14, [1, -1, 0, -2, 0, 1, -4, -3, 3]), (727, 15, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (727, 16, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (727, 17, [1, 0, 0, -2, 1, -4, -3, -1, 3]), (727, 18, [1, 0, -1, -2, -1, 2, -4, 0, 3]), (727, 19, [1, 0, 0, -2, -1, -4, -4, 0, 1]), (727, 20, [1, 0, -1, -2, -1, 2, -2, 1, 1]), (727, 21, [1, 0, -1, -2, 1, 1, -2, -1, 2]), (442, 24, [1, 0, -1, 4, 1, -4, 2, -4, -1]), (727, 22, [0, -1, 0, -1, 2, 0, 1, 2, -1]), (727, 23, [1, 0, 0, -2, -1, 4, -4, 0, -1]), (727, 24, [0, -1, 0, -4, 0, 1, 3, 0, -1]), (727, 25, [0, -1, 0, -1, 2, 0, 1, 3, -1]), (727, 26, [0, 1, 0, -4, 0, 1, 1, 0, 0])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N461.TT) N461.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N461.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #461. -/
theorem lines (t5 : List T5Rec) (h442 : ∀ p ∈ LinRQSC442.blobs, LinesCl t5 (t4OfRec p.1)) (h727 : ∀ p ∈ LinRQSC727.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N461.nT).map (t4At (LRSpectrumFull.L5S4.dg N461.TT) N461.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h442 p hp
  · exact h727 p hp
)

#print axioms lines

end R461
end L5Reg
end LRSpectrumFull

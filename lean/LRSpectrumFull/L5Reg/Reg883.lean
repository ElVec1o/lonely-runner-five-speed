/-
# L5Reg.Reg883 : the lines clause for every class of the local table of rep #883 (generated by l5reg)

Every local class `i < nT` of rep #883 (2 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O883T
import LRSpectrumFull.L5S4.LinRQSC876
import LRSpectrumFull.L5S4.LinRQSC881

set_option maxRecDepth 1000000

namespace LRSpectrumFull
namespace L5Reg
namespace R883
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(876, LinRQSC876.blobs), (881, LinRQSC881.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(876, 260, [3, 0, -1, -1, 0, 0, 0, -1, 1]), (881, 110, [1, 0, 0, 0, 0, 1, -3, 1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N883.TT) N883.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N883.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #883. -/
theorem lines (t5 : List T5Rec) (h876 : ∀ p ∈ LinRQSC876.blobs, LinesCl t5 (t4OfRec p.1)) (h881 : ∀ p ∈ LinRQSC881.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N883.nT).map (t4At (LRSpectrumFull.L5S4.dg N883.TT) N883.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h876 p hp
  · exact h881 p hp
)

#print axioms lines

end R883
end L5Reg
end LRSpectrumFull

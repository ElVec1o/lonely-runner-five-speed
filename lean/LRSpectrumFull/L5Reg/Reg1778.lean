/-
# L5Reg.Reg1778 : the lines clause for every class of the local table of rep #1778 (generated by l5reg)

Every local class `i < nT` of rep #1778 (22 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O1778T
import LRSpectrumFull.L5S4.LinRQSC1046
import LRSpectrumFull.L5S4.LinRQSC1047

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R1778
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(1046, LinRQSC1046.blobs), (1047, LinRQSC1047.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(1047, 97, [2, -1, -1, 0, 3, -2, -1, 1, 0]), (1047, 98, [2, -1, 0, 0, 1, -1, 3, 1, -2]), (1047, 99, [1, 1, -1, 0, -3, 2, 2, 1, -1]), (1047, 100, [1, 1, -1, 1, 0, 0, 3, 0, -1]), (1047, 101, [1, 1, -1, -3, 0, 1, 1, 0, 0]), (1047, 102, [1, 1, -1, 0, 1, -1, 1, -1, 0]), (1047, 103, [1, 2, -1, 1, 0, 0, 2, -1, 0]), (1046, 37, [1, 0, 0, 1, -1, 1, 1, -1, 0]), (1046, 284, [1, -1, 0, -1, -2, 1, -1, -1, 1]), (1047, 104, [1, -1, 0, 1, 3, -3, 3, 0, -2]), (1047, 105, [1, -1, 0, -3, 0, 1, 2, 2, -1]), (1047, 106, [1, -2, 0, -3, 0, 1, 2, 1, -1]), (1047, 107, [1, 2, -2, -3, 0, 1, 0, 1, -1]), (1047, 108, [1, -2, 1, -1, 0, 0, -2, -1, 1]), (1047, 109, [1, 1, -1, -1, 0, 0, -2, 0, 1]), (1047, 110, [1, -1, 0, -3, 2, 1, 2, -1, -2]), (1047, 111, [1, 0, 0, -3, 1, 0, 2, -2, 1]), (1047, 112, [1, -1, 0, -3, -1, 3, 0, -3, 2]), (1047, 113, [1, -1, 0, -3, -1, 1, 2, -1, 0]), (1047, 114, [1, 2, -2, -3, 0, 1, 2, -1, 0]), (1047, 115, [1, 0, -1, -3, 1, 2, 0, -1, 0]), (1047, 116, [1, -1, 0, -3, 1, 1, 0, -1, 1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N1778.TT) N1778.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N1778.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #1778. -/
theorem lines (t5 : List T5Rec) (h1046 : ∀ p ∈ LinRQSC1046.blobs, LinesCl t5 (t4OfRec p.1)) (h1047 : ∀ p ∈ LinRQSC1047.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N1778.nT).map (t4At (LRSpectrumFull.L5S4.dg N1778.TT) N1778.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl
  · exact h1046 p hp
  · exact h1047 p hp
)

#print axioms lines

end R1778
end L5Reg
end LRSpectrumFull

/-- the lines clause for local classes 200..299 of rep #162. -/
theorem lines (t5 : List T5Rec) (h172 : ∀ p ∈ LinRQSC172.blobs, LinesCl t5 (t4OfRec p.1)) (h173 : ∀ p ∈ LinRQSC173.blobs, LinesCl t5 (t4OfRec p.1))

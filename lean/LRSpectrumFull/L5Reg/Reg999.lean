theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N999.TT) N999.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N999.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #999. -/
theorem lines (t5 : List T5Rec) (h894 : ∀ p ∈ LinRQSC894.blobs, LinesCl t5 (t4OfRec p.1)) (h899 : ∀ p ∈ LinRQSC899.blobs, LinesCl t5 (t4OfRec p.1)) (h900 : ∀ p ∈ LinRQSC900.blobs, LinesCl t5 (t4OfRec p.1)) (h903 : ∀ p ∈ LinRQSC903.blobs, LinesCl t5 (t4OfRec p.1)) (h904 : ∀ p ∈ LinRQSC904.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N999.nT).map (t4At (LRSpectrumFull.L5S4.dg N999.TT) N999.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl
  · exact h894 p hp
  · exact h899 p hp
  · exact h900 p hp
  · exact h903 p hp
  · exact h904 p hp
)

#print axioms lines


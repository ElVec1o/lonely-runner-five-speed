/-
# L5Reg.Reg832 : the lines clause for every class of the local table of rep #832 (generated by l5reg)

Every local class `i < nT` of rep #832 (31 classes) is matched to the lines record `(chunk, index)` of `adv` with a 3x3 integer matrix `M` (UNTRUSTED advice): the kernel checks
`G l'_i = sum_k M_ik l_k` (G from digits 1..10 of the record), the signed-permutation property of G, and that every local range lies in a record range (`L5Reg.Equiv.eqChk`).
The theorem takes, for each chunk used, the lines clause of the chunk's records (from `Lin.lines_clause_tab` via `L5Reg.Mem`).
No `sorry`, no `native_decide`, no new axiom.  Not registered in any aggregator.
-/
import LRSpectrumFull.L5Reg.Equiv
import LRSpectrumFull.L5S4.GD3O832T
import LRSpectrumFull.L5S4.LinRQSC870
import LRSpectrumFull.L5S4.LinRQSC872
import LRSpectrumFull.L5S4.LinRQSC876

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace LRSpectrumFull
namespace L5Reg
namespace R832
open LRSpectrumFull.L5S3 LRSpectrumFull.L5S4 LRSpectrumFull.L5S4.Lin

def bls : List (ℕ × List (ℕ × ℕ)) := [(870, LinRQSC870.blobs), (872, LinRQSC872.blobs), (876, LinRQSC876.blobs)]
def adv : List (ℕ × ℕ × List ℤ) := [(876, 231, [2, 0, -1, -1, -2, 2, -2, 1, 0]), (876, 232, [1, 0, -1, 0, -2, 1, 2, 1, -2]), (876, 233, [1, 0, 0, 0, 2, -1, 3, 1, -1]), (876, 234, [1, 0, 0, 0, 2, -1, 2, -1, 0]), (876, 235, [1, 0, 0, 0, -1, 0, 3, 0, -1]), (876, 236, [1, 0, 0, 0, -1, 2, 2, 0, 1]), (876, 237, [1, 0, 0, 0, -2, 1, 2, 1, 0]), (876, 238, [1, 2, 0, 0, -1, 0, 2, -2, -1]), (876, 239, [1, -1, 2, 0, 0, -1, 2, -1, -2]), (876, 240, [2, 0, -1, -1, 1, 0, -2, -1, 1]), (870, 135, [2, 0, -1, -2, -1, 1, -1, 2, 0]), (870, 136, [2, -1, -1, -2, -2, 3, 1, 0, -1]), (876, 241, [2, -1, -1, -1, 0, 1, -2, -2, 3]), (876, 242, [2, 1, -2, -1, 0, 1, -1, 2, 0]), (876, 243, [2, 1, -2, -1, 0, 1, -2, 1, 1]), (876, 244, [1, 0, 2, 0, 0, -1, 2, -1, -2]), (876, 245, [1, -1, 2, 0, 0, -1, 2, -1, 0]), (876, 246, [2, -1, 0, -1, 0, -1, -1, 1, 0]), (876, 247, [2, -1, -1, -1, 0, 1, -2, -2, 3]), (876, 248, [2, 1, -2, -1, 0, 1, -1, 2, 0]), (876, 249, [0, 1, 0, -1, 0, 0, 1, -1, 1]), (876, 250, [0, -2, 1, -2, 1, 0, 1, 1, -1]), (872, 208, [0, 2, 1, -1, 0, 0, 1, -1, 0]), (872, 205, [0, -2, -1, 1, 0, 0, 2, -1, 0]), (876, 251, [0, 1, -1, -1, 0, 1, 1, 0, 0]), (876, 252, [0, 1, -1, -2, 0, 1, 1, 0, 0]), (876, 253, [0, -2, 1, -2, 1, 0, 3, 0, -1]), (876, 254, [0, 2, -1, -1, -1, 1, 1, 0, -1]), (876, 255, [0, 0, 1, -2, 1, 0, 3, -2, -1]), (876, 256, [0, 0, -1, -2, 1, 1, 3, -2, 0]), (876, 257, [0, 0, 1, -2, 1, 0, 3, -1, -1])]

theorem advOk : eqAll (LRSpectrumFull.L5S4.dg N832.TT) N832.ST (assoc bls) 0 adv = true := by decide +kernel

theorem adv_len : adv.length = N832.nT := by decide +kernel

/-- the lines clause for every class of the local table of rep #832. -/
theorem lines (t5 : List T5Rec) (h870 : ∀ p ∈ LinRQSC870.blobs, LinesCl t5 (t4OfRec p.1)) (h872 : ∀ p ∈ LinRQSC872.blobs, LinesCl t5 (t4OfRec p.1)) (h876 : ∀ p ∈ LinRQSC876.blobs, LinesCl t5 (t4OfRec p.1))
    : ∀ cl ∈ (List.range N832.nT).map (t4At (LRSpectrumFull.L5S4.dg N832.TT) N832.ST), LinesCl t5 cl :=
  linesLoc_of_adv t5 _ _ _ bls adv adv_len advOk (by
  intro e he p hp
  simp only [bls, List.mem_cons, List.mem_nil_iff, or_false] at he
  rcases he with rfl | rfl | rfl
  · exact h870 p hp
  · exact h872 p hp
  · exact h876 p hp
)

#print axioms lines

end R832
end L5Reg
end LRSpectrumFull

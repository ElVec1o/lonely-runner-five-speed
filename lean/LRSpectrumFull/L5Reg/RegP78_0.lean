theorem lines (t5 : List T5Rec) (h9 : ∀ p ∈ LinRQSC9.blobs, LinesCl t5 (t4OfRec p.1)) (h68 : ∀ p ∈ LinRQSC68.blobs, LinesCl t5 (t4OfRec p.1)) (h69 : ∀ p ∈ LinRQSC69.blobs, LinesCl t5 (t4OfRec p.1))
